# Task Area TA-SD "Strategy Development" of NFDI-MatWerk: the work of its organization is a process, and the TA co-spokesperson who takes part in it
# bears the role that the process realizes. As the MWO figure draws it, the agent bears the role (obo:BFO_0000196) and the process realizes it (obo:BFO_0000055);
# the MatWerk knowledge graph writes the same link the other way round ('role of'). The labels are those of the TA-SD row of the knowledge graph's process tab.

@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ontology: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/mwo-process-agent-role#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:work_of_ta_sd_organization a owl:NamedIndividual , obo:BFO_0000015 ;
    rdfs:label "work of TA-SD_organization" ;
    obo:RO_0000057 ex:ta_co_spokesperson_1 ;
    obo:BFO_0000055 ex:co_spokesperson_role .

ex:ta_co_spokesperson_1 a owl:NamedIndividual , ontology:NFDI_0000102 ;
    rdfs:label "TACoSpokesperson 1" ;
    obo:BFO_0000196 ex:co_spokesperson_role .

ex:co_spokesperson_role a owl:NamedIndividual , ontology:NFDI_0000229 ;
    rdfs:label "co-spokesperson role for work of TA-SD_organization" .
