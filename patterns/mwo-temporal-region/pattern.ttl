                                                      rdfs:label "event frequency datum"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Event frequency datum describes how often an events occurs within a given time interval" .


###  http://purls.helmholtz-metadaten.de/mwo/MWO_0001012
<http://purls.helmholtz-metadaten.de/mwo/MWO_0001012> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000027> ;
                                                      rdfs:label "date process ended"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which the experimental process was completed." .


###  https://w3id.org/pmd/co/PMD_0060009
<https://w3id.org/pmd/co/PMD_0060009> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033> ;
                                      rdfs:label "specification datum"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value."@en .


