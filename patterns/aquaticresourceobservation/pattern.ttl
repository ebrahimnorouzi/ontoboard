Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                                     rdfs:label "Aquatic resource observation ontology" ;
                                                                                     owl:versionInfo """1.7
- removed bug in restrictions involving year-based datatype properties1.6
- added more annotations for uploading to ODP portal
1.5
- changed year datatype properties to xsd:int range for compatibility with data export
1.4
- added owl:differentFrom axioms between (clearly distinguishable) individuals from a same closed class
- added enumerated class equivalences for closed classes
- made by Aldo Gangemi
1.3
- amended labels for consistency with XML sources
- made by Aldo Gangemi
1.2:
- added individuals for closed classes (nominals) of parameters
- made by Aldo Gangemi
1.1: 
- broadened domain of property: ofFishingArea
- added property: ofSpecies, and related restriction on AquaticResourceObservation
- made by Aldo Gangemi
1.0
- created by Aldo Gangemi""" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor
cpannotationschema:hasAuthor rdf:type owl:AnnotationProperty ;
                             rdfs:label "has author"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent
cpannotationschema:hasComponent rdf:type owl:AnnotationProperty ;
                                rdfs:label "has component"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest
cpannotationschema:hasUnitTest rdf:type owl:AnnotationProperty ;
                               rdfs:label "has unit test"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
cpannotationschema:isSpecializationOf rdf:type owl:AnnotationProperty ;
                                      rdfs:label "is specialization of"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#bottomTypeOfObservation
aquaticresourceobservation:bottomTypeOfObservation rdf:type owl:ObjectProperty ;
                                                   rdfs:subPropertyOf observation:isParameterOf ;
                                                   owl:inverseOf aquaticresourceobservation:ofBottomType ;
                                                   rdfs:domain aquaticresourceobservation:BottomType ;
                                                   rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                   rdfs:label "bottomTypeOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#climaticZoneOfObservation
aquaticresourceobservation:climaticZoneOfObservation rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf observation:isParameterOf ;
                                                     owl:inverseOf aquaticresourceobservation:ofClimaticZone ;
                                                     rdfs:domain aquaticresourceobservation:ClimaticZone ;
                                                     rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                     rdfs:label "climaticZoneOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#depthZoneOfObservation
aquaticresourceobservation:depthZoneOfObservation rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf observation:isParameterOf ;
                                                  owl:inverseOf aquaticresourceobservation:ofDepthZone ;
                                                  rdfs:domain aquaticresourceobservation:DepthZone ;
                                                  rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                  rdfs:label "depthZoneOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#fishingAreaOfObservation
aquaticresourceobservation:fishingAreaOfObservation rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf observation:isParameterOf ;
                                                    owl:inverseOf aquaticresourceobservation:ofFishingArea ;
                                                    rdfs:domain water_FAO_areas:FAO_fishing_area ;
                                                    rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                    rdfs:label "areaOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#geoFormOfObservation
aquaticresourceobservation:geoFormOfObservation rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf observation:isParameterOf ;
                                                owl:inverseOf aquaticresourceobservation:ofGeoForm ;
                                                rdfs:domain aquaticresourceobservation:GeoForm ;
                                                rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                rdfs:label "geoFormOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#horizontalDistributionOfObservation
aquaticresourceobservation:horizontalDistributionOfObservation rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf observation:isParameterOf ;
                                                               owl:inverseOf aquaticresourceobservation:ofHorizontalDistribution ;
                                                               rdfs:domain aquaticresourceobservation:HorizontalDistribution ;
                                                               rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                               rdfs:label "horizontalDistributionOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofBottomType
aquaticresourceobservation:ofBottomType rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf observation:hasParameter ;
                                        rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                        rdfs:range aquaticresourceobservation:BottomType ;
                                        rdfs:label "ofBottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofClimaticZone
aquaticresourceobservation:ofClimaticZone rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf observation:hasParameter ;
                                          rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                          rdfs:range aquaticresourceobservation:ClimaticZone ;
                                          rdfs:label "ofClimaticZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofDepthZone
aquaticresourceobservation:ofDepthZone rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf observation:hasParameter ;
                                       rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                       rdfs:range aquaticresourceobservation:DepthZone ;
                                       rdfs:label "ofDepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofFishingArea
aquaticresourceobservation:ofFishingArea rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf observation:hasParameter ;
                                         rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                         rdfs:range water_FAO_areas:FAO_fishing_area ;
                                         rdfs:label "inFishingArea" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofGeoForm
aquaticresourceobservation:ofGeoForm rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf observation:hasParameter ;
                                     rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                     rdfs:range aquaticresourceobservation:GeoForm ;
                                     rdfs:label "ofGeoForm" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofHorizontalDistribution
aquaticresourceobservation:ofHorizontalDistribution rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf observation:hasParameter ;
                                                    rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                                    rdfs:range aquaticresourceobservation:HorizontalDistribution ;
                                                    rdfs:label "ofHorizontalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofSpecies
aquaticresourceobservation:ofSpecies rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf observation:hasParameter ;
                                     owl:inverseOf aquaticresourceobservation:speciesFromObservation ;
                                     rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                     rdfs:range species_taxonomic:Species ;
                                     rdfs:label "ofSpecies" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdAbundanceLevel
aquaticresourceobservation:ofStdAbundanceLevel rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf observation:hasParameter ;
                                               owl:inverseOf aquaticresourceobservation:stdAbundanceLevelOfObservation ;
                                               rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                               rdfs:range aquaticresourceobservation:StdAbundanceLevel ;
                                               rdfs:label "ofStdAbundanceLevel" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdExploitationRate
aquaticresourceobservation:ofStdExploitationRate rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf observation:hasParameter ;
                                                 owl:inverseOf aquaticresourceobservation:stdExploitationRateOfObservation ;
                                                 rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                                 rdfs:range aquaticresourceobservation:StdExploitationRate ;
                                                 rdfs:label "ofStdExploitationRate" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdExploitationState
aquaticresourceobservation:ofStdExploitationState rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf observation:hasParameter ;
                                                  owl:inverseOf aquaticresourceobservation:stdExploitationStateOfObservation ;
                                                  rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                                  rdfs:range aquaticresourceobservation:StdExploitationState ;
                                                  rdfs:label "ofStdExploitationState" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofVerticalDistribution
aquaticresourceobservation:ofVerticalDistribution rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf observation:hasParameter ;
                                                  owl:inverseOf aquaticresourceobservation:verticalDistributionOfObservation ;
                                                  rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                                  rdfs:range aquaticresourceobservation:VerticalDistribution ;
                                                  rdfs:label "ofVerticalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#speciesFromObservation
aquaticresourceobservation:speciesFromObservation rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf observation:isParameterOf ;
                                                  rdfs:domain species_taxonomic:Species ;
                                                  rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                  rdfs:label "speciesFromObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdAbundanceLevelOfObservation
aquaticresourceobservation:stdAbundanceLevelOfObservation rdf:type owl:ObjectProperty ;
                                                          rdfs:subPropertyOf observation:isParameterOf ;
                                                          rdfs:domain aquaticresourceobservation:StdAbundanceLevel ;
                                                          rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                          rdfs:label "stdAbundanceLevelOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdExploitationRateOfObservation
aquaticresourceobservation:stdExploitationRateOfObservation rdf:type owl:ObjectProperty ;
                                                            rdfs:subPropertyOf observation:isParameterOf ;
                                                            rdfs:domain aquaticresourceobservation:StdExploitationRate ;
                                                            rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                            rdfs:label "stdExploitationRateOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdExploitationStateOfObservation
aquaticresourceobservation:stdExploitationStateOfObservation rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf observation:isParameterOf ;
                                                             rdfs:domain aquaticresourceobservation:StdExploitationState ;
                                                             rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                             rdfs:label "stdExploitationStateOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#verticalDistributionOfObservation
aquaticresourceobservation:verticalDistributionOfObservation rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf observation:isParameterOf ;
                                                             rdfs:domain aquaticresourceobservation:VerticalDistribution ;
                                                             rdfs:range aquaticresourceobservation:AquaticResourceObservation ;
                                                             rdfs:label "verticalDistributionOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation
observation:hasObservation rdf:type owl:ObjectProperty ;
                           rdfs:label "has observation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter
observation:hasParameter rdf:type owl:ObjectProperty ;
                         rdfs:label "has parameter"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf
observation:isObservationOf rdf:type owl:ObjectProperty ;
                            rdfs:label "is observation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf
observation:isParameterOf rdf:type owl:ObjectProperty ;
                          rdfs:label "is parameter of"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#forReferenceYear
aquaticresourceobservation:forReferenceYear rdf:type owl:DatatypeProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                            rdfs:range xsd:int ;
                                            rdfs:label "forReferenceYear" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#hasReportingYear
aquaticresourceobservation:hasReportingYear rdf:type owl:DatatypeProperty ;
                                            rdfs:subPropertyOf observation:inDate ;
                                            rdf:type owl:FunctionalProperty ;
                                            rdfs:domain aquaticresourceobservation:AquaticResourceObservation ;
                                            rdfs:range xsd:int ;
                                            rdfs:label "hasReportingYear" .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate
observation:inDate rdf:type owl:DatatypeProperty ;
                   rdfs:label "in date"@en .


#################################################################
#    Classes
#################################################################

###  http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species
species_taxonomic:Species rdf:type owl:Class ;
                          rdfs:label "species"@en .


###  http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area
water_FAO_areas:FAO_fishing_area rdf:type owl:Class ;
                                 rdfs:label "FAO fishing area"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResource
aquaticresourceobservation:AquaticResource rdf:type owl:Class ;
                                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                             owl:onProperty observation:hasObservation ;
                                                             owl:someValuesFrom aquaticresourceobservation:AquaticResourceObservation
                                                           ] ;
                                           rdfs:comment "An aquatic resource." ;
                                           rdfs:label "Aquatic resource" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResourceObservation
aquaticresourceobservation:AquaticResourceObservation rdf:type owl:Class ;
                                                      rdfs:subClassOf observation:Observation ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty observation:isObservationOf ;
                                                                        owl:allValuesFrom aquaticresourceobservation:AquaticResource
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofBottomType ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:BottomType
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofClimaticZone ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:ClimaticZone
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofDepthZone ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:DepthZone
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofFishingArea ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass water_FAO_areas:FAO_fishing_area
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofGeoForm ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:GeoForm
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofHorizontalDistribution ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:HorizontalDistribution
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofSpecies ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass species_taxonomic:Species
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofStdAbundanceLevel ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:StdAbundanceLevel
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofStdExploitationRate ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:StdExploitationRate
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofStdExploitationState ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:StdExploitationState
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:ofVerticalDistribution ;
                                                                        owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:VerticalDistribution
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty observation:isObservationOf ;
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                        owl:onClass aquaticresourceobservation:AquaticResource
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:forReferenceYear ;
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                        owl:onDataRange xsd:int
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty aquaticresourceobservation:hasReportingYear ;
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                        owl:onDataRange xsd:int
                                                                      ] ;
                                                      rdfs:comment "An observation singled out of reported data, once a year, about an aquatic resource." ;
                                                      rdfs:label "Aquatic resource observation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#BottomType
aquaticresourceobservation:BottomType rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Class ;
                                                            owl:oneOf ( aquaticresourceobservation:CoralReef
                                                                        aquaticresourceobservation:HardBottom
                                                                        aquaticresourceobservation:Seagrass
                                                                        aquaticresourceobservation:SoftBottom
                                                                        aquaticresourceobservation:UnspecifiedClimaticZone
                                                                      )
                                                          ] ;
                                      rdfs:subClassOf observation:Parameter ;
                                      rdfs:label "BottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ClimaticZone
aquaticresourceobservation:ClimaticZone rdf:type owl:Class ;
                                        owl:equivalentClass [ rdf:type owl:Class ;
                                                              owl:oneOf ( aquaticresourceobservation:Polar
                                                                          aquaticresourceobservation:Temperate
                                                                          aquaticresourceobservation:Tropical
                                                                        )
                                                            ] ;
                                        rdfs:subClassOf observation:Parameter ;
                                        rdfs:label "ClimaticZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#DepthZone
aquaticresourceobservation:DepthZone rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Class ;
                                                           owl:oneOf ( aquaticresourceobservation:Abyssal
                                                                       aquaticresourceobservation:Coastal
                                                                       aquaticresourceobservation:Shelf
                                                                       aquaticresourceobservation:Slope
                                                                       aquaticresourceobservation:UnspecifiedDepthZone
                                                                     )
                                                         ] ;
                                     rdfs:subClassOf observation:Parameter ;
                                     rdfs:label "DepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#GeoForm
aquaticresourceobservation:GeoForm rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( aquaticresourceobservation:Canyons
                                                                     aquaticresourceobservation:Estuaries
                                                                     aquaticresourceobservation:Fjords
                                                                     aquaticresourceobservation:Lagoons
                                                                     aquaticresourceobservation:Seamounts
                                                                     aquaticresourceobservation:UnspecifiedGeoforms
                                                                   )
                                                       ] ;
                                   rdfs:subClassOf observation:Parameter ;
                                   rdfs:label "GeoForm" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HorizontalDistribution
aquaticresourceobservation:HorizontalDistribution rdf:type owl:Class ;
                                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                                        owl:oneOf ( aquaticresourceobservation:Estuarine
                                                                                    aquaticresourceobservation:Littoral
                                                                                    aquaticresourceobservation:Neritic
                                                                                    aquaticresourceobservation:Oceanic
                                                                                    aquaticresourceobservation:UnspecifiedHorizontalDistribution
                                                                                  )
                                                                      ] ;
                                                  rdfs:subClassOf observation:Parameter ;
                                                  rdfs:label "HorizontalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdAbundanceLevel
aquaticresourceobservation:StdAbundanceLevel rdf:type owl:Class ;
                                             owl:equivalentClass [ rdf:type owl:Class ;
                                                                   owl:oneOf ( aquaticresourceobservation:DepletedStdAbundanceLevel
                                                                               aquaticresourceobservation:IntermediateStdAbundanceLevel
                                                                               aquaticresourceobservation:LowStdAbundanceLevel
                                                                               aquaticresourceobservation:NotProvidedStdAbundanceLevel
                                                                               aquaticresourceobservation:PreExploitationBiomassOrHighStdAbundanceLevel
                                                                               aquaticresourceobservation:UncertainOrNotAssessedStdAbundanceLevel
                                                                             )
                                                                 ] ;
                                             rdfs:subClassOf observation:Parameter ;
                                             rdfs:label "StdAbundanceLevel" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdExploitationRate
aquaticresourceobservation:StdExploitationRate rdf:type owl:Class ;
                                               owl:equivalentClass [ rdf:type owl:Class ;
                                                                     owl:oneOf ( aquaticresourceobservation:HighFishingMortality
                                                                                 aquaticresourceobservation:ModerateFishingMortality
                                                                                 aquaticresourceobservation:NoOrLowFishingMortality
                                                                                 aquaticresourceobservation:NotProvidedExploitationRate
                                                                                 aquaticresourceobservation:UncertainOrNotAssessedExploitationRate
                                                                               )
                                                                   ] ;
                                               rdfs:subClassOf observation:Parameter ;
                                               rdfs:label "StdExploitationRate" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdExploitationState
aquaticresourceobservation:StdExploitationState rdf:type owl:Class ;
                                                owl:equivalentClass [ rdf:type owl:Class ;
                                                                      owl:oneOf ( aquaticresourceobservation:DepletedExploitationState
                                                                                  aquaticresourceobservation:FullyExploited
                                                                                  aquaticresourceobservation:ModeratelyExploited
                                                                                  aquaticresourceobservation:NoSpecificAssessment
                                                                                  aquaticresourceobservation:NotProvidedExploitationState
                                                                                  aquaticresourceobservation:Overexploited
                                                                                  aquaticresourceobservation:Recovering
                                                                                  aquaticresourceobservation:UncertainExploitationState
                                                                                  aquaticresourceobservation:Underexploited
                                                                                  aquaticresourceobservation:Unexploited
                                                                                )
                                                                    ] ;
                                                rdfs:subClassOf observation:Parameter ;
                                                rdfs:label "StdExploitationState" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#VerticalDistribution
aquaticresourceobservation:VerticalDistribution rdf:type owl:Class ;
                                                owl:equivalentClass [ rdf:type owl:Class ;
                                                                      owl:oneOf ( aquaticresourceobservation:DemersalOrBenthic
                                                                                  aquaticresourceobservation:Pelagic
                                                                                  aquaticresourceobservation:UnspecifiedVerticalDistribution
                                                                                )
                                                                    ] ;
                                                rdfs:subClassOf observation:Parameter ;
                                                rdfs:label "VerticalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation
observation:Observation rdf:type owl:Class ;
                        rdfs:label "Observation"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter
observation:Parameter rdf:type owl:Class ;
                      rdfs:label "Parameter"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Abyssal
aquaticresourceobservation:Abyssal rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:DepthZone ,
                                            owl:Thing ;
                                   rdfs:label "Abyssal" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Canyons
aquaticresourceobservation:Canyons rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:GeoForm ,
                                            owl:Thing ;
                                   rdfs:label "Canyons" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Coastal
aquaticresourceobservation:Coastal rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:DepthZone ,
                                            owl:Thing ;
                                   rdfs:label "Coastal" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#CoralReef
aquaticresourceobservation:CoralReef rdf:type owl:NamedIndividual ,
                                              aquaticresourceobservation:BottomType ,
                                              owl:Thing ;
                                     rdfs:label "Coral Reef" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#DemersalOrBenthic
aquaticresourceobservation:DemersalOrBenthic rdf:type owl:NamedIndividual ,
                                                      aquaticresourceobservation:VerticalDistribution ,
                                                      owl:Thing ;
                                             rdfs:label "Demersal/Benthic" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#DepletedExploitationState
aquaticresourceobservation:DepletedExploitationState rdf:type owl:NamedIndividual ,
                                                              aquaticresourceobservation:StdExploitationState ,
                                                              owl:Thing ;
                                                     rdfs:label "Depleted (exploitation state)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#DepletedStdAbundanceLevel
aquaticresourceobservation:DepletedStdAbundanceLevel rdf:type owl:NamedIndividual ,
                                                              aquaticresourceobservation:StdAbundanceLevel ,
                                                              owl:Thing ;
                                                     rdfs:label "Depleted (abundance level)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Estuaries
aquaticresourceobservation:Estuaries rdf:type owl:NamedIndividual ,
                                              aquaticresourceobservation:GeoForm ,
                                              owl:Thing ;
                                     rdfs:label "Estuaries" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Estuarine
aquaticresourceobservation:Estuarine rdf:type owl:NamedIndividual ,
                                              aquaticresourceobservation:HorizontalDistribution ,
                                              owl:Thing ;
                                     rdfs:label "Estuarine" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Fjords
aquaticresourceobservation:Fjords rdf:type owl:NamedIndividual ,
                                           aquaticresourceobservation:GeoForm ,
                                           owl:Thing ;
                                  rdfs:label "Fjords" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#FullyExploited
aquaticresourceobservation:FullyExploited rdf:type owl:NamedIndividual ,
                                                   aquaticresourceobservation:StdExploitationState ,
                                                   owl:Thing ;
                                          rdfs:label "Fully Exploited" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HardBottom
aquaticresourceobservation:HardBottom rdf:type owl:NamedIndividual ,
                                               aquaticresourceobservation:BottomType ,
                                               owl:Thing ;
                                      rdfs:label "Hard Bottom" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HighFishingMortality
aquaticresourceobservation:HighFishingMortality rdf:type owl:NamedIndividual ,
                                                         aquaticresourceobservation:StdExploitationRate ,
                                                         owl:Thing ;
                                                rdfs:label "High Fishing Mortality" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#IntermediateStdAbundanceLevel
aquaticresourceobservation:IntermediateStdAbundanceLevel rdf:type owl:NamedIndividual ,
                                                                  aquaticresourceobservation:StdAbundanceLevel ,
                                                                  owl:Thing ;
                                                         rdfs:label "Intermediate Abundance" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Lagoons
aquaticresourceobservation:Lagoons rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:GeoForm ,
                                            owl:Thing ;
                                   rdfs:label "Lagoons" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Littoral
aquaticresourceobservation:Littoral rdf:type owl:NamedIndividual ,
                                             aquaticresourceobservation:HorizontalDistribution ,
                                             owl:Thing ;
                                    rdfs:label "Littoral" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#LowStdAbundanceLevel
aquaticresourceobservation:LowStdAbundanceLevel rdf:type owl:NamedIndividual ,
                                                         aquaticresourceobservation:StdAbundanceLevel ,
                                                         owl:Thing ;
                                                rdfs:label "Low Abundance" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ModerateFishingMortality
aquaticresourceobservation:ModerateFishingMortality rdf:type owl:NamedIndividual ,
                                                             aquaticresourceobservation:StdExploitationRate ,
                                                             owl:Thing ;
                                                    rdfs:label "Moderate Fishing Mortality" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ModeratelyExploited
aquaticresourceobservation:ModeratelyExploited rdf:type owl:NamedIndividual ,
                                                        aquaticresourceobservation:StdExploitationState ,
                                                        owl:Thing ;
                                               rdfs:label "Moderately Exploited" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Neritic
aquaticresourceobservation:Neritic rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:HorizontalDistribution ,
                                            owl:Thing ;
                                   rdfs:label "Neritic" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#NoOrLowFishingMortality
aquaticresourceobservation:NoOrLowFishingMortality rdf:type owl:NamedIndividual ,
                                                            aquaticresourceobservation:StdExploitationRate ,
                                                            owl:Thing ;
                                                   rdfs:label "No Or Low Fishing Mortality" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#NoSpecificAssessment
aquaticresourceobservation:NoSpecificAssessment rdf:type owl:NamedIndividual ,
                                                         aquaticresourceobservation:StdExploitationState ,
                                                         owl:Thing ;
                                                rdfs:label "No Specific Assessment" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#NotProvidedExploitationRate
aquaticresourceobservation:NotProvidedExploitationRate rdf:type owl:NamedIndividual ,
                                                                aquaticresourceobservation:StdExploitationRate ,
                                                                owl:Thing ;
                                                       rdfs:label "Not Provided (exploitation rate)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#NotProvidedExploitationState
aquaticresourceobservation:NotProvidedExploitationState rdf:type owl:NamedIndividual ,
                                                                 aquaticresourceobservation:StdExploitationState ,
                                                                 owl:Thing ;
                                                        rdfs:label "Not Provided (exploitation state)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#NotProvidedStdAbundanceLevel
aquaticresourceobservation:NotProvidedStdAbundanceLevel rdf:type owl:NamedIndividual ,
                                                                 aquaticresourceobservation:StdAbundanceLevel ,
                                                                 owl:Thing ;
                                                        rdfs:label "Not Provided (abundance level)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Oceanic
aquaticresourceobservation:Oceanic rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:HorizontalDistribution ,
                                            owl:Thing ;
                                   rdfs:label "Oceanic" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Overexploited
aquaticresourceobservation:Overexploited rdf:type owl:NamedIndividual ,
                                                  aquaticresourceobservation:StdExploitationState ,
                                                  owl:Thing ;
                                         rdfs:label "Overexploited" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Pelagic
aquaticresourceobservation:Pelagic rdf:type owl:NamedIndividual ,
                                            aquaticresourceobservation:VerticalDistribution ,
                                            owl:Thing ;
                                   rdfs:label "Pelagic" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Polar
aquaticresourceobservation:Polar rdf:type owl:NamedIndividual ,
                                          aquaticresourceobservation:ClimaticZone ,
                                          owl:Thing ;
                                 rdfs:label "Polar" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#PreExploitationBiomassOrHighStdAbundanceLevel
aquaticresourceobservation:PreExploitationBiomassOrHighStdAbundanceLevel rdf:type owl:NamedIndividual ,
                                                                                  aquaticresourceobservation:StdAbundanceLevel ,
                                                                                  owl:Thing ;
                                                                         rdfs:label "PreExploitation Biomass Or High Abundance" .


