@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl> rdf:type owl:Ontology ;
                                                                                     owl:imports <http://www.ontologydesignpatterns.org/cp/owl/observation.owl> ,
                                                                                                 <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl> ,
                                                                                                 <http://www.ontologydesignpatterns.org/cp/owl/fsdas/waterareasfactsheets.owl> ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "For an aquatic resource, what species, in what fishing areas, climatic zones, bottom types, depth zones, geo forms, horizontal and vertical distribution, and for what standardized abundance level, exploitation state and rate, have been observed? for what reference year? At what year the observation has been recorded?" ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Aldo Gangemi (CNR), based on specifications by Claudio Baldassarre (UN-FAO), Caterina Caracciolo (UN-FAO), and Michael Erdmann (Ontoprise), for the NeOn project." ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> "http://ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl" ,
                                                                                                                                                                         "http://ontologydesignpatterns.org/cp/owl/fsdas/waterareasfactsheets.owl" ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "We are able to query and reason on the data extracted from the FactSheets XML database, concerning the observation of aquatic resources. There are more data in that database, however." ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent the aquatic observation data extracted from factsheet application. An aquatic observation refers to a specific year, is about an aquatic resource, and is situated in a given habitat, in which the aquatic species from the resource live. Observations can have a reporting year that is different from the observation time." ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?x
WHERE {
?x isObservationOf ?ar .
?x forReferenceYear ?y1 .
?x hasReportingYear ?y2 }""" ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> "http://ontologydesignpattern.org/cp/owl/observation.owl" ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "http://ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl" ;
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "The aquatic resource for Skipjack tuna in Northern Atlantic in 2004 (as reported in 2008) was observed with low abundance level." ;
                                                                                     rdfs:comment "An ontology that represents the semantics of a database view about \"observations\" for an aquatic resource, aggregated once a year." ;
                                                                                     rdfs:label "Aquatic resource observation ontology" ;
                                                                                     owl:versionInfo """1.7
- removed bug in restrictions involving year-based datatype properties1.6
- added more annotations for uploading to ODP portal
1.5
- changed year datatype properties to xsd:int range for compatibility with data export
1.4
- added owl:differentFrom axioms between (clearly distinguishable) individuals from a same closed class
- added enumerated class equivalences for closed classes
- made by Aldo Gangemi
1.3
- amended labels for consistency with XML sources
- made by Aldo Gangemi
1.2:
- added individuals for closed classes (nominals) of parameters
- made by Aldo Gangemi
1.1: 
- broadened domain of property: ofFishingArea
- added property: ofSpecies, and related restriction on AquaticResourceObservation
- made by Aldo Gangemi
1.0
- created by Aldo Gangemi""" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> rdf:type owl:AnnotationProperty .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#bottomTypeOfObservation
:bottomTypeOfObservation rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                         owl:inverseOf :ofBottomType ;
                         rdfs:domain :BottomType ;
                         rdfs:range :AquaticResourceObservation ;
                         rdfs:label "bottomTypeOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#climaticZoneOfObservation
:climaticZoneOfObservation rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                           owl:inverseOf :ofClimaticZone ;
                           rdfs:domain :ClimaticZone ;
                           rdfs:range :AquaticResourceObservation ;
                           rdfs:label "climaticZoneOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#depthZoneOfObservation
:depthZoneOfObservation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                        owl:inverseOf :ofDepthZone ;
                        rdfs:domain :DepthZone ;
                        rdfs:range :AquaticResourceObservation ;
                        rdfs:label "depthZoneOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#fishingAreaOfObservation
:fishingAreaOfObservation rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                          owl:inverseOf :ofFishingArea ;
                          rdfs:domain <http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area> ;
                          rdfs:range :AquaticResourceObservation ;
                          rdfs:label "areaOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#geoFormOfObservation
:geoFormOfObservation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                      owl:inverseOf :ofGeoForm ;
                      rdfs:domain :GeoForm ;
                      rdfs:range :AquaticResourceObservation ;
                      rdfs:label "geoFormOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#horizontalDistributionOfObservation
:horizontalDistributionOfObservation rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                                     owl:inverseOf :ofHorizontalDistribution ;
                                     rdfs:domain :HorizontalDistribution ;
                                     rdfs:range :AquaticResourceObservation ;
                                     rdfs:label "horizontalDistributionOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofBottomType
:ofBottomType rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
              rdfs:domain :AquaticResourceObservation ;
              rdfs:range :BottomType ;
              rdfs:label "ofBottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofClimaticZone
:ofClimaticZone rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                rdfs:domain :AquaticResourceObservation ;
                rdfs:range :ClimaticZone ;
                rdfs:label "ofClimaticZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofDepthZone
:ofDepthZone rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
             rdfs:domain :AquaticResourceObservation ;
             rdfs:range :DepthZone ;
             rdfs:label "ofDepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofFishingArea
:ofFishingArea rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
               rdfs:domain :AquaticResourceObservation ;
               rdfs:range <http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area> ;
               rdfs:label "inFishingArea" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofGeoForm
:ofGeoForm rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
           rdfs:domain :AquaticResourceObservation ;
           rdfs:range :GeoForm ;
           rdfs:label "ofGeoForm" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofHorizontalDistribution
:ofHorizontalDistribution rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                          rdfs:domain :AquaticResourceObservation ;
                          rdfs:range :HorizontalDistribution ;
                          rdfs:label "ofHorizontalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofSpecies
:ofSpecies rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
           owl:inverseOf :speciesFromObservation ;
           rdfs:domain :AquaticResourceObservation ;
           rdfs:range <http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species> ;
           rdfs:label "ofSpecies" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdAbundanceLevel
:ofStdAbundanceLevel rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                     owl:inverseOf :stdAbundanceLevelOfObservation ;
                     rdfs:domain :AquaticResourceObservation ;
                     rdfs:range :StdAbundanceLevel ;
                     rdfs:label "ofStdAbundanceLevel" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdExploitationRate
:ofStdExploitationRate rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                       owl:inverseOf :stdExploitationRateOfObservation ;
                       rdfs:domain :AquaticResourceObservation ;
                       rdfs:range :StdExploitationRate ;
                       rdfs:label "ofStdExploitationRate" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofStdExploitationState
:ofStdExploitationState rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                        owl:inverseOf :stdExploitationStateOfObservation ;
                        rdfs:domain :AquaticResourceObservation ;
                        rdfs:range :StdExploitationState ;
                        rdfs:label "ofStdExploitationState" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ofVerticalDistribution
:ofVerticalDistribution rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                        owl:inverseOf :verticalDistributionOfObservation ;
                        rdfs:domain :AquaticResourceObservation ;
                        rdfs:range :VerticalDistribution ;
                        rdfs:label "ofVerticalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#speciesFromObservation
:speciesFromObservation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                        rdfs:domain <http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species> ;
                        rdfs:range :AquaticResourceObservation ;
                        rdfs:label "speciesFromObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdAbundanceLevelOfObservation
:stdAbundanceLevelOfObservation rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                                rdfs:domain :StdAbundanceLevel ;
                                rdfs:range :AquaticResourceObservation ;
                                rdfs:label "stdAbundanceLevelOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdExploitationRateOfObservation
:stdExploitationRateOfObservation rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                                  rdfs:domain :StdExploitationRate ;
                                  rdfs:range :AquaticResourceObservation ;
                                  rdfs:label "stdExploitationRateOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#stdExploitationStateOfObservation
:stdExploitationStateOfObservation rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                                   rdfs:domain :StdExploitationState ;
                                   rdfs:range :AquaticResourceObservation ;
                                   rdfs:label "stdExploitationStateOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#verticalDistributionOfObservation
:verticalDistributionOfObservation rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                                   rdfs:domain :VerticalDistribution ;
                                   rdfs:range :AquaticResourceObservation ;
                                   rdfs:label "verticalDistributionOfObservation" .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation
<http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter
<http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf
<http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf
<http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#forReferenceYear
:forReferenceYear rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :AquaticResourceObservation ;
                  rdfs:range xsd:int ;
                  rdfs:label "forReferenceYear" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#hasReportingYear
:hasReportingYear rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate> ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :AquaticResourceObservation ;
                  rdfs:range xsd:int ;
                  rdfs:label "hasReportingYear" .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate
<http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species
<http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species> rdf:type owl:Class .


###  http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area
<http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResource
:AquaticResource rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation> ;
                                   owl:someValuesFrom :AquaticResourceObservation
                                 ] ;
                 rdfs:comment "An aquatic resource." ;
                 rdfs:label "Aquatic resource" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResourceObservation
:AquaticResourceObservation rdf:type owl:Class ;
                            rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation> ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf> ;
                                              owl:allValuesFrom :AquaticResource
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofBottomType ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :BottomType
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofClimaticZone ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :ClimaticZone
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofDepthZone ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :DepthZone
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofFishingArea ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass <http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area>
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofGeoForm ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :GeoForm
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofHorizontalDistribution ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :HorizontalDistribution
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofSpecies ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass <http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species>
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofStdAbundanceLevel ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :StdAbundanceLevel
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofStdExploitationRate ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :StdExploitationRate
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofStdExploitationState ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :StdExploitationState
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :ofVerticalDistribution ;
                                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                              owl:onClass :VerticalDistribution
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf> ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :AquaticResource
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :forReferenceYear ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:int
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasReportingYear ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:int
                                            ] ;
                            rdfs:comment "An observation singled out of reported data, once a year, about an aquatic resource." ;
                            rdfs:label "Aquatic resource observation" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#BottomType
:BottomType rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :CoralReef
                                              :HardBottom
                                              :Seagrass
                                              :SoftBottom
                                              :UnspecifiedClimaticZone
                                            )
                                ] ;
            rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
            rdfs:label "BottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#ClimaticZone
:ClimaticZone rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :Polar
                                                :Temperate
                                                :Tropical
                                              )
                                  ] ;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
              rdfs:label "ClimaticZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#DepthZone
:DepthZone rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( :Abyssal
                                             :Coastal
                                             :Shelf
                                             :Slope
                                             :UnspecifiedDepthZone
                                           )
                               ] ;
           rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
           rdfs:label "DepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#GeoForm
:GeoForm rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Class ;
                               owl:oneOf ( :Canyons
                                           :Estuaries
                                           :Fjords
                                           :Lagoons
                                           :Seamounts
                                           :UnspecifiedGeoforms
                                         )
                             ] ;
         rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
         rdfs:label "GeoForm" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HorizontalDistribution
:HorizontalDistribution rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( :Estuarine
                                                          :Littoral
                                                          :Neritic
                                                          :Oceanic
                                                          :UnspecifiedHorizontalDistribution
                                                        )
                                            ] ;
                        rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
                        rdfs:label "HorizontalDistribution" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdAbundanceLevel
:StdAbundanceLevel rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( :DepletedStdAbundanceLevel
                                                     :IntermediateStdAbundanceLevel
                                                     :LowStdAbundanceLevel
                                                     :NotProvidedStdAbundanceLevel
                                                     :PreExploitationBiomassOrHighStdAbundanceLevel
                                                     :UncertainOrNotAssessedStdAbundanceLevel
                                                   )
                                       ] ;
                   rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
                   rdfs:label "StdAbundanceLevel" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdExploitationRate
:StdExploitationRate rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :HighFishingMortality
                                                       :ModerateFishingMortality
