    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Fjords -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Fjords">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#GeoForm"/>
        <rdfs:label>Fjords</rdfs:label>
    </owl:Thing>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#FullyExploited -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#FullyExploited">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdExploitationState"/>
        <rdfs:label>Fully Exploited</rdfs:label>
    </owl:Thing>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HardBottom -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HardBottom">
