    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#forReferenceYear -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#forReferenceYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResourceObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>forReferenceYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#hasReportingYear -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#hasReportingYear">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#AquaticResourceObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>hasReportingYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate">
        <rdfs:label xml:lang="en">in date</rdfs:label>
    </owl:DatatypeProperty>
    


