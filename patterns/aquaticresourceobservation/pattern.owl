        <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdAbundanceLevel"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depleted (abundance level)</rdfs:label>
    </owl:Thing>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Estuaries -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#Estuaries">
