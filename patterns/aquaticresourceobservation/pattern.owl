    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#IntermediateStdAbundanceLevel -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#IntermediateStdAbundanceLevel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#StdAbundanceLevel"/>
