    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HighFishingMortality -->

    <owl:Thing rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#HighFishingMortality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
