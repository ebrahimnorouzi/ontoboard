# The aquaticresourceobservation pattern in use, on the pattern's own scenario: the skipjack
# tuna resource of the North Atlantic, observed for 2004 and reported in 2008 with a low
# abundance level. The habitat descriptors - fishing area, climatic zone, bottom type, depth
# zone, geoform and the two distributions - each point back at that one observation, and the
# two year properties are typed xsd:int because that is the range the pattern declares.

@prefix aquaticresourceobservation: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresourceobservation.owl#> .
@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix speciestaxonomic: <http://www.fao.org/aims/aos/fi/species_taxonomic.owl#> .
@prefix waterfaoareas: <http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/aquaticresourceobservation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:SkipjackNorthAtlantic2004 a owl:NamedIndividual , aquaticresourceobservation:AquaticResourceObservation ;
    rdfs:label "the 2004 observation of the North Atlantic skipjack tuna resource, reported in 2008" ;
    aquaticresourceobservation:forReferenceYear "2004"^^xsd:int ;
    aquaticresourceobservation:hasReportingYear "2008"^^xsd:int ;
    aquaticresourceobservation:ofSpecies ex:SkipjackTuna ;
    aquaticresourceobservation:ofStdAbundanceLevel ex:LowAbundance ;
    aquaticresourceobservation:ofStdExploitationRate ex:HighFishingMortality ;
    aquaticresourceobservation:ofStdExploitationState ex:FullyExploited ;
    aquaticresourceobservation:ofVerticalDistribution ex:PelagicDistribution .

ex:SoftBottom a owl:NamedIndividual , aquaticresourceobservation:BottomType ;
    rdfs:label "soft bottom: sand and mud" ;
    aquaticresourceobservation:bottomTypeOfObservation ex:SkipjackNorthAtlantic2004 .

ex:TemperateZone a owl:NamedIndividual , aquaticresourceobservation:ClimaticZone ;
    rdfs:label "the temperate climatic zone" ;
    aquaticresourceobservation:climaticZoneOfObservation ex:SkipjackNorthAtlantic2004 .

ex:ShelfDepthZone a owl:NamedIndividual , aquaticresourceobservation:DepthZone ;
    rdfs:label "the shelf zone, down to about 200 m" ;
    aquaticresourceobservation:depthZoneOfObservation ex:SkipjackNorthAtlantic2004 .

ex:FaoArea21 a owl:NamedIndividual , waterfaoareas:FAO_fishing_area ;
    rdfs:label "FAO Major Fishing Area 21: Atlantic, Northwest" ;
    aquaticresourceobservation:fishingAreaOfObservation ex:SkipjackNorthAtlantic2004 .

ex:NorthAtlanticSkipjackStock a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the North Atlantic skipjack tuna stock" .

ex:Seamounts a owl:NamedIndividual , aquaticresourceobservation:GeoForm ;
    rdfs:label "seamounts" ;
    aquaticresourceobservation:geoFormOfObservation ex:SkipjackNorthAtlantic2004 .

ex:OceanicDistribution a owl:NamedIndividual , aquaticresourceobservation:HorizontalDistribution ;
    rdfs:label "oceanic: offshore, away from the shelf" ;
    aquaticresourceobservation:horizontalDistributionOfObservation ex:SkipjackNorthAtlantic2004 .

ex:StockAssessment2008 a owl:NamedIndividual , observation:Observation ;
    rdfs:label "the 2008 stock assessment that recorded the 2004 figures" ;
    observation:hasFeatureOfInterest ex:NorthAtlanticSkipjackStock ;
    observation:hasResult ex:LowAbundanceFinding ;
    observation:madeBy ex:FaoFisheriesDivision .

ex:FaoFisheriesDivision a owl:NamedIndividual , observation:Observer ;
    rdfs:label "the FAO Fisheries and Aquaculture Division" .

ex:LowAbundanceFinding a owl:NamedIndividual , observation:Result ;
    rdfs:label "the finding: low abundance, the stock fully exploited" .

ex:SkipjackTuna a owl:NamedIndividual , speciestaxonomic:Species ;
    rdfs:label "skipjack tuna (Katsuwonus pelamis)" .

ex:LowAbundance a owl:NamedIndividual , aquaticresourceobservation:StdAbundanceLevel ;
    rdfs:label "low abundance level" .

ex:HighFishingMortality a owl:NamedIndividual , aquaticresourceobservation:StdExploitationRate ;
    rdfs:label "high fishing mortality" .

ex:FullyExploited a owl:NamedIndividual , aquaticresourceobservation:StdExploitationState ;
    rdfs:label "fully exploited" .

ex:PelagicDistribution a owl:NamedIndividual , aquaticresourceobservation:VerticalDistribution ;
    rdfs:label "pelagic: in the water column, not on the bottom" .

# Only one direction of each inverse pair is asserted: bottomTypeOfObservation/ofBottomType, climaticZoneOfObservation/ofClimaticZone, depthZoneOfObservation/ofDepthZone, fishingAreaOfObservation/ofFishingArea, geoFormOfObservation/ofGeoForm, horizontalDistributionOfObservation/ofHorizontalDistribution, ofSpecies/speciesFromObservation, ofStdAbundanceLevel/stdAbundanceLevelOfObservation, ofStdExploitationRate/stdExploitationRateOfObservation, ofStdExploitationState/stdExploitationStateOfObservation, ofVerticalDistribution/verticalDistributionOfObservation. A reasoner adds the other.
