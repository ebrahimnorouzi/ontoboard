<?xml version="1.0"?>
<rdf:RDF xmlns="https://ontoboard.org/patterns/nfdi-event-occurrence.owl#"
     xml:base="https://ontoboard.org/patterns/nfdi-event-occurrence.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
