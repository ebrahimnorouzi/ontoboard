# The pattern's own scenario: the baptism of prince Mieszko I in 966, whose exact place historians
# still dispute. Because the knowledge is not certain, what professor Hanna Kóčka-Krenz published
# is a claim ABOUT the event, not the event itself - an information object expressing it - and the
# act of reporting is the situation she is set in.

@prefix intensionextension: <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#> .
@prefix reportingevent: <http://semantic.cs.put.poznan.pl/ontologies/reportingevent.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix typesofentities: <http://www.ontologydesignpatterns.org/cp/owl/typesofentities.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/reportingevent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:HannaKockaKrenz a owl:NamedIndividual , situation:Entity ;
    rdfs:label "Hanna Kóčka-Krenz, the archaeologist who excavated Poznań" ;
    situation:hasSetting ex:PoznanClaimReport .

ex:PoznanClaimReport a owl:NamedIndividual , situation:Situation ;
    rdfs:label "her reporting of the baptism as having happened at Poznań, on the evidence of her own excavations" ;
    situation:isSettingFor ex:HannaKockaKrenz .

ex:BaptismAtPoznanView a owl:NamedIndividual , intensionextension:InformationObject ;
    rdfs:label "the claim that Mieszko I was baptised at Poznań in 966" ;
    intensionextension:expresses ex:BaptismOfMieszkoI .

ex:BaptismOfMieszkoI a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the baptism of prince Mieszko I, 966 - the actual event the professors disagree about" .

# Only one direction of each inverse pair is asserted: expresses/isExpressedBy, isAbout/isReferenceOf. A reasoner adds the other.
