@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fsdas: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix specieshabitat: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#> .
@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl> rdf:type owl:Ontology ;
                                                                         owl:imports fsdas:aquaticresources.owl ,
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                         dcterms:description "to represent species together with their typical environment in terms of habitat and water area"^^xsd:string ;
                                                                         dcterms:title "Specieshabitat Pattern"^^xsd:string ;
                                                                         cpannotationschema:coversRequirements "what species have what habitat in what water area?" ;
                                                                         cpannotationschema:hasConsequences """The pattern allows to represent species with a typical habitat and a typical water area where the exemplars can be found. However, there is no direct relation between the habitat (type) and the water area; in principle, it is possible that there are no places in the water area that provide the conditions for that habitat.
In order to represent that a species has a habitat within a given water area, the situation pattern should be reused and specialized, as in the speciesconditions.owl pattern.""" ;
                                                                         cpannotationschema:hasIntent "to represent species together with their typical environment in terms of habitat and water area"^^xsd:string ;
                                                                         cpannotationschema:relatedCPs "speciesconditions.owl" ;
                                                                         cpannotationschema:scenarios "give me the species having a 'demersal' habitat in water area '24'" ;
                                                                         rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label removed x1; label added x11; term declared x3;
- header: dcterms:title \"Specieshabitat Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl> as an individual, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                      """This pattern encodes a FSDAS competency question, with an indication to use some Species class, and some hasHabitat property, with range xsd:string.
Since the application task of FSDAS is to jointly query FIGIS factsheet data and RTMS time series data, the pattern must encode elements that can be easily mapped to FIGIS and RTMS schemas/ontologies.
Issue (1) mapping Species to FIGIS schema, since the needed schema elements are two instead of one.
Issue (2) representation of habitats in the pattern is intuitively with objects, since habitats are typically objects, and points in a value space (as the referents of xsd datatypes typically are). The suggestion in the competencey question is to use xsd.string though.""" ;
                                                                         rdfs:label "Specieshabitat Pattern"@en ;
                                                                         owl:versionInfo "Created by Aldo Gangemi" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#hasBottomType
specieshabitat:hasBottomType rdf:type owl:ObjectProperty ;
                             rdfs:domain owl:Thing ;
                             rdfs:range specieshabitat:BottomType ;
                             rdfs:label "hasBottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#hasDepthZone
specieshabitat:hasDepthZone rdf:type owl:ObjectProperty ;
                            rdfs:domain owl:Thing ;
                            rdfs:range specieshabitat:DepthZone ;
                            rdfs:label "hasDepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#hasGeoform
specieshabitat:hasGeoform rdf:type owl:ObjectProperty ;
                          rdfs:domain owl:Thing ;
                          rdfs:range specieshabitat:Geoform ;
                          rdfs:label "hasGeoForm" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#hasHabitat
specieshabitat:hasHabitat rdf:type owl:ObjectProperty ;
                          owl:inverseOf specieshabitat:isHabitatFor ;
                          rdfs:domain aquaticresources:AquaticSpecies ;
                          rdfs:range specieshabitat:Habitat ;
                          rdfs:label "has habitat"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#isHabitatFor
specieshabitat:isHabitatFor rdf:type owl:ObjectProperty ;
                            rdfs:domain specieshabitat:Habitat ;
                            rdfs:range aquaticresources:AquaticSpecies ;
                            rdfs:label "is habitat for"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticResource
aquaticresources:AquaticResource rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty specieshabitat:hasBottomType ;
                                                   owl:someValuesFrom specieshabitat:BottomType
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty specieshabitat:hasDepthZone ;
                                                   owl:someValuesFrom specieshabitat:DepthZone
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty specieshabitat:hasGeoform ;
                                                   owl:someValuesFrom specieshabitat:Geoform
                                                 ] ;
                                 owl:disjointWith specieshabitat:Habitat ;
                                 rdfs:label "Aquatic resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies
aquaticresources:AquaticSpecies rdf:type owl:Class ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty specieshabitat:hasHabitat ;
                                                  owl:someValuesFrom specieshabitat:Habitat
                                                ] ;
                                owl:disjointWith specieshabitat:Habitat ;
                                rdfs:comment "Here also the complex type SpeciesFeature (holding association with HabitatBio) is the schema mapping required to refer to Habitat. Any mapping has to take care of that, e.g. maps(AquaticSpecies, owl:unionOf(SpeciesRef, SpeciesFeature))." ;
                                rdfs:label "Aquatic species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#WaterArea
aquaticresources:WaterArea rdf:type owl:Class ;
                           owl:disjointWith specieshabitat:Habitat ;
                           rdfs:label "Water area"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#BottomType
specieshabitat:BottomType rdf:type owl:Class ;
                          rdfs:label "BottomType" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#DepthZone
specieshabitat:DepthZone rdf:type owl:Class ;
                         rdfs:label "DepthZone" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#Geoform
specieshabitat:Geoform rdf:type owl:Class ;
                       rdfs:label "Geoform" .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl#Habitat
specieshabitat:Habitat rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty specieshabitat:isHabitatFor ;
                                         owl:someValuesFrom aquaticresources:AquaticSpecies
                                       ] ;
                       rdfs:comment "Habitat is the biological and ecological context of a species in the area of an aquatic resource." ;
                       rdfs:label "Habitat"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl
<http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieshabitat.owl> rdf:type owl:NamedIndividual ,
                                                                                 owl:Thing .


