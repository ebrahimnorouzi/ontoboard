# Two role assignments on record for one person: Angela Merkel held the Federal
# Environment Minister role from 1994 and the Federal Chancellor role from 2005. Each
# assignment is its own situation, so each can be dated without dating the person.

@prefix agentrole: <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#> .
@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix countingas: <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeindexedclassification: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedclassification.owl#> .
@prefix timeindexedpersonrole: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/time-indexed-person-role#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:AngelaMerkel a owl:NamedIndividual , timeindexedpersonrole:Person , classification:Entity ;
    rdfs:label "Angela Merkel" ;
    objectrole:hasRole ex:FederalChancellor , ex:FederalEnvironmentMinister .

ex:FederalChancellor a owl:NamedIndividual , objectrole:Role ;
    rdfs:label "Federal Chancellor of Germany" .

ex:FederalEnvironmentMinister a owl:NamedIndividual , objectrole:Role ;
    rdfs:label "Federal Minister for the Environment" .

ex:MerkelAsChancellor a owl:NamedIndividual , timeindexedpersonrole:TimeIndexedPersonRole ;
    rdfs:label "Angela Merkel as Federal Chancellor" ;
    timeindexedsituation:forEntity ex:AngelaMerkel ;
    timeindexedsituation:atTime ex:From2005To2021 .

ex:MerkelAsEnvironmentMinister a owl:NamedIndividual , timeindexedpersonrole:TimeIndexedPersonRole ;
    rdfs:label "Angela Merkel as Federal Minister for the Environment" ;
    timeindexedsituation:forEntity ex:AngelaMerkel ;
    timeindexedsituation:atTime ex:From1994To1998 .

ex:From2005To2021 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "22 November 2005 to 8 December 2021" .

ex:From1994To1998 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "17 November 1994 to 26 October 1998" .

# Only one direction of each inverse pair is asserted: atTime/isTimeIndexFor, forEntity/hasTimeIndexedSetting, hasRole/isRoleOf. A reasoner adds the other.
