@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeindexedpersonrole: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl#> .
@prefix timeindexedclassification: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedclassification.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl> rdf:type owl:Ontology ;
                                                                          owl:imports <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/cp/owl/timeindexedclassification.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                          dcterms:description "Ontology design pattern for modeling time indexed person role relationships and concepts."^^xsd:string ;
                                                                          dcterms:title "Time Indexed Person Role Pattern"^^xsd:string ;
                                                                          rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x2; label added x7; term declared x3;
- header: dcterms:title \"Time Indexed Person Role Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                          owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                                          "Created with TopBraid Composer"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity
timeindexedsituation:forEntity rdf:type owl:ObjectProperty ;
                               rdfs:label "for entity"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent
agentrole:Agent rdf:type owl:Class ;
                rdfs:label "Agent"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept
classification:Concept rdf:type owl:Class ;
                       rdfs:label "Concept"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedclassification.owl#TimeIndexedClassification
timeindexedclassification:TimeIndexedClassification rdf:type owl:Class ;
                                                    rdfs:label "Time indexed classification"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl#Person
timeindexedpersonrole:Person rdf:type owl:Class ;
                             rdfs:subClassOf agentrole:Agent ;
                             rdfs:comment "Persons in commonsense intuition, i.e. either as physical agents (humans) or social persons." ;
                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl> ;
                             rdfs:label "Person"@en ;
                             skos:prefLabel "Persona"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl#TimeIndexedPersonRole
timeindexedpersonrole:TimeIndexedPersonRole rdf:type owl:Class ;
                                            rdfs:subClassOf timeindexedclassification:TimeIndexedClassification ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty timeindexedsituation:forEntity ;
                                                              owl:someValuesFrom timeindexedpersonrole:Person
                                                            ] ;
                                            rdfs:comment "A situation that expresses time indexing for the relation between persons and roles they play." ;
                                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl> ;
                                            rdfs:label "Time indexed person role"@en ;
                                            skos:prefLabel "Classificazione"@it .


