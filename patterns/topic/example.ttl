# The pattern's own scenario: the topic of Moby-Dick is the hatred of humanity. Note that
# the topics are areas of knowledge a book can be about, while misanthropy and monomania
# are the concepts at their core - the pattern declares Topic and Concept disjoint.

@prefix topic: <http://www.ontologydesignpatterns.org/cp/owl/topic.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/topic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MobyDick a owl:NamedIndividual ;
    rdfs:label "Moby-Dick, Herman Melville, 1851" ;
    topic:hasTopic ex:HatredOfHumanity .

ex:HatredOfHumanity a owl:NamedIndividual , topic:Topic ;
    rdfs:label "the hatred of humanity" ;
    topic:hasCoreConcept ex:Misanthropy ;
    topic:nearTopicTo ex:Obsession .

ex:Misanthropy a owl:NamedIndividual , topic:Concept ;
    rdfs:label "misanthropy" .

ex:Obsession a owl:NamedIndividual , topic:Topic ;
    rdfs:label "obsession" ;
    topic:hasCoreConcept ex:Monomania .

ex:Monomania a owl:NamedIndividual , topic:Concept ;
    rdfs:label "monomania" .

ex:LifeAtSea a owl:NamedIndividual , topic:Topic ;
    rdfs:label "life at sea" ;
    topic:hasSubTopic ex:Whaling .

ex:Whaling a owl:NamedIndividual , topic:Topic ;
    rdfs:label "nineteenth-century whaling" ;
    topic:isTopicOf ex:MobyDick .

# Only one direction of each inverse pair is asserted: hasCoreConcept/isCoreConceptFor, hasPart/isPartOf, hasSubTopic/isSubTopicOf, hasTopic/isTopicOf. A reasoner adds the other.
