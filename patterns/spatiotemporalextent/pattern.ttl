dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent
cpannotationschema:hasComponent rdf:type owl:AnnotationProperty ;
                                rdfs:label "has component"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://w3id.org/daselab/onto/spatiotemporalextent#hasSpatioTemporalExtent
spatime:hasSpatioTemporalExtent rdf:type owl:ObjectProperty ;
                                rdfs:range spatime:SpatioTemporalExtent ;
                                rdfs:comment "Property relating anything (thus the domain is trivially owl:Thing and the range is unscoped) to a SpatioTemporalExtent." ;
                                rdfs:label "hasSpatioTemporalExtent" .


###  http://w3id.org/daselab/onto/spatiotemporalextent#hasTrajectory
spatime:hasTrajectory rdf:type owl:ObjectProperty ;
                      owl:equivalentProperty <http://w3id.org/daselab/onto/trajectory#hasTrajectory> ;
                      rdfs:comment "Set to be equivalent to trj:hasTrajectory from the Trajectory pattern, this property relates anything (including SpatioTemporalExtent) to Trajectory." ;
                      rdfs:label "hasTrajectory" .


###  http://w3id.org/daselab/onto/trajectory#hasTrajectory
<http://w3id.org/daselab/onto/trajectory#hasTrajectory> rdf:type owl:ObjectProperty ;
                                                        rdfs:label "hasTrajectory (trajectory)"^^xsd:string .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/daselab/onto/spatiotemporalextent#SpatioTemporalExtent
spatime:SpatioTemporalExtent rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty spatime:hasTrajectory ;
                                               owl:someValuesFrom spatime:Trajectory
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty spatime:hasTrajectory ;
                                               owl:allValuesFrom spatime:Trajectory
                                             ] ;
                             rdfs:comment "The class that represents the notion of spatiotemporal extent. A spatiotemporal extent is realized as a collection of generalized trajectories that have no temporal overlap." ;
                             rdfs:label "SpatioTemporalExtent" .


###  http://w3id.org/daselab/onto/spatiotemporalextent#Trajectory
spatime:Trajectory rdf:type owl:Class ;
                   owl:equivalentClass <http://w3id.org/daselab/onto/trajectory#Trajectory> ;
                   rdfs:comment "The hook to the Trajectory pattern, which acts as a component of the Spatiotemporal Extent pattern." ;
                   rdfs:label "Trajectory" .


###  http://w3id.org/daselab/onto/trajectory#Trajectory
<http://w3id.org/daselab/onto/trajectory#Trajectory> rdf:type owl:Class ;
                                                     rdfs:label "Trajectory (trajectory)"^^xsd:string .


