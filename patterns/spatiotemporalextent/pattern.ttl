@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix spatime: <http://w3id.org/daselab/onto/spatiotemporalextent#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://w3id.org/daselab/onto/spatiotemporalextent> .

<http://w3id.org/daselab/onto/spatiotemporalextent> rdf:type owl:Ontology ;
                                                     owl:imports <http://w3id.org/daselab/onto/trajectory> ,
                                                                 <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                     dc:creator "Adila Krisnadhi, Pascal Hitzler" ;
                                                     dcterms:description "This pattern models a spatiotemporal extent, i.e., a combination of spatial and temporal extent as a set of generalized trajectories which cannot have temporal overlap. This pattern reuses semantic trajectory pattern as component."^^xsd:string ;
                                                     dcterms:title "Spatiotemporalextent Pattern"^^xsd:string ;
                                                     cpannotationschema:coversRequirements """Where is Poland located in 1700?, 
List all places and time in which the 1990 World Chess Championship Match take place.,
Where and when did the oceanographic cruise A01132 go?""" ;
                                                     cpannotationschema:hasComponent <http://ontologydesignpatterns.org/wiki/Submissions:Trajectory> ,
                                                                                     <http://w3id.org/daselab/onto/trajectory> ,
                                                                                     "Trajectory" ;
                                                     cpannotationschema:hasIntent "This pattern models a spatiotemporal extent, i.e., a combination of spatial and temporal extent as a set of generalized trajectories which cannot have temporal overlap. This pattern reuses semantic trajectory pattern as component."^^xsd:string ;
                                                     cpannotationschema:relatedCPs "Trajectory" ;
                                                     cpannotationschema:scenarios """The World Chess Championship Match 1990 was held in two parts: New York (October 8 to November 7) and Lyons - France (November 26 to December 30).

The Renaissance occured in different places at different times.

A hurricane moves through the spacetime.""" ;
                                                     rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x10; term declared x8;
- header: dcterms:title \"Spatiotemporalextent Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: pattern.owl declares <http://w3id.org/daselab/onto/trajectory#Trajectory> as a class, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en .

