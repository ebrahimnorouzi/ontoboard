# Two of the pattern's own scenarios. The World Chess Championship Match 1990 was
# played in New York and then in Lyon, and the Renaissance happened in different
# places at different times: each extent is a set of trajectories that do not
# overlap in time.

@prefix spatiotemporalextent: <http://w3id.org/daselab/onto/spatiotemporalextent#> .
@prefix trajectory: <http://w3id.org/daselab/onto/trajectory#> .
@prefix ex: <https://w3id.org/ontoboard/example/spatiotemporalextent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:WorldChessChampionship1990 a owl:NamedIndividual ;
    rdfs:label "the World Chess Championship Match 1990" ;
    spatiotemporalextent:hasSpatioTemporalExtent ex:ChessMatchExtent .

ex:ChessMatchExtent a owl:NamedIndividual , spatiotemporalextent:SpatioTemporalExtent ;
    rdfs:label "where and when the 1990 match was played" ;
    spatiotemporalextent:hasTrajectory ex:NewYorkHalf , ex:LyonHalf .

ex:NewYorkHalf a owl:NamedIndividual , spatiotemporalextent:Trajectory ;
    rdfs:label "New York, 8 October to 7 November 1990" .

ex:LyonHalf a owl:NamedIndividual , spatiotemporalextent:Trajectory ;
    rdfs:label "Lyon, 26 November to 30 December 1990" .

ex:Renaissance a owl:NamedIndividual ;
    rdfs:label "the Renaissance" ;
    spatiotemporalextent:hasSpatioTemporalExtent ex:RenaissanceExtent .

ex:RenaissanceExtent a owl:NamedIndividual , spatiotemporalextent:SpatioTemporalExtent ;
    rdfs:label "where and when the Renaissance happened" ;
    spatiotemporalextent:hasTrajectory ex:ItalianQuattrocento , ex:NorthernRenaissance .

ex:ItalianQuattrocento a owl:NamedIndividual , spatiotemporalextent:Trajectory ;
    rdfs:label "Florence and the Italian city states, through the fifteenth century" .

ex:NorthernRenaissance a owl:NamedIndividual , spatiotemporalextent:Trajectory ;
    rdfs:label "the Low Countries and Germany, through the sixteenth century" .
