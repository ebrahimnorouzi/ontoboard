@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   owl:imports <http://www.opengis.net/ont/geosparql> ;
   <http://purl.org/dc/terms/created> "2017-10-22"@en ;
   <http://purl.org/dc/terms/description> "This ontology describes the spatial features of things used in a smart environment. Thease feartures include the geometerical representation of objects along with the spatial and directional relations between them. This ontology relies on the two other spatial related ontologies http://www.opengis.net/ont/geosparql and http://www.observedchange.com/tisc/ns/"@en ;
   <http://purl.org/dc/terms/title> "Smart Environment Geometry Ontology Pattern"@en ;
   <http://purl.org/vocab/vann/preferredNamespacePrefix> "se-geometry"@en ;
   <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/smartenvironment/patterns/geometry.owl> ;
   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What are the spatial relations among objects or sections in a smart environment?"@en ;
   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> <http://www.observedchange.com/tisc/ns> ,
                                                                                             <http://www.opengis.net/ont/geosparql> ;
   rdfs:seeAlso <http://www.observedchange.com/tisc/ns/> ,
                <http://www.opengis.net/ont/geosparql>
 ] .

