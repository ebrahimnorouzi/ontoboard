###  https://w3id.org/smartenvironment/patterns/geometry.owl#hasDescriptiveSpatialRelation
<https://w3id.org/smartenvironment/patterns/geometry.owl#hasDescriptiveSpatialRelation> rdf:type owl:ObjectProperty ;
                                                                                        rdfs:subPropertyOf <https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation> ;
                                                                                        rdfs:comment "This object property, as an spacialization of the object property hasSpatialRelation, generalizes spatial relations defined in the Open Time and Space Core Vocabulary, which are more declarative than those defined in GeoSPARQL."@en ;
                                                                                        rdfs:label "has descriptive spatial relation"@en .


###  https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation
<https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation> rdf:type owl:ObjectProperty ;
                                                                             rdfs:domain <https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject> ;
                                                                             rdfs:range <https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject> ;
                                                                             rdfs:comment "Describes any possible spatial relations between any two given spatial objects. This object properties is used to generalize all the spatial relations defined in GeoSPARQL ontology."@en ;
                                                                             rdfs:label "has spatial relation"@en .


#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class .


###  https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject
<https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                                                                                          owl:someValuesFrom <http://www.opengis.net/ont/geosparql#Geometry>
                                                                                        ] ,
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty <https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation> ;
                                                                                          owl:someValuesFrom <https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject>
                                                                                        ] ;
                                                                        rdfs:comment "Describes any physcical object in a smart environment that has a geometry."@en ;
                                                                        rdfs:label "spatial object"@en .


