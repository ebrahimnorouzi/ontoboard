###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty ;
                                                   rdfs:label "has geometry"@en .


###  http://www.opengis.net/ont/geosparql#sfContains
<http://www.opengis.net/ont/geosparql#sfContains> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                  rdfs:label "sf contains"@en .


###  http://www.opengis.net/ont/geosparql#sfCrosses
<http://www.opengis.net/ont/geosparql#sfCrosses> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                 rdfs:label "sf crosses"@en .


###  http://www.opengis.net/ont/geosparql#sfDisjoint
<http://www.opengis.net/ont/geosparql#sfDisjoint> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                  rdfs:label "sf disjoint"@en .


###  http://www.opengis.net/ont/geosparql#sfEquals
<http://www.opengis.net/ont/geosparql#sfEquals> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                rdfs:label "sf equals"@en .


###  http://www.opengis.net/ont/geosparql#sfIntersects
<http://www.opengis.net/ont/geosparql#sfIntersects> rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                    rdfs:label "sf intersects"@en .


###  http://www.opengis.net/ont/geosparql#sfOverlaps
<http://www.opengis.net/ont/geosparql#sfOverlaps> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                  rdfs:label "sf overlaps"@en .


###  http://www.opengis.net/ont/geosparql#sfTouches
<http://www.opengis.net/ont/geosparql#sfTouches> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                 rdfs:label "sf touches"@en .


###  http://www.opengis.net/ont/geosparql#sfWithin
<http://www.opengis.net/ont/geosparql#sfWithin> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                                rdfs:label "sf within"@en .


###  https://w3id.org/smartenvironment/patterns/geometry.owl#hasDescriptiveSpatialRelation
se-geometry:hasDescriptiveSpatialRelation rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf se-geometry:hasSpatialRelation ;
                                          rdfs:comment "This object property, as an spacialization of the object property hasSpatialRelation, generalizes spatial relations defined in the Open Time and Space Core Vocabulary, which are more declarative than those defined in GeoSPARQL."@en ;
                                          rdfs:label "has descriptive spatial relation"@en .


###  https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation
se-geometry:hasSpatialRelation rdf:type owl:ObjectProperty ;
                               rdfs:domain se-geometry:SpatialObject ;
                               rdfs:range se-geometry:SpatialObject ;
                               rdfs:comment "Describes any possible spatial relations between any two given spatial objects. This object properties is used to generalize all the spatial relations defined in GeoSPARQL ontology."@en ;
                               rdfs:label "has spatial relation"@en .


#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               rdfs:label "feature"@en .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                rdfs:label "geometry"@en .


###  https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject
se-geometry:SpatialObject rdf:type owl:Class ;
                          rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                                            owl:someValuesFrom <http://www.opengis.net/ont/geosparql#Geometry>
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty se-geometry:hasSpatialRelation ;
                                            owl:someValuesFrom se-geometry:SpatialObject
                                          ] ;
                          rdfs:comment "Describes any physcical object in a smart environment that has a geometry."@en ;
                          rdfs:label "spatial object"@en .


