@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix vocab: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix se-geometry: <https://w3id.org/smartenvironment/patterns/geometry.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   owl:imports <http://www.opengis.net/ont/geosparql> ;
   terms:created "2017-10-22"@en ;
   terms:description "This ontology describes the spatial features of things used in a smart environment. Thease feartures include the geometerical representation of objects along with the spatial and directional relations between them. This ontology relies on the two other spatial related ontologies http://www.opengis.net/ont/geosparql and http://www.observedchange.com/tisc/ns/"@en ;
   terms:title "Smart Environment Geometry Ontology Pattern"@en ;
   vann:preferredNamespacePrefix "se-geometry"@en ;
   vann:preferredNamespaceUri <https://w3id.org/smartenvironment/patterns/geometry.owl> ;
   cpannotationschema:coversRequirements "What are the spatial relations among objects or sections in a smart environment?"@en ;
   cpannotationschema:isSpecializationOf <http://www.observedchange.com/tisc/ns> ,
                                         <http://www.opengis.net/ont/geosparql> ;
   rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x37; term declared x2;
- file: pattern.owl declares <http://purl.org/dc/terms/created> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://purl.org/dc/terms/description> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://purl.org/dc/terms/title> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> as an annotation property, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
   rdfs:seeAlso <http://www.observedchange.com/tisc/ns/> ,
                <http://www.opengis.net/ont/geosparql>
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
terms:created rdf:type owl:AnnotationProperty ;
              rdfs:label "Date Created"@en .


###  http://purl.org/dc/terms/description
terms:description rdf:type owl:AnnotationProperty ;
                  rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
terms:title rdf:type owl:AnnotationProperty ;
            rdfs:label "Title"@en .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty ;
                              rdfs:label "preferred namespace prefix"@en .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty ;
                           rdfs:label "preferred namespace uri"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
cpannotationschema:isSpecializationOf rdf:type owl:AnnotationProperty ;
                                      rdfs:label "is specialization of"@en .


