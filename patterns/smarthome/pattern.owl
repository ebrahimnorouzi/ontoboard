    <owl:ObjectProperty rdf:about="https://w3id.org/smartenvironment/patterns/geometry.owl#hasDescriptiveSpatialRelation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation"/>
        <rdfs:comment xml:lang="en">This object property, as an spacialization of the object property hasSpatialRelation, generalizes spatial relations defined in the Open Time and Space Core Vocabulary, which are more declarative than those defined in GeoSPARQL.</rdfs:comment>
        <rdfs:label xml:lang="en">has descriptive spatial relation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation">
        <rdfs:domain rdf:resource="https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject"/>
        <rdfs:range rdf:resource="https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject"/>
        <rdfs:comment xml:lang="en">Describes any possible spatial relations between any two given spatial objects. This object properties is used to generalize all the spatial relations defined in GeoSPARQL ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">has spatial relation</rdfs:label>
    </owl:ObjectProperty>
    


