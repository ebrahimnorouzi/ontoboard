    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:label xml:lang="en">geometry</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject -->

    <owl:Class rdf:about="https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/smartenvironment/patterns/geometry.owl#hasSpatialRelation"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/smartenvironment/patterns/geometry.owl#SpatialObject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Describes any physcical object in a smart environment that has a geometry.</rdfs:comment>
        <rdfs:label xml:lang="en">spatial object</rdfs:label>
    </owl:Class>
