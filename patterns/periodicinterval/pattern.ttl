dc:title rdf:type owl:AnnotationProperty ;
         rdfs:label "Title"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
cpannotationschema:isSpecializationOf rdf:type owl:AnnotationProperty ;
                                      rdfs:label "is specialization of"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasIntervalDurationPerPeriod
PeriodicInterval:hasIntervalDurationPerPeriod rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf time:hasDurationDescription ;
                                              rdfs:domain PeriodicInterval:PeriodicInterval ;
                                              rdfs:range time:DurationDescription ;
                                              rdfs:label "hasIntervalDurationPerPeriod"@en .


###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasPeriod
PeriodicInterval:hasPeriod rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf time:hasDurationDescription ;
                           rdfs:domain PeriodicInterval:PeriodicInterval ;
                           rdfs:range time:DurationDescription ;
                           rdfs:label "hasPeriod"@en .


###  http://www.w3.org/2006/time#hasDurationDescription
time:hasDurationDescription rdf:type owl:ObjectProperty ;
                            rdfs:label "has duration description"@en .


#################################################################
#    Classes
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#PeriodicInterval
PeriodicInterval:PeriodicInterval rdf:type owl:Class ;
                                  rdfs:subClassOf time:Interval ;
                                  rdfs:label "Periodic interval"@en .


###  http://www.w3.org/2006/time#DurationDescription
time:DurationDescription rdf:type owl:Class ;
                         rdfs:label "Duration description"@en .


###  http://www.w3.org/2006/time#Interval
time:Interval rdf:type owl:Class ;
              rdfs:label "Time interval"@en .


