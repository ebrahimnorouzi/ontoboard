<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasIntervalDurationPerPeriod
:hasIntervalDurationPerPeriod rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf <http://www.w3.org/2006/time#hasDurationDescription> ;
                              rdfs:domain :PeriodicInterval ;
                              rdfs:range <http://www.w3.org/2006/time#DurationDescription> ;
                              rdfs:label "hasIntervalDurationPerPeriod"@en .


###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasPeriod
:hasPeriod rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://www.w3.org/2006/time#hasDurationDescription> ;
           rdfs:domain :PeriodicInterval ;
           rdfs:range <http://www.w3.org/2006/time#DurationDescription> ;
           rdfs:label "hasPeriod"@en .


###  http://www.w3.org/2006/time#hasDurationDescription
<http://www.w3.org/2006/time#hasDurationDescription> rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#PeriodicInterval
:PeriodicInterval rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/2006/time#Interval> ;
                  rdfs:label "Periodic interval"@en .


###  http://www.w3.org/2006/time#DurationDescription
<http://www.w3.org/2006/time#DurationDescription> rdf:type owl:Class .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class .


