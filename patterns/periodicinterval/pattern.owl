    <!-- http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasIntervalDurationPerPeriod -->

    <owl:ObjectProperty rdf:about="http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasIntervalDurationPerPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasDurationDescription"/>
        <rdfs:domain rdf:resource="http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#PeriodicInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#DurationDescription"/>
        <rdfs:label xml:lang="en">hasIntervalDurationPerPeriod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#hasPeriod -->

