# Two entries from a teaching timetable, on the pattern's own scenario: Sam teaches every Monday.
# The point of the pattern is that a repeating slot needs two durations, not one - how often it
# comes round, and how long it lasts each time - so the lecture and the lab keep them apart.

@prefix periodicinterval: <http://delicias.dia.fi.upm.es/ontologies/PeriodicInterval.owl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ex: <https://w3id.org/ontoboard/example/periodicinterval#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:SamsMondayLecture a owl:NamedIndividual , periodicinterval:PeriodicInterval ;
    rdfs:label "Sam's lecture, every Monday 10:00 to 12:00, autumn term" ;
    periodicinterval:hasPeriod ex:OneWeek ;
    periodicinterval:hasIntervalDurationPerPeriod ex:TwoHours .

ex:OneWeek a owl:NamedIndividual , time:DurationDescription ;
    rdfs:label "one week, the period from one lecture to the next" .

ex:TwoHours a owl:NamedIndividual , time:DurationDescription ;
    rdfs:label "two hours, the length of one lecture" .

ex:FortnightlyLabSession a owl:NamedIndividual , periodicinterval:PeriodicInterval ;
    rdfs:label "the measurement lab, every second Thursday afternoon, autumn term" ;
    periodicinterval:hasPeriod ex:TwoWeeks ;
    periodicinterval:hasIntervalDurationPerPeriod ex:ThreeHours .

ex:TwoWeeks a owl:NamedIndividual , time:DurationDescription ;
    rdfs:label "two weeks, the period from one lab session to the next" .

ex:ThreeHours a owl:NamedIndividual , time:DurationDescription ;
    rdfs:label "three hours, the length of one lab session" .
