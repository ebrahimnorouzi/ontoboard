@prefix : <http://www.irit.fr/recherches/MELODI/ontologies/SAN#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.irit.fr/recherches/MELODI/ontologies/SAN> .

<http://www.irit.fr/recherches/MELODI/ontologies/SAN> rdf:type owl:Ontology ;
                                                       <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/> ;
                                                       <http://purl.org/dc/elements/1.1/creator> <http://www.irit.fr/recherches/MELODI/ontologies/contributors#ben_alaya> ,
                                                                                                 <http://www.irit.fr/recherches/MELODI/ontologies/contributors#drira> ,
                                                                                                 <http://www.irit.fr/recherches/MELODI/ontologies/contributors#hernandez> ,
                                                                                                 <http://www.irit.fr/recherches/MELODI/ontologies/contributors#monteil> ,
                                                                                                 <http://www.irit.fr/recherches/MELODI/ontologies/contributors#seydoux> ,
                                                                                                 "Nicolas Seydoux, Mahdi Ben Alaya, Khalil Drira, Nathalie Hernandez, Thierry Monteil" ;
                                                       <http://purl.org/dc/elements/1.1/description> """SAN stands for Semantic Actuator Network. It is intended to describe Semantic Actuator Networks, as a counterpoint to SSN definition of Semantic Sensor Networks. An actuator is a physical device having an effect on the world (see Actuator for more information).

It is worth noticing that some concepts are imported from SSN, but not SSN as a whole. This is a design choice intended to separate as much as possible the definition on actuator from the definition of sensor, which are completely different concept that can be used independantly from each other.

This ontology is used as a ontological module in IoT-O ontology.""" ;
                                                       <http://purl.org/dc/elements/1.1/publisher> "IRIT (https://www.irit.fr/)" ,
                                                                                                   "LAAS-CNRS (https://www.laas.fr)" ;
                                                       <http://purl.org/dc/elements/1.1/title> "SAN" ;
                                                       <http://purl.org/dc/terms/issued> "2015-02-20" ;
                                                       <http://purl.org/dc/terms/modified> "2016-02-26" ;
                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "san" ;
                                                       <http://purl.org/vocab/vann/preferredNamespaceURI> "http://www.irit.fr/recherches/MELODI/ontologies/SAN" ;
                                                       <http://purl.org/vocommons/voaf#reliesOn> <http://purl.oclc.org/NET/ssnx/ssn> ;
                                                       rdfs:seeAlso "http://www.irit.fr/recherches/MELODI/ontologies/IoT-O" ;
                                                       owl:versionInfo 2.0.0 ;
                                                       <http://xmlns.com/foaf/0.1/primaryTopic> "Actuators and actuation" .

#################################################################
#    Annotation properties
#################################################################

###  http://creativecommons.org/ns#license
<http://creativecommons.org/ns#license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/publisher
<http://purl.org/dc/elements/1.1/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceURI
<http://purl.org/vocab/vann/preferredNamespaceURI> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocommons/voaf#reliesOn
<http://purl.org/vocommons/voaf#reliesOn> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/primaryTopic
<http://xmlns.com/foaf/0.1/primaryTopic> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  xsd:integer
<xsd:integer> rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.oclc.org/NET/ssnx/ssn#forProperty
<http://purl.oclc.org/NET/ssnx/ssn#forProperty> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#hasProperty
<http://purl.oclc.org/NET/ssnx/ssn#hasProperty> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#hasValue
<http://purl.oclc.org/NET/ssnx/ssn#hasValue> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#implements
<http://purl.oclc.org/NET/ssnx/ssn#implements> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf
<http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf> rdf:type owl:ObjectProperty ;
                                                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#actsOn
:actsOn rdf:type owl:ObjectProperty ;
        owl:inverseOf :isActedUponBy ;
        rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
        rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
        rdfs:comment "Relationship between an entity that acts upon a quantity or another entity" ;
        rdfs:label "acts on" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#actuationMethodUsed
:actuationMethodUsed rdf:type owl:ObjectProperty ;
                     rdfs:domain :Actuation ;
                     rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Process> ;
                     rdfs:comment "Process involved in the Actuation" ;
                     rdfs:label "actuation method used" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#actuationResults
:actuationResults rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> ;
                  rdfs:domain :Actuation ;
                  rdfs:range :ActuatorInput ;
                  rdfs:comment "Relation between an actuation and an actuator input, its result. Implements the ODP Effect-Actuator-Observation" ;
                  rdfs:label "actuation results" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#consumes
:consumes rdf:type owl:ObjectProperty ;
          owl:inverseOf :isConsumedBy ;
          rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
          rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
          rdfs:comment "Relation between an consumer entity and a consumee entity. Consumption can be destructive, transformative or neutral for the consumed entity." ;
          rdfs:label "consumes" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#controlledBy
:controlledBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :isController ;
              rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:comment "Describes the relationship between a controlledentity and a controller  one. The controlled entity can be a situation (state of a system, property of an environment), a device, a piece of software..." ;
              rdfs:label "controlled by" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingCapability
:hasActuatingCapability rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#hasProperty> ;
                        rdfs:domain :Actuator ;
                        rdfs:range :ActuatingCapability ;
                        rdfs:comment "Relation between an Actuator and an ActuatingCapability, describing the actuating properties of an actuator." ;
                        rdfs:label "has actuation capability" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasActuatingProperty
:hasActuatingProperty rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#hasProperty> ;
                      rdfs:domain :ActuatingCapability ;
                      rdfs:range :ActuatingProperty ;
                      rdfs:comment "Relation from an actuation capability to an actuation property." ;
                      rdfs:label "has actuation property" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasDateTime
:hasDateTime rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.linkedmodel.org/schema/vaem#date> ;
             rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Region> ;
             rdfs:range <http://www.w3.org/2006/time#Instant> ;
             rdfs:comment "Relationship between an event (DUL:Region) and a point in time." ;
             rdfs:label "has date time" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#hasEffect
:hasEffect rdf:type owl:ObjectProperty ;
           rdfs:domain :Actuator ;
           rdfs:range :Effect ;
           rdfs:comment "Relationship between an Actuator and the effect that it induces. The Effect will be linked to a physical property that the actuator impacts" ;
           rdfs:label "has effect" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#impactedProperty
:impactedProperty rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> ;
                  rdfs:domain :Actuation ;
                  rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Property> ;
                  rdfs:comment "Property on which an Actuation has an impact" ;
                  rdfs:label "impacted property" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#impacts
:impacts rdf:type owl:ObjectProperty ;
         rdfs:domain :Effect ;
         rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Property> ;
         rdfs:comment "Relationship between an effect and the property it impacts. Used in the Effect-Actuator-Actuation design pattern to describe the link between an actuator and the physical property it acts upon." ;
         rdfs:label "impacts" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#isActedUponBy
:isActedUponBy rdf:type owl:ObjectProperty ;
               rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
               rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
               rdfs:comment "Relation between an entity that is acted upen by another acting entity" ;
               rdfs:label "is acted upon by" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#isConsumedBy
:isConsumedBy rdf:type owl:ObjectProperty ;
              rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:comment "Describes a relation between a consumer and a consumee" ;
              rdfs:label "is consumed by" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#isController
:isController rdf:type owl:ObjectProperty ;
              rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity> ;
              rdfs:comment "An entity is controller of another one when it has influence on its decision process or evolution in time." ;
              rdfs:label "is controller" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#receivedActuation
:receivedActuation rdf:type owl:ObjectProperty ;
                   owl:inverseOf :wasActuationSent ;
                   rdfs:domain :Actuator ;
                   rdfs:range :Actuation ;
                   rdfs:comment "Relationship between an actuator and an Actuation it received in order to modify its action." ;
                   rdfs:label "receives actuation" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#wasActuationSent
:wasActuationSent rdf:type owl:ObjectProperty ;
                  rdfs:domain :Actuation ;
                  rdfs:range :Actuator ;
                  rdfs:comment "Relationship between an actuation that was sent and the actuator that received it" ;
                  rdfs:label "is actuation sent" .


###  http://www.linkedmodel.org/schema/vaem#date
<http://www.linkedmodel.org/schema/vaem#date> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#includesEvent
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#includesEvent> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isParametrizedBy
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isParametrizedBy> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object
<http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object> .


###  http://purl.oclc.org/NET/ssnx/ssn#Device
<http://purl.oclc.org/NET/ssnx/ssn#Device> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object> ,
                                                           <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject> .


###  http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest
<http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest> rdf:type owl:Class ;
                                                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" .


###  http://purl.oclc.org/NET/ssnx/ssn#Input
<http://purl.oclc.org/NET/ssnx/ssn#Input> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#Process
<http://purl.oclc.org/NET/ssnx/ssn#Process> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Method> .


###  http://purl.oclc.org/NET/ssnx/ssn#Property
<http://purl.oclc.org/NET/ssnx/ssn#Property> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://qudt.org/schema/qudt#QuantityKind> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf> ;
                                                               owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest>
                                                             ] ;
                                             rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/ssn" .


###  http://purl.org/vocommons/voaf#Vocabulary
<http://purl.org/vocommons/voaf#Vocabulary> rdf:type owl:Class .


###  http://qudt.org/schema/qudt#QuantityKind
<http://qudt.org/schema/qudt#QuantityKind> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Quality> .


###  http://qudt.org/schema/qudt#Unit
<http://qudt.org/schema/qudt#Unit> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#UnitOfMeasure> .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#Acting
:Acting rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Process> ;
        rdfs:comment "Acting is the process that results in an action on the physical world, might it be a motion, a display, the emission of a sound..." ;
        rdfs:label "Acting" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingCapability
:ActuatingCapability rdf:type owl:Class ;
                     rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Property> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#forProperty> ;
                                       owl:someValuesFrom <http://qudt.org/schema/qudt#QuantityKind>
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasActuatingProperty ;
                                       owl:someValuesFrom :ActuatingProperty
                                     ] ;
                     rdfs:comment "Represents actuation properties such as precision, latency, power consumption, and the environmental conditions in which these actuation can take place normally." ;
                     rdfs:label "Actuating Capability" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingDevice
:ActuatingDevice rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device> ,
                                 :Actuator ;
                 rdfs:comment "A device that implements actuating" ;
                 rdfs:label "Actuating device" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingProperty
:ActuatingProperty rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Property> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasValue> ;
                                     owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Amount>
                                   ] ;
                   rdfs:comment "A characteristic of an Actuator that gives information about the Actuations it is able to perform." ;
                   rdfs:label "Actuating Property" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingRange
:ActuatingRange rdf:type owl:Class ;
                rdfs:subClassOf :ActuatingProperty ;
                rdfs:comment "Range of commands that the actuator can receive and transduce into the physical world without damage to itself or security issues to its surrounding environment." ;
                rdfs:label "Actuating Range" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatingTime
:ActuatingTime rdf:type owl:Class ;
               rdfs:subClassOf :ActuatingProperty ;
               rdfs:comment "Time between the moment when the actuator receives an actuation command and the actual actuation." ;
               rdfs:label "Actuating Time" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuation
:Actuation rdf:type owl:Class ;
           rdfs:subClassOf :Situation ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :wasActuationSent ;
                             owl:someValuesFrom :Actuator
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#includesEvent> ;
                             owl:someValuesFrom :Effect
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :actuationMethodUsed ;
                             owl:allValuesFrom :Acting
                           ] ;
           rdfs:comment "An Actuation is the abstract representation of the command that will be translated into Effect by the Actuator (cf http://ontologydesignpatterns.org/wiki/Submissions:Actuation-Actuator-Effect for more information)." ;
           rdfs:label "Actuation" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuationValue
:ActuationValue rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Region> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isParametrizedBy> ;
                                  owl:someValuesFrom <http://qudt.org/schema/qudt#Unit>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasDateTime ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass <http://www.w3.org/2006/time#Instant>
                                ] ;
                rdfs:comment "Value of the command sent to an actuator" ;
                rdfs:label "Actuation Value" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#Actuator
:Actuator rdf:type owl:Class ;
          rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Agent> ,
                          <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject> ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#implements> ;
                            owl:someValuesFrom :Acting
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :actsOn ;
                            owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Property>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasActuatingCapability ;
                            owl:someValuesFrom :ActuatingCapability
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasEffect ;
                            owl:someValuesFrom :Effect
                          ] ;
          rdfs:comment "An actuator is an entity which is able to act upon the physical world. Whether it is a light bulb or a servomotor, an actuator receives inputs represented by Actuations and produces an effect on the world." ;
          rdfs:label "Actuator" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatorInput
:ActuatorInput rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Input> ,
                               <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasValue> ;
                                 owl:someValuesFrom :ActuationValue
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isConsumedBy ;
                                 owl:someValuesFrom :Actuator
                               ] ;
               rdfs:comment "An actuator input is a piece of information provided to an actuator describing its expected behaviour, and it is described by an Actuation Value" ;
               rdfs:label "Actuator Input" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#ActuatorOutput
:ActuatorOutput rdf:type owl:Class ;
                owl:equivalentClass :Effect ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> ;
                rdfs:comment "Behaviour of an actuator after it has been given an input. To stick to its definition, an actuator output must have an effect on the physical world." ;
                rdfs:label "Actuator Output" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#Effect
:Effect rdf:type owl:Class ;
        rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event> ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :impacts ;
                          owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Property>
                        ] ;
        rdfs:comment "Concept bound to the definition of an actuator as an agent havong an effect on the physical world. Therefore, an effect is any kind of physical modification induced by an actuator." ;
        rdfs:label "Effect" .


###  http://www.irit.fr/recherches/MELODI/ontologies/SAN#Situation
:Situation rdf:type owl:Class ;
           rdfs:subClassOf :Situation ,
                           <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Agent
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Agent> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Amount
