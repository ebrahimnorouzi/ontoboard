# One living-room gateway collecting from the four sender nodes of a small flat. The two
# competency questions the pattern asks - which nodes send to a given receiver, and which
# receiver a set of senders reports to - are read straight off these edges.

@prefix smarthomenetwork: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Network.owl#> .
@prefix ssn: <http://purl.oclc.org/NET/ssnx/ssn#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-network#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:LivingRoomGateway a owl:NamedIndividual , smarthomenetwork:DataReceiverNode ;
    rdfs:label "the ZigBee gateway node in the living room of flat 3B" ;
    smarthomenetwork:receivesDataFrom ex:CouchPressureNode ,
        ex:TelevisionPowerNode ,
        ex:BedroomTemperatureNode ,
        ex:FrontDoorContactNode .

ex:CouchPressureNode a owl:NamedIndividual , smarthomenetwork:DataSenderNode ;
    rdfs:label "the pressure-mat node under the living-room couch" .

ex:TelevisionPowerNode a owl:NamedIndividual , smarthomenetwork:DataSenderNode ;
    rdfs:label "the power-meter node on the television socket" .

ex:BedroomTemperatureNode a owl:NamedIndividual , smarthomenetwork:DataSenderNode ;
    rdfs:label "the temperature node on the bedroom wall" .

ex:FrontDoorContactNode a owl:NamedIndividual , smarthomenetwork:DataSenderNode ;
    rdfs:label "the magnetic-contact node on the front door" .

# Only one direction of each inverse pair is asserted: receivesDataFrom/sendsDataTo. A reasoner adds the other.
