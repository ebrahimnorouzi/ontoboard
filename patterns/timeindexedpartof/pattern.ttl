@prefix : <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix timeindexedpartof: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> rdf:type owl:Ontology ;
                                                                      owl:imports <http://www.ontologydesignpatterns.org/cp/owl/partof.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                      dcterms:description """The time indexed part of pattern. 
This pattern re-uses part of and time-indexed situation patterns. It is extracted from DOLCE-UltraLite by partial clone of elements."""^^xsd:string ;
                                                                      dcterms:title "Timeindexedpartof Pattern"^^xsd:string ;
                                                                      rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x1; label added x9; term declared x3;
- header: dcterms:title \"Timeindexedpartof Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                   """The time indexed part of pattern. 
This pattern re-uses part of and time-indexed situation patterns. It is extracted from DOLCE-UltraLite by partial clone of elements."""^^xsd:string ;
                                                                      owl:versionInfo """0.1: Created by Aldo Gangemi
0.2: Revised as a specialization of timeindexedsituation.owl"""^^xsd:string ,
                                                                                      "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
situation:isSettingFor rdf:type owl:ObjectProperty ;
                       rdfs:label "isSettingFor"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesPartObject
timeindexedpartof:includesPartObject rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf timeindexedsituation:forEntity ;
                                     owl:inverseOf timeindexedpartof:isPartObjectOf ;
                                     rdfs:domain timeindexedpartof:Object ;
                                     rdfs:range timeindexedpartof:TimeIndexedPartOf ;
                                     rdfs:comment "A relation between a temporary part-of situation and the part(s) involved." ;
                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                                     rdfs:label "includes part object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesWholeObject
timeindexedpartof:includesWholeObject rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf timeindexedsituation:forEntity ;
                                      owl:inverseOf timeindexedpartof:isWholeObjectOf ;
                                      rdfs:domain timeindexedpartof:Object ;
                                      rdfs:range timeindexedpartof:TimeIndexedPartOf ;
                                      rdfs:comment "A relation between a temporary part-of situation and the whole object involved." ;
                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                                      rdfs:label "includes whole object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isPartObjectOf
timeindexedpartof:isPartObjectOf rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf timeindexedsituation:hasTimeIndexedSetting ;
                                 rdfs:domain timeindexedpartof:TimeIndexedPartOf ;
                                 rdfs:range timeindexedpartof:Object ;
                                 rdfs:comment "A relation between object part(s) and the temporary part-of situation they are involved in." ;
                                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                                 rdfs:label "is part object of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isWholeObjectOf
timeindexedpartof:isWholeObjectOf rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf timeindexedsituation:hasTimeIndexedSetting ;
                                  rdfs:domain timeindexedpartof:TimeIndexedPartOf ;
                                  rdfs:range timeindexedpartof:Object ;
                                  rdfs:comment "A relation between a whole object and the temporary part-of situation it is involved in." ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                                  rdfs:label "is whole object of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime
timeindexedsituation:atTime rdf:type owl:ObjectProperty ;
                            rdfs:label "at time"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity
timeindexedsituation:forEntity rdf:type owl:ObjectProperty ;
                               rdfs:label "for entity"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting
timeindexedsituation:hasTimeIndexedSetting rdf:type owl:ObjectProperty ;
                                           rdfs:label "has time indexed setting"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
situation:Situation rdf:type owl:Class ;
                    owl:disjointWith timeinterval:TimeInterval ;
                    rdfs:label "Situation"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#Object
timeindexedpartof:Object rdf:type owl:Class ;
                         rdfs:subClassOf owl:Thing ;
                         owl:disjointWith timeinterval:TimeInterval ;
                         rdfs:comment "Any physical, social, or mental object, or a substance" ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                         rdfs:label "Object"@en ;
                         skos:prefLabel "Oggetto"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#TimeIndexedPartOf
timeindexedpartof:TimeIndexedPartOf rdf:type owl:Class ;
                                    rdfs:subClassOf situation:Situation ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty timeindexedpartof:isPartObjectOf ;
                                                      owl:someValuesFrom timeindexedpartof:Object
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty timeindexedpartof:isWholeObjectOf ;
                                                      owl:someValuesFrom timeindexedpartof:Object
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty timeindexedsituation:atTime ;
                                                      owl:someValuesFrom timeinterval:TimeInterval
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty situation:isSettingFor ;
                                                      owl:minCardinality "3"^^xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty timeindexedpartof:isWholeObjectOf ;
                                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                                    ] ;
                                    rdfs:comment "A situation that includes at least two Objects, one having the role of whole object, the other(s) being a part(s) of it, and one TimeInterval." ;
                                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl> ;
                                    rdfs:label "Time indexed part of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval
timeinterval:TimeInterval rdf:type owl:Class ;
                          rdfs:label "Time interval"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


