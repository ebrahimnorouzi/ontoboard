    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesPartObject -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesPartObject">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isPartObjectOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#Object"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#TimeIndexedPartOf"/>
        <rdfs:comment>A relation between a temporary part-of situation and the part(s) involved.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl"/>
        <rdfs:label xml:lang="en">includes part object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesWholeObject -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#includesWholeObject">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isWholeObjectOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#Object"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#TimeIndexedPartOf"/>
        <rdfs:comment>A relation between a temporary part-of situation and the whole object involved.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl"/>
        <rdfs:label xml:lang="en">includes whole object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isPartObjectOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#isPartObjectOf">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#TimeIndexedPartOf"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl#Object"/>
        <rdfs:comment>A relation between object part(s) and the temporary part-of situation they are involved in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedpartof.owl"/>
        <rdfs:label xml:lang="en">is part object of</rdfs:label>
    </owl:ObjectProperty>
    


