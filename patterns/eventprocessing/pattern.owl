<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#"
     xml:base="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:model="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eva Blomqvist and Mikko Rinne</dc:creator>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To model event objects (in the context of complex event processing), their attributes, and their relations actual events, and sensor readings producing the events. Different types of event objects, such as complex, composite, and simple events are modelled, preoperties for expressing relations between event objects, such as constituency and componency are expressed, and attributes of event objects, such as timestamps and other data values. This pattern is aligned both to the SSN (Semantic Sensor Network) ontology, and the Event-F model, which in turn both use DUL as an upper layer.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eventprocessing Pattern</dcterms:title>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">By what sensor was this event object recorded?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What actual event does this event object document?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What are the parts of this composite event object?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What event objects are this complex event object and abstraction of?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What is the header/body of this event object?</cpannotationschema:coversRequirements>
        <cpannotationschema:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What is the timestamp of this event object?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To model event objects (in the context of complex event processing), their attributes, and their relations actual events, and sensor readings producing the events. Different types of event objects, such as complex, composite, and simple events are modelled, preoperties for expressing relations between event objects, such as constituency and componency are expressed, and attributes of event objects, such as timestamps and other data values. This pattern is aligned both to the SSN (Semantic Sensor Network) ontology, and the Event-F model, which in turn both use DUL as an upper layer.</cpannotationschema:hasIntent>
        <cpannotationschema:isSpecializationOf rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pattern extends both the SSN ontology and the Event-F model, which in turn are based on DUL.</cpannotationschema:isSpecializationOf>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x26; term declared x6;
- header: dcterms:title &quot;Eventprocessing Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- file: pattern.owl declares &lt;http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationDescription&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationSituation&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventInterpretationDescription&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://purl.oclc.org/NET/ssnx/ssn#SensorOutput&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#Event&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#Region&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#SpaceRegion&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval&gt; as a class, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#hasPart&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#isAbout&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#isEventIncludedIn&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf&gt; as an object property, as pattern.ttl did
- file: pattern.owl declares &lt;http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue&gt; as a data property, as pattern.ttl did
- file: pattern.owl declares &lt;http://purl.org/dc/elements/1.1/creator&gt; as an annotation property, as pattern.ttl did
- axiom added: EquivalentObjectProperties(&lt;http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSensorReadingValue&gt; &lt;http://purl.oclc.org/NET/ssnx/ssn#hasValue&gt;) - the source says hasSensorReadingValue owl:equivalentProperty ssn:hasValue and declares ssn:hasValue nowhere, so the OWL API read no axiom from it and the curated file lost the statement (the final review of 1.155.0); kept as the source says it, ssn:hasValue an object property as hasSensorReadingValue is
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Created with TopBraid Composer</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator">
        <rdfs:label xml:lang="en">Creator</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="en">Description (DC terms)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label xml:lang="en">Title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements">
        <rdfs:label xml:lang="en">covers requirements</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent">
        <rdfs:label xml:lang="en">has intent</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf">
        <rdfs:label xml:lang="en">is specialization of</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/ssnx/ssn#hasValue -->

    <owl:ObjectProperty rdf:about="http://purl.oclc.org/NET/ssnx/ssn#hasValue">
        <owl:equivalentProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSensorReadingValue"/>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent">
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent">
        <rdfs:label xml:lang="en">has constituent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart">
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion">
        <rdfs:label xml:lang="en">has region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#isAbout -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#isAbout">
        <rdfs:label xml:lang="en">is about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf">
        <rdfs:label xml:lang="en">is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf">
        <rdfs:label xml:lang="en">is constituent of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#isEventIncludedIn -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#isEventIncludedIn">
        <rdfs:label xml:lang="en">is event included in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf">
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasDirectSubEventObject -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasDirectSubEventObject">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSubEventObject"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isDirectSubEventObjectOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectHeader"/>
            <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectConstituent"/>
        </owl:propertyChainAxiom>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that connects a complex event with the low-level events it is a higher-level representation of. This is a non-transitive relation that can be used to create a hierarchy of levels of sub-events, that represents the reasoning/triggering or abstraction process that led up to the creation or detection of a complex event. The transitive superproperty hasSubEventObject allows for direclty querying for the transitive closure of sub-events, regardless of the hierarchy, even if only this non-transitive sub-property is used in the data.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has direct sub-event object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventDuration -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue"/>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property for represting a time interval of an event object, rather than a time point. Alternative is to define several time points, using the subproperties of the datatype property hasEventObjectTime.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventLocation -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventLocation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue"/>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SpaceRegion"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object attribute value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectBody -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectBody">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectBodyOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectBody"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some event processing systems need to distinguish between an event object header and its body, where the event object header is the part of the event object with known content (e.g. known vocabulary) that can be directly processed by the event processing system. This property relates an event object to its body part.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectComponent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectPart"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectComponentOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectHeader"/>
            <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectComponent"/>
        </owl:propertyChainAxiom>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This non-transitive property expresses the direct relation between an event object and its direct parts, i.e. its components. Using this property a hierarchy of components can be expressed for an event object. The components of the event object do not exist on their own, but exist to &quot;make up&quot; the whole of the encapsulating event, likewise the encapsulating event is not complete without its parts. Please note the difference between this stronger relation, compared to the &quot;hasSubEvent&quot;-property which merely relates event objects to each other, e.g. expressing the triggering of abstractions, but without implying that the events are parts of each other.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectHeader -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectHeader">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectHeaderOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some event processing systems need to distinguish between an event object header and its body, where the event object header is the part of the event object with known content (e.g. known vocabulary) that can be directly processed by the event processing system. This property relates an event object to its header part.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object header</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectPart -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectPart">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This transitive property represents a partonomy relation between event objects. An event object can consist of several &quot;partial events&quot; that together make up the complete event object. The parts of the event object do not exist on their own, but exist to &quot;make up&quot; the whole of the encapsulating event, likewise the encapsulating event is not complete without its parts. Please note the difference between this stronger relation, compared to the &quot;hasSubEvent&quot;-property which merely relates event objects to each other, e.g. expressing the triggering of abstractions, but without implying that the events are parts of each other.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSensorReadingValue -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSensorReadingValue">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property for expresseing the alignemet to the SSN ontology, equivalent to ssn:hasValue.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has sensor reading value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSubEventObject -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSubEventObject">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isSubEventObjectOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that connects a complex event with the low-level events it is a higher-level representation of. An event object may reference another event, on a lower level of abstraction or granularity, upon which is it is based or from which it was derived or triggered, making that other event a &quot;sub event&quot; of this aggregated or more abstract event object. Note that for modelling instance data, normally, the non-transitive sub-property &quot;hasDirectSubEventObject&quot; should be used, based on which the presence of this transitive relation can be inferred.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has sub-event object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#informationAboutEvent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#informationAboutEvent">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isAbout"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expresses information about an event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isDirectSubEventObjectOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isDirectSubEventObjectOf">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isSubEventObjectOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is direct sub event object of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectBodyOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectBodyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is event object body of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf"/>
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectPartOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is event object component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectHeaderOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectHeaderOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isComponentOf"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is event object header of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectPartOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is event object part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isSubEventObjectOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isSubEventObjectOf">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is sub event object of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectComponent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectComponent">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event objects that use a header/body structure can use this property to refer to the components (i.e. direct parts) of the event object. Through a property chain axiom, the presence of a &quot;hasEventObjectComponent&quot; relation can be inferred.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refers to event object component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectConstituent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#refersToEventObjectConstituent">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event objects that use a header/body structure can use this property to refer to the constituents (i.e. direct sub-events in an abstraction hierarchy) of the event object. Through a property chain axiom, the presence of a &quot;hasDirectSubEventObject&quot; relation can be inferred.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refers to event object constituent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue -->

    <owl:DatatypeProperty rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue">
        <rdfs:label xml:lang="en">has data value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectApplicationTime -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectApplicationTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The timestamp assigned by the source of the data when it was transmitted, i.e. when it entered the stream.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object application time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeDataValue -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeDataValue">
        <rdfs:subPropertyOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object attribute data value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectExpirationTime -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectExpirationTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time limit on the validity of this event object.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object expiration time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectSamplingTime -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectSamplingTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The time the event was detected and recorded as data, e.g. when it was recorded by a sensor in terms of the sensor&apos;s internal clock.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object sampling time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectSystemTime -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectSystemTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The timestamp of the event according to the event processing system (in terms of its internal clock time), i.e. when the event object was received byt the event processing system through the stream.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object system time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeDataValue"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has event object time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationDescription -->

    <owl:Class rdf:about="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationDescription">
        <rdfs:label xml:lang="en">event documentation description</rdfs:label>
    </owl:Class>
    


    <!-- http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationSituation -->

    <owl:Class rdf:about="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationSituation">
        <rdfs:label xml:lang="en">event documentation situation</rdfs:label>
    </owl:Class>
    


    <!-- http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventInterpretationDescription -->

    <owl:Class rdf:about="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventInterpretationDescription">
        <rdfs:label xml:lang="en">event interpretation description</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.oclc.org/NET/ssnx/ssn#SensorOutput -->

    <owl:Class rdf:about="http://purl.oclc.org/NET/ssnx/ssn#SensorOutput">
        <owl:equivalentClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SensorOutput"/>
        <rdfs:label xml:lang="en">sensor output</rdfs:label>
    </owl:Class>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#Event -->

    <owl:Class rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Event">
        <rdfs:label xml:lang="en">event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject -->

    <owl:Class rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject">
        <rdfs:label xml:lang="en">information object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#Region -->

    <owl:Class rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Region">
        <rdfs:label xml:lang="en">region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#SpaceRegion -->

    <owl:Class rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#SpaceRegion">
        <rdfs:label xml:lang="en">space region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval -->

    <owl:Class rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval">
        <rdfs:label xml:lang="en">time interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectPart"/>
                        <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasSubEventObject"/>
                        <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SimpleEventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An event that summarizes, represents, or denotes a set of other events, i.e. it is an abstraction over other events. Anything that is not a complex event is instead a simple event.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complex event object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#CompositeEventObject">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectPart"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An event object that is composed of a set of other event objects, i.e. its parts.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">composite event object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SimpleEventObject"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#informationAboutEvent"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isEventIncludedIn"/>
                        <owl:someValuesFrom rdf:resource="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationSituation"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventDocumentationDescription"/>
                    <rdf:Description rdf:about="http://events.semantic-multimedia.org/ontology/2009/4/15/model.owl#EventInterpretationDescription"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventDuration"/>
                        <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue"/>
                        <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Region"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectHeader"/>
                        <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeDataValue"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An object that represents, encodes, or records an event, generally for the purpose of computer processing. 

An event object may consist of an event object header and a body, where the header is defined as the part of the event object that can be interpreted by the event processing system, i.e. and event object needs to contain at least some information (e.g. with a known vocabulary) that can be used by the event processing system. Note that the open world assumption allows us to choose not to explicitly specify a header, despite the restriction that it exists. 

An event object is either a complex event, i.e. an event object that has some relation (either through abstraction or componency) to other event objects, or a simple event. 

An event object records information about an actual event, which is then by implication a documented event (i.e. participating in an event documentation situation).</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectBody -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectBody">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectBodyOf"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some event processing systems need to distinguish between an event object header and its body, where the event object header is the part of the event object with known content (e.g. known vocabulary) that can be directly processed by the event processing system, and the body is the rest of the event object. The body may always be empty or missing.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event object body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#isEventObjectHeaderOf"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventDuration"/>
                        <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectTime"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeValue"/>
                        <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Region"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#hasEventObjectAttributeDataValue"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some event processing systems need to distinguish between an event object header and its body, where the event object header is the part of the event object with known content (e.g. known vocabulary) that can be directly processed by the event processing system. Although a header is considered mandatory for an event object, if not specified what the header consists of, it can be inferred by the system through the fact that it contains the &quot;known&quot; part, as opposed to the body that may contain a payload that the system cannot interpret.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event object header</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectBody"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObjectHeader"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#InformationObject"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event object part</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SensorOutput -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SensorOutput">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#ComplexEventObject"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SimpleEventObject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Class representing the alignement to ssn:SensorOutput, expressing the restriction that an ssn:SensorOutput is either a complex event or a simple event, depending on the sensor used.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor output</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SimpleEventObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#SimpleEventObject">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/eventprocessing.owl#EventObject"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An event object that is not an abstraction of other event objects, nor is composed of other event objects.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">simple event object</rdfs:label>
    </owl:Class>
</rdf:RDF>



