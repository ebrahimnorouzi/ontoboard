@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> rdf:type owl:Ontology ;
                                                                           owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                           dcterms:description "To represent aquatic resources or stocks as composed of aquatic organisms from one or more species, and living in a water area."^^xsd:string ;
                                                                           dcterms:title "Aquaticresources Pattern"^^xsd:string ;
                                                                           cpannotationschema:coversRequirements "What species are present in this aquatic resource/stock? In what water area this aquatic resource/stock lives in?" ;
                                                                           cpannotationschema:hasConsequences "Relations between aquatic resources and either aquatic species or water areas can be represented. In order to infer what species typically live in what water areas however, an application needs to add a SWRL rule, or a SPARQL query that unifies the hasSpecies and hasWaterArea relations." ;
                                                                           cpannotationschema:hasIntent "To represent aquatic resources or stocks as composed of aquatic organisms from one or more species, and living in a water area."^^xsd:string ;
                                                                           cpannotationschema:scenarios "give me the Species for water area 24" ,
                                                                                                        "give me the Water areas for species Gadus morhua" ;
                                                                           rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x6; term declared x2;
- header: dcterms:title \"Aquaticresources Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                           owl:versionInfo """1.1
changed hasWaterArea to canOccurIn"""^^xsd:string ,
                                                                                           "Created by Aldo Gangemi" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#canOccurIn
aquaticresources:canOccurIn rdf:type owl:ObjectProperty ;
                            owl:inverseOf aquaticresources:isAreaOfOccurrenceOf ;
                            rdfs:domain owl:Thing ;
                            rdfs:range aquaticresources:WaterArea ;
                            rdfs:label "has water area"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#hasSpecies
aquaticresources:hasSpecies rdf:type owl:ObjectProperty ;
                            owl:inverseOf aquaticresources:isSpeciesPresentIn ;
                            rdfs:domain aquaticresources:AquaticResource ;
                            rdfs:range aquaticresources:AquaticSpecies ;
                            rdfs:comment "has species"@en ;
                            rdfs:label "has species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#isAreaOfOccurrenceOf
aquaticresources:isAreaOfOccurrenceOf rdf:type owl:ObjectProperty ;
                                      rdfs:domain aquaticresources:WaterArea ;
                                      rdfs:range owl:Thing ;
                                      rdfs:label "is water area of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#isSpeciesPresentIn
aquaticresources:isSpeciesPresentIn rdf:type owl:ObjectProperty ;
                                    rdfs:domain aquaticresources:AquaticSpecies ;
                                    rdfs:range aquaticresources:AquaticResource ;
                                    rdfs:label "is species present in"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticResource
aquaticresources:AquaticResource rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty aquaticresources:canOccurIn ;
                                                   owl:someValuesFrom aquaticresources:WaterArea
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty aquaticresources:hasSpecies ;
                                                   owl:someValuesFrom aquaticresources:AquaticSpecies
                                                 ] ;
                                 owl:disjointWith aquaticresources:AquaticSpecies ,
                                                  aquaticresources:WaterArea ;
                                 rdfs:comment """A fishery resource (a collection of actual aquatic organisms) that can include aquatic organisms from different AquaticSpecies, and is localized in some WaterArea.
It can be mapped to fi:AqResRef""" ;
                                 rdfs:label "Aquatic resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies
aquaticresources:AquaticSpecies rdf:type owl:Class ;
                                owl:disjointWith aquaticresources:WaterArea ;
                                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                                rdfs:label "Aquatic species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#WaterArea
aquaticresources:WaterArea rdf:type owl:Class ;
                           rdfs:comment "A physical water area. Mappable to fi:WaterAreaRef" ;
                           rdfs:label "Water area"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


