# The aquaticresources pattern in use: the Western Baltic cod stock, a fishery resource made up
# of Atlantic cod and occurring in ICES Subdivision 24. Both of the pattern's relations are
# shown - what species a stock contains, and which water area it can occur in - because the
# second is what distinguishes this pattern from a list of species names.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/aquaticresources#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:WesternBalticCodStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Western Baltic cod stock" ;
    aquaticresources:hasSpecies ex:AtlanticCod ;
    aquaticresources:canOccurIn ex:IcesSubdivision24 .

ex:AtlanticCod a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic cod (Gadus morhua)" .

ex:IcesSubdivision24 a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "ICES Subdivision 24, the Arkona Basin" .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, hasSpecies/isSpeciesPresentIn. A reasoner adds the other.
