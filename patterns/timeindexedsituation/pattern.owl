     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:situation="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#"
     xmlns:timeinterval="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:timeindexedsituation="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent time indexed situations.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Timeindexedsituation Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>At what time did a certain situation occur?,What situations occurred at a certain time?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasAuthor>Aldo Gangemi</cpannotationschema:hasAuthor>
        <cpannotationschema:hasComponent>TimeInterval</cpannotationschema:hasComponent>
        <cpannotationschema:hasConsequences>We can represent situations that have an explicit time parameter.
In principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern.</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent time indexed situations.</cpannotationschema:hasIntent>
        <cpannotationschema:hasUnitTest>SELECT ?x ?e ?t
WHERE {
?x :forEntity ?e .
?x :atTime ?t }</cpannotationschema:hasUnitTest>
        <cpannotationschema:isSpecializationOf>Situation</cpannotationschema:isSpecializationOf>
        <cpannotationschema:relatedCPs>Time indexed participation,TimeIndexedClassification</cpannotationschema:relatedCPs>
        <cpannotationschema:scenarios>Mustafa&apos;s address in 2005 was in Brussels</cpannotationschema:scenarios>
        <rdfs:comment>A generic pattern usable for all situations that require a temporal indexing.</rdfs:comment>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x15; term declared x2;
- header: dcterms:title &quot;Timeindexedsituation Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0
- Revised, and added annotations for ODP publishing
0.1
- Created by Aldo Gangemi</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.1 added rdfs:isDefinedBy for all named entities</owl:versionInfo>
    </owl:Ontology>
    


