@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> rdf:type owl:Ontology ;
                                                                         owl:imports <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ,
                                                                                     <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl> ,
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                         dcterms:description "To represent time indexed situations."^^xsd:string ;
                                                                         dcterms:title "Timeindexedsituation Pattern"^^xsd:string ;
                                                                         cpannotationschema:coversRequirements "At what time did a certain situation occur?,What situations occurred at a certain time?" ;
                                                                         cpannotationschema:hasAuthor "Aldo Gangemi" ;
                                                                         cpannotationschema:hasComponent "TimeInterval" ;
                                                                         cpannotationschema:hasConsequences """We can represent situations that have an explicit time parameter.
In principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern.""" ;
                                                                         cpannotationschema:hasIntent "To represent time indexed situations."^^xsd:string ;
                                                                         cpannotationschema:hasUnitTest """SELECT ?x ?e ?t
WHERE {
?x :forEntity ?e .
?x :atTime ?t }""" ;
                                                                         cpannotationschema:isSpecializationOf "Situation" ;
                                                                         cpannotationschema:relatedCPs "Time indexed participation,TimeIndexedClassification" ;
                                                                         cpannotationschema:scenarios "Mustafa's address in 2005 was in Brussels" ;
                                                                         rdfs:comment "A generic pattern usable for all situations that require a temporal indexing." ,
                                                                                      """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x15; term declared x2;
- header: dcterms:title \"Timeindexedsituation Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                         owl:versionInfo """1.0
- Revised, and added annotations for ODP publishing
0.1
- Created by Aldo Gangemi"""^^xsd:string ,
                                                                                         "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

