@prefix : <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> rdf:type owl:Ontology ;
                                                                         owl:imports <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ,
                                                                                     <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl> ,
                                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "At what time did a certain situation occur?,What situations occurred at a certain time?" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Aldo Gangemi" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> "TimeInterval" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """We can represent situations that have an explicit time parameter.
In principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern.""" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent time indexed situations." ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?x ?e ?t
WHERE {
?x :forEntity ?e .
?x :atTime ?t }""" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> "Situation" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "Time indexed participation,TimeIndexedClassification" ;
                                                                         <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "Mustafa's address in 2005 was in Brussels" ;
                                                                         rdfs:comment "A generic pattern usable for all situations that require a temporal indexing." ;
                                                                         owl:versionInfo """1.0
- Revised, and added annotations for ODP publishing
0.1
- Created by Aldo Gangemi"""^^xsd:string ,
                                                                                         "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

