#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/rtmsmapping.owl#hasRTMS_Code
:hasRTMS_Code rdf:type owl:ObjectProperty ;
              rdfs:domain owl:Thing ;
              rdfs:range :RTMS_Code ;
              rdfs:label "has RTMS_Code"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/rtmsmapping.owl#RTMS_Code
:RTMS_Code rdf:type owl:Class ;
           rdfs:comment """Any code RTMS relational database that is linked from the FIGIS XML.
For species, it can be possibly mapped to fi:FAO3AlphaCode, fi:FAOTaxonomicCode, or fi:ISSCAAPCode""" ;
           rdfs:label "RTMS_Code"@en .


