# Three fishery records carrying the codes that stand for them in the RTMS reference database:
# a 3-alpha species code each, and the ISSCAAP group code, which the two tuna records share.
# That sharing is the whole use of the pattern - it is how you find the records that mean the
# same thing to RTMS.

@prefix rtmsmapping: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/rtmsmapping.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/rtmsmapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:SkipjackRecord a owl:NamedIndividual , owl:Thing ;
    rdfs:label "the FSDAS species record for skipjack tuna, Katsuwonus pelamis" ;
    rtmsmapping:hasRTMS_Code ex:Code_SKJ , ex:Code_ISSCAAP36 .

ex:YellowfinRecord a owl:NamedIndividual , owl:Thing ;
    rdfs:label "the FSDAS species record for yellowfin tuna, Thunnus albacares" ;
    rtmsmapping:hasRTMS_Code ex:Code_YFT , ex:Code_ISSCAAP36 .

ex:NorthSeaCodStockRecord a owl:NamedIndividual , owl:Thing ;
    rdfs:label "the FSDAS record for the North Sea stock of Atlantic cod" ;
    rtmsmapping:hasRTMS_Code ex:Code_COD , ex:Code_ISSCAAP32 .

ex:Code_SKJ a owl:NamedIndividual , rtmsmapping:RTMS_Code ;
    rdfs:label "SKJ, the 3-alpha code for skipjack tuna" .

ex:Code_YFT a owl:NamedIndividual , rtmsmapping:RTMS_Code ;
    rdfs:label "YFT, the 3-alpha code for yellowfin tuna" .

ex:Code_COD a owl:NamedIndividual , rtmsmapping:RTMS_Code ;
    rdfs:label "COD, the 3-alpha code for Atlantic cod" .

ex:Code_ISSCAAP36 a owl:NamedIndividual , rtmsmapping:RTMS_Code ;
    rdfs:label "ISSCAAP group 36, tunas, bonitos and billfishes" ;
    rdfs:comment "Held by both tuna records. One code, two records: the question \"which of our records mean the same to RTMS?\" is answered by looking at who points here." .

ex:Code_ISSCAAP32 a owl:NamedIndividual , rtmsmapping:RTMS_Code ;
    rdfs:label "ISSCAAP group 32, cods, hakes and haddocks" .

# The records are plain owl:Thing on purpose. The pattern gives hasRTMS_Code the domain
# owl:Thing because it says nothing about what is being coded - a species, a stock, a
# landing - only that whatever it is has a code on the RTMS side.
