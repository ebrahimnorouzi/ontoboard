# Two rooms of one flat as smart-home geo features, each carrying the floor polygon that
# gives it a geometry, and placed relative to one another. This is what the pattern means
# by a spatial entity: a feature with a geometry, not a bare label on a floor plan.

@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix smarthomegeometry: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-geometry#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Kitchen a owl:NamedIndividual , smarthomegeometry:SmartHomeGeoFeature ;
    rdfs:label "the kitchen of flat 3B" ;
    geo:hasGeometry ex:KitchenFloorPolygon ;
    smarthomegeometry:northOf ex:LivingRoom .

ex:KitchenFloorPolygon a owl:NamedIndividual , geo:Geometry ;
    rdfs:label "the kitchen floor polygon, 3.2 m by 4.0 m" .

ex:LivingRoom a owl:NamedIndividual , smarthomegeometry:SmartHomeGeoFeature ;
    rdfs:label "the living room of flat 3B" ;
    geo:hasGeometry ex:LivingRoomFloorPolygon .

ex:LivingRoomFloorPolygon a owl:NamedIndividual , geo:Geometry ;
    rdfs:label "the living-room floor polygon, 5.0 m by 4.0 m" .

# Only northOf is asserted. A reasoner adds hasDirectionalRelation and hasSpatialRelation
# from the pattern's property hierarchy. The pattern declares no inverse for the eight
# compass relations, so the living room is not thereby southOf the kitchen.
