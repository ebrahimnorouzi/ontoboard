:northOf rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#northWestOf
:northWestOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#southEastOf
:southEastOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#southOf
:southOf rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#southWestOf
:southWestOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#westOf
:westOf rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasDirectionalRelation .


###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty .


###  http://www.opengis.net/ont/geosparql#sfContains
<http://www.opengis.net/ont/geosparql#sfContains> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfCrosses
<http://www.opengis.net/ont/geosparql#sfCrosses> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfDisjoint
<http://www.opengis.net/ont/geosparql#sfDisjoint> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfEquals
<http://www.opengis.net/ont/geosparql#sfEquals> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfIntersects
<http://www.opengis.net/ont/geosparql#sfIntersects> rdf:type owl:ObjectProperty ;
                                                    rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfOverlaps
<http://www.opengis.net/ont/geosparql#sfOverlaps> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfTouches
<http://www.opengis.net/ont/geosparql#sfTouches> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf :hasSpatialRelation .


###  http://www.opengis.net/ont/geosparql#sfWithin
<http://www.opengis.net/ont/geosparql#sfWithin> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf :hasSpatialRelation .


