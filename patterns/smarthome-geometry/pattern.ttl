#    Object Properties
#################################################################

###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#eastOf
:eastOf rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :hasDirectionalRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#hasDirectionalRelation
:hasDirectionalRelation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasSpatialRelation .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#hasSpatialRelation
:hasSpatialRelation rdf:type owl:ObjectProperty .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#northEastOf
:northEastOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasDirectionalRelation .


