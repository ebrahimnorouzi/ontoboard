@base <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl> .

<http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl> rdf:type owl:Ontology ;
                                                                               owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                               <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What are the spatial entities (objects with geometry) in a smart home environment?"^^xsd:string ;
                                                                               <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> "This pattern is a spacializayion of the GeoSPARQL ontology (http://www.opengis.net/ont/geosparql) in order to be used in the definition of spatial entities (e.g. places or physical objects) in a smart environment."^^xsd:string .

