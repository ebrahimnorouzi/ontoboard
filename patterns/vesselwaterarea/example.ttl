# The pattern's own scenario - the water areas gillnetters are used in. Western Baltic
# gillnetters work both the Arkona Basin, where the bottom-set gillnet they carry is also
# recorded as suitable, and the Belt Sea, where only the vessel relation is asserted: the
# vessel-to-area link is related to the gear-to-area one but does not depend on it.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix gearspecies: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#> .
@prefix gearvessel: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/vesselwaterarea#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:WesternBalticCodStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Western Baltic cod stock" ;
    aquaticresources:hasSpecies ex:AtlanticCod .

ex:AtlanticCod a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic cod (Gadus morhua)" ;
    gearspecies:isCaughtByGearType ex:BottomSetGillnet .

ex:EuropeanFlounder a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "European flounder (Platichthys flesus)" .

ex:HarbourPorpoise a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "harbour porpoise (Phocoena phocoena)" .

ex:BottomSetGillnet a owl:NamedIndividual , gearspecies:GearType , gearvessel:GearType ;
    rdfs:label "bottom-set gillnet (anchored)" ;
    gearspecies:targetsSpecies ex:EuropeanFlounder ;
    gearspecies:catchesSpecies ex:AtlanticCod ;
    gearspecies:incidentallyCatchesSpecies ex:HarbourPorpoise ;
    gearvessel:usedByVesselType ex:Gillnetter .

ex:Gillnetter a owl:NamedIndividual , gearvessel:VesselType ;
    rdfs:label "gillnetter" .

ex:IcesSubdivision24 a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "ICES Subdivision 24, the Arkona Basin" ;
    <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearwaterarea.owl#isSuitableForGearType> ex:BottomSetGillnet ;
    <http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselwaterarea.owl#canBeCrossedByVesselType> ex:Gillnetter .

ex:IcesSubdivision22 a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "ICES Subdivision 22, the Belt Sea" ;
    <http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselwaterarea.owl#canBeCrossedByVesselType> ex:Gillnetter .

# Only one direction of each inverse pair is asserted: canBeCrossedByVesselType/canCrossWaterArea, canOccurIn/isAreaOfOccurrenceOf, catchesSpecies/isCaughtBy, hasSpecies/isSpeciesPresentIn, isSuitableForGearType/isUsedInWaterArea, usedByVesselType/usesGearType. A reasoner adds the other.
