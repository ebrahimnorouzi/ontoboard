@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gearvessel: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#> .
@prefix gearspecies: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#> .
@prefix gearwaterarea: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearwaterarea.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselwaterarea.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselwaterarea.owl> rdf:type owl:Ontology ;
                                                                          owl:imports <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearwaterarea.owl> ,
                                                                                      <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                          dcterms:description "to represent a direct relation between vessel types and water areas regardless of what type of fishing gear is fitted"^^xsd:string ;
                                                                          dcterms:title "Vesselwaterarea Pattern"^^xsd:string ;
                                                                          cpannotationschema:coversRequirements "which vessel types can be used in which water areas? (provided that water areas have species that are caught by geartypes that are used by vessel types)" ;
                                                                          cpannotationschema:hasComponent "<http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl>" ;
                                                                          cpannotationschema:hasConsequences "The pattern can be used to represent a water area setting and the vessels that can be used there, no matter whether these constraints are legal or logistic. The hasWaterArea object property is used as in the gearwaterarea pattern. Usage of this property as applied to VesselTypes is related to, but not strictly dependent on the hasWaterArea property as applied to GearTypes." ;
                                                                          cpannotationschema:hasIntent "to represent a direct relation between vessel types and water areas regardless of what type of fishing gear is fitted"^^xsd:string ;
                                                                          cpannotationschema:scenarios "in which water areas are 'gillneters' used?" ;
                                                                          rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x11; term declared x11;
- header: dcterms:title \"Vesselwaterarea Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                       """This pattern composes gearvessel.owl and gearwaterarea.owl.
This must be inferred compositionally, and requires either  more sophisticated logical pattern, like 'property chain', available in OWL2 (but not in OWL1), or a complex reasoning pattern, like 'DL classifier+SPARQL', or 'DL classifier+SWRL rule firing'.""" ;
                                                                          owl:versionInfo "1.2" ,
                                                                                          "Created by Alessandro Adamou"^^xsd:string .

