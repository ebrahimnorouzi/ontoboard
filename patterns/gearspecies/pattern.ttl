@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl11: <http://www.w3.org/2006/12/owl11#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl> rdf:type owl:Ontology ;
                                                                      owl:imports <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                      dcterms:description "to represent types of fishing gear with respect to the aquatic species they either are targeted to catch or can accidentally catch"^^xsd:string ;
                                                                      dcterms:title "Gearspecies Pattern"^^xsd:string ;
                                                                      cpannotationschema:coversRequirements "what type of fishing gear can catch what aquatic species?" ;
                                                                      cpannotationschema:hasConsequences """The pattern outlines the relations between aquatic species and types of fishing gear that are suitable for catching exemplars thereof. While we do not make this distinction from the species' viewpoint, we do distinguish what species are gear types targeted to and what can be also incidentally caught. Since the original model does not hint at any other possible use for the three object properties presented herein, restriction superclasses for domains and ranges have been refactored as domain and range axioms for said properties. 
Note that this pattern can also be composed with:
1) gearvessel.owl for answering what species can be caught using what vessel types, or which vessels are typically used in water areas: cf. vesselspecies.owl and vesselwaterareas.ow.
2) aquaticresources.owl for answering what water areas are typical for what gear types: cf. gearwaterarea.owl.
This must be inferred compositionally, and requires either  more sophisticated logical pattern, like 'property chain', available in OWL2 (but not in OWL1), or a complex reasoning pattern, like 'DL classifier+SPARQL', or 'DL classifier+SWRL rule firing'.""" ;
                                                                      cpannotationschema:hasIntent "to represent types of fishing gear with respect to the aquatic species they either are targeted to catch or can accidentally catch"^^xsd:string ;
                                                                      cpannotationschema:scenarios "give me the gears which incidentally catch species \"dolphins\"" ,
                                                                                                   "give me the species caught using \"bottom gillnets\"" ;
                                                                      rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x13; term declared x7;
- header: dcterms:title \"Gearspecies Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                      owl:versionInfo "1.2" ,
                                                                                      "Created by Alessandro Adamou"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#catchesSpecies
:catchesSpecies rdf:type owl:ObjectProperty ;
                owl:inverseOf :isCaughtBy ;
                rdfs:domain :GearType ;
                rdfs:range aquaticresources:AquaticSpecies ;
                rdfs:label "catches species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#incidentallyCatchesSpecies
:incidentallyCatchesSpecies rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :catchesSpecies ;
                            rdfs:domain :GearType ;
                            rdfs:range aquaticresources:AquaticSpecies ;
                            rdfs:label "incidentally catches species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#isCaughtBy
:isCaughtBy rdf:type owl:ObjectProperty ;
            rdfs:domain aquaticresources:AquaticSpecies ;
            rdfs:range :GearType ;
            rdfs:label "is caught by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#isCaughtByGearType
:isCaughtByGearType rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :isCaughtBy ;
                    rdfs:domain aquaticresources:AquaticSpecies ;
                    rdfs:range :GearType ;
                    rdfs:label "is caught by gear type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#targetsSpecies
:targetsSpecies rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :catchesSpecies ;
                rdfs:domain :GearType ;
                rdfs:range aquaticresources:AquaticSpecies ;
                rdfs:label "targets species"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies
aquaticresources:AquaticSpecies rdf:type owl:Class ;
                                owl:disjointWith :GearType ;
                                rdfs:label "Aquatic species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#GearType
:GearType rdf:type owl:Class ;
          rdfs:subClassOf owl:Thing ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :incidentallyCatchesSpecies ;
                            owl:someValuesFrom aquaticresources:AquaticSpecies
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :targetsSpecies ;
                            owl:someValuesFrom aquaticresources:AquaticSpecies
                          ] ;
          rdfs:label "gear type"@en .


