# Three kinds of fishing gear and the species they catch, on the pattern's own scenarios:
# a purse seine and a drifting longline both target bluefin tuna, a bottom-set gillnet targets
# hake and takes common dolphin incidentally, and the dolphin record also names the gear from
# the species' side.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix gearspecies: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/gearspecies#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MediterraneanBluefinTunaStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Mediterranean bluefin tuna stock" ;
    aquaticresources:hasSpecies ex:AtlanticBluefinTuna .

ex:AtlanticBluefinTuna a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic bluefin tuna (Thunnus thynnus)" .

ex:EuropeanHake a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "European hake (Merluccius merluccius)" .

ex:BlueShark a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "blue shark (Prionace glauca)" .

ex:ShortBeakedCommonDolphin a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "short-beaked common dolphin (Delphinus delphis)" ;
    gearspecies:isCaughtByGearType ex:DriftingLongline .

ex:TunaPurseSeine a owl:NamedIndividual , gearspecies:GearType ;
    rdfs:label "tuna purse seine" ;
    gearspecies:targetsSpecies ex:AtlanticBluefinTuna .

ex:DriftingLongline a owl:NamedIndividual , gearspecies:GearType ;
    rdfs:label "drifting longline" ;
    gearspecies:targetsSpecies ex:AtlanticBluefinTuna ;
    gearspecies:catchesSpecies ex:BlueShark .

ex:BottomSetGillnet a owl:NamedIndividual , gearspecies:GearType ;
    rdfs:label "bottom-set gillnet (anchored)" ;
    gearspecies:targetsSpecies ex:EuropeanHake ;
    gearspecies:incidentallyCatchesSpecies ex:ShortBeakedCommonDolphin .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, catchesSpecies/isCaughtBy, hasSpecies/isSpeciesPresentIn. A reasoner adds the other.
