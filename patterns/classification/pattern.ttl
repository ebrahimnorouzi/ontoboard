@prefix : <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/classification.owl> rdf:type owl:Ontology ;
                                                                   dcterms:description "Represents the assignment of a concept to a classification scheme or taxonomy."^^xsd:string ;
                                                                   dcterms:title "Classification Pattern"^^xsd:string ;
                                                                   rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x2; term declared x2;
- header: dcterms:title \"Classification Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                "Represents the assignment of a concept to a classification scheme or taxonomy."^^xsd:string ;
                                                                   rdfs:label "Classification Pattern"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies
:classifies rdf:type owl:ObjectProperty ;
            rdfs:domain :Concept ;
            rdfs:range :Entity ;
            rdfs:label "classifies" .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy
:isClassifiedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :Entity ;
                rdfs:range :Concept ;
                rdfs:label "isClassifiedBy" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept
:Concept rdf:type owl:Class ;
         rdfs:label "Concept" .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity
:Entity rdf:type owl:Class ;
        rdfs:label "Entity" .


