@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl> rdf:type owl:Ontology ;
                                                                     owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "what vessel type can equip what gear type?" ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "This is a straightforward pattern that describes vessel types in terms of the fishing gear they can be equipped with. The original usesGearType object property has been reworked, in that subclass restrictions for affected classes have been replacd with domain and range axiom. This also allows the definition of inverse property usedByVesselType." ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "to represent types of fishing gear with regard to the types of vessel they can be mounted on" ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "give me the vesseltypes that use 'trawls'" ;
                                                                     owl:versionInfo "1.0"^^xsd:string ,
                                                                                     "Created by Alessandro Adamou"^^xsd:string .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usedByVesselType
:usedByVesselType rdf:type owl:ObjectProperty ;
                  owl:inverseOf :usesGearType ;
                  rdfs:domain :GearType ;
                  rdfs:range :VesselType ;
                  rdfs:label "used by vessel type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usesGearType
:usesGearType rdf:type owl:ObjectProperty ;
              rdfs:domain :VesselType ;
              rdfs:range :GearType ;
              rdfs:label "uses gear type"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType
:GearType rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :usedByVesselType ;
                            owl:allValuesFrom :VesselType
                          ] ;
          owl:disjointWith :VesselType ;
          rdfs:comment """Gear types are conceptual entities that are characterized together with AquaticSpecies that are either targeted or can be incidentally caught. 
Mappable to fi:GeartypeRef""" ;
          rdfs:label "Gear type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType
:VesselType rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :usesGearType ;
                              owl:allValuesFrom :GearType
                            ] ;
            rdfs:comment """Vessel types are conceptual entities. 
Mappable to fi:VesseltypeRef""" ;
            rdfs:label "Vessel type"@en .


