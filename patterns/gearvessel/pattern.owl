    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usedByVesselType -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usedByVesselType">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usesGearType"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType"/>
        <rdfs:label xml:lang="en">used by vessel type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usesGearType -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usesGearType">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType"/>
        <rdfs:label xml:lang="en">uses gear type</rdfs:label>
    </owl:ObjectProperty>
    


