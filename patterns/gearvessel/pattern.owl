    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usedByVesselType"/>
                <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType"/>
        <rdfs:comment>Gear types are conceptual entities that are characterized together with AquaticSpecies that are either targeted or can be incidentally caught. 
Mappable to fi:GeartypeRef</rdfs:comment>
        <rdfs:label xml:lang="en">Gear type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#usesGearType"/>
                <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Vessel types are conceptual entities. 
Mappable to fi:VesseltypeRef</rdfs:comment>
        <rdfs:label xml:lang="en">Vessel type</rdfs:label>
    </owl:Class>
</rdf:RDF>



