# Three kinds of fishing gear from the FAO gear classification, each linked to the
# vessel types that can be rigged with it - a bottom otter trawl is worked from both
# stern and side trawlers, while a purse seine needs a purse seiner.

@prefix gearvessel: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/gearvessel#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:BottomOtterTrawl a owl:NamedIndividual , gearvessel:GearType ;
    rdfs:label "bottom otter trawl" ;
    gearvessel:usedByVesselType ex:SternTrawler , ex:SideTrawler .

ex:PurseSeine a owl:NamedIndividual , gearvessel:GearType ;
    rdfs:label "purse seine" ;
    gearvessel:usedByVesselType ex:PurseSeiner .

ex:SetGillnet a owl:NamedIndividual , gearvessel:GearType ;
    rdfs:label "set gillnet (anchored)" ;
    gearvessel:usedByVesselType ex:Gillnetter .

ex:SternTrawler a owl:NamedIndividual , gearvessel:VesselType ;
    rdfs:label "stern trawler" .

ex:SideTrawler a owl:NamedIndividual , gearvessel:VesselType ;
    rdfs:label "side trawler" .

ex:PurseSeiner a owl:NamedIndividual , gearvessel:VesselType ;
    rdfs:label "purse seiner" .

ex:Gillnetter a owl:NamedIndividual , gearvessel:VesselType ;
    rdfs:label "gillnetter" .

# Only one direction of each inverse pair is asserted: usedByVesselType/usesGearType. A reasoner adds the other.

