#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTheLastSituation
:isTheLastSituation rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Situation ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "This property defines if a situation that is member of a recurrent situation series is the last one or not."@en ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                    rdfs:label "is the last situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#situationNumber
:situationNumber rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Situation ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "This property represents the number of the situation in the recurrent situation series (the first situation, the second situation, etc.)"@en ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                 rdfs:label "situation number"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#RecurrentSituationSeries
:RecurrentSituationSeries rdf:type owl:Class ;
                          rdfs:subClassOf [ owl:intersectionOf ( :Situation
                                                                 <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection>
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasMemberSituation ;
                                            owl:someValuesFrom [ rdf:type owl:Class ;
                                                                 owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasNextSituation ;
                                                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass :Situation
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty :hasPreviousSituation ;
                                                                                 owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass :Situation
                                                                               ]
                                                                             )
                                                               ]
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasTimePeriod ;
                                            owl:someValuesFrom :TimePeriod
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasUnifyingFactor ;
                                            owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description>
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#satisfies> ;
                                            owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description>
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasMemberSituation ;
                                            owl:allValuesFrom :Situation
                                          ] ;
                          rdfs:comment "Recurrent situation series is modeled as an intersection of the classes Collection and Situation. Indeed, a recurrent situation is seen as a collection, since it contains entities that share one or more common properties and are unified conceptually. These entities are member of the collection, and are all consecutive situations, in such a manner that each situation has either a previous situation, or a next situation, or both, unless the series has never been instantiated. At the same time, a recurrent situation is a situation, intended as a relational context in which the contextualized things are based on a frame: a recurrent situation is similar to a plan that defines how the things involved in that plan (i.e. the specific situations) shall be carried out, e.g. where the situations shall be located, in which time of the year, etc."@en ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                          rdfs:label "Recurrent Situation Series"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#Situation
:Situation rdf:type owl:Class ;
           rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/d0.owl#Eventuality> ;
           rdfs:comment "This class represents a Situation."@en ;
           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
           rdfs:label "Situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#TimePeriod
:TimePeriod rdf:type owl:Class ;
            rdfs:comment "This class represents a Time Period (e.g. 1 week)."@en ;
            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
            rdfs:label "Time Period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#UnifyingSituation
:UnifyingSituation rdf:type owl:Class ;
                   rdfs:subClassOf :Situation ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :involvesUnifyingFactor ;
                                     owl:someValuesFrom owl:Thing
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isValidIn ;
                                     owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval>
                                   ] ;
                   rdfs:comment "A Unifying Situation is a situation involving a unifying factor, i.e. a concept classifying an element or property occurring in each situation member of a recurrent situation series, which unifies the collection and makes all the situations attributable to a homogeneous collection, and is valid at a specific time interval."@en ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                   rdfs:label "Unifying Situation"@en .


###  http://www.ontologydesignpatterns.org/ont/d0.owl#Eventuality
<http://www.ontologydesignpatterns.org/ont/d0.owl#Eventuality> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Description> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#unifying-factor
:unifying-factor rdf:type owl:NamedIndividual ,
                          <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept> ;
                 rdfs:comment "A Unifying Factor is a concept, which classifies an element or property occurring in each situation member of a recurrent situation series. The unifying factor unifies the collection and makes all the situations attributable to a homogeneous collection."@en ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                 rdfs:label "Unifying Factor"@en .


