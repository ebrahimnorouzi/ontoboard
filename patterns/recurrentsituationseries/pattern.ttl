###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasEstimatedTimePeriod
:hasEstimatedTimePeriod rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasTimePeriod ;
                        owl:inverseOf :isEstimatedTimePeriodOf ;
                        rdfs:domain :RecurrentSituationSeries ;
                        rdfs:range :TimePeriod ;
                        rdfs:comment "This property relates a recurrent situation series to an estimated time period."@en ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                        rdfs:label "has estimated time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasImmediateNextSituation
:hasImmediateNextSituation rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :hasNextSituation ;
                           owl:inverseOf :hasImmediatePreviousSituation ;
                           rdf:type owl:FunctionalProperty ;
                           rdfs:domain :Situation ;
                           rdfs:range :Situation ;
                           rdfs:comment "This property relates a situation member of a recurrent situation series to the immediate next situation member of the same recurrent situation series."@en ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                           rdfs:label "has immediate next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasImmediatePreviousSituation
:hasImmediatePreviousSituation rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :hasPreviousSituation ;
                               rdf:type owl:FunctionalProperty ;
                               rdfs:domain :Situation ;
                               rdfs:range :Situation ;
                               rdfs:comment "This property relates a situation member of a recurrent situation series to the immediate previous situation member of the same recurrent situation series."@en ;
                               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                               rdfs:label "has immediate previous situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasMeasuredTimePeriod
:hasMeasuredTimePeriod rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasTimePeriod ;
                       owl:inverseOf :isMeasuredTimePeriodOf ;
                       rdfs:domain :RecurrentSituationSeries ;
                       rdfs:range :TimePeriod ;
                       rdfs:comment "This property relates a recurrent situation series to a measured time period."@en ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                       rdfs:label "has measured time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasMemberSituation
:hasMemberSituation rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasMember> ;
                    owl:inverseOf :isSituationMemberOf ;
                    rdfs:domain :RecurrentSituationSeries ;
                    rdfs:range :Situation ;
                    rdfs:comment "This property relates a recurrent situation series to a situation that is member of it."@en ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                    rdfs:label "has member situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasNextSituation
:hasNextSituation rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#precedes> ;
                  owl:inverseOf :hasPreviousSituation ;
                  rdf:type owl:TransitiveProperty ;
                  rdfs:domain :Situation ;
                  rdfs:range :Situation ;
                  rdfs:comment "This property relates a situation member of a recurrent situation series to a next situation member of the same recurrent situation series."@en ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                  rdfs:label "has next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasPreviousSituation
:hasPreviousSituation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#follows> ;
                      rdf:type owl:TransitiveProperty ;
                      rdfs:domain :Situation ;
                      rdfs:range :Situation ;
                      rdfs:comment "This property relates a situation member of a recurrent situation series to a previous situation member of the same recurrent situation series."@en ;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                      rdfs:label "has previous situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasTimePeriod
:hasTimePeriod rdf:type owl:ObjectProperty ;
               owl:inverseOf :isTimePeriodOf ;
               rdfs:domain :RecurrentSituationSeries ;
               rdfs:range :TimePeriod ;
               owl:propertyChainAxiom ( :hasMemberSituation
                                        :hasTimePeriodBeforeNextSituation
                                      ) ;
               rdfs:comment "This property relates a recurrent situation series to a time period."@en ;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
               rdfs:label "has time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasTimePeriodBeforeNextSituation
:hasTimePeriodBeforeNextSituation rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf :hasTimePeriod ;
                                  owl:inverseOf :isTimePeriodBeforeNextSituationOf ;
                                  rdfs:domain :Situation ;
                                  rdfs:range :TimePeriod ;
                                  rdfs:comment "This property relates a situation member of a recurrent situation series to the time period elapsing before its next situation."@en ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                  rdfs:label "has time period before next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasUnifyingFactor
:hasUnifyingFactor rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isUnifyingFactorOf ;
                   rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection> ;
                   rdfs:range owl:Thing ;
                   owl:propertyChainAxiom ( :hasUnifyingSituation
                                            :involvesUnifyingFactor
                                          ) ;
                   rdfs:comment "This property relates a collection to a unifying factor."@en ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                   rdfs:label "has unifying factor"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasUnifyingSituation
:hasUnifyingSituation rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isUnifyingSituationOf ;
                      rdfs:domain :RecurrentSituationSeries ;
                      rdfs:range :UnifyingSituation ;
                      rdfs:comment "This property relates a recurrent situation series to a unifying situation."@en ;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                      rdfs:label "has unifying situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#involvesUnifyingFactor
:involvesUnifyingFactor rdf:type owl:ObjectProperty ;
                        owl:inverseOf :isInvolvedInUnifyingSituation ;
                        rdfs:domain :UnifyingSituation ;
                        rdfs:range owl:Thing ;
                        rdfs:comment "This property relates a unifying situation to the involved unifying factor."@en ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                        rdfs:label "involves unifying factor"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isEstimatedTimePeriodOf
:isEstimatedTimePeriodOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :isTimePeriodOf ;
                         rdfs:domain :TimePeriod ;
                         rdfs:range :RecurrentSituationSeries ;
                         rdfs:comment "This property relates an estimated time period to a recurrent situation series."@en ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                         rdfs:label "is estimated time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isInvolvedInUnifyingSituation
:isInvolvedInUnifyingSituation rdf:type owl:ObjectProperty ;
                               rdfs:domain owl:Thing ;
                               rdfs:range :UnifyingSituation ;
                               rdfs:comment "This property relates a unifying factor to the unifying situation it is involved in."@en ;
                               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                               rdfs:label "is involved in unifying situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isLocallyInconsistentWith
:isLocallyInconsistentWith rdf:type owl:ObjectProperty ;
                           rdfs:domain owl:Thing ;
                           rdfs:range owl:Thing ;
                           rdfs:comment "This property relates two entities that are considered locally inconsistent."@en ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                           rdfs:label "is locally inconsistent with"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isMeasuredTimePeriodOf
:isMeasuredTimePeriodOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isTimePeriodOf ;
                        rdfs:domain :TimePeriod ;
                        rdfs:range :RecurrentSituationSeries ;
                        rdfs:comment "This property relates a measured time period to a recurrent situation series."@en ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                        rdfs:label "is measured time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isSituationMemberOf
:isSituationMemberOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isMemberOf> ;
                     rdfs:domain :Situation ;
                     rdfs:range :RecurrentSituationSeries ;
                     rdfs:comment "This property relates a situation that is member of a recurrent situation series to the recurrent situation series."@en ;
                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                     rdfs:label "is situation member of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTimePeriodBeforeNextSituationOf
:isTimePeriodBeforeNextSituationOf rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf :isTimePeriodOf ;
                                   rdfs:domain :TimePeriod ;
                                   rdfs:range :Situation ;
                                   rdfs:comment "This property relates a time period, elapsing before the next situation of a situation member of a recurrent situation series, to one of the member situations."@en ;
                                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                   rdfs:label "is time period before next situation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTimePeriodOf
:isTimePeriodOf rdf:type owl:ObjectProperty ;
                rdfs:domain :TimePeriod ;
                rdfs:range :RecurrentSituationSeries ;
                rdfs:comment "This property relates a time period to a recurrent situation series having that time period."@en ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                rdfs:label "is time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isUnifyingFactorOf
:isUnifyingFactorOf rdf:type owl:ObjectProperty ;
                    rdfs:domain owl:Thing ;
                    rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection> ;
                    rdfs:comment "This property relates a unifying factor to the collection that is unified by that factor."@en ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                    rdfs:label "is unifying factor of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isUnifyingSituationOf
:isUnifyingSituationOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :UnifyingSituation ;
                       rdfs:range :RecurrentSituationSeries ;
                       rdfs:comment "This property relates a unifying situation to the recurrent situation series it unifies."@en ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                       rdfs:label "is unifying situation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isValidIn
:isValidIn rdf:type owl:ObjectProperty ;
           rdfs:domain :UnifyingSituation ;
           rdfs:range <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval> ;
           rdfs:comment "This property relates a unifying situation to its temporal validity."@en ;
           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
           rdfs:label "is valid in"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#follows
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#follows> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasMember
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasMember> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isClassifiedBy
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isClassifiedBy> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isMemberOf
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isMemberOf> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#precedes
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#precedes> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#satisfies
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#satisfies> rdf:type owl:ObjectProperty .


