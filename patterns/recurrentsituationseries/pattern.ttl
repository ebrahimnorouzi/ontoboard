@prefix : <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#> .
@prefix d0: <http://www.ontologydesignpatterns.org/ont/d0.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rss: <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix opla: <http://ontologydesignpatterns.org/opla/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> rdf:type owl:Ontology ;
                                                                             owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                             opla:reusesPatternAsTemplate <http://ontologydesignpatterns.org/cp/owl/sequence.owl> ,
                                                                                                          <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> ,
                                                                                                          <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl> ,
                                                                                                          <http://www.ontologydesignpatterns.org/cp/owl/description.owl> ,
                                                                                                          <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ;
                                                                             dc:creator "Aldo Gangemi" ,
                                                                                        "Andrea Nuzzolese" ,
                                                                                        "Valentina Carriero" ,
                                                                                        "Valentina Presutti" ;
                                                                             dcterms:description "To represent recurrent situation series as situations and collections of consecutive situations, with a regular time period between situations and unifying factors."^^xsd:string ;
                                                                             dcterms:title "Recurrentsituationseries Pattern"^^xsd:string ;
                                                                             cpannotationschema:coversRequirements "What are the situations of a recurrent situation series?, Which is the time period elapsing between two situations of a recurrent situation series?, When is the next situation of a recurrent situation series scheduled?,  What are the unifying criteria shared by all the situations in a recurrent situation series?, Which are the unifying situations shared by a (subset of) the situations member of a recurrent situation series?, When is a unifying situation valid?, Which is the (immediate) next situation in a recurrent situation series?, Which is the (immediate) previous situation in a recurrent situation series?" ;
                                                                             cpannotationschema:hasConsequences "A series of recurrent situations, its unifying factors and the recurrent time period can be modeled." ;
                                                                             cpannotationschema:hasIntent "To represent recurrent situation series as situations and collections of consecutive situations, with a regular time period between situations and unifying factors."^^xsd:string ;
                                                                             cpannotationschema:relatedCPs "Classification" ,
                                                                                                           "Collection" ,
                                                                                                           "Description" ,
                                                                                                           "Recurrent Event Series" ,
                                                                                                           "Sequence" ,
                                                                                                           "Situation" ;
                                                                             cpannotationschema:scenarios "Umbria Jazz is a collection of situations, which all take place in July and in the Italian region of Umbria, and has the musical genre jazz as a topic. Its situations recur at regular time periods, i.e. annually." ;
                                                                             rdfs:comment "A pattern for recurrent situation series. This pattern is a new version of the recurrent event series ODP (http://www.ontologydesignpatterns.org/cp/owl/recurrenteventseries.owl), based on new analysis which led to terminological and modelling changes."@en ,
                                                                                          """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x22; term declared x7;
- header: dcterms:title \"Recurrentsituationseries Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                             rdfs:label "recurrent situation series" .

#################################################################
#    Annotation properties
#################################################################

###  http://ontologydesignpatterns.org/opla/isNativeTo
opla:isNativeTo rdf:type owl:AnnotationProperty ;
                rdfs:label "is native to"@en .


###  http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate
opla:reusesPatternAsTemplate rdf:type owl:AnnotationProperty ;
                             rdfs:label "reuses pattern as template"@en .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty ;
           rdfs:label "Creator"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasEstimatedTimePeriod
rss:hasEstimatedTimePeriod rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf rss:hasTimePeriod ;
                           owl:inverseOf rss:isEstimatedTimePeriodOf ;
                           rdfs:domain rss:RecurrentSituationSeries ;
                           rdfs:range rss:TimePeriod ;
                           rdfs:comment "This property relates a recurrent situation series to an estimated time period."@en ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                           rdfs:label "has estimated time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasImmediateNextSituation
rss:hasImmediateNextSituation rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf rss:hasNextSituation ;
                              owl:inverseOf rss:hasImmediatePreviousSituation ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain rss:Situation ;
                              rdfs:range rss:Situation ;
                              rdfs:comment "This property relates a situation member of a recurrent situation series to the immediate next situation member of the same recurrent situation series."@en ;
                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                              rdfs:label "has immediate next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasImmediatePreviousSituation
rss:hasImmediatePreviousSituation rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf rss:hasPreviousSituation ;
                                  rdf:type owl:FunctionalProperty ;
                                  rdfs:domain rss:Situation ;
                                  rdfs:range rss:Situation ;
                                  rdfs:comment "This property relates a situation member of a recurrent situation series to the immediate previous situation member of the same recurrent situation series."@en ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                  rdfs:label "has immediate previous situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasMeasuredTimePeriod
rss:hasMeasuredTimePeriod rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf rss:hasTimePeriod ;
                          owl:inverseOf rss:isMeasuredTimePeriodOf ;
                          rdfs:domain rss:RecurrentSituationSeries ;
                          rdfs:range rss:TimePeriod ;
                          rdfs:comment "This property relates a recurrent situation series to a measured time period."@en ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                          rdfs:label "has measured time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasMemberSituation
rss:hasMemberSituation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf dul:hasMember ;
                       owl:inverseOf rss:isSituationMemberOf ;
                       rdfs:domain rss:RecurrentSituationSeries ;
                       rdfs:range rss:Situation ;
                       rdfs:comment "This property relates a recurrent situation series to a situation that is member of it."@en ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                       rdfs:label "has member situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasNextSituation
rss:hasNextSituation rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf dul:precedes ;
                     owl:inverseOf rss:hasPreviousSituation ;
                     rdf:type owl:TransitiveProperty ;
                     rdfs:domain rss:Situation ;
                     rdfs:range rss:Situation ;
                     rdfs:comment "This property relates a situation member of a recurrent situation series to a next situation member of the same recurrent situation series."@en ;
                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                     rdfs:label "has next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasPreviousSituation
rss:hasPreviousSituation rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf dul:follows ;
                         rdf:type owl:TransitiveProperty ;
                         rdfs:domain rss:Situation ;
                         rdfs:range rss:Situation ;
                         rdfs:comment "This property relates a situation member of a recurrent situation series to a previous situation member of the same recurrent situation series."@en ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                         rdfs:label "has previous situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasTimePeriod
rss:hasTimePeriod rdf:type owl:ObjectProperty ;
                  owl:inverseOf rss:isTimePeriodOf ;
                  rdfs:domain rss:RecurrentSituationSeries ;
                  rdfs:range rss:TimePeriod ;
                  owl:propertyChainAxiom ( rss:hasMemberSituation
                                           rss:hasTimePeriodBeforeNextSituation
                                         ) ;
                  rdfs:comment "This property relates a recurrent situation series to a time period."@en ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                  rdfs:label "has time period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasTimePeriodBeforeNextSituation
rss:hasTimePeriodBeforeNextSituation rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf rss:hasTimePeriod ;
                                     owl:inverseOf rss:isTimePeriodBeforeNextSituationOf ;
                                     rdfs:domain rss:Situation ;
                                     rdfs:range rss:TimePeriod ;
                                     rdfs:comment "This property relates a situation member of a recurrent situation series to the time period elapsing before its next situation."@en ;
                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                     rdfs:label "has time period before next situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasUnifyingFactor
rss:hasUnifyingFactor rdf:type owl:ObjectProperty ;
                      owl:inverseOf rss:isUnifyingFactorOf ;
                      rdfs:domain dul:Collection ;
                      rdfs:range owl:Thing ;
                      owl:propertyChainAxiom ( rss:hasUnifyingSituation
                                               rss:involvesUnifyingFactor
                                             ) ;
                      rdfs:comment "This property relates a collection to a unifying factor."@en ;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                      rdfs:label "has unifying factor"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#hasUnifyingSituation
rss:hasUnifyingSituation rdf:type owl:ObjectProperty ;
                         owl:inverseOf rss:isUnifyingSituationOf ;
                         rdfs:domain rss:RecurrentSituationSeries ;
                         rdfs:range rss:UnifyingSituation ;
                         rdfs:comment "This property relates a recurrent situation series to a unifying situation."@en ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                         rdfs:label "has unifying situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#involvesUnifyingFactor
rss:involvesUnifyingFactor rdf:type owl:ObjectProperty ;
                           owl:inverseOf rss:isInvolvedInUnifyingSituation ;
                           rdfs:domain rss:UnifyingSituation ;
                           rdfs:range owl:Thing ;
                           rdfs:comment "This property relates a unifying situation to the involved unifying factor."@en ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                           rdfs:label "involves unifying factor"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isEstimatedTimePeriodOf
rss:isEstimatedTimePeriodOf rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf rss:isTimePeriodOf ;
                            rdfs:domain rss:TimePeriod ;
                            rdfs:range rss:RecurrentSituationSeries ;
                            rdfs:comment "This property relates an estimated time period to a recurrent situation series."@en ;
                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                            rdfs:label "is estimated time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isInvolvedInUnifyingSituation
rss:isInvolvedInUnifyingSituation rdf:type owl:ObjectProperty ;
                                  rdfs:domain owl:Thing ;
                                  rdfs:range rss:UnifyingSituation ;
                                  rdfs:comment "This property relates a unifying factor to the unifying situation it is involved in."@en ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                  rdfs:label "is involved in unifying situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isLocallyInconsistentWith
rss:isLocallyInconsistentWith rdf:type owl:ObjectProperty ;
                              rdfs:domain owl:Thing ;
                              rdfs:range owl:Thing ;
                              rdfs:comment "This property relates two entities that are considered locally inconsistent."@en ;
                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                              rdfs:label "is locally inconsistent with"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isMeasuredTimePeriodOf
rss:isMeasuredTimePeriodOf rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf rss:isTimePeriodOf ;
                           rdfs:domain rss:TimePeriod ;
                           rdfs:range rss:RecurrentSituationSeries ;
                           rdfs:comment "This property relates a measured time period to a recurrent situation series."@en ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                           rdfs:label "is measured time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isSituationMemberOf
rss:isSituationMemberOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dul:isMemberOf ;
                        rdfs:domain rss:Situation ;
                        rdfs:range rss:RecurrentSituationSeries ;
                        rdfs:comment "This property relates a situation that is member of a recurrent situation series to the recurrent situation series."@en ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                        rdfs:label "is situation member of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTimePeriodBeforeNextSituationOf
rss:isTimePeriodBeforeNextSituationOf rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf rss:isTimePeriodOf ;
                                      rdfs:domain rss:TimePeriod ;
                                      rdfs:range rss:Situation ;
                                      rdfs:comment "This property relates a time period, elapsing before the next situation of a situation member of a recurrent situation series, to one of the member situations."@en ;
                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                                      rdfs:label "is time period before next situation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTimePeriodOf
rss:isTimePeriodOf rdf:type owl:ObjectProperty ;
                   rdfs:domain rss:TimePeriod ;
                   rdfs:range rss:RecurrentSituationSeries ;
                   rdfs:comment "This property relates a time period to a recurrent situation series having that time period."@en ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                   rdfs:label "is time period of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isUnifyingFactorOf
rss:isUnifyingFactorOf rdf:type owl:ObjectProperty ;
                       rdfs:domain owl:Thing ;
                       rdfs:range dul:Collection ;
                       rdfs:comment "This property relates a unifying factor to the collection that is unified by that factor."@en ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                       rdfs:label "is unifying factor of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isUnifyingSituationOf
rss:isUnifyingSituationOf rdf:type owl:ObjectProperty ;
                          rdfs:domain rss:UnifyingSituation ;
                          rdfs:range rss:RecurrentSituationSeries ;
                          rdfs:comment "This property relates a unifying situation to the recurrent situation series it unifies."@en ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                          rdfs:label "is unifying situation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isValidIn
rss:isValidIn rdf:type owl:ObjectProperty ;
              rdfs:domain rss:UnifyingSituation ;
              rdfs:range dul:TimeInterval ;
              rdfs:comment "This property relates a unifying situation to its temporal validity."@en ;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
              rdfs:label "is valid in"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies
dul:classifies rdf:type owl:ObjectProperty ;
               rdfs:label "classifies"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#follows
dul:follows rdf:type owl:ObjectProperty ;
            rdfs:label "follows"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasMember
dul:hasMember rdf:type owl:ObjectProperty ;
              rdfs:label "has member"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isClassifiedBy
dul:isClassifiedBy rdf:type owl:ObjectProperty ;
                   rdfs:label "is classified by"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isMemberOf
dul:isMemberOf rdf:type owl:ObjectProperty ;
               rdfs:label "is member of"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#precedes
dul:precedes rdf:type owl:ObjectProperty ;
             rdfs:label "precedes"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#satisfies
dul:satisfies rdf:type owl:ObjectProperty ;
              rdfs:label "satisfies"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#isTheLastSituation
rss:isTheLastSituation rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain rss:Situation ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "This property defines if a situation that is member of a recurrent situation series is the last one or not."@en ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                       rdfs:label "is the last situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#situationNumber
rss:situationNumber rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain rss:Situation ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "This property represents the number of the situation in the recurrent situation series (the first situation, the second situation, etc.)"@en ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                    rdfs:label "situation number"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#RecurrentSituationSeries
rss:RecurrentSituationSeries rdf:type owl:Class ;
                             rdfs:subClassOf [ owl:intersectionOf ( rss:Situation
                                                                    dul:Collection
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty rss:hasMemberSituation ;
                                               owl:someValuesFrom [ rdf:type owl:Class ;
                                                                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty rss:hasNextSituation ;
                                                                                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                    owl:onClass rss:Situation
                                                                                  ]
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty rss:hasPreviousSituation ;
                                                                                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                    owl:onClass rss:Situation
                                                                                  ]
                                                                                )
                                                                  ]
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty rss:hasTimePeriod ;
                                               owl:someValuesFrom rss:TimePeriod
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty rss:hasUnifyingFactor ;
                                               owl:someValuesFrom dul:Description
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty dul:satisfies ;
                                               owl:someValuesFrom dul:Description
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty rss:hasMemberSituation ;
                                               owl:allValuesFrom rss:Situation
                                             ] ;
                             rdfs:comment "Recurrent situation series is modeled as an intersection of the classes Collection and Situation. Indeed, a recurrent situation is seen as a collection, since it contains entities that share one or more common properties and are unified conceptually. These entities are member of the collection, and are all consecutive situations, in such a manner that each situation has either a previous situation, or a next situation, or both, unless the series has never been instantiated. At the same time, a recurrent situation is a situation, intended as a relational context in which the contextualized things are based on a frame: a recurrent situation is similar to a plan that defines how the things involved in that plan (i.e. the specific situations) shall be carried out, e.g. where the situations shall be located, in which time of the year, etc."@en ;
                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                             rdfs:label "Recurrent Situation Series"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#Situation
rss:Situation rdf:type owl:Class ;
              rdfs:subClassOf d0:Eventuality ;
              rdfs:comment "This class represents a Situation."@en ;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
              rdfs:label "Situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#TimePeriod
rss:TimePeriod rdf:type owl:Class ;
               rdfs:comment "This class represents a Time Period (e.g. 1 week)."@en ;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
               rdfs:label "Time Period"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl#UnifyingSituation
rss:UnifyingSituation rdf:type owl:Class ;
                      rdfs:subClassOf rss:Situation ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty rss:involvesUnifyingFactor ;
                                        owl:someValuesFrom owl:Thing
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty rss:isValidIn ;
                                        owl:someValuesFrom dul:TimeInterval
                                      ] ;
                      rdfs:comment "A Unifying Situation is a situation involving a unifying factor, i.e. a concept classifying an element or property occurring in each situation member of a recurrent situation series, which unifies the collection and makes all the situations attributable to a homogeneous collection, and is valid at a specific time interval."@en ;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/recurrentsituationseries.owl> ;
                      rdfs:label "Unifying Situation"@en .


