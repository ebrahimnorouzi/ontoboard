#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000039
ns2:IAO_0000039 rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:label "has measurement unit label"@en .


###  http://purl.obolibrary.org/obo/OBI_0001927
ns2:OBI_0001927 rdf:type owl:ObjectProperty ;
                ns2:IAO_0000115 "A relation between a value specification and an entity which the specification is about."@en ;
                rdfs:label "specifies value of" .


###  http://purl.obolibrary.org/obo/RO_0000086
ns2:RO_0000086 rdf:type owl:ObjectProperty ;
               rdfs:range ns2:BFO_0000019 ;
               ns2:IAO_0000112 "this apple has quality this red color"@en ;
               ns2:IAO_0000115 "a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence"@en ;
               ns2:IAO_0000116 "A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist."@en ;
               rdfs:label "has quality"@en .


###  https://w3id.org/pmd/co/PMD_0025999
:PMD_0025999 rdf:type owl:ObjectProperty ;
             ns2:IAO_0000116 """The 'relational quality of' is more strict that 'quality of' from RO, since domain is 'relational quality'. The motivtion to introduce an object property for relational qualities is the following:
RO's 'quality of' is functional i.e., a->b, a->c => b=c. The functionality is relevant for most of the SDC -> IC triples, expect for relational qualities, which per definiton can be simultaneously inherited in >=2 ICs. Thus,  'relational quality of'  has the same intention to connect SDC to IC, however, without cardinality constraints."""@en ;
             rdfs:label "relational property of"@en ;
             skos:definition "a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ,
                             "eine Beziehung zwischen einer relationalen Qualität und einem unabhängigen Kontinuum (dem Träger), bei der die Existenz der Qualität speziell vom Träger abhängt"@de ;
             skos:prefLabel "relationale Eigenschaft von"@de .


#################################################################
#    Data properties
#################################################################

###  http://purl.obolibrary.org/obo/OBI_0001937
ns2:OBI_0001937 rdf:type owl:DatatypeProperty ;
                ns2:IAO_0000115 "A relation between a value specification and a number that quantifies it."@en ;
                ns2:IAO_0000116 "A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning." ;
                rdfs:label "has specified numeric value" .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000019
ns2:BFO_0000019 rdf:type owl:Class ;
                rdfs:label "quality"@en ;
                skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en .


###  http://purl.obolibrary.org/obo/BFO_0000030
ns2:BFO_0000030 rdf:type owl:Class ;
                rdfs:subClassOf ns2:BFO_0000040 ;
                rdfs:label "object"@en ;
                skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
ns2:BFO_0000040 rdf:type owl:Class ;
                ns2:IAO_0000115 "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
                ns2:IAO_0000116 "Elucidation: An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
                rdfs:label "material entity"@en ;
                skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .


###  http://purl.obolibrary.org/obo/BFO_0000145
ns2:BFO_0000145 rdf:type owl:Class ;
                rdfs:subClassOf ns2:BFO_0000019 ;
                rdfs:label "relational quality"@en ;
                skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en .


###  http://purl.obolibrary.org/obo/OBI_0001931
ns2:OBI_0001931 rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty ns2:IAO_0000039 ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns2:OBI_0001937 ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                ns2:IAO_0000115 "A value specification that consists of two parts: a numeral and a unit label"@en ;
                rdfs:label "scalar value specification" .


###  http://purl.obolibrary.org/obo/UO_0000163
ns2:UO_0000163 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( ns2:UO_0000163
                                               )
                                   ] ;
               rdfs:subClassOf ns2:UO_1000163 .


###  http://purl.obolibrary.org/obo/UO_1000163
ns2:UO_1000163 rdf:type owl:Class ;
               rdfs:label "mass percentage based unit" .


###  https://w3id.org/pmd/co/PMD_0020026
:PMD_0020026 rdf:type owl:Class ;
             rdfs:subClassOf :PMD_0020140 ;
             rdfs:comment "A Portion Of Matter that consists of only Iron atoms."@en ;
             rdfs:label "portion of iron"@en ;
             skos:definition "A 'portion of iron' is a 'Poriton Of Pure Substance' that 'consists of' only chebi:iron atom."@en .


###  https://w3id.org/pmd/co/PMD_0020102
:PMD_0020102 rdf:type owl:Class ;
             rdfs:label "mass fraction"@en ;
             skos:definition "a relational quality expressing a mass of a part in relation to the the mass of the whole"@en .


###  https://w3id.org/pmd/co/PMD_0020140
:PMD_0020140 rdf:type owl:Class ;
             rdfs:subClassOf ns2:BFO_0000040 ;
             rdfs:label "portion of pure chemical element"@en ;
             skos:definition "A portion of pure chemical element is a pure substance composed of multiple atoms, which are all of the same kind."@en .


###  https://w3id.org/pmd/co/PMD_0025997
:PMD_0025997 rdf:type owl:Class ;
             rdfs:subClassOf ns2:OBI_0001931 ;
             rdfs:label "concentration value specification"@en ;
             skos:definition "a value specification that contains information about quantitative share of a part relative to a specified whole."@en .


