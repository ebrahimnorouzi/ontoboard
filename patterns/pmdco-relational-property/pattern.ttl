ns2:UO_0000163 rdfs:label "mass percentage" ;
               ns2:IAO_0000115 "A dimensionless concentration unit which denotes the mass of a substance in a mixture as a percentage of the mass of the entire mixture." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns2:UO_0000163 ;
   owl:annotatedProperty ns2:IAO_0000115 ;
   owl:annotatedTarget "A dimensionless concentration unit which denotes the mass of a substance in a mixture as a percentage of the mass of the entire mixture." ;
   ns1:hasDbXref "Wikipedia:Wikipedia"
 ] .


