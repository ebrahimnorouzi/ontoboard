<rdf:RDF xmlns="https://w3id.org/pmd/co/"
     xml:base="https://w3id.org/pmd/co/"
     xmlns:ns1="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ns2="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ontoboard.org/patterns/pmdco-relational-property.owl">
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relational qualities hold between two or more entities rather than inhering in one. The example is a mass proportion relating a portion of iron to a metal sheet with a magnitude of 97.7 mass-%, expressed through a fraction value specification.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relational property</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x1; label added x9; term declared x4;
- header: dcterms:title &quot;Relational property&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- header: dcterms:license &lt;https://creativecommons.org/licenses/by/4.0/&gt; - https://github.com/materialdigital/core-ontology
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </owl:Ontology>
    


