# The saxophone collection from the pattern's own scenario. The members are plain
# individuals, because this pattern ranges hasMember over owl:Thing: domain
# membership, not set theory, so anything at all can be collected.

@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/collectionentity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MySaxophoneCollection a owl:NamedIndividual , collectionentity:Collection ;
    rdfs:label "my saxophone collection" ;
    collectionentity:hasMember ex:MarkVITenor ,
        ex:BalancedActionAlto ,
        ex:ConnTransitionalBari .

ex:MarkVITenor a owl:NamedIndividual ;
    rdfs:label "Selmer Mark VI tenor saxophone, serial 84371" .

ex:BalancedActionAlto a owl:NamedIndividual ;
    rdfs:label "Selmer Balanced Action alto saxophone, 1939" .

ex:ConnTransitionalBari a owl:NamedIndividual ;
    rdfs:label "Conn Transitional baritone saxophone, 1930" .

# Only one direction of each inverse pair is asserted: hasMember/isMemberOf. A reasoner adds the other.

