@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/resourceabundanceobservation.owl#> .
@prefix obs: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/resourceabundanceobservation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/resourceabundanceobservation.owl> rdf:type owl:Ontology ;
                                                                                       owl:imports <http://www.ontologydesignpatterns.org/cp/owl/observation.owl> ,
                                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> ,
                                                                                                   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                                       dcterms:description "The intent of the pattern is to be able to represent observations of aquatic resources, where the observations have been made a certain year and has certain other parameters."^^xsd:string ;
                                                                                       dcterms:title "Resourceabundanceobservation Pattern"^^xsd:string ;
                                                                                       cpannotationschema:coversRequirements "What resource is observed? For what year and at what abundance level?" ;
                                                                                       cpannotationschema:hasConsequences "The patterns states that for each instance of the resource observation all parameters exist, this does not however mean that they are necessarily present in the knowledge base. Any dependencies between parameters have not been taken intor account, there are no formal restrictions on the combination possible. The parameters are intended to have a fixed set of values (to be defined as nominals) but this is not explicit in the pattern." ;
                                                                                       cpannotationschema:hasIntent "The intent of the pattern is to be able to represent observations of aquatic resources, where the observations have been made a certain year and has certain other parameters."^^xsd:string ;
                                                                                       cpannotationschema:hasUnitTest """SELECT ?x WHERE {?x a :AquaticResourceObservation.  ?x :hasReferenceYear \"2004\"^^xsd:gYear}
SELECT ?x WHERE {?x a :AquaticResourceObservation.  ?x :hasAbundanceLevel :LowAbundance}""" ;
                                                                                       cpannotationschema:scenarios """Give me the resource observations for the year 2004
Give me the resource observations where the abundance level is 'Low abundance'""" ;
                                                                                       rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x15; term declared x15;
- header: dcterms:title \"Resourceabundanceobservation Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: only pattern.ttl said Declaration(Datatype(xsd:gYear)) - not kept: pattern.owl is what an import copies
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                                       owl:versionInfo "1.0" .

#################################################################
