# The pattern on the pattern's own query: a resource observation for the year 2004 whose abundance
# level is 'Low abundance'. The resource is the Northeast Arctic cod stock, the species is Gadus
# morhua, and beside it stands the survey observation it rests on - made by an ICES working group,
# over the Barents Sea, with a spawning-stock biomass figure as its result.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix resourceabundanceobservation: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/resourceabundanceobservation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/resourceabundanceobservation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:CodAbundance2004 a owl:NamedIndividual , resourceabundanceobservation:ResourceAbundanceObservation ;
    rdfs:label "the 2004 abundance observation of the Northeast Arctic cod stock" ;
    resourceabundanceobservation:hasAbundanceLevel ex:LowAbundance ;
    resourceabundanceobservation:hasReferenceYear "2004"^^xsd:gYear ;
    resourceabundanceobservation:hasResource ex:NortheastArcticCodStock .

ex:LowAbundance a owl:NamedIndividual , resourceabundanceobservation:AbundanceLevel ;
    rdfs:label "Low abundance" .

ex:NortheastArcticCodStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Northeast Arctic cod stock, ICES subareas 1 and 2" ;
    aquaticresources:hasSpecies ex:GadusMorhua .

ex:GadusMorhua a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic cod, Gadus morhua" .

ex:BarentsSeaWinterSurvey2004 a owl:NamedIndividual , observation:Observation ;
    rdfs:label "the winter acoustic survey of the Barents Sea, February 2004" ;
    observation:hasFeatureOfInterest ex:BarentsSea ;
    observation:hasResult ex:SpawningStockBiomass2004 ;
    observation:madeBy ex:ArcticFisheriesWorkingGroup .

ex:BarentsSea a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the Barents Sea, the water body surveyed" .

ex:SpawningStockBiomass2004 a owl:NamedIndividual , observation:Result ;
    rdfs:label "spawning-stock biomass for 2004, below the precautionary level" .

ex:ArcticFisheriesWorkingGroup a owl:NamedIndividual , observation:Observer ;
    rdfs:label "the ICES Arctic Fisheries Working Group" .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, hasAbundanceLevel/isAbundanceLevelOf, hasResource/isResourceOf, hasSpecies/isSpeciesPresentIn. A reasoner adds the other.
