# The Policy pattern on a real digital-preservation rule: a national library's archive must keep
# three checksummed copies of every born-digital work. A subpolicy covers file format migration,
# and the nightly fixity audit is both the process that implements the rule and the one that
# validates compliance with it.

@prefix policyodp: <http://mklab.iti.gr/pericles/Policy_ODP#> .
@prefix ex:        <https://w3id.org/ontoboard/example/policy#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .

ex:ThreeCopyRetentionPolicy a owl:NamedIndividual , policyodp:Policy ;
    rdfs:label "Three-copy retention policy for born-digital works" ;
    policyodp:hasAutomationStatus ex:AutomatedWithHumanValidation ;
    policyodp:hasImplementationStatus ex:PartiallyImplemented ;
    policyodp:hasLanguage ex:EnglishProse ;
    policyodp:hasPolicyType ex:MandatoryLegalRequirement ;
    policyodp:hasRequirementLevel ex:MustLevel ;
    policyodp:hasStatement ex:ThreeCopyStatement ;
    policyodp:hasSubPolicy ex:FileFormatMigrationPolicy ;
    policyodp:hasValidationProcess ex:NightlyFixityAudit ;
    policyodp:implementedBy ex:NightlyFixityAudit .

ex:FileFormatMigrationPolicy a owl:NamedIndividual , policyodp:Policy ;
    rdfs:label "File format migration policy: TIFF masters reviewed every five years" .

ex:ThreeCopyStatement a owl:NamedIndividual , policyodp:Statement ;
    rdfs:label "Every accessioned work is held as three checksummed copies, on two media types, one of them off-site." .

ex:NightlyFixityAudit a owl:NamedIndividual , policyodp:Process ;
    rdfs:label "Nightly fixity audit of the three replicas" .

ex:EnglishProse a owl:NamedIndividual , policyodp:Language ;
    rdfs:label "English prose (non-formal policy text)" .

ex:MandatoryLegalRequirement a owl:NamedIndividual , policyodp:PolicyType ;
    rdfs:label "Mandatory, under the legal deposit regulations" .

ex:MustLevel a owl:NamedIndividual , policyodp:RequirementLevel ;
    rdfs:label "MUST (RFC 2119)" .

ex:PartiallyImplemented a owl:NamedIndividual , policyodp:ImplementationStatus ;
    rdfs:label "Partially implemented: the off-site copy is still pending" .

ex:AutomatedWithHumanValidation a owl:NamedIndividual , policyodp:AutomationStatus ;
    rdfs:label "Automated, with human validation of the audit report" .
