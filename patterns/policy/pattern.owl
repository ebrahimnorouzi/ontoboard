        <rdfs:range rdf:resource="http://mklab.iti.gr/pericles/Policy_ODP#Policy"/>
        <rdfs:comment>Associates a policy to another policy that is contained in the initial.</rdfs:comment>
        <rdfs:label>has subpolicy</rdfs:label>
    </owl:ObjectProperty>
    


