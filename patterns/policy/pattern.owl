        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
        <rdfs:comment>Associates a policy to the user community the policy has been designed for.</rdfs:comment>
        <rdfs:label>targets users</rdfs:label>
    </owl:ObjectProperty>
    


