# The price pattern in use: the shelf price of a paperback in a Berlin bookshop. The price is
# an entity in its own right - it carries the amount, and it points at the currency the amount
# is expressed in, so the same book can be priced again in another currency without the number
# losing its meaning.

@prefix price: <http://www.ontologydesignpatterns.org/cp/owl/price.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/price#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ShelfPriceOfThePaperback a owl:NamedIndividual , price:Price ;
    rdfs:label "EUR 18.99, the shelf price of the paperback edition" ;
    price:hasCurrency ex:Euro ;
    price:hasValue "18.99"^^xsd:float .

ex:Euro a owl:NamedIndividual , price:Currency ;
    rdfs:label "the euro (EUR)" .

# Only one direction of each inverse pair is asserted: hasPrice/isPriceOf. A reasoner adds the other.
