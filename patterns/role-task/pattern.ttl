#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#hasTask
taskrole:hasTask rdf:type owl:ObjectProperty ;
                 owl:inverseOf taskrole:isTaskOf ;
                 rdfs:domain taskrole:Role ;
                 rdfs:range taskrole:Task ;
                 rdfs:comment "A relation between roles and tasks, e.g. 'students have the duty of giving exams' (i.e. the Role 'student' hasTask the Task 'giving exams')."^^xsd:string ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> ;
                 rdfs:label "has target"@en ;
                 skos:prefLabel "ha come obiettivo"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#isTaskOf
taskrole:isTaskOf rdf:type owl:ObjectProperty ;
                  rdfs:domain taskrole:Task ;
                  rdfs:range taskrole:Role ;
                  rdfs:comment "A relation between roles and tasks, e.g. 'students have the duty of giving exams' (i.e. the Role 'student' hasTask the Task 'giving exams')." ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> ;
                  rdfs:label "is a target for"@en ;
                  skos:prefLabel "è un obiettivo per"@it .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Role
taskrole:Role rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty taskrole:hasTask ;
                                owl:allValuesFrom taskrole:Task
                              ] ;
              owl:disjointWith taskrole:Task ;
              rdfs:comment "A concept that classifies an object. For example, the role developer classifies a person, the role server classifies a computer machine.  A hasTask only Tasks."^^xsd:string ;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> ;
              rdfs:label "Role"@en ;
              skos:prefLabel "Ruolo"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Task
taskrole:Task rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty taskrole:isTaskOf ;
                                owl:allValuesFrom taskrole:Role
                              ] ;
              rdfs:comment "A piece of work to be done or undertaken. A Task is assigned to only Roles through the property isTaskOf."^^xsd:string ;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> ;
              rdfs:label "Task"@en ;
              skos:prefLabel "Task"@it .


