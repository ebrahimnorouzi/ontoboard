@base <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl> rdf:type owl:Ontology ;
                                                             owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                             dcterms:description "To represent the assignment of tasks to roles"^^xsd:string ;
                                                             dcterms:title "Role Task Pattern"^^xsd:string ;
                                                             cpannotationschema:coversRequirements "What roles are this task of?, What tasks do have this role?" ;
                                                             cpannotationschema:extractedFrom "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl" ;
                                                             cpannotationschema:hasConsequences "This pattern allows to put roles in the domain of discourse. It does not allow to model time indexed task assignement." ;
                                                             cpannotationschema:hasIntent "To represent the assignment of tasks to roles"^^xsd:string ;
                                                             cpannotationschema:relatedCPs "This CP is typically composed with the http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl CP, or http://www.ontologydesignpatterns.org/cp/owl/timeindexedpersonrole.owl CP. It is a component of the http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl CP" ;
                                                             cpannotationschema:scenarios "students have the duty of giving exams" ;
                                                             rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x4; label moved to skos:altLabel x1; label added x10; term declared x4;
- header: dcterms:title \"Role Task Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                          """The task role pattern. 
This pattern is extracted from DOLCE-UltraLite by partial clone of elements.""" ;
                                                             rdfs:label "task role" ;
                                                             owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                             "Created by Valentina Presutti"^^xsd:string ;
                                                             skos:altLabel "role task"^^xsd:string .

