<http://www.ontologydesignpatterns.org/cp/owl/partof.owl> rdf:type owl:Ontology ;
                                                           dcterms:description "Models mereological part-whole relationships. A whole entity has parts, and parts are components of a whole."^^xsd:string ;
                                                           dcterms:title "Part-Of Pattern"^^xsd:string ;
                                                           rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x2; term declared x2;
- header: dcterms:title \"Part-Of Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                        "Models mereological part-whole relationships. A whole entity has parts, and parts are components of a whole."^^xsd:string ;
                                                           rdfs:label "Part-Of Pattern"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Whole ;
         rdfs:range :Part ;
         rdfs:label "hasPart" .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Part ;
          rdfs:range :Whole ;
          rdfs:label "isPartOf" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Part
:Part rdf:type owl:Class ;
      rdfs:label "Part" .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Whole
:Whole rdf:type owl:Class ;
       rdfs:label "Whole" .


