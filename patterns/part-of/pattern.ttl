@prefix : <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/partof.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/partof.owl> rdf:type owl:Ontology ;
                                                           rdfs:comment "Models mereological part-whole relationships. A whole entity has parts, and parts are components of a whole." ;
                                                           rdfs:label "Part-Of Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :Whole ;
         rdfs:range :Part ;
         rdfs:label "hasPart" .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Part ;
          rdfs:range :Whole ;
          rdfs:label "isPartOf" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Part
:Part rdf:type owl:Class ;
      rdfs:label "Part" .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Whole
:Whole rdf:type owl:Class ;
       rdfs:label "Whole" .


