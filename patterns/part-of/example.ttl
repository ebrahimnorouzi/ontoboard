# Three wholes and their parts: a wheel and an engine in a car, a chapter in a book,
# and the liver in an organism. The pattern declares hasPart and isPartOf separately
# rather than as an inverse pair, so each pair is stated in both directions.

@prefix partof: <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/part-of#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Car a owl:NamedIndividual , partof:Whole ;
    rdfs:label "a Volkswagen Golf" ;
    partof:hasPart ex:FrontLeftWheel , ex:Engine .

ex:FrontLeftWheel a owl:NamedIndividual , partof:Part ;
    rdfs:label "its front left wheel" ;
    partof:isPartOf ex:Car .

ex:Engine a owl:NamedIndividual , partof:Part ;
    rdfs:label "its 1.5-litre petrol engine" ;
    partof:isPartOf ex:Car .

ex:Book a owl:NamedIndividual , partof:Whole ;
    rdfs:label "a printed copy of Moby-Dick" ;
    partof:hasPart ex:ChapterThree .

ex:ChapterThree a owl:NamedIndividual , partof:Part ;
    rdfs:label "chapter 3, The Spouter-Inn" ;
    partof:isPartOf ex:Book .

ex:HumanOrganism a owl:NamedIndividual , partof:Whole ;
    rdfs:label "an adult human organism" ;
    partof:hasPart ex:Liver .

ex:Liver a owl:NamedIndividual , partof:Part ;
    rdfs:label "its liver" ;
    partof:isPartOf ex:HumanOrganism .
