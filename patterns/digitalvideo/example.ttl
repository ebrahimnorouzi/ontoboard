# One real file taken apart: a 22-minute documentary episode digitised from a PAL
# broadcast master, wrapped in MP4, carrying an H.264 video stream, a German audio
# track, subtitles and a timecode stream. Every leaf is a value a technical
# metadata record for such a file actually carries.

@prefix digitalvideoodp: <http://mklab.iti.gr/pericles/DigitalVideo_ODP#> .
@prefix ex: <https://w3id.org/ontoboard/example/digitalvideo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PAL a owl:NamedIndividual , digitalvideoodp:AnalogBroadcastStandard ;
    rdfs:label "PAL, the analogue standard of the source tape" .

ex:SixteenByNine a owl:NamedIndividual , digitalvideoodp:AspectRatio ;
    rdfs:label "16:9" .

ex:GermanStereoTrack a owl:NamedIndividual , digitalvideoodp:AudioStream ;
    rdfs:label "the German stereo audio track at 256 kbit/s" .

ex:Chroma420 a owl:NamedIndividual , digitalvideoodp:ChromaFormat ;
    rdfs:label "4:2:0 chroma subsampling" .

ex:QuickTimeTimecodeCodec a owl:NamedIndividual , digitalvideoodp:Codec ;
    rdfs:label "the QuickTime timecode codec" .

ex:YCbCr a owl:NamedIndividual , digitalvideoodp:ColourSpaceType ;
    rdfs:label "Y'CbCr" .

ex:Mp4Container a owl:NamedIndividual , digitalvideoodp:Container ;
    rdfs:label "the MP4 container the file is wrapped in" .

ex:DocumentaryEpisode3 a owl:NamedIndividual , digitalvideoodp:DigitalVideo ;
    rdfs:label "episode 3 of the documentary series, 22 minutes long" ;
    digitalvideoodp:hasAnalogBroadcastStandard ex:PAL ;
    digitalvideoodp:hasAudioStream ex:GermanStereoTrack ;
    digitalvideoodp:hasStream ex:TimecodeStream ;
    digitalvideoodp:hasSubtitleStream ex:GermanSubtitleStream ;
    digitalvideoodp:hasVideoStream ex:HdVideoStream ;
    digitalvideoodp:wrappedBy ex:Mp4Container .

ex:ClosedCaptions a owl:NamedIndividual , digitalvideoodp:EmbeddingType ;
    rdfs:label "closed captions, selectable rather than burnt in" .

ex:TwentyFiveFps a owl:NamedIndividual , digitalvideoodp:FrameRate ;
    rdfs:label "25 frames per second" .

ex:FullHd1080 a owl:NamedIndividual , digitalvideoodp:FrameSize ;
    rdfs:label "1920 x 1080 pixels" .

ex:BroadcastRange a owl:NamedIndividual , digitalvideoodp:RangeType ;
    rdfs:label "limited, broadcast-legal range" .

ex:ProgressiveScan a owl:NamedIndividual , digitalvideoodp:ScanType ;
    rdfs:label "progressive scan" .

ex:Bt709Standards a owl:NamedIndividual , digitalvideoodp:SetOfStandards ;
    rdfs:label "the ITU-R BT.709 standards for HD video" .

ex:TimecodeStream a owl:NamedIndividual , digitalvideoodp:Stream ;
    rdfs:label "the timecode stream copied from the broadcast master" ;
    digitalvideoodp:processedBy ex:QuickTimeTimecodeCodec .

ex:GermanSubtitleStream a owl:NamedIndividual , digitalvideoodp:SubtitleStream ;
    rdfs:label "the German subtitle stream" ;
    digitalvideoodp:hasEmbeddingType ex:ClosedCaptions ;
    digitalvideoodp:hasSubtitleTextFormat ex:SubRip .

ex:SubRip a owl:NamedIndividual , digitalvideoodp:SubtitleTextFormat ;
    rdfs:label "SubRip (.srt) text format" .

ex:H264Codec a owl:NamedIndividual , digitalvideoodp:VideoCodec ;
    rdfs:label "the H.264 / MPEG-4 AVC video codec" ;
    digitalvideoodp:hasVideoCodecLevel ex:Level40 ;
    digitalvideoodp:hasVideoCodecProfile ex:HighProfile .

ex:Level40 a owl:NamedIndividual , digitalvideoodp:VideoCodecLevel ;
    rdfs:label "Level 4.0" .

ex:HighProfile a owl:NamedIndividual , digitalvideoodp:VideoCodecProfile ;
    rdfs:label "High Profile" .

ex:MeasuredPsnr a owl:NamedIndividual , digitalvideoodp:VideoQualityMeasurement ;
    rdfs:label "a measured 42.1 dB on the encoded master" .

ex:Psnr a owl:NamedIndividual , digitalvideoodp:VideoQualityMetric ;
    rdfs:label "peak signal-to-noise ratio (PSNR)" .

ex:HdVideoStream a owl:NamedIndividual , digitalvideoodp:VideoStream ;
    rdfs:label "the 1080p video stream" ;
    digitalvideoodp:hasAspectRatio ex:SixteenByNine ;
    digitalvideoodp:hasChromaFormat ex:Chroma420 ;
    digitalvideoodp:hasColourSpaceType ex:YCbCr ;
    digitalvideoodp:hasFrameRate ex:TwentyFiveFps ;
    digitalvideoodp:hasFrameSize ex:FullHd1080 ;
    digitalvideoodp:hasRangeType ex:BroadcastRange ;
    digitalvideoodp:hasScanType ex:ProgressiveScan ;
    digitalvideoodp:hasSetOfStandards ex:Bt709Standards ;
    digitalvideoodp:hasVideoQualityMeasurement ex:MeasuredPsnr ;
    digitalvideoodp:hasVideoQualityMetric ex:Psnr ;
    digitalvideoodp:hasYUVSampleRange ex:Range16To235 .

ex:Range16To235 a owl:NamedIndividual , digitalvideoodp:YUVSampleRange ;
    rdfs:label "luma samples from 16 to 235" .
