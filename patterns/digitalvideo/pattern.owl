            <rdf:Description rdf:about="http://mklab.iti.gr/pericles/DigitalVideo_ODP#SubtitleStream"/>
            <rdf:Description rdf:about="http://mklab.iti.gr/pericles/DigitalVideo_ODP#VideoStream"/>
        </owl:members>
    </rdf:Description>
