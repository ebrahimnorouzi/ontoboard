# One invoice for a steel-plate delivery, with everything the pattern hangs off it:
# the order it refers to, its two line items, the buying and the selling it records,
# the euro it is priced in, the net and tax totals, and the signed PDF it is grounded in.

@prefix invoice: <http://www.ontologydesignpatterns.org/cp/invoice.owl#> .
@prefix ns1: <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/invoice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Invoice20260417 a owl:NamedIndividual , ns1:Invoice ;
    rdfs:label "invoice 2026-0417, from the rolling mill to the frame workshop" ;
    ns1:ID "2026-0417" ;
    ns1:InvoiceCurrencyType ex:Euro ;
    ns1:LineItemCountQuantity "2"^^xsd:int ;
    ns1:PricingCurrencyType ex:Euro ;
    ns1:ReferencedOrder ex:PlatePurchaseOrder ;
    ns1:TaxCurrencyType ex:Euro ;
    ns1:buyerTransaction ex:BuyingTheSteelPlate ;
    ns1:context ex:QuarterlySupplyAgreement ;
    ns1:grounding ex:SignedInvoicePdf ;
    ns1:legalTotals ex:NetTotalPayable ;
    ns1:lineItem ex:PlateLine , ex:DeliveryLine ;
    ns1:sellerTransaction ex:SellingTheSteelPlate ;
    ns1:subText ex:PlateLineNetAmount ;
    ns1:taxTotal ex:VatAtTwentyTwoPercent .

ex:Euro a owl:NamedIndividual , ns1:CurrencyMeasure ;
    rdfs:label "euro, EUR" .

ex:PlatePurchaseOrder a owl:NamedIndividual , ns1:Order ;
    rdfs:label "purchase order PO-5512 for hot-rolled steel plate" .

ex:PlateLine a owl:NamedIndividual , ns1:LineItem ;
    rdfs:label "line 1: 12 sheets of S235JR plate, 2000 x 1000 x 6 mm, at 345.00 each" .

ex:DeliveryLine a owl:NamedIndividual , ns1:LineItem ;
    rdfs:label "line 2: delivery to the workshop goods entrance, 240.00" .

ex:BuyingTheSteelPlate a owl:NamedIndividual , ns1:Buying ;
    rdfs:label "the workshop buying the plate" .

ex:SellingTheSteelPlate a owl:NamedIndividual , ns1:Selling ;
    rdfs:label "the rolling mill selling the plate" .

ex:QuarterlySupplyAgreement a owl:NamedIndividual , ns1:Context ;
    rdfs:label "the quarterly supply agreement this delivery falls under" .

ex:SignedInvoicePdf a owl:NamedIndividual , ns1:Grounding ;
    rdfs:label "the countersigned PDF invoice filed for the tax year" .

ex:NetTotalPayable a owl:NamedIndividual , ns1:LegalTotals ;
    rdfs:label "net total payable: 4,380.00 EUR" .

ex:VatAtTwentyTwoPercent a owl:NamedIndividual , ns1:TaxTotal ;
    rdfs:label "VAT at 22 per cent: 963.60 EUR" .

ex:PlateLineNetAmount a owl:NamedIndividual , ns1:TransactionAmount ;
    rdfs:label "net amount of the plate line: 4,140.00 EUR" .

