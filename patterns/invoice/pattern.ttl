@base <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> rdf:type owl:Ontology ;
                                                            owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What are the transactions involved in this invoice? What is the order this invoice is referring to? What is the line item for this invoice? What is the amount of the transactions involved in this invoice? What currency is applied to this invoice?" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> "http://www-neon-project.org/InvoiceReferenceOntology" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent the core attributes of an invoice" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "http://www.ontologydesignpatterns.org/cp/owl/salespurchaseordercontracts.owl" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "An invoice refers to transactions related to an ordered item for a certain amount of currency, and is grounded in a (legally valid) document." ;
                                                            owl:versionInfo "1.0"^^xsd:string ,
                                                                            "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

