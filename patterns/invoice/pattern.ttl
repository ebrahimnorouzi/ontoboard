@prefix invoice: <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#> .
@prefix invoice2: <http://www.ontologydesignpatterns.org/cp/invoice.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> rdf:type owl:Ontology ;
                                                            owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                            dcterms:description "To represent the core attributes of an invoice"^^xsd:string ;
                                                            dcterms:title "Invoice Pattern"^^xsd:string ;
                                                            cpannotationschema:coversRequirements "What are the transactions involved in this invoice? What is the order this invoice is referring to? What is the line item for this invoice? What is the amount of the transactions involved in this invoice? What currency is applied to this invoice?" ;
                                                            cpannotationschema:extractedFrom "http://www-neon-project.org/InvoiceReferenceOntology" ;
                                                            cpannotationschema:hasIntent "To represent the core attributes of an invoice"^^xsd:string ;
                                                            cpannotationschema:relatedCPs "http://www.ontologydesignpatterns.org/cp/owl/salespurchaseordercontracts.owl" ;
                                                            cpannotationschema:scenarios "An invoice refers to transactions related to an ordered item for a certain amount of currency, and is grounded in a (legally valid) document." ;
                                                            rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x36; term declared x2;
- header: dcterms:title \"Invoice Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                            owl:versionInfo "1.0" ,
                                                                            "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

