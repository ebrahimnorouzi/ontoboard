#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#ID
invoice:ID rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain invoice:Invoice ;
           rdfs:range xsd:string ;
           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
           rdfs:label "ID"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#LineItemCountQuantity
invoice:LineItemCountQuantity rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain invoice:Invoice ;
                              rdfs:range xsd:int ;
                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                              rdfs:label "line item count quantity"@en .


