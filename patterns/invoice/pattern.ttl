#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/invoice.owl#InvoiceType
invoice2:InvoiceType rdf:type owl:Class ;
                     rdfs:label "invoice type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Buying
invoice:Buying rdf:type owl:Class ;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
               rdfs:label "buying"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Context
invoice:Context rdf:type owl:Class ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                rdfs:label "context"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#CurrencyMeasure
invoice:CurrencyMeasure rdf:type owl:Class ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                        rdfs:label "currency measure"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Grounding
invoice:Grounding rdf:type owl:Class ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                  rdfs:label "grounding"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Invoice
invoice:Invoice rdf:type owl:Class ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                rdfs:label "invoice"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#LegalTotals
invoice:LegalTotals rdf:type owl:Class ;
                    rdfs:subClassOf invoice:TransactionAmount ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                    rdfs:label "legal totals"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#LineItem
invoice:LineItem rdf:type owl:Class ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                 rdfs:label "line item"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Order
invoice:Order rdf:type owl:Class ;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
              rdfs:label "order"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#Selling
invoice:Selling rdf:type owl:Class ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                rdfs:label "selling"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#TaxTotal
invoice:TaxTotal rdf:type owl:Class ;
                 rdfs:subClassOf invoice:TransactionAmount ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                 rdfs:label "tax total"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#TransactionAmount
invoice:TransactionAmount rdf:type owl:Class ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
