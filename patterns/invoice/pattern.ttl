dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom
cpannotationschema:extractedFrom rdf:type owl:AnnotationProperty ;
                                 rdfs:label "extracted from"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#InvoiceCurrencyCode
invoice:InvoiceCurrencyCode rdf:type owl:ObjectProperty ;
                            rdfs:domain invoice2:InvoiceType ;
                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                            rdfs:label "invoice currency code"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#InvoiceCurrencyType
invoice:InvoiceCurrencyType rdf:type owl:ObjectProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain invoice:Invoice ;
                            rdfs:range invoice:CurrencyMeasure ;
                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                            rdfs:label "invoice currency type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#IssueDate
invoice:IssueDate rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain invoice:Invoice ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                  rdfs:label "issue date"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#PricingCurrencyType
invoice:PricingCurrencyType rdf:type owl:ObjectProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain invoice:Invoice ;
                            rdfs:range invoice:CurrencyMeasure ;
                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                            rdfs:label "pricing currency type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#ReferencedOrder
invoice:ReferencedOrder rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain invoice:Invoice ;
                        rdfs:range invoice:Order ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                        rdfs:label "referenced order"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#TaxCurrencyType
invoice:TaxCurrencyType rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain invoice:Invoice ;
                        rdfs:range invoice:CurrencyMeasure ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                        rdfs:label "tax currency type"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#TaxPointDate
invoice:TaxPointDate rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain invoice:Invoice ;
                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                     rdfs:label "tax point date"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#buyerTransaction
invoice:buyerTransaction rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain invoice:Invoice ;
                         rdfs:range invoice:Buying ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                         rdfs:label "buyer transaction"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#context
invoice:context rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain invoice:Invoice ;
                rdfs:range invoice:Context ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                rdfs:label "context (property)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#grounding
invoice:grounding rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain invoice:Invoice ;
                  rdfs:range invoice:Grounding ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                  rdfs:label "grounding (property)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#legalTotals
invoice:legalTotals rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain invoice:Invoice ;
                    rdfs:range invoice:LegalTotals ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                    rdfs:label "legal totals (property)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#lineItem
invoice:lineItem rdf:type owl:ObjectProperty ;
                 rdfs:domain invoice:Invoice ;
                 rdfs:range invoice:LineItem ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                 rdfs:label "line item (property)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#sellerTransaction
invoice:sellerTransaction rdf:type owl:ObjectProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain invoice:Invoice ;
                          rdfs:range invoice:Selling ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                          rdfs:label "seller transaction"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#subText
invoice:subText rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain invoice:Invoice ;
                rdfs:range invoice:TransactionAmount ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                rdfs:label "sub text"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/invoice.owl#taxTotal
invoice:taxTotal rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain invoice:Invoice ;
                 rdfs:range invoice:TaxTotal ;
                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/invoice.owl> ;
                 rdfs:label "tax total (property)"@en .


