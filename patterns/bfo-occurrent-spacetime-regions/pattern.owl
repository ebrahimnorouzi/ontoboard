     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <Ontology>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Where and when an occurrent is. The spatiotemporal region a process occupies, the temporal region that region projects onto, and the temporal regions at which a continuant exists.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occurrent Spacetime Regions</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x4; term declared x4;
- header: dcterms:title &quot;Occurrent Spacetime Regions&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- header: dcterms:license &lt;https://creativecommons.org/licenses/by/4.0/&gt; - https://github.com/BFO-ontology/BFO-2020
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </Ontology>
    


