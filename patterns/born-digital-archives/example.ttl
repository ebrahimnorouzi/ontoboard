# One born-digital archive, from the fonds down to a single message, which is the
# hierarchy the pattern's competency questions ask about: a fonds has part a series, a
# series has part a file, a file has part an item. Two creators are named, one for the
# fonds and one for the file inside it.

@prefix borndigitalarchivesodp: <http://mklab.iti.gr/pericles/BornDigitalArchives_ODP#> .
@prefix ex: <https://w3id.org/ontoboard/example/born-digital-archives#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MorrisonPapers a owl:NamedIndividual , borndigitalarchivesodp:Fonds ;
    rdfs:label "the Jean Morrison papers (fonds)" ;
    borndigitalarchivesodp:hasCreator ex:JeanMorrison ;
    borndigitalarchivesodp:hasPart ex:CorrespondenceSeries .

ex:CorrespondenceSeries a owl:NamedIndividual , borndigitalarchivesodp:Series ;
    rdfs:label "correspondence, 1998-2004 (series)" ;
    borndigitalarchivesodp:hasPart ex:ElectronicMail2001 .

ex:ElectronicMail2001 a owl:NamedIndividual , borndigitalarchivesodp:File ;
    rdfs:label "electronic mail, 2001 (file)" ;
    borndigitalarchivesodp:hasCreator ex:JohnSmith ;
    borndigitalarchivesodp:hasPart ex:BudgetMessage .

ex:BudgetMessage a owl:NamedIndividual , borndigitalarchivesodp:Item ;
    rdfs:label "message \"Re: budget for the archive\", 14 March 2001 (item)" .

ex:JeanMorrison a owl:NamedIndividual , borndigitalarchivesodp:Creator ;
    rdfs:label "Jean Morrison, who accumulated the papers" .

ex:JohnSmith a owl:NamedIndividual , borndigitalarchivesodp:Creator ;
    rdfs:label "John Smith, who wrote the 2001 mail" .

