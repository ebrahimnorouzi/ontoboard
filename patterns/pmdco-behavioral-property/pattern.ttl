#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000054
ns1:BFO_0000054 rdf:type owl:ObjectProperty ;
                rdfs:range ns1:BFO_0000015 ;
                rdfs:label "has realization"@en ;
                skos:altLabel "realized in"@en ;
                skos:definition "b has realization c =Def c realizes b"@en .


###  http://purl.obolibrary.org/obo/IAO_0000039
ns1:IAO_0000039 rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:label "has measurement unit label"@en .


###  http://purl.obolibrary.org/obo/RO_0000052
ns1:RO_0000052 rdf:type owl:ObjectProperty ;
               owl:inverseOf ns1:RO_0000053 ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain ns1:BFO_0000020 ;
               ns1:IAO_0000112 "this fragility is a characteristic of this vase"@en ,
                               "this red color is a characteristic of this apple"@en ;
               ns1:IAO_0000115 "a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence."@en ;
               rdfs:comment "Note that this relation was previously called \"inheres in\", but was changed to be called \"characteristic of\" because BFO2 uses \"inheres in\" in a more restricted fashion. This relation differs from BFO2:inheres_in in two respects: (1) it does not impose a range constraint, and thus it allows qualities of processes, as well as of information entities, whereas BFO2 restricts inheres_in to only apply to independent continuants (2) it is declared functional, i.e. something can only be a characteristic of one thing." ;
               rdfs:label "characteristic of"@en .


###  http://purl.obolibrary.org/obo/RO_0000053
ns1:RO_0000053 rdf:type owl:ObjectProperty ,
                        owl:InverseFunctionalProperty ;
               rdfs:range ns1:BFO_0000020 ;
               ns1:IAO_0000112 "this apple is bearer of this red color"@en ,
                               "this vase is bearer of this fragility"@en ;
               ns1:IAO_0000115 "Inverse of characteristic_of"@en ;
               ns1:IAO_0000116 "A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist."@en ;
               rdfs:label "has characteristic"@en .


###  https://w3id.org/pmd/co/PMD_0000077
:PMD_0000077 rdf:type owl:ObjectProperty ;
             rdfs:range ns1:OBI_0001933 ;
             rdfs:label "specified by value"@en ;
             skos:definition "A relation between an entity and a value specification which is about this entity."@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.obolibrary.org/obo/OBI_0001937
ns1:OBI_0001937 rdf:type owl:DatatypeProperty ;
                rdfs:domain ns1:OBI_0001933 ;
                ns1:IAO_0000115 "A relation between a value specification and a number that quantifies it."@en ;
                ns1:IAO_0000116 "A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning." ;
                rdfs:label "has specified numeric value" .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000002
ns1:BFO_0000002 rdf:type owl:Class ;
                owl:disjointWith ns1:BFO_0000003 ;
                rdfs:label "continuant"@en ;
                skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000003
ns1:BFO_0000003 rdf:type owl:Class ;
                rdfs:label "occurrent"@en ;
                skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
ns1:BFO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf ns1:BFO_0000003 ;
                rdfs:label "process"@en ;
                skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
ns1:BFO_0000020 rdf:type owl:Class ;
                rdfs:subClassOf ns1:BFO_0000002 ;
                rdfs:label "specifically dependent continuant"@en ;
                skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en .


###  http://purl.obolibrary.org/obo/OBI_0001931
ns1:OBI_0001931 rdf:type owl:Class ;
                rdfs:subClassOf ns1:OBI_0001933 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:IAO_0000039 ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:OBI_0001937 ;
                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                ns1:IAO_0000115 "A value specification that consists of two parts: a numeral and a unit label"@en ;
                rdfs:label "scalar value specification" .


###  http://purl.obolibrary.org/obo/OBI_0001933
ns1:OBI_0001933 rdf:type owl:Class ;
                rdfs:subClassOf ns1:BFO_0000002 ;
                ns1:IAO_0000112 "The value of 'positive' in a classification scheme of \"positive or negative\"; the value of '20g' on the quantitative scale of mass." ;
                ns1:IAO_0000115 "An information content entity that specifies a value within a classification scheme or on a quantitative scale."@en ;
                ns1:IAO_0000116 "This term is currently a descendant of 'information content entity', which requires that it 'is about' something. A value specification of '20g' for a measurement data item of the mass of a particular mouse 'is about' the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change 'value specification' to remove the 'is about' requirement." ;
                rdfs:label "value specification" .


###  https://w3id.org/pmd/co/PMD_0000005
:PMD_0000005 rdf:type owl:Class ;
             rdfs:subClassOf :PMD_0020353 ,
                             :PMD_0023004 ;
             rdfs:comment """A property is a material trait in terms of the kind and magnitude of response to a specific imposed stimulus. Generally, definitions of properties are made independent of material shape and size.
(Callister, W.D., Rethwisch, D.G., Materials Science and Engineering, Wiley, 2014)

Technical materials are complex aggregates. Many properties that are determined for those aggregates are intrinsically associated with the methodologies employed in the measurement process. This is in contrast to typical 'physical' properties, which like e.g. mass that can be determined to high accuracy independently of the measurement process. 
As a consequence, material properties in the ontology are differeciated according to their measurement method, e.g. Brinell hardness and Vickers hardness are different types of indentation hardness rather than different measures/quantification (GDC) of the materials property 'indentation hardness'.
 The 'unit idenifieres' of such properties (e.g. \"HV1\", \"HV10\", \"HBW\") are strictly speaking not units but rather references to the measurement methodology used to determine a numeric value that quantifies the property.

Extensive properties that depend on the object being tested rather than on the portion of matter are (extensive) object- or system-properties."""@en ;
             rdfs:label "material performance property"@en ;
             skos:definition "a disposition of a portion of matter that is realized in a compatible process and whose realization is grounded in the portions intensive qualities"@en ;
             skos:prefLabel "Materialeigenschaft"@de .


###  https://w3id.org/pmd/co/PMD_0000522
:PMD_0000522 rdf:type owl:Class ;
             rdfs:subClassOf ns1:BFO_0000015 ;
             rdfs:label "mechanical process"@en ;
             skos:definition "is a process in which forces, moments, or imposed displacements to objects or object aggregates occur and/or the equivalent (stresses, strains) to materials or portions of matter"@en ,
                             "ist ein Prozess, bei dem Kräfte, Momente oder auferlegte Verschiebungen auf Objekte oder Objektaggregate und/oder das Äquivalent (Spannungen, Dehnungen) auf Materialien oder Teile der Materie auftreten"@de ;
             skos:prefLabel "mechanischer Prozess"@de .


###  https://w3id.org/pmd/co/PMD_0000639
:PMD_0000639 rdf:type owl:Class ;
             rdfs:subClassOf ns1:BFO_0000002 ;
             rdfs:label "ferrous metal"@en ;
             skos:definition "metal that has iron as primary constituent"@en .


###  https://w3id.org/pmd/co/PMD_0000851
:PMD_0000851 rdf:type owl:Class ;
             rdfs:subClassOf :PMD_0020164 ;
             rdfs:label "melting point"@en ;
             skos:definition "Der Schmelzpunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom festen in den flüssigen Zustand (oder umgekehrt) entsteht."@de ,
                             "The melting point is a state of matter boundary realized by transition form the solid state to the liquid state (or vice versa)."@en ;
             skos:prefLabel "Schmelzpunkt"@de .


###  https://w3id.org/pmd/co/PMD_0020096
:PMD_0020096 rdf:type owl:Class ;
             rdfs:subClassOf :PMD_0000639 ;
             rdfs:label "steel"@en ;
             skos:definition "ferrous metal that consists of iron and carbon and possibly other alloying elements (and possibly impurities)"@en .


###  https://w3id.org/pmd/co/PMD_0020164
:PMD_0020164 rdf:type owl:Class ;
             rdfs:subClassOf ns1:BFO_0000020 ;
             rdfs:label "state of matter boundary"@en ;
             skos:definition "A state of matter boundary is a phase boundary that is realized by the transition from one aggregate state to another aggregate state."@en ,
                             "Eine Zustandsgrenze ist eine Phasengrenze, die durch den Übergang von einem Aggregatzustand in einen anderen Aggregatzustand realisiert wird."@de ;
             skos:prefLabel "Zustandsgrenze der Materie"@de .


###  https://w3id.org/pmd/co/PMD_0020353
:PMD_0020353 rdf:type owl:Class ;
             rdfs:subClassOf ns1:BFO_0000020 ;
             ns1:IAO_0000116 "Do not use this class directly. It will be deprecated in future releases." ;
             rdfs:label "unclassified property"@en ;
             skos:definition "a collection of to-be classifed SDCs"@en .


###  https://w3id.org/pmd/co/PMD_0023004
:PMD_0023004 rdf:type owl:Class ;
             rdfs:subClassOf ns1:BFO_0000020 ;
             rdfs:label "a portions property"@en ;
             skos:definition "a 'property by bearer' that indicates that its bearer is a portion of matter"@en .


###  https://w3id.org/pmd/co/PMD_0080171
:PMD_0080171 rdf:type owl:Class ;
             rdfs:subClassOf :PMD_0023004 ;
             rdfs:comment "The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain."@en ;
             rdfs:label "yield stress"@en ;
             skos:definition "is the stress at which the material has a non-zero plastic strain."@en ;
             skos:prefLabel "Fließgrenze"@de .


