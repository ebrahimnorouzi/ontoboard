<?xml version="1.0"?>
<rdf:RDF xmlns="https://ontoboard.org/patterns/pmdco-behavioral-property.owl#"
     xml:base="https://ontoboard.org/patterns/pmdco-behavioral-property.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://ontoboard.org/patterns/pmdco-behavioral-property.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000112 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000112"/>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000115 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115"/>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000116 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000116"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000054 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000054">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">has realization</rdfs:label>
        <rdfs:label xml:lang="en">realized in</rdfs:label>
        <skos:definition xml:lang="en">b has realization c =Def c realizes b</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000039 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000039">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has measurement unit label</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000052 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000052">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <obo:IAO_0000112 xml:lang="en">this fragility is a characteristic of this vase</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">this red color is a characteristic of this apple</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence.</obo:IAO_0000115>
        <rdfs:comment>Note that this relation was previously called &quot;inheres in&quot;, but was changed to be called &quot;characteristic of&quot; because BFO2 uses &quot;inheres in&quot; in a more restricted fashion. This relation differs from BFO2:inheres_in in two respects: (1) it does not impose a range constraint, and thus it allows qualities of processes, as well as of information entities, whereas BFO2 restricts inheres_in to only apply to independent continuants (2) it is declared functional, i.e. something can only be a characteristic of one thing.</rdfs:comment>
        <rdfs:label xml:lang="en">characteristic of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000053 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000053">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000112 xml:lang="en">this apple is bearer of this red color</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">this vase is bearer of this fragility</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">Inverse of characteristic_of</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">has characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0000077 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0000077">
        <rdfs:label xml:lang="en">specified by value</rdfs:label>
        <skos:definition xml:lang="en">A relation between an entity and a value specification which is about this entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/OBI_0001937 -->

    <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/OBI_0001937">
        <obo:IAO_0000115 xml:lang="en">A relation between a value specification and a number that quantifies it.</obo:IAO_0000115>
        <obo:IAO_0000116>A range of &apos;real&apos; might be better than &apos;float&apos;. For now we follow &apos;has measurement value&apos; until we can consider technical issues with SPARQL queries and reasoning.</obo:IAO_0000116>
        <rdfs:label>has specified numeric value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A value specification that consists of two parts: a numeral and a unit label</obo:IAO_0000115>
        <rdfs:label>scalar value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001933">
        <obo:IAO_0000112>The value of &apos;positive&apos; in a classification scheme of &quot;positive or negative&quot;; the value of &apos;20g&apos; on the quantitative scale of mass.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies a value within a classification scheme or on a quantitative scale.</obo:IAO_0000115>
        <obo:IAO_0000116>This term is currently a descendant of &apos;information content entity&apos;, which requires that it &apos;is about&apos; something. A value specification of &apos;20g&apos; for a measurement data item of the mass of a particular mouse &apos;is about&apos; the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change &apos;value specification&apos; to remove the &apos;is about&apos; requirement.</obo:IAO_0000116>
        <rdfs:label>value specification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:comment xml:lang="en">A property is a material trait in terms of the kind and magnitude of response to a specific imposed stimulus. Generally, definitions of properties are made independent of material shape and size.
(Callister, W.D., Rethwisch, D.G., Materials Science and Engineering, Wiley, 2014)

Technical materials are complex aggregates. Many properties that are determined for those aggregates are intrinsically associated with the methodologies employed in the measurement process. This is in contrast to typical &apos;physical&apos; properties, which like e.g. mass that can be determined to high accuracy independently of the measurement process. 
As a consequence, material properties in the ontology are differeciated according to their measurement method, e.g. Brinell hardness and Vickers hardness are different types of indentation hardness rather than different measures/quantification (GDC) of the materials property &apos;indentation hardness&apos;.
 The &apos;unit idenifieres&apos; of such properties (e.g. &quot;HV1&quot;, &quot;HV10&quot;, &quot;HBW&quot;) are strictly speaking not units but rather references to the measurement methodology used to determine a numeric value that quantifies the property.

Extensive properties that depend on the object being tested rather than on the portion of matter are (extensive) object- or system-properties.</rdfs:comment>
        <rdfs:label xml:lang="de">Materialeigenschaft</rdfs:label>
        <rdfs:label xml:lang="en">material performance property</rdfs:label>
        <skos:definition xml:lang="en">a disposition of a portion of matter that is realized in a compatible process and whose realization is grounded in the portions intensive qualities</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000522 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">mechanical process</rdfs:label>
        <rdfs:label xml:lang="de">mechanischer Prozess</rdfs:label>
        <skos:definition xml:lang="en">is a process in which forces, moments, or imposed displacements to objects or object aggregates occur and/or the equivalent (stresses, strains) to materials or portions of matter</skos:definition>
        <skos:definition xml:lang="de">ist ein Prozess, bei dem Kräfte, Momente oder auferlegte Verschiebungen auf Objekte oder Objektaggregate und/oder das Äquivalent (Spannungen, Dehnungen) auf Materialien oder Teile der Materie auftreten</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000639 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000639">
        <rdfs:label xml:lang="en">ferrous metal</rdfs:label>
        <skos:definition xml:lang="en">metal that has iron as primary constituent</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000851 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000851">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <rdfs:label xml:lang="de">Schmelzpunkt</rdfs:label>
        <rdfs:label xml:lang="en">melting point</rdfs:label>
        <skos:definition xml:lang="de">Der Schmelzpunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom festen in den flüssigen Zustand (oder umgekehrt) entsteht.</skos:definition>
        <skos:definition xml:lang="en">The melting point is a state of matter boundary realized by transition form the solid state to the liquid state (or vice versa).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020096 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020096">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000639"/>
        <rdfs:label xml:lang="en">steel</rdfs:label>
        <skos:definition xml:lang="en">ferrous metal that consists of iron and carbon and possibly other alloying elements (and possibly impurities)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020164 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020164">
        <rdfs:label xml:lang="de">Zustandsgrenze der Materie</rdfs:label>
        <rdfs:label xml:lang="en">state of matter boundary</rdfs:label>
        <skos:definition xml:lang="en">A state of matter boundary is a phase boundary that is realized by the transition from one aggregate state to another aggregate state.</skos:definition>
        <skos:definition xml:lang="de">Eine Zustandsgrenze ist eine Phasengrenze, die durch den Übergang von einem Aggregatzustand in einen anderen Aggregatzustand realisiert wird.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020353 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020353">
        <obo:IAO_0000116>Do not use this class directly. It will be deprecated in future releases.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">unclassified property</rdfs:label>
        <skos:definition xml:lang="en">a collection of to-be classifed SDCs</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023004">
        <rdfs:label xml:lang="en">a portions property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a portion of matter</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080171 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080171">
        <rdfs:comment xml:lang="en">The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain.</rdfs:comment>
        <rdfs:label xml:lang="de">Fließgrenze</rdfs:label>
        <rdfs:label xml:lang="en">yield stress</rdfs:label>
        <skos:definition xml:lang="en">is the stress at which the material has a non-zero plastic strain.</skos:definition>
    </owl:Class>
</rdf:RDF>



