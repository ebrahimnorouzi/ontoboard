<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/pmd/co/"
     xml:base="https://w3id.org/pmd/co/"
     xmlns:ns1="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ontoboard.org/patterns/pmdco-behavioral-property.owl">
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Behavioral material properties manifest only in specific circumstances: yield strength is the material&apos;s behavior under mechanical stress, realized in a mechanical process. The property is a specifically dependent continuant borne by the material and given a value by a scalar value specification.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Behavioral property</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x5; label moved to skos:altLabel x1; label added x9; term declared x5;
- header: dcterms:title &quot;Behavioral property&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- header: dcterms:license &lt;https://creativecommons.org/licenses/by/4.0/&gt; - https://github.com/materialdigital/core-ontology
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </owl:Ontology>
    


