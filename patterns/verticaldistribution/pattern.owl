     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:observation="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:verticaldistribution="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The intent of the pattern is to be able to represent vertical distribution for aquatic resources.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verticaldistribution Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>What resource has what vertical distribution?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasConsequences>This pattern only allows to query what vertical distribution is typical of an aquatic resource. Whereas such values can be subject to observation, another pattern based on the generic &apos;observation&apos; pattern should be used.
The vertical distribution is intended to have a fixed set of values (to be defined as nominals) but this is not explicit in the pattern.</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The intent of the pattern is to be able to represent vertical distribution for aquatic resources.</cpannotationschema:hasIntent>
        <cpannotationschema:hasUnitTest>SELECT ?x WHERE {?x a :AquaticResourceObservation.  ?x :hasVerticalDistribution :Pelagic}</cpannotationschema:hasUnitTest>
        <cpannotationschema:scenarios>Give me the resource observations where the vertical distribution is &apos;Pelagic&apos;</cpannotationschema:scenarios>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x13; term declared x2;
- header: dcterms:title &quot;Verticaldistribution Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- file: only pattern.ttl said Declaration(Datatype(xsd:gYear)) - not kept: pattern.owl is what an import copies
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <owl:versionInfo>Created by Eva Blomqvist</owl:versionInfo>
    </owl:Ontology>
    


