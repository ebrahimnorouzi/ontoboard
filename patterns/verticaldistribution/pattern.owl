    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#AquaticResource -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#AquaticResource">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter"/>
        <rdfs:comment>A fishery resource (a collection of actual aquatic organisms) that can include aquatic organisms from different AquaticSpecies, and is localized in some WaterArea.
It can be mapped to fi:AqResRef</rdfs:comment>
        <rdfs:label xml:lang="en">Aquatic resource</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#AquaticResourceObservation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#AquaticResourceObservation">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#hasResource"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#AquaticResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#hasVerticalDistribution"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#VerticalDistribution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An observation of a resource characterised by different parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">Aquatic resource observation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#VerticalDistribution -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#VerticalDistribution">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter"/>
        <rdfs:label xml:lang="en">Vertical distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter">
        <rdfs:label xml:lang="en">Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:RDF>



