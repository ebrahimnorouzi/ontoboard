# The verticaldistribution pattern on the query the pattern asks: which resource observations record
# a pelagic distribution. The 2022 assessment of the North Sea herring stock records the stock as
# pelagic for its reference year; beside it sits the acoustic survey that backs the reading, with its
# own feature of interest, result and observer.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix verticaldistribution: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/verticaldistribution.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/verticaldistribution#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:NorthSeaHerringStock a owl:NamedIndividual , aquaticresources:AquaticResource , verticaldistribution:AquaticResource ;
    rdfs:label "the North Sea autumn-spawning herring stock" ;
    aquaticresources:hasSpecies ex:AtlanticHerring .

ex:HerringAssessment2022 a owl:NamedIndividual , verticaldistribution:AquaticResourceObservation ;
    rdfs:label "the 2022 assessment of the North Sea herring stock" ;
    verticaldistribution:hasReferenceYear "2022"^^xsd:gYear ;
    verticaldistribution:hasResource ex:NorthSeaHerringStock ;
    verticaldistribution:hasVerticalDistribution ex:Pelagic .

ex:AtlanticHerring a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic herring (Clupea harengus)" .

ex:DepthOfHerringShoals a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the depth at which the herring shoals sit in the northern North Sea" .

ex:DanaAcousticSurvey a owl:NamedIndividual , observation:Observation ;
    rdfs:label "the acoustic survey run from RV Dana, July 2022" ;
    observation:hasFeatureOfInterest ex:DepthOfHerringShoals ;
    observation:hasResult ex:ShoalsBetween40And150m ;
    observation:madeBy ex:DanaSurveyTeam .

ex:DanaSurveyTeam a owl:NamedIndividual , observation:Observer ;
    rdfs:label "the acoustic survey team aboard RV Dana" .

ex:ShoalsBetween40And150m a owl:NamedIndividual , observation:Result ;
    rdfs:label "shoals recorded between 40 and 150 m, clear of the bottom" .

ex:Pelagic a owl:NamedIndividual , verticaldistribution:VerticalDistribution ;
    rdfs:label "pelagic: living in the water column rather than on the sea bed" .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, hasResource/isResourceOf, hasSpecies/isSpeciesPresentIn, hasVerticalDistribution/isVerticalDistributionOf. A reasoner adds the other.

