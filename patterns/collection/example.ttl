# The collection pattern in use: the saxophone collection from the pattern's own scenario - a Mark
# VI tenor, a Balanced Action alto, a Conn Transitional bari - and beside it a second collection,
# the 2024 insurance schedule, which two of those same horns are also members of.

@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix ex:               <https://w3id.org/ontoboard/example/collection#> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .

ex:SaxophoneCollection a owl:NamedIndividual , collectionentity:Collection ;
    rdfs:label "my saxophone collection" ;
    collectionentity:hasMember ex:MarkVITenor , ex:BalancedActionAlto , ex:ConnTransitionalBari .

ex:InsuredInstruments a owl:NamedIndividual , collectionentity:Collection ;
    rdfs:label "the instruments on the 2024 insurance schedule" ;
    rdfs:comment "A second collection over some of the same horns. A collection here is a first-order entity and not a logical class, so two of them may overlap with neither containing the other." ;
    collectionentity:hasMember ex:MarkVITenor , ex:ConnTransitionalBari , ex:StudioUpright .

ex:MarkVITenor a owl:NamedIndividual ;
    rdfs:label "the Selmer Mark VI tenor saxophone, serial 85432" ;
    rdfs:comment "A member of both collections, which answers the pattern's second question: what collections is this thing a member of? It carries no type from this pattern, because hasMember has range owl:Thing - membership is all the pattern says about a member." .

ex:BalancedActionAlto a owl:NamedIndividual ;
    rdfs:label "the Selmer Balanced Action alto saxophone, 1938" .

ex:ConnTransitionalBari a owl:NamedIndividual ;
    rdfs:label "the Conn Transitional baritone saxophone, 1930" .

ex:StudioUpright a owl:NamedIndividual ;
    rdfs:label "the studio upright piano" .

# Only one direction of each inverse pair is asserted: hasMember/isMemberOf. A reasoner adds the other.
