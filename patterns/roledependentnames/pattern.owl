    <!-- https://kastle-labl.org/lod/ontology/assumesAgentRole -->

    <owl:ObjectProperty rdf:about="https://kastle-labl.org/lod/ontology/assumesAgentRole">
        <rdfs:label xml:lang="en">assumes agent role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-labl.org/lod/ontology/hasName -->

    <owl:ObjectProperty rdf:about="https://kastle-labl.org/lod/ontology/hasName">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://kastle-labl.org/lod/ontology/assumesAgentRole"/>
            <rdf:Description rdf:about="https://kastle-labl.org/lod/ontology/hasRoleUnderName"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">has name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-labl.org/lod/ontology/hasNameAsString -->

    <owl:ObjectProperty rdf:about="https://kastle-labl.org/lod/ontology/hasNameAsString">
        <rdfs:label xml:lang="en">has name as string</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-labl.org/lod/ontology/hasRoleUnderName -->

    <owl:ObjectProperty rdf:about="https://kastle-labl.org/lod/ontology/hasRoleUnderName">
        <rdfs:label xml:lang="en">has role under name</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://kastle-labl.org/lod/ontology/providesAgentRole -->

    <owl:ObjectProperty rdf:about="https://kastle-labl.org/lod/ontology/providesAgentRole">
        <rdfs:label xml:lang="en">provides agent role</rdfs:label>
    </owl:ObjectProperty>
    


