    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Thing">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/hasName"/>
                <owl:allValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/Name"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/hasRoleUnderName"/>
                <owl:allValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/Name"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/providesAgentRole"/>
                <owl:allValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/AgentRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thing</rdfs:label>
    </rdf:Description>
    


    <!-- https://kastle-labl.org/lod/ontology/Agent -->

    <owl:Class rdf:about="https://kastle-labl.org/lod/ontology/Agent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/hasName"/>
                <owl:someValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/Name"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/assumesAgentRole"/>
                <owl:allValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/AgentRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/assumesAgentRole"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://kastle-labl.org/lod/ontology/AgentRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://kastle-labl.org/lod/ontology/assumesAgentRole"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://kastle-labl.org/lod/ontology/AgentRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://kastle-labl.org/lod/ontology/AgentRole"/>
        <owl:disjointWith rdf:resource="https://kastle-labl.org/lod/ontology/Name"/>
        <rdfs:label xml:lang="en">agent</rdfs:label>
    </owl:Class>
    


    <!-- https://kastle-labl.org/lod/ontology/AgentRole -->

    <owl:Class rdf:about="https://kastle-labl.org/lod/ontology/AgentRole">
        <owl:disjointWith rdf:resource="https://kastle-labl.org/lod/ontology/Name"/>
        <rdfs:label xml:lang="en">agent role</rdfs:label>
        <skos:editorialNote xml:lang="en">Axioms were lost when this pattern was harvested: the OWL API could not read part of the source and substituted placeholder classes in http://org.semanticweb.owlapi/error#, which asserted this class to be a subclass of Error1, Error2 and so on. The placeholders are removed here because they carry no information. What they stood for is still in the source: https://ontologydesignpatterns.org/wiki/Submissions:RoleDependentNames.</skos:editorialNote>
    </owl:Class>
    


    <!-- https://kastle-labl.org/lod/ontology/Name -->

    <owl:Class rdf:about="https://kastle-labl.org/lod/ontology/Name">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/hasNameAsString"/>
                <owl:someValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/xsd:string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:Class>
    


    <!-- https://kastle-labl.org/lod/ontology/xsd:string -->

    <owl:Class rdf:about="https://kastle-labl.org/lod/ontology/xsd:string">
        <rdfs:label xml:lang="en">xsd:string</rdfs:label>
    </owl:Class>
    <rdf:Description>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Restriction>
        <owl:onProperty rdf:resource="https://kastle-labl.org/lod/ontology/assumesAgentRole"/>
        <owl:someValuesFrom rdf:resource="https://kastle-labl.org/lod/ontology/Agent"/>
        <rdfs:subClassOf rdf:resource="https://kastle-labl.org/lod/ontology/Agent"/>
    </owl:Restriction>
</rdf:RDF>



