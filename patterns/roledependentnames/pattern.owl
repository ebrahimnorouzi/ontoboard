  <rdf:Description rdf:about="https://kastle-labl.org/lod/ontology/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:hasPatternName>Role Module Pattern</ns1:hasPatternName>
    <ns2:addressesScenario rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use Case&#13;&#13;
                                                                Use Case Description</ns2:addressesScenario>
    <ns2:hasCompetencyQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cq1</ns2:hasCompetencyQuestion>
    <ns2:hasCompetencyQuestion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cq2</ns2:hasCompetencyQuestion>
    <ns3:hasConnections rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thing providesAgentRole AgentRole r&#13;&#13;
AgentRole hasRoleUnderName Name r st&#13;&#13;
Agent assumesAgentRole AgentRole st sd iqsf sr&#13;&#13;
Agent hasName Name r e iqsf&#13;&#13;
Name hasNameAsString xsd:string e</ns3:hasConnections>
    <ns3:hasSchemaDiagramFileName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M_Role.png</ns3:hasSchemaDiagramFileName>
