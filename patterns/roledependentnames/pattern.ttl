@prefix : <https://kastle-labl.org/lod/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://kastle-labl.org/lod/ontology/> .

<https://kastle-labl.org/lod/ontology/> rdf:type owl:Ontology ;
                                         <http://ontologydesignpatterns.org/opla-core#hasPatternName> "Role Module Pattern" ;
                                         <http://ontologydesignpatterns.org/opla-cp#addressesScenario> """Use Case
                                                                Use Case Description"""^^xsd:string ;
                                         <http://ontologydesignpatterns.org/opla-cp#hasCompetencyQuestion> "cq1"^^xsd:string ,
                                                                                                           "cq2"^^xsd:string ;
                                         <http://ontologydesignpatterns.org/opla-sd#hasConnections> """Thing providesAgentRole AgentRole r
AgentRole hasRoleUnderName Name r st
Agent assumesAgentRole AgentRole st sd iqsf sr
Agent hasName Name r e iqsf
Name hasNameAsString xsd:string e"""^^xsd:string ;
                                         <http://ontologydesignpatterns.org/opla-sd#hasSchemaDiagramFileName> "M_Role.png"^^xsd:string ;
                                         <http://purl.org/dc/elements/1.1/contributor> "Cogan Shimizu" ,
                                                                                       "Pascal Hitzler" ,
                                                                                       "Rushrukh Rayan" ;
                                         <http://purl.org/dc/elements/1.1/creator> "Cogan Shimizu" ,
                                                                                   "Pascal Hitzler" ,
                                                                                   "Rushrukh Rayan" .

#################################################################
#    Annotation properties
#################################################################

###  http://ontologydesignpatterns.org/opla-core#hasPatternName
<http://ontologydesignpatterns.org/opla-core#hasPatternName> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-cp#addressesScenario
<http://ontologydesignpatterns.org/opla-cp#addressesScenario> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-cp#hasCompetencyQuestion
<http://ontologydesignpatterns.org/opla-cp#hasCompetencyQuestion> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#hasConnections
<http://ontologydesignpatterns.org/opla-sd#hasConnections> rdf:type owl:AnnotationProperty .


###  http://ontologydesignpatterns.org/opla-sd#hasSchemaDiagramFileName
<http://ontologydesignpatterns.org/opla-sd#hasSchemaDiagramFileName> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://kastle-labl.org/lod/ontology/assumesAgentRole
:assumesAgentRole rdf:type owl:ObjectProperty ;
                  owl:propertyChainAxiom ( :hasName
                                           [ owl:inverseOf :hasRoleUnderName
                                           ]
                                         ) .


###  https://kastle-labl.org/lod/ontology/hasName
:hasName rdf:type owl:ObjectProperty ;
         owl:propertyChainAxiom ( :assumesAgentRole
                                  :hasRoleUnderName
                                ) .


###  https://kastle-labl.org/lod/ontology/hasNameAsString
:hasNameAsString rdf:type owl:ObjectProperty .


###  https://kastle-labl.org/lod/ontology/hasRoleUnderName
:hasRoleUnderName rdf:type owl:ObjectProperty .


###  https://kastle-labl.org/lod/ontology/providesAgentRole
:providesAgentRole rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://org.semanticweb.owlapi/error#Error1
<http://org.semanticweb.owlapi/error#Error1> rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasName ;
                            owl:allValuesFrom :Name
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasRoleUnderName ;
                            owl:allValuesFrom :Name
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :providesAgentRole ;
                            owl:allValuesFrom :AgentRole
                          ] .


###  https://kastle-labl.org/lod/ontology/Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasName ;
                         owl:someValuesFrom :Name
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :assumesAgentRole ;
                         owl:allValuesFrom :AgentRole
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :assumesAgentRole ;
                         owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                         owl:onClass :AgentRole
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty [ owl:inverseOf :assumesAgentRole
                                        ] ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :AgentRole
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty [ owl:inverseOf :hasName
                                        ] ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Name
                       ] ;
       owl:disjointWith :AgentRole ,
                        :Name .


###  https://kastle-labl.org/lod/ontology/AgentRole
:AgentRole rdf:type owl:Class ;
           rdfs:subClassOf <http://org.semanticweb.owlapi/error#Error1> ;
           owl:disjointWith :Name .


###  https://kastle-labl.org/lod/ontology/Name
:Name rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :hasNameAsString ;
                        owl:someValuesFrom :xsd:string
                      ] .


###  https://kastle-labl.org/lod/ontology/xsd:string
:xsd:string rdf:type owl:Class .


[ owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger
] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
   owl:onProperty :assumesAgentRole ;
   owl:someValuesFrom :Agent ;
   rdfs:subClassOf :Agent
 ] .


