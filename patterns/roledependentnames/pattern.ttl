@prefix : <https://kastle-labl.org/lod/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns1: <http://ontologydesignpatterns.org/opla-core#> .
@prefix ns2: <http://ontologydesignpatterns.org/opla-cp#> .
@prefix ns3: <http://ontologydesignpatterns.org/opla-sd#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://kastle-labl.org/lod/ontology/> .

<https://kastle-labl.org/lod/ontology/> rdf:type owl:Ontology ;
                                         ns1:hasPatternName "Role Module Pattern" ;
                                         ns2:addressesScenario """Use Case
                                                                Use Case Description"""^^xsd:string ;
                                         ns2:hasCompetencyQuestion "cq1"^^xsd:string ,
                                                                   "cq2"^^xsd:string ;
                                         ns3:hasConnections """Thing providesAgentRole AgentRole r
AgentRole hasRoleUnderName Name r st
Agent assumesAgentRole AgentRole st sd iqsf sr
Agent hasName Name r e iqsf
Name hasNameAsString xsd:string e"""^^xsd:string ;
                                         ns3:hasSchemaDiagramFileName "M_Role.png"^^xsd:string ;
                                         dc:contributor "Cogan Shimizu" ,
                                                        "Pascal Hitzler" ,
                                                        "Rushrukh Rayan" ;
                                         dc:creator "Cogan Shimizu" ,
                                                    "Pascal Hitzler" ,
                                                    "Rushrukh Rayan" ;
                                         dcterms:description "Diagram | Intent: | An ontology design pattern for modeling Names as part of Roles, to capture scenarios where an Agent performs different Roles using different Names associated with the different Roles. Examples of an Agent performing a Role using different Names are rather ubiq- uitous, e.g., authors..."^^xsd:string ;
                                         dcterms:title "Roledependentnames Pattern"^^xsd:string ;
                                         rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x20; term declared x3;
- header: dcterms:title \"Roledependentnames Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- axiom removed: SubObjectPropertyOf(ObjectPropertyChain(<https://kastle-labl.org/lod/ontology/hasName> ObjectInverseOf(<https://kastle-labl.org/lod/ontology/hasRoleUnderName>)) <https://kastle-labl.org/lod/ontology/assumesAgentRole>) - with the chain assumesAgentRole o hasRoleUnderName -> hasName it made a cycle of property chains, outside OWL 2 DL (no reasoner could answer); broken at the inverse that closes it - an agent who acts in a role still carries the role's name
- axiom removed: SubClassOf(<https://kastle-labl.org/lod/ontology/Agent> ObjectMaxCardinality(1 ObjectInverseOf(<https://kastle-labl.org/lod/ontology/hasName>) <https://kastle-labl.org/lod/ontology/Name>)) - the chain assumesAgentRole o hasRoleUnderName -> hasName makes hasName a non-simple property, and OWL 2 DL allows no cardinality restriction on one, so no reasoner could answer; this one - on the inverse of hasName - goes, the chain stays (keeping this and dropping that chain instead leaves assumesAgentRole in two cardinality restrictions)
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://ontologydesignpatterns.org/opla-core#hasPatternName
ns1:hasPatternName rdf:type owl:AnnotationProperty ;
                   rdfs:label "has pattern name"@en .


###  http://ontologydesignpatterns.org/opla-cp#addressesScenario
ns2:addressesScenario rdf:type owl:AnnotationProperty ;
                      rdfs:label "addresses scenario"@en .


###  http://ontologydesignpatterns.org/opla-cp#hasCompetencyQuestion
ns2:hasCompetencyQuestion rdf:type owl:AnnotationProperty ;
                          rdfs:label "has competency question"@en .


###  http://ontologydesignpatterns.org/opla-sd#hasConnections
ns3:hasConnections rdf:type owl:AnnotationProperty ;
                   rdfs:label "has connections"@en .


###  http://ontologydesignpatterns.org/opla-sd#hasSchemaDiagramFileName
ns3:hasSchemaDiagramFileName rdf:type owl:AnnotationProperty ;
                             rdfs:label "has schema diagram file name"@en .


###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty ;
               rdfs:label "Contributor"@en .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty ;
           rdfs:label "Creator"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty ;
                   rdfs:label "editorial note"@en .


#################################################################
#    Object Properties
#################################################################

###  https://kastle-labl.org/lod/ontology/assumesAgentRole
:assumesAgentRole rdf:type owl:ObjectProperty ;
                  rdfs:label "assumes agent role"@en .


###  https://kastle-labl.org/lod/ontology/hasName
:hasName rdf:type owl:ObjectProperty ;
         owl:propertyChainAxiom ( :assumesAgentRole
                                  :hasRoleUnderName
                                ) ;
         rdfs:label "has name"@en .


###  https://kastle-labl.org/lod/ontology/hasNameAsString
:hasNameAsString rdf:type owl:ObjectProperty ;
                 rdfs:label "has name as string"@en .


###  https://kastle-labl.org/lod/ontology/hasRoleUnderName
:hasRoleUnderName rdf:type owl:ObjectProperty ;
                  rdfs:label "has role under name"@en .


###  https://kastle-labl.org/lod/ontology/providesAgentRole
:providesAgentRole rdf:type owl:ObjectProperty ;
                   rdfs:label "provides agent role"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasName ;
                            owl:allValuesFrom :Name
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasRoleUnderName ;
                            owl:allValuesFrom :Name
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :providesAgentRole ;
                            owl:allValuesFrom :AgentRole
                          ] ;
          rdfs:label "Thing"^^xsd:string .


###  https://kastle-labl.org/lod/ontology/Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasName ;
                         owl:someValuesFrom :Name
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :assumesAgentRole ;
                         owl:allValuesFrom :AgentRole
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :assumesAgentRole ;
                         owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                         owl:onClass :AgentRole
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty [ owl:inverseOf :assumesAgentRole
                                        ] ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :AgentRole
                       ] ;
       owl:disjointWith :AgentRole ,
                        :Name ;
       rdfs:label "agent"@en .


###  https://kastle-labl.org/lod/ontology/AgentRole
:AgentRole rdf:type owl:Class ;
           owl:disjointWith :Name ;
           rdfs:label "agent role"@en ;
           skos:editorialNote "Axioms were lost when this pattern was harvested: the OWL API could not read part of the source and substituted placeholder classes in http://org.semanticweb.owlapi/error#, which asserted this class to be a subclass of Error1, Error2 and so on. The placeholders are removed here because they carry no information. What they stood for is still in the source: https://ontologydesignpatterns.org/wiki/Submissions:RoleDependentNames."@en .


###  https://kastle-labl.org/lod/ontology/Name
:Name rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :hasNameAsString ;
                        owl:someValuesFrom :xsd:string
                      ] ;
      rdfs:label "name"@en .


###  https://kastle-labl.org/lod/ontology/xsd:string
:xsd:string rdf:type owl:Class ;
            rdfs:label "xsd:string"@en .


[ owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger
] .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
   owl:onProperty :assumesAgentRole ;
   owl:someValuesFrom :Agent ;
   rdfs:subClassOf :Agent
 ] .


