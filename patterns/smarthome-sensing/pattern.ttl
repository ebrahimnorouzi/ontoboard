@prefix : <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl> .

<http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl> rdf:type owl:Ontology ;
                                                                              owl:imports <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl> ,
                                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What is the output of the sensing process?"^^xsd:string ,
                                                                                                                                                                        "What sensors are involved (implement) the sensing process?"^^xsd:string ,
                                                                                                                                                                        "When the sensor output is generated by the sensor?"^^xsd:string ,
                                                                                                                                                                        "Which feature of interest is considered for the observation (sensing) process?"^^xsd:string ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> """The pattern extends both the SSN ontology and DUL. The extension is in the form of specialization of the following classes: http://purl.oclc.org/NET/ssnx/ssn#Output
http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationRealization
http://purl.oclc.org/NET/ssnx/ssn#Sensing
http://purl.oclc.org/NET/ssnx/ssn#SensingDevice"""^^xsd:string ;
                                                                              rdfs:isDefinedBy "This pattern uses the ODP featureOfInterest (http://ontologydesignpatterns.org/wiki/Submissions:SmartHome_FeatureOfInterest)."^^xsd:string .

#################################################################
#    Object Properties
#################################################################

###  http://purl.oclc.org/NET/ssnx/ssn#hasMeasurementProperty
<http://purl.oclc.org/NET/ssnx/ssn#hasMeasurementProperty> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#hasOutput
<http://purl.oclc.org/NET/ssnx/ssn#hasOutput> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#implementedBy
<http://purl.oclc.org/NET/ssnx/ssn#implementedBy> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#implements
<http://purl.oclc.org/NET/ssnx/ssn#implements> rdf:type owl:ObjectProperty .


###  http://purl.oclc.org/NET/ssnx/ssn#isProducedBy
<http://purl.oclc.org/NET/ssnx/ssn#isProducedBy> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasSetting
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasSetting> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isObservableAt
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isObservableAt> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isParticipantIn
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isParticipantIn> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isQualityOf
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isQualityOf> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#hasMaxValue
:hasMaxValue rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue> ;
             rdfs:range xsd:double .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#hasMinValue
:hasMinValue rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue> ;
             rdfs:range xsd:double .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#outputDataType
:outputDataType rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl#SmartHomeFeatureOfInterest
<http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl#SmartHomeFeatureOfInterest> rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                                                                    owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isDescribedBy> ;
                                                                                                                                    owl:someValuesFrom :SensingProcess
                                                                                                                                  ] .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#ObservationType
:ObservationType rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#MeasurementProperty> .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#SensingProcess
:SensingProcess rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Sensing> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#implementedBy> ;
                                  owl:someValuesFrom :SmartHomeSensor
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes> ;
                                  owl:someValuesFrom <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl#SmartHomeFeatureOfInterest>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasSetting> ;
                                  owl:someValuesFrom :SensorConfiguration
                                ] .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#SensorConfiguration
:SensorConfiguration rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasMeasurementProperty> ;
                                       owl:someValuesFrom :ObservationType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasMeasurementProperty> ;
                                       owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Frequency>
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> ;
                                       owl:someValuesFrom :SensingProcess
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isSettingFor> ;
                                       owl:someValuesFrom :SmartHomeSensor
                                     ] .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#SmartHomeSensor
:SmartHomeSensor rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#SensingDevice> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#hasOutput> ;
                                   owl:someValuesFrom :SmartHomeSensorOutput
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#implements> ;
                                   owl:someValuesFrom :SensingProcess
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasSetting> ;
                                   owl:someValuesFrom :SensorConfiguration
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf> ;
                                   owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/ssn#Device>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :outputDataType ;
                                   owl:someValuesFrom xsd:string
                                 ] .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Sensing.owl#SmartHomeSensorOutput
:SmartHomeSensorOutput rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#SensorOutput> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#isProducedBy> ;
                                         owl:someValuesFrom :SmartHomeSensor
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isObservableAt> ;
                                         owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval>
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasMaxValue ;
                                         owl:someValuesFrom xsd:double
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasMinValue ;
                                         owl:someValuesFrom xsd:double
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue> ;
                                         owl:someValuesFrom xsd:long
                                       ] .


###  http://purl.oclc.org/NET/ssnx/ssn#Device
<http://purl.oclc.org/NET/ssnx/ssn#Device> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#Frequency
<http://purl.oclc.org/NET/ssnx/ssn#Frequency> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#MeasurementProperty
<http://purl.oclc.org/NET/ssnx/ssn#MeasurementProperty> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#Sensing
<http://purl.oclc.org/NET/ssnx/ssn#Sensing> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#SensingDevice
<http://purl.oclc.org/NET/ssnx/ssn#SensingDevice> rdf:type owl:Class .


###  http://purl.oclc.org/NET/ssnx/ssn#SensorOutput
<http://purl.oclc.org/NET/ssnx/ssn#SensorOutput> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#TimeInterval> rdf:type owl:Class .


