@prefix : <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix parameter: <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> rdf:type owl:Ontology ;
                                                              owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                              dcterms:description "To represent parameters to be used for a certain concept."^^xsd:string ;
                                                              dcterms:title "Parameter Pattern"^^xsd:string ;
                                                              cpannotationschema:extractedFrom "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl" ;
                                                              cpannotationschema:hasAuthor "Valentina Presutti" ;
                                                              cpannotationschema:hasIntent "To represent parameters to be used for a certain concept."^^xsd:string ;
                                                              rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x5; label added x6; term declared x3;
- header: dcterms:title \"Parameter Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                           "The parameter content ontology design pattern. This CP is extracted from the DOLCE Ultra Lite ontology. It represents parameters which are constraints or selections on observable values." ;
                                                              rdfs:label "Parameter" ;
                                                              owl:versionInfo """1.0
- Created by Valentina Presutti"""^^xsd:string ,
                                                                              "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom
cpannotationschema:extractedFrom rdf:type owl:AnnotationProperty ;
                                 rdfs:label "extracted from"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor
cpannotationschema:hasAuthor rdf:type owl:AnnotationProperty ;
                             rdfs:label "has author"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#hasParameter
parameter:hasParameter rdf:type owl:ObjectProperty ;
                       owl:inverseOf parameter:isParameterFor ;
                       rdfs:domain parameter:Concept ;
                       rdfs:range parameter:Parameter ;
                       rdfs:comment "A Concept can have a Parameter that constrains the attributes that a classified Entity can have in a certain Situation, e.g. a 4WheelDriver Role definedIn the ItalianTrafficLaw has a MinimumAge parameter on the Amount 16." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> ;
                       rdfs:label "has parameter"@en ;
                       skos:prefLabel "ha parametro"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#isParameterFor
parameter:isParameterFor rdf:type owl:ObjectProperty ;
                         rdfs:domain parameter:Parameter ;
                         rdfs:range parameter:Concept ;
                         rdfs:comment "A Concept can have a Parameter that constrains the attributes that a classified Entity can have in a certain Situation, e.g. a 4WheelDriver Role definedIn the ItalianTrafficLaw has a MinimumAge parameter on the Amount 16." ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> ;
                         rdfs:label "is parameter for"@en ;
                         skos:prefLabel "è un parametro per"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#hasParameterDataValue
parameter:hasParameterDataValue rdf:type owl:DatatypeProperty ;
                                rdfs:domain parameter:Parameter ;
                                rdfs:comment """Parametrizes values from a datatype. For example, a Parameter AgeForDriving hasParameterDataValue 18 on datatype xsd:int, in the Italian traffic code. In this example, AgeForDriving isDefinedIn the Norm ItalianTrafficCodeAgeDriving.
More complex parametrization requires workarounds. E.g. AgeRangeForDrugUsage could parametrize data value: 14 to 50 on the datatype: xsd:int. Since complex datatypes are not allowed in OWL1.0, a solution to this can only work by creating two 'sub-parameters': MinimumAgeRangeForDrugUsage (that hasParameterDataValue 14) and MaximumAgeRangeForDrugUsage (that hasParameterDataValue 50), which are components of the main Parameter AgeRangeForDrugUsage.
Ordering on subparameters can be created by using or specializing the object property 'precedes'.""" ;
                                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> ;
                                rdfs:label "has parameter data value"@en ;
                                skos:prefLabel "ha valore"@it .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#Concept
parameter:Concept rdf:type owl:Class ;
                  rdfs:comment """A concept is a SocialObject, and isDefinedIn a Description . 
Once defined, a Concept can be used in other descriptions. 
The classifies relation relates concepts to entities at some time"""^^xsd:string ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> ;
                  rdfs:label "Concept"@en ;
                  skos:prefLabel "Concetto"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#Parameter
parameter:Parameter rdf:type owl:Class ;
                    rdfs:subClassOf parameter:Concept ;
                    rdfs:comment """A Concept that classifies something having a certain value, e.g. 'High' can be said of people taller than 185 cm.
However, in order to formally represent this constraint, we need to add an anonymous type to a parameter instance, using a property that convey the semantics of the parameter, e.g.:
High rdf:type Person and (some hasHeight (Height and (oneOf isTallerThan 185) and (oneOf hasUnitOfMeasure centimeter)))"""^^xsd:string ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl> ;
                    rdfs:label "Parameter"@en ;
                    skos:prefLabel "Parametro"@it .


