# The nurses on a hospital ward: a Community is a Collection every member of which is
# an Agent, and one of those nurses also holds the shift-leader role for the week.

@prefix agentrole: <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#> .
@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix communities: <http://www.ontologydesignpatterns.org/cp/owl/communities.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/communities#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Ward7Nurses a owl:NamedIndividual , communities:Community ;
    rdfs:label "the nurses on Ward 7" ;
    collectionentity:hasMember ex:AnnaRossi ,
        ex:KwameMensah ,
        ex:LenaFischer .

ex:AnnaRossi a owl:NamedIndividual , agentrole:Agent ;
    rdfs:label "Anna Rossi, registered nurse" ;
    objectrole:hasRole ex:ShiftLeader .

ex:KwameMensah a owl:NamedIndividual , agentrole:Agent ;
    rdfs:label "Kwame Mensah, registered nurse" .

ex:LenaFischer a owl:NamedIndividual , agentrole:Agent ;
    rdfs:label "Lena Fischer, registered nurse" .

ex:ShiftLeader a owl:NamedIndividual , objectrole:Role ;
    rdfs:label "shift leader, week 44" .

# Only one direction of each inverse pair is asserted: hasMember/isMemberOf, hasRole/isRoleOf. A reasoner adds the other.

