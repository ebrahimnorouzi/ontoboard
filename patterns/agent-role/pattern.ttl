@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> rdf:type owl:Ontology ;
                                                              rdfs:comment "Represents an agent playing a role in some context. Agents can be persons, organizations, or software agents." ;
                                                              rdfs:label "Agent Role Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         rdfs:domain :Agent ;
         rdfs:range :Role ;
         rdfs:label "hasRole" .


###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#isRoleOf
:isRoleOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Role ;
          rdfs:range :Agent ;
          rdfs:label "isRoleOf" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent
:Agent rdf:type owl:Class ;
       rdfs:label "Agent" .


###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Role
:Role rdf:type owl:Class ;
      rdfs:label "Role" .


