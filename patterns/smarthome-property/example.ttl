# Three objects in an assisted-living apartment and the properties a smart home
# monitors them by: the front door's open/closed state, the refrigerator's
# compartment temperature, and the surface temperature of the living-room radiator.

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix smarthomeproperty: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Property.owl#> .
@prefix ssn: <http://purl.oclc.org/NET/ssnx/ssn#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-property#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:FrontDoor a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the front door of the apartment" ;
    ssn:hasProperty ex:FrontDoorOpenState .

ex:FrontDoorOpenState a owl:NamedIndividual , smarthomeproperty:SmartHomeProperty ;
    rdfs:label "whether the front door stands open or closed" ;
    ssn:isPropertyOf ex:FrontDoor .

ex:KitchenRefrigerator a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the refrigerator in the kitchen" ;
    ssn:hasProperty ex:RefrigeratorCompartmentTemperature .

ex:RefrigeratorCompartmentTemperature a owl:NamedIndividual , smarthomeproperty:SmartHomeProperty ;
    rdfs:label "the air temperature inside the refrigerator compartment" ;
    ssn:isPropertyOf ex:KitchenRefrigerator .

ex:LivingRoomRadiator a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the radiator under the living-room window" ;
    ssn:hasProperty ex:RadiatorSurfaceTemperature .

ex:RadiatorSurfaceTemperature a owl:NamedIndividual , smarthomeproperty:SmartHomeProperty ;
    rdfs:label "the surface temperature of the living-room radiator" ;
    ssn:isPropertyOf ex:LivingRoomRadiator .
