#    Object Properties
#################################################################

###  http://purl.oclc.org/NET/ssnx/ssn#forProperty
<http://purl.oclc.org/NET/ssnx/ssn#forProperty> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isAbout
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isAbout> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isDescribedBy
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isDescribedBy> rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl#SmartHomeFeatureOfInterest
:SmartHomeFeatureOfInterest rdf:type owl:Class ;
                            rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject> ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://purl.oclc.org/NET/ssnx/ssn#forProperty> ;
                                              owl:someValuesFrom <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Property.owl#SmartHomeProperty>
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isAbout> ;
                                              owl:someValuesFrom <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>
                                            ] .


###  http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Property.owl#SmartHomeProperty
<http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Property.owl#SmartHomeProperty> rdf:type owl:Class .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject
<http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject> rdf:type owl:Class .


