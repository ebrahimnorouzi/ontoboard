# The pattern's own two scenarios: "the pressure sensed on the couch" and "the electric
# current of the TV". Each feature of interest is a piece of information with no value of
# its own - it names the property (forProperty) and the object that property belongs to
# (isAbout), which is what a sensing process then observes.

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix smarthomefeatureofinterest: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_FeatureOfInterest.owl#> .
@prefix smarthomeproperty: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Property.owl#> .
@prefix ssn: <http://purl.oclc.org/NET/ssnx/ssn#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-featureofinterest#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Couch a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the three-seat couch in the living room of flat 3B" ;
    ssn:hasProperty ex:CouchSeatPressure .

ex:CouchSeatPressure a owl:NamedIndividual , smarthomeproperty:SmartHomeProperty ;
    rdfs:label "the seat pressure of the couch" .

ex:PressureSensedOnTheCouch a owl:NamedIndividual , smarthomefeatureofinterest:SmartHomeFeatureOfInterest ;
    rdfs:label "the pressure sensed on the couch" ;
    ssn:forProperty ex:CouchSeatPressure ;
    dul:isAbout ex:Couch .

ex:Television a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the 48-inch television in the living room of flat 3B" ;
    ssn:hasProperty ex:TelevisionCurrent .

ex:TelevisionCurrent a owl:NamedIndividual , smarthomeproperty:SmartHomeProperty ;
    rdfs:label "the electric current drawn by the television" .

ex:ElectricCurrentOfTheTV a owl:NamedIndividual , smarthomefeatureofinterest:SmartHomeFeatureOfInterest ;
    rdfs:label "the electric-current of the TV" ;
    ssn:forProperty ex:TelevisionCurrent ;
    dul:isAbout ex:Television .

# Only one direction of each inverse pair is asserted: hasProperty, not isPropertyOf. A reasoner adds the other.
