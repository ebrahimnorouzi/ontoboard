<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/pmd/co/"
     xml:base="https://w3id.org/pmd/co/"
     xmlns:ns1="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ontoboard.org/patterns/mwo-material-entity-description.owl">
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gives a structured description of a material entity such as a device or a material: it is tied to the processes or projects it participates in or is an output of, its realizable aspects (role, disposition, function) hang off bearer_of, agents and a place are attached, and its structural composition is given by part and member relations. Further ICEs carry its identifiers, specifications and other descriptive metadata.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pattern 8: Material Entity Description</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x2; label added x8; term declared x4;
- header: dcterms:title &quot;Pattern 8: Material Entity Description&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- header: dcterms:license &lt;https://creativecommons.org/publicdomain/zero/1.0/&gt; - https://github.com/ISE-FIZKarlsruhe/mwo/blob/main/mwo.ttl
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </owl:Ontology>
    


