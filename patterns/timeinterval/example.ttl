# The pattern's own scenario: the interval "January 2008" starts at 2008-01-01 and ends at
# 2008-01-31. The year it sits in is a second interval, written at a coarser granularity,
# because the pattern deliberately declares no range for its date properties.

@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/timeinterval#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:January2008 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "January 2008" ;
    timeinterval:hasIntervalDate "2008-01" ;
    timeinterval:hasIntervalStartDate "2008-01-01" ;
    timeinterval:hasIntervalEndDate "2008-01-31" .

ex:Year2008 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "2008" ;
    timeinterval:hasIntervalDate "2008" ;
    timeinterval:hasIntervalStartDate "2008-01-01" ;
    timeinterval:hasIntervalEndDate "2008-12-31" .
