# Two Northeast Atlantic stocks and the depths their species keep to: Greenland
# halibut on the slope below 200 metres, Atlantic cod in the shelf waters above it.
# This answers the pattern's scenario, "the species found below 200 metres for a
# water area".

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix speciesbathymetry: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesbathymetry.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/speciesbathymetry#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:GreenlandHalibutStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Northeast Atlantic Greenland halibut stock" ;
    aquaticresources:hasSpecies ex:GreenlandHalibut ;
    aquaticresources:canOccurIn ex:FaoArea27 .

ex:GreenlandHalibut a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Greenland halibut, Reinhardtius hippoglossoides" ;
    speciesbathymetry:hasBathymetricRange ex:SlopeDepths .

ex:SlopeDepths a owl:NamedIndividual , speciesbathymetry:BathymetricRange ;
    rdfs:label "200 to 1600 metres, the continental slope" ;
    speciesbathymetry:hasRangeMin "200.0"^^xsd:float ;
    speciesbathymetry:hasRangeMax "1600.0"^^xsd:float .

ex:NortheastArcticCodStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the Northeast Arctic cod stock" ;
    aquaticresources:hasSpecies ex:AtlanticCod ;
    aquaticresources:canOccurIn ex:FaoArea27 .

ex:AtlanticCod a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "Atlantic cod, Gadus morhua" ;
    speciesbathymetry:hasBathymetricRange ex:ShelfDepths .

ex:ShelfDepths a owl:NamedIndividual , speciesbathymetry:BathymetricRange ;
    rdfs:label "20 to 600 metres, the shelf waters" ;
    speciesbathymetry:hasRangeMin "20.0"^^xsd:float ;
    speciesbathymetry:hasRangeMax "600.0"^^xsd:float .

ex:FaoArea27 a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "FAO Major Fishing Area 27, the Northeast Atlantic" .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, hasBathymetricRange/isBathymetricRangeOf, hasSpecies/isSpeciesPresentIn. A reasoner adds the other.
