    <!-- http://purl.obolibrary.org/obo/RO_0000057 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
        <obo:IAO_0000112 xml:lang="en">this blood coagulation has participant this blood clot</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">this investigation has participant this investigator</obo:IAO_0000112>
        <obo:IAO_0000112 xml:lang="en">this process has participant this input material (or this output material)</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">a relation between a process and a continuant, in which the continuant is somehow involved in the process</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process. The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002234 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002234">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <obo:IAO_0000115>p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001025 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001025">
        <owl:inverseOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001028"/>
        <rdfs:comment>inverse of property &quot;implemented by&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">implements</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001028 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001028">
        <rdfs:comment>The property relates an entity to an agent that has adapted or developed the entity for a specific purpose and actively uses it within a particular context.</rdfs:comment>
        <rdfs:label xml:lang="en">implemented by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001134 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001134">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001028"/>
        <owl:inverseOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001135"/>
        <rdfs:comment>The property relates an entity to an agent that has modified, customized, or extended it for a specific use case or research purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">developed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001135 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001135">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001025"/>
        <rdfs:comment>inverse of property &quot;developed by&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">develops</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001136 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001136">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001028"/>
        <owl:inverseOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001137"/>
        <rdfs:comment>The property relates an entity to agents that collaboratively contributed to its development.</rdfs:comment>
        <rdfs:label xml:lang="en">co developed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001137 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001137">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001025"/>
        <rdfs:comment>inverse of property &quot;co developed by&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">co develops</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001138 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001138">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001028"/>
        <owl:inverseOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001139"/>
        <rdfs:comment>The property relates an entity to an agent responsible for its creation or primary development.</rdfs:comment>
        <rdfs:label xml:lang="en">adapted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purls.helmholtz-metadaten.de/mwo/MWO_0001139 -->

    <owl:ObjectProperty rdf:about="http://purls.helmholtz-metadaten.de/mwo/MWO_0001139">
        <rdfs:subPropertyOf rdf:resource="http://purls.helmholtz-metadaten.de/mwo/MWO_0001025"/>
        <rdfs:comment>inverse of property &quot;adapted by&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">adapts</rdfs:label>
    </owl:ObjectProperty>
    


