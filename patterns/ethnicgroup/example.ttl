# The ethnicgroup pattern in use, on the Sami of northern Europe. The group is the hub, and one
# linksTo property runs from it to each kind of thing a group is described by: the country and
# continent it lives in, its language, the county, city, town, river and island of its homeland,
# the military operation that emptied that homeland in 1944, its singers, writers and office
# holders, and the neighbouring Kven minority.

@prefix ontology: <http://dbpedia.org/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/ethnicgroup#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:SamiPeople a owl:NamedIndividual , ontology:EthnicGroup ;
    rdfs:label "the Sámi people" ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToAdministrativeRegion> ex:Finnmark ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToCity> ex:Tromso ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToContinent> ex:Europe ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToCountry> ex:Norway ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToEthnicGroup> ex:KvenPeople ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToIsland> ex:Soroya ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToLanguage> ex:NorthernSami ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToMilitaryConflict> ex:BurningOfFinnmark1944 ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToMusicalArtist> ex:MariBoine ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToOfficeHolder> ex:SiljeKarineMuotka ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToPresident> ex:OleHenrikMagga ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToRiver> ex:TanaRiver ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToTown> ex:Karasjok ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToWriter> ex:NilsAslakValkeapaa .

ex:KvenPeople a owl:NamedIndividual , ontology:EthnicGroup ;
    rdfs:label "the Kven, the neighbouring minority of Finnish descent" .

ex:Norway a owl:NamedIndividual , ontology:Country ;
    rdfs:label "Norway" .

ex:Europe a owl:NamedIndividual , ontology:Continent ;
    rdfs:label "Europe" .

ex:NorthernSami a owl:NamedIndividual , ontology:Language ;
    rdfs:label "Northern Sámi" .

ex:Finnmark a owl:NamedIndividual , ontology:AdministrativeRegion ;
    rdfs:label "Finnmark, the northernmost county of Norway" .

ex:Tromso a owl:NamedIndividual , ontology:City ;
    rdfs:label "Tromsø" .

ex:Karasjok a owl:NamedIndividual , ontology:Town ;
    rdfs:label "Karasjok, seat of the Sámi Parliament of Norway" .

ex:TanaRiver a owl:NamedIndividual , ontology:River ;
    rdfs:label "the Tana, the salmon river of the Sámi homeland" .

ex:Soroya a owl:NamedIndividual , ontology:Island ;
    rdfs:label "Sørøya, an island off the Finnmark coast" .

ex:BurningOfFinnmark1944 a owl:NamedIndividual , ontology:MilitaryConflict ;
    rdfs:label "the burning of Finnmark, 1944" .

ex:MariBoine a owl:NamedIndividual , ontology:MusicalArtist ;
    rdfs:label "Mari Boine, joik singer" .

ex:SiljeKarineMuotka a owl:NamedIndividual , ontology:OfficeHolder ;
    rdfs:label "Silje Karine Muotka, president of the Sámi Parliament of Norway" .

ex:OleHenrikMagga a owl:NamedIndividual , ontology:President ;
    rdfs:label "Ole Henrik Magga, its first president" .

ex:NilsAslakValkeapaa a owl:NamedIndividual , ontology:Writer ;
    rdfs:label "Nils-Aslak Valkeapää, poet and joik artist" .
