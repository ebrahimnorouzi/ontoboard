@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl> .

<file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl> rdf:type owl:Ontology ;
                                                                                                                                             owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ,
                                                                                                                                                         <http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl> ;
                                                                                                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> <http://dbpedia.org/> ,
                                                                                                                                                                                                                                  <http://en.wikipedia.org/> ;
                                                                                                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Andrea Giovanni Nuzzolese" ,
                                                                                                                                                                                                                              "Valentina Presutti" ;
                                                                                                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To model the core knowledge needed to describe a EthnicGroup" ;
                                                                                                                                             rdfs:comment "An encyclopedic knowledge pattern (EKP) identifying the core knowledge that describes a EthnicGroup" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToAdministrativeRegion
:linksToAdministrativeRegion rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                             rdfs:range <http://dbpedia.org/ontology/AdministrativeRegion> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToCity
:linksToCity rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
             rdfs:range <http://dbpedia.org/ontology/City> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToContinent
:linksToContinent rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                  rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                  rdfs:range <http://dbpedia.org/ontology/Continent> ;
                  rdfs:comment "Relation between Ethnic Group and Continent"@en ,
                               "Relazione tra Ethnic Group e Continent"@it ;
                  rdfs:label "links to Continent"@en .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToCountry
:linksToCountry rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                rdfs:range <http://dbpedia.org/ontology/Country> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToEthnicGroup
:linksToEthnicGroup rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://dbpedia.org/ontology/EthnicGroup> ;
                    rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                    rdfs:range <http://dbpedia.org/ontology/EthnicGroup> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToIsland
:linksToIsland rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
               rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
               rdfs:range <http://dbpedia.org/ontology/Island> ;
               rdfs:comment "Relation between Ethnic Group and Island"@en ,
                            "Relazione tra Ethnic Group e Island"@it ;
               rdfs:label "links to Island"@en .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToLanguage
:linksToLanguage rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://dbpedia.org/ontology/Language> ;
                 rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                 rdfs:range <http://dbpedia.org/ontology/Language> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToMilitaryConflict
:linksToMilitaryConflict rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://dbpedia.org/ontology/Event> ;
                         rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                         rdfs:range <http://dbpedia.org/ontology/MilitaryConflict> ;
                         rdfs:comment "Relation between Ethnic Group and Military Conflict"@en ,
                                      "Relazione tra Ethnic Group e Military Conflict"@it ;
                         rdfs:label "links to Military Conflict"@en .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToMusicalArtist
:linksToMusicalArtist rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                      rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                      rdfs:range <http://dbpedia.org/ontology/MusicalArtist> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToOfficeHolder
:linksToOfficeHolder rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                     rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                     rdfs:range <http://dbpedia.org/ontology/OfficeHolder> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToPresident
:linksToPresident rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                  rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                  rdfs:range <http://dbpedia.org/ontology/President> .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToRiver
:linksToRiver rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
              rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
              rdfs:range <http://dbpedia.org/ontology/River> ;
              rdfs:comment "Relation between Ethnic Group and River"@en ,
                           "Relazione tra Ethnic Group e River"@it ;
              rdfs:label "links to River"@en .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToTown
:linksToTown rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
             rdfs:range <http://dbpedia.org/ontology/Town> ;
             rdfs:comment "Relation between Ethnic Group and Town"@en ,
                          "Relazione tra Ethnic Group e Town"@it ;
             rdfs:label "links to Town"@en .


###  file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/ethnicgroup/pattern.owl#linksToWriter
:linksToWriter rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
               rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
               rdfs:range <http://dbpedia.org/ontology/Writer> .


###  http://dbpedia.org/ontology/EthnicGroup
<http://dbpedia.org/ontology/EthnicGroup> rdf:type owl:ObjectProperty .


###  http://dbpedia.org/ontology/Event
<http://dbpedia.org/ontology/Event> rdf:type owl:ObjectProperty ;
                                    rdfs:label "event"@en ,
                                               "évènement"@fr .


###  http://dbpedia.org/ontology/Language
<http://dbpedia.org/ontology/Language> rdf:type owl:ObjectProperty .


###  http://dbpedia.org/ontology/Person
<http://dbpedia.org/ontology/Person> rdf:type owl:ObjectProperty ;
                                     rdfs:label "Person"@de ,
                                                "person"@en ,
                                                "personne"@fr ,
                                                "pessoa"@pt .


###  http://dbpedia.org/ontology/Place
<http://dbpedia.org/ontology/Place> rdf:type owl:ObjectProperty ;
                                    rdfs:label "lieu"@fr ,
                                               "lugar"@pt ,
                                               "place"@en ,
                                               "περιοχή"@el .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
<http://www.w3.org/2004/02/skos/core#relatedMatch> rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/AdministrativeRegion
<http://dbpedia.org/ontology/AdministrativeRegion> rdf:type owl:Class ;
                                                   rdfs:label "administrative region"@en ,
                                                              "région administrative"@fr .


###  http://dbpedia.org/ontology/City
<http://dbpedia.org/ontology/City> rdf:type owl:Class ;
                                   rdfs:comment "a relatively large and permanent settlement, particularly a large urban settlement" ;
                                   rdfs:label "city"@en ,
                                              "cité"@fr .


###  http://dbpedia.org/ontology/Continent
<http://dbpedia.org/ontology/Continent> rdf:type owl:Class ;
                                        rdfs:label "continent"@en ,
                                                   "continent"@fr ,
                                                   "ήπειρος"@el .


###  http://dbpedia.org/ontology/Country
<http://dbpedia.org/ontology/Country> rdf:type owl:Class ;
                                      rdfs:label "Staat"@de ,
                                                 "country"@en ,
                                                 "pays"@fr ,
                                                 "χώρα"@el .


###  http://dbpedia.org/ontology/EthnicGroup
<http://dbpedia.org/ontology/EthnicGroup> rdf:type owl:Class ;
                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToAdministrativeRegion ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/AdministrativeRegion>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToCity ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/City>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToCountry ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/Country>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToEthnicGroup ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/EthnicGroup>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToLanguage ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/Language>
                                                          ] .


###  http://dbpedia.org/ontology/Island
<http://dbpedia.org/ontology/Island> rdf:type owl:Class ;
                                     rdfs:label "island"@en ,
                                                "île"@fr ,
                                                "νησί"@el .


###  http://dbpedia.org/ontology/Language
<http://dbpedia.org/ontology/Language> rdf:type owl:Class .


###  http://dbpedia.org/ontology/MilitaryConflict
<http://dbpedia.org/ontology/MilitaryConflict> rdf:type owl:Class ;
                                               rdfs:label "conflit militaire"@fr ,
                                                          "military conflict"@en .


###  http://dbpedia.org/ontology/MusicalArtist
<http://dbpedia.org/ontology/MusicalArtist> rdf:type owl:Class ;
                                            rdfs:label "artista musical"@pt ,
                                                       "musical artist"@en ,
                                                       "musicien"@fr .


###  http://dbpedia.org/ontology/OfficeHolder
<http://dbpedia.org/ontology/OfficeHolder> rdf:type owl:Class ;
                                           rdfs:label "Amtsinhaber"@de ,
                                                      "office holder"@en ,
                                                      "titulaire"@fr .


###  http://dbpedia.org/ontology/President
<http://dbpedia.org/ontology/President> rdf:type owl:Class ;
                                        rdfs:label "president"@en ,
                                                   "président"@fr .


###  http://dbpedia.org/ontology/River
<http://dbpedia.org/ontology/River> rdf:type owl:Class ;
                                    rdfs:comment "a large natural stream" ;
                                    rdfs:label "river"@en ,
                                               "rivière"@fr .


###  http://dbpedia.org/ontology/Town
<http://dbpedia.org/ontology/Town> rdf:type owl:Class ;
                                   rdfs:comment "a settlement ranging from a few hundred to several thousand (occasionally hundreds of thousands). The precise meaning varies between countries and is not always a matter of legal definition. Usually, a town is thought of as larger than a village but smaller than a city, though there are exceptions to this rule." ;
                                   rdfs:label "town"@en ,
                                              "ville"@fr .


###  http://dbpedia.org/ontology/Writer
<http://dbpedia.org/ontology/Writer> rdf:type owl:Class ;
                                     rdfs:label "writer"@en ,
                                                "écrivain"@fr .


