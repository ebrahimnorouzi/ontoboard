@prefix : <http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#> .
@prefix mq: <http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl#> .
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix ekp: <http://www.ontologydesignpatterns.org/cp/ekp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl> .

<http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl> rdf:type owl:Ontology ;
                                                                 owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ,
                                                                             <http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl> ;
                                                                 dcterms:description "To model the core knowledge needed to describe a EthnicGroup"^^xsd:string ;
                                                                 dcterms:title "Ethnicgroup Pattern"^^xsd:string ;
                                                                 cpa:extractedFrom <http://dbpedia.org/> ,
                                                                                   <http://en.wikipedia.org/> ;
                                                                 cpa:hasAuthor "Andrea Giovanni Nuzzolese" ,
                                                                               "Valentina Presutti" ;
                                                                 cpa:hasIntent "To model the core knowledge needed to describe a EthnicGroup"^^xsd:string ;
                                                                 rdfs:comment "An encyclopedic knowledge pattern (EKP) identifying the core knowledge that describes a EthnicGroup" ,
                                                                              """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x27; label added x20; term declared x6;
- header: dcterms:title \"Ethnicgroup Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> as an annotation property, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom
cpa:extractedFrom rdf:type owl:AnnotationProperty ;
                  rdfs:label "extracted from"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor
cpa:hasAuthor rdf:type owl:AnnotationProperty ;
              rdfs:label "has author"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpa:hasIntent rdf:type owl:AnnotationProperty ;
              rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl#dbpediaInfoboxMatchingWeight
mq:dbpediaInfoboxMatchingWeight rdf:type owl:AnnotationProperty ;
                                rdfs:label "DBpedia infobox matching weight"^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://dbpedia.org/ontology/EthnicGroup
<http://dbpedia.org/ontology/EthnicGroup> rdf:type owl:ObjectProperty .


###  http://dbpedia.org/ontology/Event
<http://dbpedia.org/ontology/Event> rdf:type owl:ObjectProperty ;
                                    rdfs:label "event"@en ;
                                    skos:prefLabel "évènement"@fr .


###  http://dbpedia.org/ontology/Language
<http://dbpedia.org/ontology/Language> rdf:type owl:ObjectProperty .


###  http://dbpedia.org/ontology/Person
<http://dbpedia.org/ontology/Person> rdf:type owl:ObjectProperty ;
                                     rdfs:label "person"@en ;
                                     skos:prefLabel "Person"@de ,
                                                    "personne"@fr ,
                                                    "pessoa"@pt .


###  http://dbpedia.org/ontology/Place
<http://dbpedia.org/ontology/Place> rdf:type owl:ObjectProperty ;
                                    rdfs:label "place"@en ;
                                    skos:prefLabel "lieu"@fr ,
                                                   "lugar"@pt ,
                                                   "περιοχή"@el .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToAdministrativeRegion
:linksToAdministrativeRegion rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                             rdfs:range <http://dbpedia.org/ontology/AdministrativeRegion> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCity
:linksToCity rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
             rdfs:range <http://dbpedia.org/ontology/City> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToContinent
:linksToContinent rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                  rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                  rdfs:range <http://dbpedia.org/ontology/Continent> ;
                  rdfs:comment "Relation between Ethnic Group and Continent"@en ,
                               "Relazione tra Ethnic Group e Continent"@it ;
                  rdfs:label "links to Continent"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCountry
:linksToCountry rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
                rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                rdfs:range <http://dbpedia.org/ontology/Country> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToEthnicGroup
:linksToEthnicGroup rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://dbpedia.org/ontology/EthnicGroup> ;
                    rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                    rdfs:range <http://dbpedia.org/ontology/EthnicGroup> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToIsland
:linksToIsland rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
               rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
               rdfs:range <http://dbpedia.org/ontology/Island> ;
               rdfs:comment "Relation between Ethnic Group and Island"@en ,
                            "Relazione tra Ethnic Group e Island"@it ;
               rdfs:label "links to Island"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToLanguage
:linksToLanguage rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://dbpedia.org/ontology/Language> ;
                 rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                 rdfs:range <http://dbpedia.org/ontology/Language> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToMilitaryConflict
:linksToMilitaryConflict rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://dbpedia.org/ontology/Event> ;
                         rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                         rdfs:range <http://dbpedia.org/ontology/MilitaryConflict> ;
                         rdfs:comment "Relation between Ethnic Group and Military Conflict"@en ,
                                      "Relazione tra Ethnic Group e Military Conflict"@it ;
                         rdfs:label "links to Military Conflict"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToMusicalArtist
:linksToMusicalArtist rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                      rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                      rdfs:range <http://dbpedia.org/ontology/MusicalArtist> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToOfficeHolder
:linksToOfficeHolder rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                     rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                     rdfs:range <http://dbpedia.org/ontology/OfficeHolder> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToPresident
:linksToPresident rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
                  rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
                  rdfs:range <http://dbpedia.org/ontology/President> .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToRiver
:linksToRiver rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
              rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
              rdfs:range <http://dbpedia.org/ontology/River> ;
              rdfs:comment "Relation between Ethnic Group and River"@en ,
                           "Relazione tra Ethnic Group e River"@it ;
              rdfs:label "links to River"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToTown
:linksToTown rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://dbpedia.org/ontology/Place> ;
             rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
             rdfs:range <http://dbpedia.org/ontology/Town> ;
             rdfs:comment "Relation between Ethnic Group and Town"@en ,
                          "Relazione tra Ethnic Group e Town"@it ;
             rdfs:label "links to Town"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToWriter
:linksToWriter rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://dbpedia.org/ontology/Person> ;
               rdfs:domain <http://dbpedia.org/ontology/EthnicGroup> ;
               rdfs:range <http://dbpedia.org/ontology/Writer> .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:ObjectProperty ;
                  rdfs:label "has related match"@en .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/AdministrativeRegion
<http://dbpedia.org/ontology/AdministrativeRegion> rdf:type owl:Class ;
                                                   rdfs:label "administrative region"@en ;
                                                   skos:prefLabel "région administrative"@fr .


###  http://dbpedia.org/ontology/City
<http://dbpedia.org/ontology/City> rdf:type owl:Class ;
                                   rdfs:comment "a relatively large and permanent settlement, particularly a large urban settlement" ;
                                   rdfs:label "city"@en ;
                                   skos:prefLabel "cité"@fr .


###  http://dbpedia.org/ontology/Continent
<http://dbpedia.org/ontology/Continent> rdf:type owl:Class ;
                                        rdfs:label "continent"@en ;
                                        skos:prefLabel "continent"@fr ,
                                                       "ήπειρος"@el .


###  http://dbpedia.org/ontology/Country
<http://dbpedia.org/ontology/Country> rdf:type owl:Class ;
                                      rdfs:label "country"@en ;
                                      skos:prefLabel "Staat"@de ,
                                                     "pays"@fr ,
                                                     "χώρα"@el .


###  http://dbpedia.org/ontology/EthnicGroup
<http://dbpedia.org/ontology/EthnicGroup> rdf:type owl:Class ;
                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToAdministrativeRegion ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/AdministrativeRegion>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToCity ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/City>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToCountry ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/Country>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToEthnicGroup ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/EthnicGroup>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :linksToLanguage ;
                                                            owl:someValuesFrom <http://dbpedia.org/ontology/Language>
                                                          ] .


###  http://dbpedia.org/ontology/Island
<http://dbpedia.org/ontology/Island> rdf:type owl:Class ;
                                     rdfs:label "island"@en ;
                                     skos:prefLabel "île"@fr ,
                                                    "νησί"@el .


###  http://dbpedia.org/ontology/Language
<http://dbpedia.org/ontology/Language> rdf:type owl:Class .


###  http://dbpedia.org/ontology/MilitaryConflict
<http://dbpedia.org/ontology/MilitaryConflict> rdf:type owl:Class ;
                                               rdfs:label "military conflict"@en ;
                                               skos:prefLabel "conflit militaire"@fr .


###  http://dbpedia.org/ontology/MusicalArtist
<http://dbpedia.org/ontology/MusicalArtist> rdf:type owl:Class ;
                                            rdfs:label "musical artist"@en ;
                                            skos:prefLabel "artista musical"@pt ,
                                                           "musicien"@fr .


###  http://dbpedia.org/ontology/OfficeHolder
<http://dbpedia.org/ontology/OfficeHolder> rdf:type owl:Class ;
                                           rdfs:label "office holder"@en ;
                                           skos:prefLabel "Amtsinhaber"@de ,
                                                          "titulaire"@fr .


###  http://dbpedia.org/ontology/President
<http://dbpedia.org/ontology/President> rdf:type owl:Class ;
                                        rdfs:label "president"@en ;
                                        skos:prefLabel "président"@fr .


###  http://dbpedia.org/ontology/River
<http://dbpedia.org/ontology/River> rdf:type owl:Class ;
                                    rdfs:comment "a large natural stream" ;
                                    rdfs:label "river"@en ;
                                    skos:prefLabel "rivière"@fr .


###  http://dbpedia.org/ontology/Town
<http://dbpedia.org/ontology/Town> rdf:type owl:Class ;
                                   rdfs:comment "a settlement ranging from a few hundred to several thousand (occasionally hundreds of thousands). The precise meaning varies between countries and is not always a matter of legal definition. Usually, a town is thought of as larger than a village but smaller than a city, though there are exceptions to this rule." ;
                                   rdfs:label "town"@en ;
                                   skos:prefLabel "ville"@fr .


###  http://dbpedia.org/ontology/Writer
<http://dbpedia.org/ontology/Writer> rdf:type owl:Class ;
                                     rdfs:label "writer"@en ;
                                     skos:prefLabel "écrivain"@fr .


#################################################################
#    Individuals
#################################################################

###  http://dbpedia.org/property/before
<http://dbpedia.org/property/before> rdf:type owl:NamedIndividual ;
                                     rdfs:label "before"@en .


###  http://dbpedia.org/property/caption
<http://dbpedia.org/property/caption> rdf:type owl:NamedIndividual ;
                                      rdfs:label "caption"@en .


###  http://dbpedia.org/property/col
<http://dbpedia.org/property/col> rdf:type owl:NamedIndividual ;
                                  rdfs:label "col"@en .


###  http://dbpedia.org/property/imageCaption
<http://dbpedia.org/property/imageCaption> rdf:type owl:NamedIndividual ;
                                           rdfs:label "image caption"@en .


###  http://dbpedia.org/property/langs
<http://dbpedia.org/property/langs> rdf:type owl:NamedIndividual ;
                                    rdfs:label "langs"@en .


###  http://dbpedia.org/property/languages
<http://dbpedia.org/property/languages> rdf:type owl:NamedIndividual ;
                                        rdfs:label "languages"@en .


###  http://dbpedia.org/property/popplace
<http://dbpedia.org/property/popplace> rdf:type owl:NamedIndividual ;
                                       rdfs:label "popplace"@en .


###  http://dbpedia.org/property/regions
<http://dbpedia.org/property/regions> rdf:type owl:NamedIndividual ;
                                      rdfs:label "regions"@en .


###  http://dbpedia.org/property/related
<http://dbpedia.org/property/related> rdf:type owl:NamedIndividual ;
                                      rdfs:label "related"@en .


###  http://dbpedia.org/property/relatedC
<http://dbpedia.org/property/relatedC> rdf:type owl:NamedIndividual ;
                                       rdfs:label "related c"@en .


###  http://dbpedia.org/property/rels
<http://dbpedia.org/property/rels> rdf:type owl:NamedIndividual ;
                                   rdfs:label "rels"@en .


###  http://dbpedia.org/property/text
<http://dbpedia.org/property/text> rdf:type owl:NamedIndividual ;
                                   rdfs:label "text"@en .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToAdministrativeRegion
:linksToAdministrativeRegion rdf:type owl:NamedIndividual ;
                             skos:relatedMatch <http://dbpedia.org/property/popplace> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToAdministrativeRegion ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/popplace> ;
   mq:dbpediaInfoboxMatchingWeight 100.0
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCity
:linksToCity rdf:type owl:NamedIndividual ;
             skos:relatedMatch <http://dbpedia.org/property/popplace> ,
                               <http://dbpedia.org/property/regions> ,
                               <http://dbpedia.org/property/text> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCity ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/popplace> ;
   mq:dbpediaInfoboxMatchingWeight 36.84
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCity ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/regions> ;
   mq:dbpediaInfoboxMatchingWeight 5.26
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCity ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/text> ;
   mq:dbpediaInfoboxMatchingWeight 57.89
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCountry
:linksToCountry rdf:type owl:NamedIndividual ;
                skos:relatedMatch <http://dbpedia.org/property/before> ,
                                  <http://dbpedia.org/property/popplace> ,
                                  <http://dbpedia.org/property/regions> ,
                                  <http://dbpedia.org/property/relatedC> ,
                                  <http://dbpedia.org/property/text> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCountry ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/before> ;
   mq:dbpediaInfoboxMatchingWeight 8.33
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCountry ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/popplace> ;
   mq:dbpediaInfoboxMatchingWeight 50.0
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCountry ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/regions> ;
   mq:dbpediaInfoboxMatchingWeight 16.67
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCountry ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/relatedC> ;
   mq:dbpediaInfoboxMatchingWeight 8.33
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToCountry ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/text> ;
   mq:dbpediaInfoboxMatchingWeight 16.67
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToEthnicGroup
:linksToEthnicGroup rdf:type owl:NamedIndividual ;
                    skos:relatedMatch <http://dbpedia.org/property/caption> ,
                                      <http://dbpedia.org/property/col> ,
                                      <http://dbpedia.org/property/related> ,
                                      <http://dbpedia.org/property/relatedC> ,
                                      <http://dbpedia.org/property/rels> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToEthnicGroup ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/caption> ;
   mq:dbpediaInfoboxMatchingWeight 0.53
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToEthnicGroup ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/col> ;
   mq:dbpediaInfoboxMatchingWeight 1.05
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToEthnicGroup ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/related> ;
   mq:dbpediaInfoboxMatchingWeight 87.89
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToEthnicGroup ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/relatedC> ;
   mq:dbpediaInfoboxMatchingWeight 10.0
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToEthnicGroup ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/rels> ;
   mq:dbpediaInfoboxMatchingWeight 0.53
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToLanguage
:linksToLanguage rdf:type owl:NamedIndividual ;
                 skos:relatedMatch <http://dbpedia.org/property/langs> ,
                                   <http://dbpedia.org/property/languages> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToLanguage ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/langs> ;
   mq:dbpediaInfoboxMatchingWeight 59.68
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToLanguage ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/languages> ;
   mq:dbpediaInfoboxMatchingWeight 40.32
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToMusicalArtist
:linksToMusicalArtist rdf:type owl:NamedIndividual ;
                      skos:relatedMatch <http://dbpedia.org/property/caption> ,
                                        <http://dbpedia.org/property/imageCaption> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToMusicalArtist ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/caption> ;
   mq:dbpediaInfoboxMatchingWeight 91.67
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToMusicalArtist ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/imageCaption> ;
   mq:dbpediaInfoboxMatchingWeight 8.33
 ] .


###  http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToOfficeHolder
:linksToOfficeHolder rdf:type owl:NamedIndividual ;
                     skos:relatedMatch <http://dbpedia.org/property/caption> ,
                                       <http://dbpedia.org/property/imageCaption> .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToOfficeHolder ;
   owl:annotatedProperty skos:relatedMatch ;
   owl:annotatedTarget <http://dbpedia.org/property/caption> ;
   mq:dbpediaInfoboxMatchingWeight 90.0
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :linksToOfficeHolder ;
