    <!-- http://dbpedia.org/ontology/Event -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/Event">
        <rdfs:label xml:lang="en">event</rdfs:label>
        <skos:prefLabel xml:lang="fr">évènement</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://dbpedia.org/ontology/Language -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/Language"/>
    


    <!-- http://dbpedia.org/ontology/Person -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/Person">
        <rdfs:label xml:lang="en">person</rdfs:label>
        <skos:prefLabel xml:lang="de">Person</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">personne</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">pessoa</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://dbpedia.org/ontology/Place -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/Place">
        <rdfs:label xml:lang="en">place</rdfs:label>
        <skos:prefLabel xml:lang="fr">lieu</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">lugar</skos:prefLabel>
        <skos:prefLabel xml:lang="el">περιοχή</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToAdministrativeRegion -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToAdministrativeRegion">
        <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/Place"/>
        <rdfs:domain rdf:resource="http://dbpedia.org/ontology/EthnicGroup"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/AdministrativeRegion"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCity -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToCity">
        <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/Place"/>
        <rdfs:domain rdf:resource="http://dbpedia.org/ontology/EthnicGroup"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToContinent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToContinent">
