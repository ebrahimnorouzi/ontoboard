        <rdfs:range rdf:resource="http://dbpedia.org/ontology/MusicalArtist"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToOfficeHolder -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToOfficeHolder">
