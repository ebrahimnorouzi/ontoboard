        <rdfs:domain rdf:resource="http://dbpedia.org/ontology/EthnicGroup"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/OfficeHolder"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToPresident -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToPresident">
        <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/Person"/>
        <rdfs:domain rdf:resource="http://dbpedia.org/ontology/EthnicGroup"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/President"/>
