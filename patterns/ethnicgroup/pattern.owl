    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#linksToMilitaryConflict">
        <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/Event"/>
        <rdfs:domain rdf:resource="http://dbpedia.org/ontology/EthnicGroup"/>
