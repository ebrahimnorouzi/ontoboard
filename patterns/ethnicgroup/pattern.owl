<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl#"
     xml:base="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl"
     xmlns:mq="http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl#"
     xmlns:cpa="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:ekp="http://www.ontologydesignpatterns.org/cp/ekp#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/EthnicGroup.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/dbpediainfoboxmatchingweight.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To model the core knowledge needed to describe a EthnicGroup</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ethnicgroup Pattern</dcterms:title>
        <cpa:extractedFrom rdf:resource="http://dbpedia.org/"/>
        <cpa:extractedFrom rdf:resource="http://en.wikipedia.org/"/>
        <cpa:hasAuthor>Andrea Giovanni Nuzzolese</cpa:hasAuthor>
        <cpa:hasAuthor>Valentina Presutti</cpa:hasAuthor>
        <cpa:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To model the core knowledge needed to describe a EthnicGroup</cpa:hasIntent>
        <rdfs:comment>An encyclopedic knowledge pattern (EKP) identifying the core knowledge that describes a EthnicGroup</rdfs:comment>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x27; label added x20; term declared x6;
- header: dcterms:title &quot;Ethnicgroup Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- file: pattern.owl declares &lt;http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor&gt; as an annotation property, as pattern.ttl did
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </owl:Ontology>
    


