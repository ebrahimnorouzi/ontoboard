# Three oysters that are all sold as "oyster": their superseded scientific names, the
# local names used for them, and why a catch record for one may really be another.

@prefix speciesnames: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/speciesnames#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MagallanaGigas a owl:NamedIndividual , speciesnames:AquaticSpecies ;
    rdfs:label "Magallana gigas, the Pacific oyster" ;
    speciesnames:hasSynonym "Crassostrea gigas (Thunberg, 1793)" ,
        "Ostrea gigas Thunberg, 1793" ;
    speciesnames:hasLocalName "Pacific oyster (United Kingdom, trade name)" ,
        "Japanese oyster (United States, Pacific coast)" ,
        "magaki (Japan)" ;
    speciesnames:canBeConfusedWith "Ostrea edulis: the two are farmed in the same beds in Europe and both are sold simply as 'oyster', but M. gigas has a deeply cupped, elongated and strongly fluted shell." .

ex:OstreaEdulis a owl:NamedIndividual , speciesnames:AquaticSpecies ;
    rdfs:label "Ostrea edulis, the European flat oyster" ;
    speciesnames:hasSynonym "Ostrea taurica Krynicki, 1837" ;
    speciesnames:hasLocalName "native oyster (United Kingdom)" ,
        "flat oyster (Ireland)" ;
    speciesnames:canBeConfusedWith "Magallana gigas: landings reported as 'oyster' from Atlantic beds may be either species; O. edulis has a flat, almost circular shell." .

ex:CrassostreaVirginica a owl:NamedIndividual , speciesnames:AquaticSpecies ;
    rdfs:label "Crassostrea virginica, the eastern oyster" ;
    speciesnames:hasSynonym "Ostrea virginica Gmelin, 1791" ;
    speciesnames:hasLocalName "eastern oyster (United States, Atlantic and Gulf coasts)" ;
    speciesnames:canBeConfusedWith "Magallana gigas: both are cupped oysters of the family Ostreidae and both are called 'cupped oyster' in trade statistics." .
