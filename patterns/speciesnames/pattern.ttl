@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "what local names are used for that species? what synonyms exist for that species? can that species be confused with some other one?" ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "Terminological and conceptual similarity between species can be encoded byusing the three properties in this pattern." ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To express the terminological variants and the conceptual similarity that can be sources of confusion between species." ;
                                                                       owl:versionInfo "1.0"^^xsd:string ,
                                                                                       "Created by Aldo Gangemi" .

#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#canBeConfusedWith
:canBeConfusedWith rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AquaticSpecies ;
                   rdfs:range xsd:string ;
                   rdfs:comment "A property for expressing a description of why a species may be confused with another. It may instead/also contain a list of other species with which a species may be confused." ;
                   rdfs:label "can be confused with"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#hasLocalName
:hasLocalName rdf:type owl:DatatypeProperty ;
              rdfs:domain :AquaticSpecies ;
              rdfs:range xsd:string ;
              rdfs:comment "Property to express a species' localname , where it is used , and any additional information like the name of the dialect or more detailed geographical information on where exactly the local-common name is used for the aquatic species in a given country." ;
              rdfs:label "has local name"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#hasSynonym
:hasSynonym rdf:type owl:DatatypeProperty ;
            rdfs:domain :AquaticSpecies ;
            rdfs:range xsd:string ;
            rdfs:comment "Expresses the scientific names that exist for a species but are no longer valid." ;
            rdfs:label "has synonym"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


