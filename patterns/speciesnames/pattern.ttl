@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                       dcterms:description "To express the terminological variants and the conceptual similarity that can be sources of confusion between species."^^xsd:string ;
                                                                       dcterms:title "Speciesnames Pattern"^^xsd:string ;
                                                                       cpannotationschema:coversRequirements "what local names are used for that species? what synonyms exist for that species? can that species be confused with some other one?" ;
                                                                       cpannotationschema:hasConsequences "Terminological and conceptual similarity between species can be encoded byusing the three properties in this pattern." ;
                                                                       cpannotationschema:hasIntent "To express the terminological variants and the conceptual similarity that can be sources of confusion between species."^^xsd:string ;
                                                                       rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x5; term declared x5;
- header: dcterms:title \"Speciesnames Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                       owl:versionInfo "1.0" ,
                                                                                       "Created by Aldo Gangemi" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#canBeConfusedWith
:canBeConfusedWith rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AquaticSpecies ;
                   rdfs:range xsd:string ;
                   rdfs:comment "A property for expressing a description of why a species may be confused with another. It may instead/also contain a list of other species with which a species may be confused." ;
                   rdfs:label "can be confused with"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#hasLocalName
:hasLocalName rdf:type owl:DatatypeProperty ;
              rdfs:domain :AquaticSpecies ;
              rdfs:range xsd:string ;
              rdfs:comment "Property to express a species' localname , where it is used , and any additional information like the name of the dialect or more detailed geographical information on where exactly the local-common name is used for the aquatic species in a given country." ;
              rdfs:label "has local name"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#hasSynonym
:hasSynonym rdf:type owl:DatatypeProperty ;
            rdfs:domain :AquaticSpecies ;
            rdfs:range xsd:string ;
            rdfs:comment "Expresses the scientific names that exist for a species but are no longer valid." ;
            rdfs:label "has synonym"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesnames.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


