#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent
agentrole:Agent rdf:type owl:Class ;
                rdfs:subClassOf objectrole:Object ;
                owl:disjointWith objectrole:Role ;
                cpannotationschema:isCloneOf "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Agent" ;
                rdfs:comment "Any agentive Object , either physical, or social." ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> ;
                rdfs:label "Agent"@en ;
                skos:prefLabel "Agente"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Object
objectrole:Object rdf:type owl:Class ;
                  rdfs:label "Object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Role
objectrole:Role rdf:type owl:Class ;
                rdfs:label "Role"@en .


