# Gene Ontology terms sorted into the pattern's three top categories, on the pattern's own
# scenario: the template activity is part of telomerase activity. partOf is transitive, so a
# reasoner also places the telomerase holoenzyme complex in the nucleus, via the nucleoplasm.

@prefix gotop: <http://www.ontologydesignpatterns.org/cp/owl/gotop.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/go-top#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:TelomeraseActivity a owl:NamedIndividual , gotop:MolecularFunction ;
    rdfs:label "telomerase activity (GO:0003720)" .

ex:TemplateForGRichStrandSynthesis a owl:NamedIndividual , gotop:MolecularFunction ;
    rdfs:label "template for synthesis of G-rich strand of telomere DNA activity (GO:0003721)" ;
    gotop:partOf ex:TelomeraseActivity .

ex:TelomereMaintenance a owl:NamedIndividual , gotop:BiologicalProcess ;
    rdfs:label "telomere maintenance (GO:0000723)" ;
    gotop:partOf ex:ChromosomeOrganization .

ex:ChromosomeOrganization a owl:NamedIndividual , gotop:BiologicalProcess ;
    rdfs:label "chromosome organization (GO:0051276)" .

ex:TelomeraseHoloenzymeComplex a owl:NamedIndividual , gotop:CellularComponent ;
    rdfs:label "telomerase holoenzyme complex (GO:0005697)" ;
    gotop:partOf ex:Nucleoplasm .

ex:Nucleoplasm a owl:NamedIndividual , gotop:CellularComponent ;
    rdfs:label "nucleoplasm (GO:0005654)" ;
    gotop:partOf ex:Nucleus .

ex:Nucleus a owl:NamedIndividual , gotop:CellularComponent ;
    rdfs:label "nucleus (GO:0005634)" .
