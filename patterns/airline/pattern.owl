  <rdf:Description rdf:about="file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/airline/pattern.owl#hasAircraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has Aircraft</rdfs:label>
    <rdfs:comment xml:lang="en">Relation between Airline and Aircraft</rdfs:comment>
    <rdfs:comment xml:lang="it">Relazione tra Airline e Aircraft</rdfs:comment>
    <rdfs:domain rdf:resource="http://dbpedia.org/ontology/Airline"/>
    <rdfs:range rdf:resource="http://dbpedia.org/ontology/Aircraft"/>
    <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/MeanOfTransportation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbpedia.org/ontology/Aircraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="el">αεροσκάφος</rdfs:label>
    <rdfs:label xml:lang="en">aircraft</rdfs:label>
    <rdfs:label xml:lang="fr">avion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbpedia.org/ontology/MeanOfTransportation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">has Aircraft</rdfs:label>
    <rdfs:comment xml:lang="en">Relation between Airline and Aircraft</rdfs:comment>
    <rdfs:comment xml:lang="it">Relazione tra Airline e Aircraft</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/airline/pattern.owl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:extractedFrom rdf:resource="http://dbpedia.org/"/>
    <ns1:extractedFrom rdf:resource="http://en.wikipedia.org/"/>
    <ns1:hasAuthor>Aldo Gangemi</ns1:hasAuthor>
    <ns1:hasAuthor>Andrea Giovanni Nuzzolese</ns1:hasAuthor>
    <ns1:hasAuthor>Valentina Presutti</ns1:hasAuthor>
    <ns1:hasIntent>To represent the encyclopedic knowledge expressed by an object typed as Airline</ns1:hasIntent>
    <rdfs:comment>Airline Encyclopedic Knowledge Pattern</rdfs:comment>
    <owl:imports rdf:resource="file:/schemas/cpannotationschema.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbpedia.org/ontology/Airline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">airline</rdfs:label>
    <rdfs:label xml:lang="fr">compagnie aérienne</rdfs:label>
    <skos:editorialNote xml:lang="en">Axioms were lost when this pattern was harvested: the OWL API could not read part of the source and substituted placeholder classes in http://org.semanticweb.owlapi/error#, which asserted this class to be a subclass of Error1, Error2 and so on. The placeholders are removed here because they carry no information. What they stood for is still in the source: https://ontologydesignpatterns.org/wiki/Submissions:Airline.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent">
