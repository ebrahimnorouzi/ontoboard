@prefix : <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/airline/pattern.owl#> .
@prefix ns1: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/airline/pattern.owl> a owl:Ontology ;
    ns1:extractedFrom <http://dbpedia.org/>,
        <http://en.wikipedia.org/> ;
    ns1:hasAuthor "Aldo Gangemi",
        "Andrea Giovanni Nuzzolese",
        "Valentina Presutti" ;
    ns1:hasIntent "To represent the encyclopedic knowledge expressed by an object typed as Airline" ;
    rdfs:comment "Airline Encyclopedic Knowledge Pattern" ;
    owl:imports <file:/schemas/cpannotationschema.owl> .

:hasAircraft a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "has Aircraft"@en ;
    rdfs:comment "Relation between Airline and Aircraft"@en,
        "Relazione tra Airline e Aircraft"@it ;
    rdfs:domain <http://dbpedia.org/ontology/Airline> ;
    rdfs:range <http://dbpedia.org/ontology/Aircraft> ;
    rdfs:subPropertyOf <http://dbpedia.org/ontology/MeanOfTransportation> .

ns1:extractedFrom a owl:AnnotationProperty .

ns1:hasAuthor a owl:AnnotationProperty .

ns1:hasIntent a owl:AnnotationProperty .

<http://dbpedia.org/ontology/Aircraft> a owl:Class ;
    rdfs:label "αεροσκάφος"@el,
        "aircraft"@en,
        "avion"@fr .

<http://dbpedia.org/ontology/Airline> a owl:Class ;
    rdfs:label "airline"@en,
        "compagnie aérienne"@fr ;
    skos:editorialNote "Axioms were lost when this pattern was harvested: the OWL API could not read part of the source and substituted placeholder classes in http://org.semanticweb.owlapi/error#, which asserted this class to be a subclass of Error1, Error2 and so on. The placeholders are removed here because they carry no information. What they stood for is still in the source: https://ontologydesignpatterns.org/wiki/Submissions:Airline."@en .

<http://dbpedia.org/ontology/MeanOfTransportation> a owl:AnnotationProperty ;
    rdfs:label "has Aircraft"@en ;
    rdfs:comment "Relation between Airline and Aircraft"@en,
        "Relazione tra Airline e Aircraft"@it .

