# Two collections drawn from one conference submission: its keyword set, whose size is
# asserted, and the set of reviewers assigned to it. Because these are sets and not bags,
# naming the same keyword twice would still leave four members.

@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix set: <http://www.ontologydesignpatterns.org/cp/owl/set.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/set#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Submission412Keywords a owl:NamedIndividual ;
    rdfs:label "the keywords of submission 412: ontology design pattern, smart home, SSN, alignment" ;
    rdfs:comment "Typed only by the domain of set:size, which the pattern declares to be a collection." ;
    set:size 4 .

ex:Submission412Reviewers a owl:NamedIndividual , set:Set ;
    rdfs:label "the set of reviewers assigned to submission 412" .

# Only one direction of each inverse pair is asserted: hasMember/isMemberOf. A reasoner adds the other.
