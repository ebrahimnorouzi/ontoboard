    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences">
        <rdfs:label xml:lang="en">has consequences</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent">
        <rdfs:label xml:lang="en">has intent</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isCloneOf -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isCloneOf">
        <rdfs:label xml:lang="en">is clone of</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
        <rdfs:label xml:lang="en">preferred label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasAggregatedMember -->

    <owl:ObjectProperty rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasAggregatedMember">
        <owl:inverseOf rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isAggregatedMemberOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject"/>
        <rdfs:range rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object"/>
        <rdfs:label xml:lang="en">has aggregated member</rdfs:label>
        <skos:prefLabel xml:lang="es">tiene miembro agregado</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasDirectAggregatedMember -->

    <owl:ObjectProperty rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasDirectAggregatedMember">
        <rdfs:subPropertyOf rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasAggregatedMember"/>
        <rdfs:label xml:lang="en">has direct aggregated member</rdfs:label>
        <skos:prefLabel xml:lang="es">tiene miembro agregado directamente</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isAggregatedMemberOf -->

    <owl:ObjectProperty rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isAggregatedMemberOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object"/>
        <rdfs:range rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject"/>
        <rdfs:label xml:lang="en">is aggregated member of</rdfs:label>
        <skos:prefLabel xml:lang="es">es miembro agregado de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isDirectAggregatedMemberOf -->

    <owl:ObjectProperty rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isDirectAggregatedMemberOf">
        <rdfs:subPropertyOf rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isAggregatedMemberOf"/>
        <rdfs:label xml:lang="en">is direct aggregated member of</rdfs:label>
        <skos:prefLabel xml:lang="es">es miembro agregado directamente de</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject -->

    <owl:Class rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasAggregatedMember"/>
                <owl:someValuesFrom rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality"/>
        <owl:disjointWith rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#SimpleObject"/>
        <rdfs:comment xml:lang="en">An object that is an aggregation of two or more objects.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un objeto resultante de la agregación de dos o más objetos.</rdfs:comment>
        <rdfs:label xml:lang="en">Aggregated object</rdfs:label>
        <skos:prefLabel xml:lang="es">Objeto agregado</skos:prefLabel>
    </owl:Class>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object -->

    <owl:Class rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object">
        <owl:equivalentClass rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality"/>
        <cpannotationschema:isCloneOf>http://www.loa-cnr.it/ontologies/DUL.owl#Object</cpannotationschema:isCloneOf>
        <rdfs:comment xml:lang="en">Any physical, social, or mental object, or a substance.</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier objeto físico, social o mental o sustancia.</rdfs:comment>
        <rdfs:label xml:lang="en">Object</rdfs:label>
        <skos:prefLabel xml:lang="es">Objeto</skos:prefLabel>
    </owl:Class>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality -->

    <owl:Class rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject"/>
                    <rdf:Description rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#SimpleObject"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Object by cardinality</rdfs:label>
        <skos:prefLabel xml:lang="es">Objeto por cardinalidad</skos:prefLabel>
    </owl:Class>
    


    <!-- http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#SimpleObject -->

    <owl:Class rdf:about="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#SimpleObject">
        <rdfs:subClassOf rdf:resource="http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality"/>
        <rdfs:comment xml:lang="en">A simple object, that is, an object that has no aggregated objects.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un objeto simple, es decir, un objeto que no tiene objetos agregados.</rdfs:comment>
        <rdfs:label xml:lang="en">Simple object</rdfs:label>
        <skos:prefLabel xml:lang="es">Objeto simple</skos:prefLabel>
    </owl:Class>
</rdf:RDF>



