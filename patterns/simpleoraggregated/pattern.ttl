@prefix : <http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix SimpleOrAggregated: <http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl> .

<http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl> rdf:type owl:Ontology ;
                                                                   owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                   dc:creator "Mari Carmen Suárez Figueroa Baonza" ,
                                                                              "María Poveda" ;
                                                                   dcterms:description "The goal of this pattern is to represent objects that can be simple or aggregated (that is, several objects gathered in another object acting as a whole). The main difference between the aggregation relation and other mereological relationships (such as part of or composition) is that the aggregated object and its aggregated members should belong to the same concept. For example, a turbine is part of an engine, whereas an aggregated provider is formed by providers."^^xsd:string ;
                                                                   dcterms:title "Simpleoraggregated Pattern"^^xsd:string ;
                                                                   cpannotationschema:coversRequirements "What elements are aggregated members of this object?" ,
                                                                                                         "What is this object aggregated member of?" ;
                                                                   cpannotationschema:hasConsequences "This Content OP allows designers to represent aggregations relations." ;
                                                                   cpannotationschema:hasIntent "The goal of this pattern is to represent objects that can be simple or aggregated (that is, several objects gathered in another object acting as a whole). The main difference between the aggregation relation and other mereological relationships (such as part of or composition) is that the aggregated object and its aggregated members should belong to the same concept. For example, a turbine is part of an engine, whereas an aggregated provider is formed by providers. " ;
                                                                   rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label trimmed x1; label moved to skos:prefLabel x8; label added x8; term declared x3;
- header: dcterms:title \"Simpleoraggregated Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty ;
           rdfs:label "Creator"@en .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isCloneOf
cpannotationschema:isCloneOf rdf:type owl:AnnotationProperty ;
                             rdfs:label "is clone of"@en .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasAggregatedMember
SimpleOrAggregated:hasAggregatedMember rdf:type owl:ObjectProperty ;
                                       owl:inverseOf SimpleOrAggregated:isAggregatedMemberOf ;
                                       rdf:type owl:TransitiveProperty ;
                                       rdfs:domain SimpleOrAggregated:AggregatedObject ;
                                       rdfs:range SimpleOrAggregated:Object ;
                                       rdfs:label "has aggregated member"@en ;
                                       skos:prefLabel "tiene miembro agregado"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#hasDirectAggregatedMember
SimpleOrAggregated:hasDirectAggregatedMember rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf SimpleOrAggregated:hasAggregatedMember ;
                                             rdfs:label "has direct aggregated member"@en ;
                                             skos:prefLabel "tiene miembro agregado directamente"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isAggregatedMemberOf
SimpleOrAggregated:isAggregatedMemberOf rdf:type owl:ObjectProperty ,
                                                 owl:TransitiveProperty ;
                                        rdfs:domain SimpleOrAggregated:Object ;
                                        rdfs:range SimpleOrAggregated:AggregatedObject ;
                                        rdfs:label "is aggregated member of"@en ;
                                        skos:prefLabel "es miembro agregado de"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#isDirectAggregatedMemberOf
SimpleOrAggregated:isDirectAggregatedMemberOf rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf SimpleOrAggregated:isAggregatedMemberOf ;
                                              rdfs:label "is direct aggregated member of"@en ;
                                              skos:prefLabel "es miembro agregado directamente de"@es .


#################################################################
#    Classes
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#AggregatedObject
SimpleOrAggregated:AggregatedObject rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                                          owl:onProperty SimpleOrAggregated:hasAggregatedMember ;
                                                          owl:someValuesFrom SimpleOrAggregated:Object
                                                        ] ;
                                    rdfs:subClassOf SimpleOrAggregated:ObjectByCardinality ;
                                    owl:disjointWith SimpleOrAggregated:SimpleObject ;
                                    rdfs:comment "An object that is an aggregation of two or more objects."@en ,
                                                 "Un objeto resultante de la agregación de dos o más objetos."@es ;
                                    rdfs:label "Aggregated object"@en ;
                                    skos:prefLabel "Objeto agregado"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#Object
SimpleOrAggregated:Object rdf:type owl:Class ;
                          owl:equivalentClass SimpleOrAggregated:ObjectByCardinality ;
                          cpannotationschema:isCloneOf "http://www.loa-cnr.it/ontologies/DUL.owl#Object" ;
                          rdfs:comment "Any physical, social, or mental object, or a substance."@en ,
                                       "Cualquier objeto físico, social o mental o sustancia."@es ;
                          rdfs:label "Object"@en ;
                          skos:prefLabel "Objeto"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#ObjectByCardinality
SimpleOrAggregated:ObjectByCardinality rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Class ;
                                                             owl:unionOf ( SimpleOrAggregated:AggregatedObject
                                                                           SimpleOrAggregated:SimpleObject
                                                                         )
                                                           ] ;
                                       rdfs:label "Object by cardinality"@en ;
                                       skos:prefLabel "Objeto por cardinalidad"@es .


###  http://delicias.dia.fi.upm.es/ontologies/SimpleOrAggregated.owl#SimpleObject
SimpleOrAggregated:SimpleObject rdf:type owl:Class ;
                                rdfs:subClassOf SimpleOrAggregated:ObjectByCardinality ;
                                rdfs:comment "A simple object, that is, an object that has no aggregated objects."@en ,
                                             "Un objeto simple, es decir, un objeto que no tiene objetos agregados."@es ;
                                rdfs:label "Simple object"@en ;
                                skos:prefLabel "Objeto simple"@es .


