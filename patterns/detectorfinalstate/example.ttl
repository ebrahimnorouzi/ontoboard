# The pieces an LHC analysis is built from: a dilepton final state near the Z pole
# with jets and large missing energy. Each individual sits in exactly one class,
# because the pattern declares eleven of its classes pairwise disjoint.

@prefix detectorfinalstate: <http://purl.org/net/detectorfinalstate/> .
@prefix ex: <https://w3id.org/ontoboard/example/detectorfinalstate#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:TwoJetsAndMissingEnergy a owl:NamedIndividual , detectorfinalstate:And ;
    rdfs:label "at least two jets and large missing transverse energy" .

ex:AntiKtR04JetDefinition a owl:NamedIndividual , detectorfinalstate:BaseDefinition ;
    rdfs:label "the anti-kt jet definition with radius R = 0.4" .

ex:GreaterThan a owl:NamedIndividual , detectorfinalstate:BinaryRelation ;
    rdfs:label "is greater than" .

ex:MissingTransverseEnergy a owl:NamedIndividual , detectorfinalstate:EventLevelQuantity ;
    rdfs:label "the missing transverse energy of the event" .

ex:NinetyOnePointTwo a owl:NamedIndividual , detectorfinalstate:Number ;
    rdfs:label "91.2, the Z boson mass" .

ex:ElectronPairOrMuonPair a owl:NamedIndividual , detectorfinalstate:Or ;
    rdfs:label "an electron pair or a muon pair" .

ex:DileptonInvariantMass a owl:NamedIndividual , detectorfinalstate:PhysicalQuantity ;
    rdfs:label "the invariant mass of the lepton pair" .

ex:LeadingJet a owl:NamedIndividual , detectorfinalstate:PhysicsObject ;
    rdfs:label "the leading jet in the event" .

ex:GeV a owl:NamedIndividual , detectorfinalstate:Unit ;
    rdfs:label "GeV" .
