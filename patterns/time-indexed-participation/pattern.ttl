#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesEvent
:includesEvent rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> ;
               owl:inverseOf :isEventIncludedIn ;
               rdfs:domain :TimeIndexedParticipation ;
               rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
               rdfs:comment "A relation between situations and events, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included a burning of my fingers)."^^xsd:string ;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> ;
               rdfs:label "include l'evento"@it ,
                          "includes event"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesObject
:includesObject rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> ;
                owl:inverseOf :isObjectIncludedIn ;
                rdfs:domain :TimeIndexedParticipation ;
                rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
                rdfs:comment "A relation between situations and objects, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included me)."^^xsd:string ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> ;
                rdfs:label "include l'oggetto"@it ,
                           "includes object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#isEventIncludedIn
:isEventIncludedIn rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting> ;
                   rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
                   rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> ;
                   rdfs:label "is event included in"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#isObjectIncludedIn
:isObjectIncludedIn rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting> ;
                    rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
                    rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> ;
                    rdfs:label "is object included in"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting> rdf:type owl:ObjectProperty .


