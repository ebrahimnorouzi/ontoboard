@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeindexedparticipation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> rdf:type owl:Ontology ;
                                                                             owl:imports <http://www.ontologydesignpatterns.org/cp/owl/participation.owl> ,
                                                                                         <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> ;
                                                                             dcterms:description "To represent participants in events at some time,To represent participants in parts of events."^^xsd:string ;
                                                                             dcterms:title "Time Indexed Participation Pattern"^^xsd:string ;
                                                                             cpannotationschema:coversRequirements "When something participated in some event?,At what time an event had some participant?" ;
                                                                             cpannotationschema:hasAuthor "Aldo Gangemi" ;
                                                                             cpannotationschema:hasComponent "Participation,Region" ;
                                                                             cpannotationschema:hasConsequences """We can represent participation relations with time. This enables participations at different times as well as partial participations in events.
However, this pattern focuses on participation of one entity in one event. If complex events need to be represented (with subevents, more participants and times, etc.), a partonomic structure must be introduced, e.g. by creating a new pattern that composes TimeIndexedParticipation with PartOf.""" ;
                                                                             cpannotationschema:hasIntent "To represent participants in events at some time,To represent participants in parts of events."^^xsd:string ;
                                                                             cpannotationschema:hasUnitTest """SELECT ?e ?o ?t
WHERE {
?x :includesEvent ?e .
?x :includesObject ?o .
?x :atTime ?t }""" ;
                                                                             cpannotationschema:isSpecializationOf "TimeIndexedSituation" ;
                                                                             cpannotationschema:relatedCPs "Participation,Time indexed person role" ;
                                                                             cpannotationschema:scenarios "This morning I've prepared my coffee and had my fingers burnt,The football match lasted only ten minutes for Totti" ;
                                                                             rdfs:comment "A time-indexed pattern for participation" ,
                                                                                          """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x2; label added x19; term declared x3;
- header: dcterms:title \"Time Indexed Participation Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                             owl:versionInfo """1.0
- Revised and annotated for ODP publishing
0.2
- Revised with specialization from timeindexedsituation.owl
0.1
- Created by Aldo Gangemi"""^^xsd:string ,
                                                                                             "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

