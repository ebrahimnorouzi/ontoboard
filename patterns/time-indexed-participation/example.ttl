# The time-indexed-participation pattern on the scenario the pattern itself gives: "the football
# match lasted only ten minutes for Totti". Plain participation says Totti played in the derby; the
# time-indexed participation is the extra individual that carries the ten minutes, so the match and
# the player can keep their own durations.

@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeindexedparticipation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/time-indexed-participation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:DanieleDeRossi a owl:NamedIndividual , situation:Entity ;
    rdfs:label "Daniele De Rossi, who came on when Totti went off" ;
    situation:hasSetting ex:TheDerbyAsPlayed .

ex:RomaLazioDerby a owl:NamedIndividual , participation:Event ;
    rdfs:label "the Roma-Lazio derby at the Stadio Olimpico" ;
    participation:hasParticipant ex:FrancescoTotti .

ex:FrancescoTotti a owl:NamedIndividual , participation:Object ;
    rdfs:label "Francesco Totti" ;
    participation:isParticipantIn ex:RomaLazioDerby .

ex:TheDerbyAsPlayed a owl:NamedIndividual , situation:Situation ;
    rdfs:label "the derby taken as a situation: the setting that holds the players and the clock together" ;
    situation:isSettingFor ex:DanieleDeRossi .

ex:TottisTenMinutes a owl:NamedIndividual , timeindexedparticipation:TimeIndexedParticipation ;
    rdfs:label "Totti's ten minutes in the derby" ;
    timeindexedparticipation:includesEvent ex:RomaLazioDerby ;
    timeindexedparticipation:includesObject ex:FrancescoTotti .

ex:TottisSpellOnThePitch a owl:NamedIndividual , timeindexedsituation:TimeIndexedSituation ;
    rdfs:label "that spell on the pitch as a plain dated situation - the general shape the participation above refines" ;
    timeindexedsituation:atTime ex:TheOpeningTenMinutes .

ex:TheOpeningTenMinutes a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "the opening ten minutes of the match, 15:00 to 15:10" ;
    timeinterval:hasIntervalDate "2007-03-11" ;
    timeinterval:hasIntervalEndDate "15:10" ;
    timeinterval:hasIntervalStartDate "15:00" .

# Only one direction of each inverse pair is asserted: atTime/isTimeIndexFor, forEntity/hasTimeIndexedSetting, includesEvent/isEventIncludedIn, includesObject/isObjectIncludedIn. A reasoner adds the other.

