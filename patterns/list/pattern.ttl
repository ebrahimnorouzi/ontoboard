@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/list.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/list.owl> rdf:type owl:Ontology ;
                                                         owl:imports <http://www.ontologydesignpatterns.org/cp/owl/bag.owl> ,
                                                                     <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> ;
                                                         dcterms:description "To represent ordered collections, i.e. lists."^^xsd:string ;
                                                         dcterms:title "List Pattern"^^xsd:string ;
                                                         cpannotationschema:coversRequirements "What are the items (elements) in this list?"^^xsd:string ,
                                                                                               "What is the first/last item in this list?"^^xsd:string ,
                                                                                               "What is the length (size) of this list?"^^xsd:string ,
                                                                                               "What it the next/previous item in the list?"^^xsd:string ,
                                                                                               "What resource does this list item contain?"^^xsd:string ;
                                                         cpannotationschema:extractedFrom "http://swan.mindinformatics.org/ontologies/1.2/collections.owl"^^xsd:string ;
                                                         cpannotationschema:hasAuthor "PaoloCiccarese"^^xsd:string ;
                                                         cpannotationschema:hasComponent "http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl"^^xsd:string ,
                                                                                         "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"^^xsd:string ;
                                                         cpannotationschema:hasIntent "To represent ordered collections, i.e. lists."^^xsd:string ;
                                                         cpannotationschema:isSpecializationOf "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"^^xsd:string ;
                                                         cpannotationschema:reengineeredFrom "http://swan.mindinformatics.org/ontologies/1.2/collections.owl"^^xsd:string ;
                                                         cpannotationschema:relatedCPs "http://www.ontologydesignpatterns.org/cp/owl/bag.owl"^^xsd:string ,
                                                                                       "http://www.ontologydesignpatterns.org/cp/owl/set.owl"^^xsd:string ;
                                                         rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x16; term declared x16;
- header: dcterms:title \"List Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                         owl:versionInfo "Created with TopBraid Composer"^^xsd:string .

