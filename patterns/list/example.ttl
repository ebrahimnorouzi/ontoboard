ex:Bag1 a owl:NamedIndividual , bag:Bag ;
    rdfs:label "a (collections) Bag" ;
    bag:hasItem ex:Item1 .

ex:Entity1 a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "an Entity" ;
    sequence:directlyFollows ex:Entity2 ;
    sequence:directlyPrecedes ex:Entity2 ;
    sequence:follows ex:Entity2 ;
    sequence:precedes ex:Entity2 .

ex:Entity2 a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "an Entity (another)" .

ex:Item1 a owl:NamedIndividual , bag:Item ;
    rdfs:label "an item" .

ex:List1 a owl:NamedIndividual , list:List ;
    rdfs:label "a list" ;
    list:hasLastItem ex:ListItem1 .

ex:ListItem1 a owl:NamedIndividual , list:ListItem ;
    rdfs:label "a list item" ;
    list:firstItemOf ex:List1 ;
    list:nextItem ex:ListItem2 .

ex:ListItem2 a owl:NamedIndividual , list:ListItem ;
