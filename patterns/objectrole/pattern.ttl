@prefix : <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> rdf:type owl:Ontology ;
                                                               owl:imports <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> ,
                                                                           <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                               dcterms:description "To represents objects and the roles they play."^^xsd:string ;
                                                               dcterms:title "Objectrole Pattern"^^xsd:string ;
                                                               cpannotationschema:coversRequirements "What role does this object play? which objects do play that role?"^^xsd:string ;
                                                               cpannotationschema:extractedFrom "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl" ;
                                                               cpannotationschema:hasConsequences "It is possible to make asser tions about roles, which are typically considered at the meta-level of an ontology. Instances of Role reify such elements, which are therefore put in the ordinar y domain of an ontology. It is not possible to parametrize the classiﬁcation over different dimensions e.g., time, space, etc."^^xsd:string ;
                                                               cpannotationschema:hasIntent "To represents objects and the roles they play."^^xsd:string ;
                                                               cpannotationschema:isSpecializationOf "http://www.ontologydesignpatterns.org/cp/owl/classification.owl" ;
                                                               cpannotationschema:relatedCPs "It specializes the classiﬁcation CP. It is specialized by agent role."^^xsd:string ;
                                                               cpannotationschema:scenarios "This old glass is used as a ﬂower pot."^^xsd:string ;
                                                               rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x4; label added x13; term declared x3;
- header: dcterms:title \"Objectrole Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                            "It is extracted from DOLCE Ultra Lite ontology and specialize the classification CP. Object is an Entity, and Role is a Concept. The hasRole relation specializes the classifies relation, while the isRoleOf specializes the isClassifiedBy relation." ;
                                                               owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                               "Created by Valentina Presutti"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom
cpannotationschema:extractedFrom rdf:type owl:AnnotationProperty ;
                                 rdfs:label "extracted from"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
cpannotationschema:isSpecializationOf rdf:type owl:AnnotationProperty ;
                                      rdfs:label "is specialization of"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs
cpannotationschema:relatedCPs rdf:type owl:AnnotationProperty ;
                              rdfs:label "related c ps"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies
classification:classifies rdf:type owl:ObjectProperty ;
                          rdfs:label "classifies"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy
classification:isClassifiedBy rdf:type owl:ObjectProperty ;
                              rdfs:label "isClassifiedBy"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#hasRole
objectrole:hasRole rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf classification:isClassifiedBy ;
                   owl:inverseOf objectrole:isRoleOf ;
                   rdfs:domain objectrole:Object ;
                   rdfs:range objectrole:Role ;
                   rdfs:comment "A relation between an object and a role, e.g. the person 'John' has role 'student'."^^xsd:string ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ;
                   rdfs:label "has role"@en ;
                   skos:prefLabel "ha ruolo"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#isRoleOf
objectrole:isRoleOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf classification:classifies ;
                    rdfs:domain objectrole:Role ;
                    rdfs:range objectrole:Object ;
                    rdfs:comment "A relation between an object and a role, e.g. the 'student' is the role of 'John'." ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ;
                    rdfs:label "is role of"@en ;
                    skos:prefLabel "è un ruolo di"@it .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept
classification:Concept rdf:type owl:Class ;
                       rdfs:label "Concept"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Object
objectrole:Object rdf:type owl:Class ;
                  rdfs:comment "Any physical, social, or mental object, or a substance"^^xsd:string ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ;
                  rdfs:label "Object"@en ;
                  skos:prefLabel "Oggetto"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Role
objectrole:Role rdf:type owl:Class ;
                rdfs:subClassOf classification:Concept ;
                rdfs:comment "A Concept that classifies an Object"^^xsd:string ;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ;
                rdfs:label "Role"@en ;
                skos:prefLabel "Ruolo"@it .


