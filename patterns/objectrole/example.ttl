# A jam jar, a tomato tin and a cracked teapot, all kept because they make good flower pots.
# This is the pattern's own scenario ("this old glass is used as a flower pot"): one Role played
# by three quite different Objects, over the plain Concept/Entity classification it specialises.

@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/objectrole#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ContainerGardening a owl:NamedIndividual , classification:Concept ;
    rdfs:label "container gardening" ;
    classification:classifies ex:WindowsillHerbGarden .

ex:WindowsillHerbGarden a owl:NamedIndividual , classification:Entity ;
    rdfs:label "the herb garden on the kitchen windowsill" ;
    classification:isClassifiedBy ex:ContainerGardening .

ex:OldJamJar a owl:NamedIndividual , objectrole:Object ;
    rdfs:label "the empty jam jar kept from last summer" ;
    objectrole:hasRole ex:FlowerPot .

ex:TomatoTin a owl:NamedIndividual , objectrole:Object ;
    rdfs:label "a rinsed tomato tin with holes punched in its base" ;
    objectrole:hasRole ex:FlowerPot .

ex:CrackedTeapot a owl:NamedIndividual , objectrole:Object ;
    rdfs:label "the teapot whose spout broke off" ;
    objectrole:hasRole ex:FlowerPot .

ex:FlowerPot a owl:NamedIndividual , objectrole:Role ;
    rdfs:label "flower pot" .

# Only one direction of each inverse pair is asserted: hasRole/isRoleOf. A reasoner adds the other.
