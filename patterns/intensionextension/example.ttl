# Three pieces of information, the meaning each one expresses, and - for two of them -
# the thing out in the world they are about. The name on the airport signage expresses
# a designation and is about the airport itself; the two are not the same entity.

@prefix intensionextension: <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/intensionextension#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:LeonardoDaVinciName a owl:NamedIndividual , intensionextension:InformationObject ;
    rdfs:label "the name \"Leonardo da Vinci\" on the terminal signage" ;
    intensionextension:expresses ex:RomeAirportDesignation ;
    intensionextension:isAbout ex:FiumicinoAirport .

ex:RomeAirportDesignation a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the official designation of Rome's main airport" .

ex:FiumicinoAirport a owl:NamedIndividual , owl:Thing ;
    rdfs:label "the airport at Fiumicino, west of Rome" .

ex:LegalPersonTerm a owl:NamedIndividual , intensionextension:InformationObject ;
    rdfs:label "the term \"legal person\" as used in company law" ;
    intensionextension:expresses ex:LegalPersonConcept .

ex:LegalPersonConcept a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the concept of an incorporated entity holding legal status" .

ex:GiveWaySign a owl:NamedIndividual , intensionextension:InformationObject ;
    rdfs:label "the inverted red triangle painted at the depot gate" ;
    intensionextension:expresses ex:GiveWayRule ;
    intensionextension:isAbout ex:DepotJunction .

ex:GiveWayRule a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the rule that traffic leaving the depot must give way" .

ex:DepotJunction a owl:NamedIndividual , owl:Thing ;
    rdfs:label "the junction where the depot road meets the main road" .

# Only one direction of each inverse pair is asserted: expresses/isExpressedBy, isAbout/isReferenceOf. A reasoner adds the other.

