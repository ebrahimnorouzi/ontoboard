# Where things are: a hospital and a bridge located in the city of Heidelberg, and two
# weather instruments located at a geographic coordinate on the hospital roof.

@prefix place: <http://www.ontologydesignpatterns.org/cp/owl/place.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/spatial-object#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:CityOfHeidelberg a owl:NamedIndividual , place:Place ;
    rdfs:label "the city of Heidelberg" ;
    place:isLocationOf ex:UniversityHospital , ex:OldBridge .

ex:UniversityHospital a owl:NamedIndividual , place:SpatialObject ;
    rdfs:label "Heidelberg University Hospital" ;
    place:hasLocation ex:CityOfHeidelberg .

ex:OldBridge a owl:NamedIndividual , place:SpatialObject ;
    rdfs:label "the Old Bridge over the Neckar" ;
    place:hasLocation ex:CityOfHeidelberg .

ex:Coordinate_49_4094N_8_6724E a owl:NamedIndividual , place:Place ;
    rdfs:label "the point 49.4094 N, 8.6724 E on the hospital roof" ;
    place:isLocationOf ex:AirTemperatureSensor , ex:RainGauge .

ex:AirTemperatureSensor a owl:NamedIndividual , place:SpatialObject ;
    rdfs:label "air temperature sensor TMP-204" ;
    place:hasLocation ex:Coordinate_49_4094N_8_6724E .

ex:RainGauge a owl:NamedIndividual , place:SpatialObject ;
    rdfs:label "tipping-bucket rain gauge RG-11" ;
    place:hasLocation ex:Coordinate_49_4094N_8_6724E .
