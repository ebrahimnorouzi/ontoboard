<http://www.ontologydesignpatterns.org/cp/owl/place.owl> rdf:type owl:Ontology ;
                                                          rdfs:comment "Represents spatial entities and their locations. Used for geographical and spatial modeling." ;
                                                          rdfs:label "Place (Spatial Object) Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain :SpatialObject ;
             rdfs:range :Place ;
             rdfs:label "hasLocation" .


###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#isLocationOf
:isLocationOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Place ;
              rdfs:range :SpatialObject ;
              rdfs:label "isLocationOf" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#Place
:Place rdf:type owl:Class ;
       rdfs:label "Place" .


###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#SpatialObject
:SpatialObject rdf:type owl:Class ;
               rdfs:label "Spatial Object" .


