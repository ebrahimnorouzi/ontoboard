                                                                       "Represents spatial entities and their locations. Used for geographical and spatial modeling."^^xsd:string ;
                                                          rdfs:label "Place (Spatial Object) Pattern"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain :SpatialObject ;
             rdfs:range :Place ;
             rdfs:label "hasLocation" .


###  http://www.ontologydesignpatterns.org/cp/owl/place.owl#isLocationOf
:isLocationOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Place ;
              rdfs:range :SpatialObject ;
              rdfs:label "isLocationOf" .


#################################################################
