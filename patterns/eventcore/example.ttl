# The eventcore pattern on the scenario its own documentation gives: the 1990 World Chess
# Championship Match, played in New York from 8 October to 7 November and in Lyons from
# 26 November to 30 December. The match is one event with a discontinuous extent - two
# sub-events, each with its own spatio-temporal extent, both sub-extents of the match's -
# and it provides the two participant roles its players held.

@prefix event: <http://w3id.org/daselab/onto/event#> .
@prefix ex: <https://w3id.org/ontoboard/example/eventcore#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:WorldChessChampionship1990 a owl:NamedIndividual , event:Event ;
    rdfs:label "the 1990 World Chess Championship Match" ;
    event:hasSpatioTemporalExtent ex:MatchExtent ;
    event:providesParticipantRole ex:DefendingChampionRole ;
    event:providesParticipantRole ex:ChallengerRole ;
    event:hasInformationObject ex:MatchReport .

ex:NewYorkHalf a owl:NamedIndividual , event:Event ;
    rdfs:label "the New York half of the match, games 1 to 12" ;
    event:subEventOf ex:WorldChessChampionship1990 ;
    event:hasSpatioTemporalExtent ex:NewYorkExtent .

ex:LyonsHalf a owl:NamedIndividual , event:Event ;
    rdfs:label "the Lyons half of the match, games 13 to 24" ;
    event:subEventOf ex:WorldChessChampionship1990 ;
    event:hasSpatioTemporalExtent ex:LyonsExtent .

ex:MatchExtent a owl:NamedIndividual , event:SpatioTemporalExtent ;
    rdfs:label "the extent of the match: two cities, autumn 1990" .

ex:NewYorkExtent a owl:NamedIndividual , event:SpatioTemporalExtent ;
    rdfs:label "New York, 8 October to 7 November 1990" ;
    event:subSpatioTemporalExtentOf ex:MatchExtent .

ex:LyonsExtent a owl:NamedIndividual , event:SpatioTemporalExtent ;
    rdfs:label "Lyons, 26 November to 30 December 1990" ;
    event:subSpatioTemporalExtentOf ex:MatchExtent .

ex:DefendingChampionRole a owl:NamedIndividual , event:ParticipantRole ;
    rdfs:label "the defending champion role, held by Garry Kasparov" .

ex:ChallengerRole a owl:NamedIndividual , event:ParticipantRole ;
    rdfs:label "the challenger role, held by Anatoly Karpov" .

ex:MatchReport a owl:NamedIndividual , event:InformationObject ;
    rdfs:label "the match report, final score 12.5 to 11.5" .

# The pattern's own rules do the rest: a sub-event's participant roles are also the parent
# event's, and the extent of a sub-event is a sub-extent of the parent event's extent.
