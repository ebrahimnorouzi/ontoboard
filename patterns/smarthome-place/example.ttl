# One flat as a smart home: three sections that are its parts, a sensor deployment it is a
# platform for, and a physical object that one section is the location of. These are the
# three edges the pattern's own restrictions on SmartHome and SmartHomeSection call for,
# and between them they answer all three of its competency questions.

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix smarthomegeometry: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Geometry.owl#> .
@prefix smarthomeplace: <http://ecareathome-ontology.mpi.aass.oru.se/patterns/SmartHome_Place.owl#> .
@prefix ssn: <http://purl.oclc.org/NET/ssnx/ssn#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-place#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Flat3B a owl:NamedIndividual , smarthomeplace:SmartHome ;
    rdfs:label "flat 3B, Lindenweg 14, instrumented as a smart home" ;
    ssn:inDeployment ex:ECareDeployment ;
    dul:hasPart ex:LivingRoom ,
        ex:Kitchen ,
        ex:Bedroom .

ex:ECareDeployment a owl:NamedIndividual , ssn:Deployment ;
    rdfs:label "the e-care sensor deployment installed in flat 3B in March 2017" .

ex:LivingRoom a owl:NamedIndividual , smarthomeplace:SmartHomeSection ;
    rdfs:label "the living room of flat 3B" ;
    dul:isLocationOf ex:Couch .

ex:Kitchen a owl:NamedIndividual , smarthomeplace:SmartHomeSection ;
    rdfs:label "the kitchen of flat 3B" .

ex:Bedroom a owl:NamedIndividual , smarthomeplace:SmartHomeSection ;
    rdfs:label "the bedroom of flat 3B" .

ex:Couch a owl:NamedIndividual , dul:PhysicalObject ;
    rdfs:label "the three-seat couch in the living room of flat 3B" .

# Only one direction of each DUL pair is asserted: hasPart, not isPartOf; isLocationOf, not
# hasLocation. A reasoner with DUL loaded adds the other.
