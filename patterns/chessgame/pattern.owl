        <rdfs:label>hasFirstHalfMove</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/NET/rdfchess/ontology/hasHalfMove -->

    <owl:ObjectProperty rdf:about="http://purl.org/NET/rdfchess/ontology/hasHalfMove">
