    </owl:ObjectProperty>
    


    <!-- http://purl.org/NET/rdfchess/ontology/hasFirstHalfMove -->

    <owl:ObjectProperty rdf:about="http://purl.org/NET/rdfchess/ontology/hasFirstHalfMove">
