# Kasparov - Topalov, round 4 of the 1999 Hoogovens tournament at Wijk aan Zee:
# the game that the competency questions ask about. The two seats at the board are
# roles, so the same man can also hold the author role of his published commentary.

@prefix ontology: <http://purl.org/NET/rdfchess/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/chessgame#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:KasparovToMoveAt24 a owl:NamedIndividual , ontology:ActingPlayerRole ;
    rdfs:label "Kasparov, the player to move at 24.Rxd4" .

ex:GarryKasparov a owl:NamedIndividual , ontology:Agent ;
    rdfs:label "Garry Kasparov" .

ex:KasparovAsCommentator a owl:NamedIndividual , ontology:AuthorRole ;
    rdfs:label "Kasparov as author of the published commentary" .

ex:TopalovAsBlack a owl:NamedIndividual , ontology:BlackPlayerRole ;
    rdfs:label "Veselin Topalov playing Black" .

ex:HoogovensTournament a owl:NamedIndividual , ontology:ChessCompetitionSeries ;
    rdfs:label "the Hoogovens tournament, held every January since 1938" .

ex:WijkAanZee a owl:NamedIndividual , ontology:Place ;
    rdfs:label "Wijk aan Zee, Netherlands" .

ex:TwentiethJanuary1999 a owl:NamedIndividual , ontology:TemporalExtent ;
    rdfs:label "20 January 1999" .

ex:KasparovAsWhite a owl:NamedIndividual , ontology:WhitePlayerRole ;
    rdfs:label "Garry Kasparov playing White" .
