@prefix : <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix region: <http://www.ontologydesignpatterns.org/cp/owl/region.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix taskrole: <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#> .
@prefix basicplan: <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#> .
@prefix parameter: <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix description: <http://www.ontologydesignpatterns.org/cp/owl/description.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix basicplanexecution: <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#> .
@prefix basicplandescription: <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> rdf:type owl:Ontology ;
                                                              owl:imports <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/cp/owl/region.owl> ,
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                              dcterms:description "The basic plans. This content ontology design patterns represents plans descriptions and their executions. It is defined by combining and expanding other CPs: basic plans description, basic plans execution, and object role. Expansion involves the partial clone of ontology elements from DOLCE Ultra Lite and Plans Lite ontologies."^^xsd:string ;
                                                              dcterms:title "Basicplan Pattern"^^xsd:string ;
                                                              rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x8; label added x23; term declared x3;
- header: dcterms:title \"Basicplan Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                           "The basic plans. This content ontology design patterns represents plans descriptions and their executions. It is defined by combining and expanding other CPs: basic plans description, basic plans execution, and object role. Expansion involves the partial clone of ontology elements from DOLCE Ultra Lite and Plans Lite ontologies."^^xsd:string ;
                                                              owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                              "Created by Valentina Presutti"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#conceptualizes
basicplan:conceptualizes rdf:type owl:ObjectProperty ;
                         owl:inverseOf basicplan:isConceptualizedBy ;
                         rdfs:domain basicplanexecution:Agent ;
                         rdfs:range basicplandescription:Plan ;
                         rdfs:comment "A relation stating that an Agent is internally representing a SocialObject . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created the solar-system metaphor for the atomic theory'; 'Jacques assumes all swans are white'; 'the task force members share the attack plan'." ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                         rdfs:label "conceptualizes"@en ;
                         skos:prefLabel "concettualizza"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#executesTask
basicplan:executesTask rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf classification:isClassifiedBy ;
                       owl:inverseOf basicplan:isExecutedIn ;
                       rdfs:domain basicplanexecution:Action ;
                       rdfs:range taskrole:Task ;
                       rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'."^^xsd:string ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                       rdfs:label "executes task"@en ;
                       skos:prefLabel "esegue il task"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#isConceptualizedBy
basicplan:isConceptualizedBy rdf:type owl:ObjectProperty ;
                             rdfs:domain basicplandescription:Plan ;
                             rdfs:range basicplanexecution:Agent ;
                             rdfs:comment "A relation stating that an Agent is internally representing a Description . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created a solar-system metaphor for his atomic theory'; 'Jacques assumes all swans are white'; 'the task force shares the attack plan'." ;
                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                             rdfs:label "is conceptualized by"@en ;
                             skos:prefLabel "è concettualizzato da"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#isExecutedIn
basicplan:isExecutedIn rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf classification:classifies ;
                       rdfs:domain taskrole:Task ;
                       rdfs:range basicplanexecution:Action ;
                       rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                       rdfs:label "is executed in"@en ;
                       skos:prefLabel "è eseguito mediante"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#isParametrizedBy
basicplan:isParametrizedBy rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf classification:isClassifiedBy ;
                           owl:inverseOf basicplan:parametrizes ;
                           rdfs:domain region:Region ;
                           rdfs:range parameter:Parameter ;
                           rdfs:comment "The relation between a Parameter, e.g. 'MajorAge', and a Region, e.g. '>17 year'." ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                           rdfs:label "is parametrized by"@en ;
                           skos:prefLabel "è parametrizzato da"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#isSatisfiedBy
basicplan:isSatisfiedBy rdf:type owl:ObjectProperty ;
                        owl:inverseOf basicplan:satisfies ;
                        rdfs:domain description:Description ;
                        rdfs:range situation:Situation ;
                        rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan." ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                        rdfs:label "is satisfied by"@en ;
                        skos:prefLabel "è soddisfatta da"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#parametrizes
basicplan:parametrizes rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf classification:classifies ;
                       rdfs:domain parameter:Parameter ;
                       rdfs:range region:Region ;
                       rdfs:comment """The relation between a Parameter, e.g. 'MajorAgeLimit', and a Region, e.g. '18_year'.
For a more data-oriented relation, see hasDataValue""" ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                       rdfs:label "parametrizes"@en ;
                       skos:prefLabel "parametrizza"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#satisfies
basicplan:satisfies rdf:type owl:ObjectProperty ;
                    rdfs:domain situation:Situation ;
                    rdfs:range description:Description ;
                    rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan."^^xsd:string ;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                    rdfs:label "satisfies"@en ;
                    skos:prefLabel "soddisfa"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies
classification:classifies rdf:type owl:ObjectProperty ;
                          rdfs:label "classifies"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy
classification:isClassifiedBy rdf:type owl:ObjectProperty ;
                              rdfs:label "isClassifiedBy"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#isRoleOf
objectrole:isRoleOf rdf:type owl:ObjectProperty ;
                    rdfs:label "is role of"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#GoalSituation
basicplan:GoalSituation rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( situation:Situation
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty basicplan:satisfies ;
                                                                     owl:someValuesFrom basicplandescription:Goal
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf situation:Situation ;
                        rdfs:comment "A goal situation is a situation that satisfies a goal.Opposite to the case of subplan executions, a goal situation is not part of a plan execution.In other words, it is not true in general that any situation satisfying a part of a description, is also part of the situation that satisfies the whole description. This helps to account for the following cases: a) Execution of plans containing abort or suspension conditions (the plan would be satisfied even if the goal has not been reached, see below), b) Incidental satisfaction, like when a situation satisfies a goal without being intentionally planned (but anyway desired)."^^xsd:string ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ;
                        rdfs:label "Goal situation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Goal
basicplandescription:Goal rdf:type owl:Class ;
                          rdfs:label "goal"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan
basicplandescription:Plan rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty basicplan:isSatisfiedBy ;
                                            owl:allValuesFrom basicplanexecution:PlanExecution
                                          ] ;
                          rdfs:label "plan"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#Action
basicplanexecution:Action rdf:type owl:Class ;
                          rdfs:label "Action"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#Agent
basicplanexecution:Agent rdf:type owl:Class ;
                         owl:disjointWith description:Concept ;
                         rdfs:label "agent"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution
basicplanexecution:PlanExecution rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( situation:Situation
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty basicplan:satisfies ;
                                                                              owl:someValuesFrom basicplandescription:Plan
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty basicplan:satisfies ;
                                                   owl:allValuesFrom basicplandescription:Plan
                                                 ] ;
                                 rdfs:label "Plan execution"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept
classification:Concept rdf:type owl:Class ;
                       owl:equivalentClass description:Concept ,
                                           parameter:Concept ;
                       rdfs:label "Concept (classification)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Concept
description:Concept rdf:type owl:Class ;
                    owl:disjointWith situation:Situation ;
                    rdfs:label "Concept (description)"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description
description:Description rdf:type owl:Class ;
                        rdfs:label "Description"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Object
objectrole:Object rdf:type owl:Class ;
                  owl:equivalentClass participation:Object ;
                  rdfs:label "Object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Role
objectrole:Role rdf:type owl:Class ;
                owl:equivalentClass taskrole:Role ;
                rdfs:label "Role (objectrole)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#Concept
parameter:Concept rdf:type owl:Class ;
                  rdfs:label "Concept"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#Parameter
parameter:Parameter rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty basicplan:parametrizes ;
                                      owl:allValuesFrom region:Region
                                    ] ;
                    owl:disjointWith taskrole:Role ;
                    rdfs:label "Parameter"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object
participation:Object rdf:type owl:Class ;
                     rdfs:label "Object"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/region.owl#Region
region:Region rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty basicplan:isParametrizedBy ;
                                owl:allValuesFrom parameter:Parameter
                              ] ;
              rdfs:label "Region"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
situation:Situation rdf:type owl:Class ;
                    rdfs:label "Situation"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Role
taskrole:Role rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty objectrole:isRoleOf ;
                                owl:allValuesFrom objectrole:Object
                              ] ;
              rdfs:label "Role (taskrole)"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Task
taskrole:Task rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty basicplan:isExecutedIn ;
                                owl:allValuesFrom basicplanexecution:Action
                              ] ;
              rdfs:label "Task"@en .


