<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/move.owl#"
     xml:base="http://www.ontologydesignpatterns.org/cp/owl/move.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:move="http://www.ontologydesignpatterns.org/cp/owl/move.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/move.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The move content ontology design pattern. This CP represents the action of moving a physical object from a place to another. The move CP is extracted from the CIDOC ontology.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Move Pattern</dcterms:title>
        <cpannotationschema:extractedFrom>http://cidoc.ics.forth.gr/cidoc_v4.2.owl</cpannotationschema:extractedFrom>
        <cpannotationschema:reengineeredFrom>http://cidoc.ics.forth.gr/cidoc_v4.2.owl</cpannotationschema:reengineeredFrom>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x4; term declared x2;
- header: dcterms:title &quot;Move Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The move content ontology design pattern. This CP represents the action of moving a physical object from a place to another. The move CP is extracted from the CIDOC ontology.</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.1 added rdfs:isDefinedBy for all named entities</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Created by Aldo Gangemi and Valentina Presutti</owl:versionInfo>
    </owl:Ontology>
    


