# A museum loan, in the CIDOC sense: a painting is moved from a storeroom in
# Karlsruhe to a gallery in Frankfurt, by road, and the transfer is made up of a
# shorter leg. movedFrom and movedTo are the endpoints; tookPlaceAt is the route.

@prefix move: <http://www.ontologydesignpatterns.org/cp/owl/move.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/move#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:WaterLiliesLoanTransfer a owl:NamedIndividual , move:Move ;
    rdfs:label "the loan transfer of the Water Lilies canvas, March 2024" ;
    move:consistsOf ex:RoadLegKarlsruheFrankfurt ;
    move:moved ex:WaterLiliesCanvas ;
    move:movedFrom ex:KunsthalleStoreroom ;
    move:movedTo ex:StaedelGalleryThree ;
    move:tookPlaceAt ex:A5Autobahn .

ex:RoadLegKarlsruheFrankfurt a owl:NamedIndividual , move:Move ;
    rdfs:label "the road leg of that transfer, Karlsruhe to Frankfurt" .

ex:WaterLiliesCanvas a owl:NamedIndividual , move:PhysicalObject ;
    rdfs:label "the Water Lilies canvas, inventory no. 1904-12" .

ex:KunsthalleStoreroom a owl:NamedIndividual , move:Place ;
    rdfs:label "storeroom B of the Kunsthalle, Karlsruhe" .

ex:StaedelGalleryThree a owl:NamedIndividual , move:Place ;
    rdfs:label "gallery 3 of the Staedel Museum, Frankfurt" .

ex:A5Autobahn a owl:NamedIndividual , move:Place ;
    rdfs:label "the A5 autobahn, the route the transfer took" .

# Only one direction of each inverse pair is asserted: consistsOf/formsPartOf, moved/movedBy, movedFrom/wasOriginOf, movedTo/wasDestinationOf, tookPlaceAt/witnessed. A reasoner adds the other.
