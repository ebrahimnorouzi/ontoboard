@base <http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl> rdf:type owl:Ontology ;
                                                                    rdfs:comment "Two or more objects co-participate in the same event." ;
                                                                    rdfs:label "Co-Participation Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl#coParticipatesWith
:coParticipatesWith rdf:type owl:ObjectProperty ;
                    rdfs:domain :Object ;
                    rdfs:range :Object ;
                    rdfs:label "coParticipatesWith" .


###  http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl#hasParticipant
:hasParticipant rdf:type owl:ObjectProperty ;
                rdfs:domain :Event ;
                rdfs:range :Object ;
                rdfs:label "hasParticipant" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl#Event
:Event rdf:type owl:Class ;
       rdfs:label "Event" .


###  http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl#Object
:Object rdf:type owl:Class ;
        rdfs:label "Object" .


