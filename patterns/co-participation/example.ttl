# Two researchers on the same conference panel. The panel has one of them as a
# participant, and because they sat through it together each co-participates with
# the other - which is what the pattern is for: reading co-participation off a
# shared event rather than asserting the event twice.

@prefix coparticipation: <http://www.ontologydesignpatterns.org/cp/owl/coparticipation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/co-participation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ClosingPanel a owl:NamedIndividual , coparticipation:Event ;
    rdfs:label "the closing panel of the ontology design patterns workshop" ;
    coparticipation:hasParticipant ex:MariaLombardi .

ex:MariaLombardi a owl:NamedIndividual , coparticipation:Object ;
    rdfs:label "Maria Lombardi, who chaired the panel" ;
    coparticipation:coParticipatesWith ex:JonasWeber .

ex:JonasWeber a owl:NamedIndividual , coparticipation:Object ;
    rdfs:label "Jonas Weber, who answered questions beside her" .
