@prefix : <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix partof: <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix agentrole: <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#> .
@prefix communities: <http://www.ontologydesignpatterns.org/cp/owl/communities.owl#> .
@prefix intensionextension: <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#> .
@prefix informationobjectsandrepresentationlanguages: <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> rdf:type owl:Ontology ;
                                                                                                 owl:imports <http://www.ontologydesignpatterns.org/cp/owl/communities.owl> ,
                                                                                                             <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl> ,
                                                                                                             <http://www.ontologydesignpatterns.org/cp/owl/partof.owl> ;
                                                                                                 dcterms:description "Diagram (this article has no graphical representation)"^^xsd:string ;
                                                                                                 dcterms:title "Informationobjectsandrepresentationlanguages Pattern"^^xsd:string ;
                                                                                                 rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x13; label added x8; term declared x3;
- header: dcterms:title \"Informationobjectsandrepresentationlanguages Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                                                 owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#conceptualizes
informationobjectsandrepresentationlanguages:conceptualizes rdf:type owl:ObjectProperty ;
                                                            owl:inverseOf informationobjectsandrepresentationlanguages:isConceptualizedBy ;
                                                            rdfs:domain [ rdf:type owl:Class ;
                                                                          owl:unionOf ( agentrole:Agent
                                                                                        communities:Community
                                                                                      )
                                                                        ] ;
                                                            rdfs:range intensionextension:SocialObject ;
                                                            rdfs:comment "A relation stating that an Agent is internally representing a SocialObject . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created the solar-system metaphor for the atomic theory'; 'Jacques assumes all swans are white'; 'the task force members share the attack plan'." ;
                                                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                            rdfs:label "conceptualizes"@en ;
                                                            skos:prefLabel "concettualizza"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#formallyRepresents
informationobjectsandrepresentationlanguages:formallyRepresents rdf:type owl:ObjectProperty ;
                                                                owl:inverseOf informationobjectsandrepresentationlanguages:isFormallyRepresentedIn ;
                                                                rdfs:domain informationobjectsandrepresentationlanguages:FormalExpression ;
                                                                rdfs:comment """The relation between formal expressions, and anything that they are supposed to represent.
E.g., 'the predicate 'MariachiInTijuana' formallyRepresents the dul:Collection of all mariachis in Tijuana'; 'the equivalence relation '<=>' formallyRepresents the concept of two entities having the same properties'.
Notice that formal expressions are formally interpreted by instances of dul:FormalEntity""" ;
                                                                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                                rdfs:label "formally represents"@en ;
                                                                skos:prefLabel "rappresenta formalmente"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage
informationobjectsandrepresentationlanguages:hasRepresentationLanguage rdf:type owl:ObjectProperty ;
                                                                       owl:inverseOf informationobjectsandrepresentationlanguages:isRepresentationLanguageOf ;
                                                                       rdfs:domain intensionextension:InformationObject ;
                                                                       rdfs:range informationobjectsandrepresentationlanguages:Language ;
                                                                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                                       rdfs:label "has representation language"@en ;
                                                                       skos:prefLabel "ha linguaggio di rappresentazione"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isConceptualizedBy
informationobjectsandrepresentationlanguages:isConceptualizedBy rdf:type owl:ObjectProperty ;
                                                                rdfs:domain intensionextension:SocialObject ;
                                                                rdfs:range [ rdf:type owl:Class ;
                                                                             owl:unionOf ( agentrole:Agent
                                                                                           communities:Community
                                                                                         )
                                                                           ] ;
                                                                rdfs:comment "A relation stating that an Agent is internally representing a Description . E.g., 'John believes in the conspiracy theory'; 'Niels Bohr created a solar-system metaphor for his atomic theory'; 'Jacques assumes all swans are white'; 'the task force shares the attack plan'." ;
                                                                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                                rdfs:label "is conceptualized by"@en ;
                                                                skos:prefLabel "è concettualizzato da"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isFormallyRepresentedIn
informationobjectsandrepresentationlanguages:isFormallyRepresentedIn rdf:type owl:ObjectProperty ;
                                                                     rdfs:range informationobjectsandrepresentationlanguages:FormalExpression ;
                                                                     rdfs:comment """The relation between formal expressions, and anything that they are supposed to represent.
E.g., 'the predicate 'MariachiInTijuana' formallyRepresents the dul:Collection of all mariachis in Tijuana'; 'the equivalence relation '<=>' formallyRepresents the concept of two entities having the same properties'.
Notice that formal expressions are formally interpreted by instances of dul:FormalEntity""" ;
                                                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                                     rdfs:label "is formally represented in"@en ;
                                                                     skos:prefLabel "è rappresentato formalmente in"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isRepresentationLanguageOf
informationobjectsandrepresentationlanguages:isRepresentationLanguageOf rdf:type owl:ObjectProperty ;
                                                                        rdfs:domain informationobjectsandrepresentationlanguages:Language ;
                                                                        rdfs:range intensionextension:InformationObject ;
                                                                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                                        rdfs:label "is representation language of"@en ;
                                                                        skos:prefLabel "è il linguaggio di rappresentazione di"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart
partof:hasPart rdf:type owl:ObjectProperty ;
               rdfs:label "has part"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent
agentrole:Agent rdf:type owl:Class ;
                rdfs:label "Agent"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community
communities:Community rdf:type owl:Class ;
                      owl:disjointWith informationobjectsandrepresentationlanguages:FormalExpression ,
                                       informationobjectsandrepresentationlanguages:IconicObject ,
                                       informationobjectsandrepresentationlanguages:Language ,
                                       informationobjectsandrepresentationlanguages:LinguisticObject ;
                      rdfs:label "Community"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression
informationobjectsandrepresentationlanguages:FormalExpression rdf:type owl:Class ;
                                                              rdfs:subClassOf intensionextension:InformationObject ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty informationobjectsandrepresentationlanguages:hasRepresentationLanguage ;
                                                                                owl:someValuesFrom informationobjectsandrepresentationlanguages:FormalLanguage
                                                                              ] ;
                                                              owl:disjointWith informationobjectsandrepresentationlanguages:IconicObject ,
                                                                               informationobjectsandrepresentationlanguages:Language ,
                                                                               informationobjectsandrepresentationlanguages:LinguisticObject ;
                                                              rdfs:comment "Any information object represented in a FormalLanguage, usually having a formal interpretation by a dul:FormalEntity, and used to formally represent any Entity" ;
                                                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                              rdfs:label "Formal expression"@en ;
                                                              skos:prefLabel "Espressione formale"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalLanguage
informationobjectsandrepresentationlanguages:FormalLanguage rdf:type owl:Class ;
                                                            rdfs:subClassOf informationobjectsandrepresentationlanguages:Language ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty partof:hasPart ;
                                                                              owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty informationobjectsandrepresentationlanguages:isFormallyRepresentedIn ;
                                                                                                  owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                                                ]
                                                                            ] ;
                                                            owl:disjointWith informationobjectsandrepresentationlanguages:IconicLanguage ,
                                                                             informationobjectsandrepresentationlanguages:NaturalLanguage ;
                                                            rdfs:comment "A formal language, created by some human, with a fixed grammar, and usually with an explicit formal semantics (i.e. its elements have an interpretation wrt to formal entities such as sets, categories, etc.)." ;
                                                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                            rdfs:label "Formal language"@en ;
                                                            skos:prefLabel "Linguaggio formale"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicLanguage
informationobjectsandrepresentationlanguages:IconicLanguage rdf:type owl:Class ;
                                                            rdfs:subClassOf informationobjectsandrepresentationlanguages:Language ;
                                                            owl:disjointWith informationobjectsandrepresentationlanguages:NaturalLanguage ;
                                                            rdfs:comment "A language made up of graphical elements. It can be natural, artificial, and even formal." ;
                                                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                            rdfs:label "Iconic language"@en ;
                                                            skos:prefLabel "Linguaggio iconico"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicObject
informationobjectsandrepresentationlanguages:IconicObject rdf:type owl:Class ;
                                                          rdfs:subClassOf intensionextension:InformationObject ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty informationobjectsandrepresentationlanguages:hasRepresentationLanguage ;
                                                                            owl:someValuesFrom informationobjectsandrepresentationlanguages:IconicLanguage
                                                                          ] ;
                                                          owl:disjointWith informationobjectsandrepresentationlanguages:Language ,
                                                                           informationobjectsandrepresentationlanguages:LinguisticObject ;
                                                          rdfs:comment "An information object represented in an IconicLanguage" ;
                                                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                          rdfs:label "Iconic object"@en ;
                                                          skos:prefLabel "Oggetto iconico"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language
informationobjectsandrepresentationlanguages:Language rdf:type owl:Class ;
                                                      owl:disjointWith informationobjectsandrepresentationlanguages:LinguisticObject ;
                                                      rdfs:comment """A natural or artificial language, provided with an alphabet (or vocabulary) and combinatorial rules. In the case of natural languages, their components are 'temporary' and 'reconstructed' out of actual usage. For example, a grammar for a natural language has the status of a theory for that language, and alternative ones can exist (e.g. generative vs. construction grammars).
Another distinction, between the general (systemic) rules for a language, and the local (contextual) rules for e.g. a certain context, speaker, place, etc., can be made separately.
The most comprehensive classification of languages ha probably been made by Umberto Eco, based on the production modes of the 'signs' that are represented in a certain language. It uses several semiotic dimensions, and will be modeled in a forthcoming ontology.""" ;
                                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                      rdfs:label "Language"@en ;
                                                      skos:prefLabel "Linguaggio"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject
informationobjectsandrepresentationlanguages:LinguisticObject rdf:type owl:Class ;
                                                              rdfs:subClassOf intensionextension:InformationObject ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty informationobjectsandrepresentationlanguages:hasRepresentationLanguage ;
                                                                                owl:someValuesFrom informationobjectsandrepresentationlanguages:NaturalLanguage
                                                                              ] ;
                                                              rdfs:comment "An information object represented in a NaturalLanguage" ;
                                                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                              rdfs:label "Linguistic object"@en ;
                                                              skos:prefLabel "Oggetto linguistico"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage
informationobjectsandrepresentationlanguages:NaturalLanguage rdf:type owl:Class ;
                                                             rdfs:subClassOf informationobjectsandrepresentationlanguages:Language ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty informationobjectsandrepresentationlanguages:isConceptualizedBy ;
                                                                               owl:someValuesFrom communities:Community
                                                                             ] ;
                                                             rdfs:comment """A natural language, evolved and used in a community across time.
Natural languages components are 'temporary' and 'reconstructed' out of actual usage. For example, a grammar for a (part of a) natural language has the status of a theory for that language, but alternative ones can exist (e.g. generative vs. construction grammars).""" ;
                                                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl> ;
                                                             rdfs:label "Natural language"@en ;
                                                             skos:prefLabel "Linguaggio naturale"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject
intensionextension:InformationObject rdf:type owl:Class ;
                                     rdfs:label "Information object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#SocialObject
intensionextension:SocialObject rdf:type owl:Class ;
                                rdfs:label "Social object"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


