# One information object of each kind the pattern distinguishes, with the language it
# is written in and the meaning it expresses: a tenancy agreement in Italian, a circuit
# schematic in standard symbols, and Ohm's law in algebraic notation.

@prefix agentrole: <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#> .
@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix communities: <http://www.ontologydesignpatterns.org/cp/owl/communities.owl#> .
@prefix informationobjectsandrepresentationlanguages: <http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#> .
@prefix intensionextension: <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/informationobjectsandrepresentationlanguages#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:TenancyAgreement a owl:NamedIndividual , informationobjectsandrepresentationlanguages:LinguisticObject ;
    rdfs:label "the signed tenancy agreement for flat 3B" ;
    informationobjectsandrepresentationlanguages:hasRepresentationLanguage ex:Italian ;
    intensionextension:expresses ex:TenancyTerms .

ex:Italian a owl:NamedIndividual , informationobjectsandrepresentationlanguages:NaturalLanguage ;
    rdfs:label "Italian" .

ex:TenancyTerms a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the terms the landlord and the tenant agreed" .

ex:PreamplifierSchematic a owl:NamedIndividual , informationobjectsandrepresentationlanguages:IconicObject ;
    rdfs:label "the preamplifier schematic on sheet 2 of the drawing set" ;
    informationobjectsandrepresentationlanguages:hasRepresentationLanguage ex:CircuitSymbolSet ;
    intensionextension:expresses ex:PreamplifierDesign .

ex:CircuitSymbolSet a owl:NamedIndividual , informationobjectsandrepresentationlanguages:IconicLanguage ;
    rdfs:label "the IEC 60617 set of graphical symbols for circuit diagrams" .

ex:PreamplifierDesign a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the preamplifier design the schematic lays out" .

ex:OhmsLawFormula a owl:NamedIndividual , informationobjectsandrepresentationlanguages:FormalExpression ;
    rdfs:label "the formula V = I R as written in the textbook" ;
    informationobjectsandrepresentationlanguages:hasRepresentationLanguage ex:AlgebraicNotation ;
    intensionextension:expresses ex:OhmsLaw .

ex:AlgebraicNotation a owl:NamedIndividual , informationobjectsandrepresentationlanguages:FormalLanguage ;
    rdfs:label "ordinary algebraic notation" .

ex:OhmsLaw a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "Ohm's law, that voltage is current times resistance" .

# Only one direction of each inverse pair is asserted: conceptualizes/isConceptualizedBy, expresses/isExpressedBy, formallyRepresents/isFormallyRepresentedIn, hasMember/isMemberOf, hasPart/isPartOf, hasRepresentationLanguage/isRepresentationLanguageOf, isAbout/isReferenceOf. A reasoner adds the other.

