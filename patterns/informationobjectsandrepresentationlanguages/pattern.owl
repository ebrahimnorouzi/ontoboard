    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="en">Description (DC terms)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label xml:lang="en">Title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#isDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
        <rdfs:label xml:lang="en">preferred label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#conceptualizes -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#conceptualizes">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isConceptualizedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#SocialObject"/>
        <rdfs:comment>A relation stating that an Agent is internally representing a SocialObject . E.g., &apos;John believes in the conspiracy theory&apos;; &apos;Niels Bohr created the solar-system metaphor for the atomic theory&apos;; &apos;Jacques assumes all swans are white&apos;; &apos;the task force members share the attack plan&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">conceptualizes</rdfs:label>
        <skos:prefLabel xml:lang="it">concettualizza</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#formallyRepresents -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#formallyRepresents">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isFormallyRepresentedIn"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression"/>
        <rdfs:comment>The relation between formal expressions, and anything that they are supposed to represent.
E.g., &apos;the predicate &apos;MariachiInTijuana&apos; formallyRepresents the dul:Collection of all mariachis in Tijuana&apos;; &apos;the equivalence relation &apos;&lt;=&gt;&apos; formallyRepresents the concept of two entities having the same properties&apos;.
Notice that formal expressions are formally interpreted by instances of dul:FormalEntity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">formally represents</rdfs:label>
        <skos:prefLabel xml:lang="it">rappresenta formalmente</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isRepresentationLanguageOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">has representation language</rdfs:label>
        <skos:prefLabel xml:lang="it">ha linguaggio di rappresentazione</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isConceptualizedBy -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isConceptualizedBy">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#SocialObject"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>A relation stating that an Agent is internally representing a Description . E.g., &apos;John believes in the conspiracy theory&apos;; &apos;Niels Bohr created a solar-system metaphor for his atomic theory&apos;; &apos;Jacques assumes all swans are white&apos;; &apos;the task force shares the attack plan&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">is conceptualized by</rdfs:label>
        <skos:prefLabel xml:lang="it">è concettualizzato da</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isFormallyRepresentedIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isFormallyRepresentedIn">
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression"/>
        <rdfs:comment>The relation between formal expressions, and anything that they are supposed to represent.
E.g., &apos;the predicate &apos;MariachiInTijuana&apos; formallyRepresents the dul:Collection of all mariachis in Tijuana&apos;; &apos;the equivalence relation &apos;&lt;=&gt;&apos; formallyRepresents the concept of two entities having the same properties&apos;.
Notice that formal expressions are formally interpreted by instances of dul:FormalEntity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">is formally represented in</rdfs:label>
        <skos:prefLabel xml:lang="it">è rappresentato formalmente in</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isRepresentationLanguageOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isRepresentationLanguageOf">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">is representation language of</rdfs:label>
        <skos:prefLabel xml:lang="it">è il linguaggio di rappresentazione di</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart">
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent">
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicObject"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject"/>
        <rdfs:label xml:lang="en">Community</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalExpression">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalLanguage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicObject"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject"/>
        <rdfs:comment>Any information object represented in a FormalLanguage, usually having a formal interpretation by a dul:FormalEntity, and used to formally represent any Entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Formal expression</rdfs:label>
        <skos:prefLabel xml:lang="it">Espressione formale</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalLanguage -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#FormalLanguage">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isFormallyRepresentedIn"/>
                        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicLanguage"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage"/>
        <rdfs:comment>A formal language, created by some human, with a fixed grammar, and usually with an explicit formal semantics (i.e. its elements have an interpretation wrt to formal entities such as sets, categories, etc.).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Formal language</rdfs:label>
        <skos:prefLabel xml:lang="it">Linguaggio formale</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicLanguage -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicLanguage">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage"/>
        <rdfs:comment>A language made up of graphical elements. It can be natural, artificial, and even formal.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Iconic language</rdfs:label>
        <skos:prefLabel xml:lang="it">Linguaggio iconico</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicObject">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#IconicLanguage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject"/>
        <rdfs:comment>An information object represented in an IconicLanguage</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Iconic object</rdfs:label>
        <skos:prefLabel xml:lang="it">Oggetto iconico</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject"/>
        <rdfs:comment>A natural or artificial language, provided with an alphabet (or vocabulary) and combinatorial rules. In the case of natural languages, their components are &apos;temporary&apos; and &apos;reconstructed&apos; out of actual usage. For example, a grammar for a natural language has the status of a theory for that language, and alternative ones can exist (e.g. generative vs. construction grammars).
Another distinction, between the general (systemic) rules for a language, and the local (contextual) rules for e.g. a certain context, speaker, place, etc., can be made separately.
The most comprehensive classification of languages ha probably been made by Umberto Eco, based on the production modes of the &apos;signs&apos; that are represented in a certain language. It uses several semiotic dimensions, and will be modeled in a forthcoming ontology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Language</rdfs:label>
        <skos:prefLabel xml:lang="it">Linguaggio</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#LinguisticObject">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#hasRepresentationLanguage"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An information object represented in a NaturalLanguage</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Linguistic object</rdfs:label>
        <skos:prefLabel xml:lang="it">Oggetto linguistico</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#NaturalLanguage">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#Language"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#isConceptualizedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/communities.owl#Community"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A natural language, evolved and used in a community across time.
Natural languages components are &apos;temporary&apos; and &apos;reconstructed&apos; out of actual usage. For example, a grammar for a (part of a) natural language has the status of a theory for that language, but alternative ones can exist (e.g. generative vs. construction grammars).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl"/>
        <rdfs:label xml:lang="en">Natural language</rdfs:label>
        <skos:prefLabel xml:lang="it">Linguaggio naturale</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#InformationObject">
        <rdfs:label xml:lang="en">Information object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#SocialObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#SocialObject">
        <rdfs:label xml:lang="en">Social object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:RDF>



