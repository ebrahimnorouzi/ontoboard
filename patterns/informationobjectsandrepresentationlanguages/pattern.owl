     xmlns:communities="http://www.ontologydesignpatterns.org/cp/owl/communities.owl#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:intensionextension="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#"
     xmlns:informationobjectsandrepresentationlanguages="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationobjectsandrepresentationlanguages.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/communities.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diagram (this article has no graphical representation)</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Informationobjectsandrepresentationlanguages Pattern</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x13; label added x8; term declared x3;
- header: dcterms:title &quot;Informationobjectsandrepresentationlanguages Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.1 added rdfs:isDefinedBy for all named entities</owl:versionInfo>
    </owl:Ontology>
    


