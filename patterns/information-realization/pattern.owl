<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl">
  <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl">
    <rdfs:label>Information Realization Pattern</rdfs:label>
    <rdfs:comment>Represents the relationship between an information object and its physical realization (e.g., a document and its printed copy).</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationObject">
    <rdfs:label>Information Object</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationRealization">
    <rdfs:label>Information Realization</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#isRealizedBy">
    <rdfs:label>isRealizedBy</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationObject"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationRealization"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#realizes">
    <rdfs:label>realizes</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationRealization"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationObject"/>
  </owl:ObjectProperty>
</rdf:RDF>