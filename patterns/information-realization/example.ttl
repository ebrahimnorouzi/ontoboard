# Three works and the physical things that carry them: a novel in a paperback copy,
# a 1948 journal paper in both the printed issue and a scanned PDF, and a set of
# keyboard variations in a recording. The same work can have several realizations.

@prefix informationrealization: <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/information-realization#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:MobyDick a owl:NamedIndividual , informationrealization:InformationObject ;
    rdfs:label "Moby-Dick, the novel" ;
    informationrealization:isRealizedBy ex:PenguinPaperback .

ex:PenguinPaperback a owl:NamedIndividual , informationrealization:InformationRealization ;
    rdfs:label "the Penguin Classics paperback copy on the office shelf" ;
    informationrealization:realizes ex:MobyDick .

ex:ShannonPaper a owl:NamedIndividual , informationrealization:InformationObject ;
    rdfs:label "Shannon's 1948 paper \"A Mathematical Theory of Communication\"" ;
    informationrealization:isRealizedBy ex:BstjPrintedIssue , ex:ShannonScanPdf .

ex:BstjPrintedIssue a owl:NamedIndividual , informationrealization:InformationRealization ;
    rdfs:label "the printed Bell System Technical Journal, volume 27, July 1948" ;
    informationrealization:realizes ex:ShannonPaper .

ex:ShannonScanPdf a owl:NamedIndividual , informationrealization:InformationRealization ;
    rdfs:label "the scanned PDF of that paper in the institute repository" ;
    informationrealization:realizes ex:ShannonPaper .

ex:GoldbergVariations a owl:NamedIndividual , informationrealization:InformationObject ;
    rdfs:label "the Goldberg Variations, BWV 988" ;
    informationrealization:isRealizedBy ex:GouldRecording .

ex:GouldRecording a owl:NamedIndividual , informationrealization:InformationRealization ;
    rdfs:label "Glenn Gould's 1955 studio recording of them" ;
    informationrealization:realizes ex:GoldbergVariations .

