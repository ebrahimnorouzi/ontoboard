<http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl> rdf:type owl:Ontology ;
                                                                           rdfs:comment "Represents the relationship between an information object and its physical realization (e.g., a document and its printed copy)." ;
                                                                           rdfs:label "Information Realization Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#isRealizedBy
:isRealizedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :InformationObject ;
              rdfs:range :InformationRealization ;
              rdfs:label "isRealizedBy" .


###  http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#realizes
:realizes rdf:type owl:ObjectProperty ;
          rdfs:domain :InformationRealization ;
          rdfs:range :InformationObject ;
          rdfs:label "realizes" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationObject
:InformationObject rdf:type owl:Class ;
                   rdfs:label "Information Object" .


###  http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#InformationRealization
:InformationRealization rdf:type owl:Class ;
                        rdfs:label "Information Realization" .


