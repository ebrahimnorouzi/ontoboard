# The types of entities pattern on an ordinary journey: a train trip, the people and things
# aboard it, two qualities they bear, and the abstract regions those qualities take their
# values in. Each individual sits in exactly one of the four top types.

@prefix typesofentities: <http://www.ontologydesignpatterns.org/cp/owl/typesofentities.owl#> .
@prefix ex:              <https://w3id.org/ontoboard/example/types-of-entities#> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .

ex:JourneyToBasel a owl:NamedIndividual , typesofentities:Event ;
    rdfs:label "the 08:12 train journey from Karlsruhe to Basel on 3 November 2025" .

ex:BoardingAtKarlsruhe a owl:NamedIndividual , typesofentities:Event ;
    rdfs:label "Anna boarding at Karlsruhe, a shorter event within that journey" .

ex:AnnaBerger a owl:NamedIndividual , typesofentities:Object ;
    rdfs:label "Anna Berger, the passenger in coach 7" .

ex:GreySuitcase a owl:NamedIndividual , typesofentities:Object ;
    rdfs:label "Anna's grey suitcase, on the rack above seat 61" .

ex:MassOfTheSuitcase a owl:NamedIndividual , typesofentities:Quality ;
    rdfs:label "the mass of that suitcase, which cannot exist without the suitcase" .

ex:DelayOfTheJourney a owl:NamedIndividual , typesofentities:Quality ;
    rdfs:label "the delay of that journey, an aspect of the event and not a thing aboard it" .

ex:TwentyThreeKilograms a owl:NamedIndividual , typesofentities:Abstract ;
    rdfs:label "23 kg, the region of the mass dimension the suitcase's mass falls in" .

ex:ElevenMinutes a owl:NamedIndividual , typesofentities:Abstract ;
    rdfs:label "11 minutes, the region of the time dimension the delay falls in" .

# The pattern declares no properties, so there are no edges to draw: what each individual shows
# is the type it belongs to. The four types are pairwise disjoint and Entity is their union, so
# a reasoner adds that each of these eight is an Entity and nothing more.
