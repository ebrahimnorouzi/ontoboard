<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.descartes-core.org/patterns/owl/transportPattern#"
     xml:base="http://www.descartes-core.org/patterns/owl/transportPattern"
     xmlns:ns1="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.descartes-core.org/patterns/owl/transportPattern">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To reduce dimensionality of large data collections.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transportpattern</dcterms:title>
        <ns1:coversRequirements rdf:datatype="http://www.w3.org/2001/XMLSchema#string">What is the extent of a point source pollution event? Where did a voyage begin, and where did it end?</ns1:coversRequirements>
        <ns1:hasConsequences rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This CP allows data modellers and ontology creators the ability to filter and categorise large geoscience data stores.</ns1:hasConsequences>
        <ns1:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To reduce dimensionality of large data collections.</ns1:hasIntent>
        <ns1:relatedCPs rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No known CPs at this time.</ns1:relatedCPs>
        <ns1:scenarios rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The rive water has pollution from a location, after a certain time.  A package left Auckland, New Zealand, at 5:45am on 01/06/2012 and arrived in Los Angeles, USA, on 01/12/2012.</ns1:scenarios>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x7; term declared x7;
- header: dcterms:title &quot;Transportpattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:label>Transport Pattern</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Created by Brandon Whitehead</owl:versionInfo>
    </owl:Ontology>
    


