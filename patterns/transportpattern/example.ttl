# The transportpattern on both scenarios the pattern lists. A parcel leaves Auckland on 1 June 2012
# and reaches Los Angeles on 12 June: the parcel is the entity moved, the ship is the mechanism that
# moves it, and the ship's own crossing is the reference frame the parcel's movement is read against.
# A pollution pulse in the Waikato River is the same shape, framed by the river's discharge.

@prefix transportpattern: <http://www.descartes-core.org/patterns/owl/transportPattern#> .
@prefix ex: <https://w3id.org/ontoboard/example/transportpattern#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ParcelAucklandToLosAngeles a owl:NamedIndividual , transportpattern:TransportEvent ;
    rdfs:label "parcel NZ4417 moving from Auckland to Los Angeles, 1 to 12 June 2012" ;
    transportpattern:referenceFrame ex:PacificCrossing .

ex:PacificCrossing a owl:NamedIndividual , transportpattern:TransportEvent ;
    rdfs:label "the container ship's Pacific crossing, the frame the parcel's movement is read against" .

ex:ParcelNZ4417 a owl:NamedIndividual , transportpattern:TransportEntity ;
    rdfs:label "parcel NZ4417, 3.2 kg: the mass that is moved" ;
    transportpattern:partOf ex:ParcelAucklandToLosAngeles .

ex:ContainerShip a owl:NamedIndividual , transportpattern:TransportMechanim ;
    rdfs:label "the container ship carrying the parcel: the mechanism that moves it" ;
    transportpattern:partOf ex:ParcelAucklandToLosAngeles .

ex:DiazinonPulse a owl:NamedIndividual , transportpattern:TransportEvent ;
    rdfs:label "a pulse of diazinon travelling down the Waikato River from an orchard outfall" ;
    transportpattern:referenceFrame ex:WaikatoDischarge .

ex:WaikatoDischarge a owl:NamedIndividual , transportpattern:TransportEvent ;
    rdfs:label "the river's discharge that week, the frame the pulse's travel time is measured in" .

