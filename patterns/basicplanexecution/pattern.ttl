@prefix : <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix region: <http://www.ontologydesignpatterns.org/cp/owl/region.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix agentrole: <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix objectrole: <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix basicplanexecution: <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/classification.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/participation.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/region.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                       dcterms:description "The basic plans execution content ontology design pattern represents the execution of a plan and the entity that participate in such an execution. This CP is the composition of other CPs: situation and region. Furthermore, it expands such CPs with ontology elements that are partial clones of elements from the DOCLE Ultra Lite and the Plans Lite ontologies."^^xsd:string ;
                                                                       dcterms:title "Basicplanexecution Pattern"^^xsd:string ;
                                                                       rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x11; label added x13; term declared x3;
- header: dcterms:title \"Basicplanexecution Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                    "The basic plans execution content ontology design pattern represents the execution of a plan and the entity that participate in such an execution. This CP is the composition of other CPs: situation and region. Furthermore, it expands such CPs with ontology elements that are partial clones of elements from the DOCLE Ultra Lite and the Plans Lite ontologies."^^xsd:string ;
                                                                       owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                                       "Created by Valentina Presutti"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#actionHasParticipant
basicplanexecution:actionHasParticipant rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf participation:hasParticipant ;
                                        owl:inverseOf basicplanexecution:isParticipantInAction ;
                                        rdfs:domain basicplanexecution:Action ;
                                        rdfs:range objectrole:Object ;
                                        rdfs:comment "A relation between a Process and an Object, e.g. 'the avalanche hasParticipant a mass of snow', or 'the cooking of a cake hasParticipant an agent, some sugar, flour, etc.'."^^xsd:string ;
                                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                        rdfs:label "action has participant"@en ;
                                        skos:prefLabel "ha come partecipante"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#includesAction
basicplanexecution:includesAction rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf situation:isSettingFor ;
                                  owl:inverseOf basicplanexecution:isActionIncludedIn ;
                                  rdfs:domain situation:Situation ;
                                  rdfs:range basicplanexecution:Action ;
                                  rdfs:comment "A relation between situations and persons, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included a burning of my fingers)."^^xsd:string ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                  rdfs:label "includes action"@en ;
                                  skos:prefLabel "include azione"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#includesAgent
basicplanexecution:includesAgent rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf situation:isSettingFor ;
                                 owl:inverseOf basicplanexecution:isAgentIncludedIn ;
                                 rdfs:domain situation:Situation ;
                                 rdfs:range agentrole:Agent ;
                                 rdfs:comment "A relation between situations and persons, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included me)."^^xsd:string ;
                                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                 rdfs:label "includes agent"@en ;
                                 skos:prefLabel "include l'agente"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#includesObject
basicplanexecution:includesObject rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf situation:isSettingFor ;
                                  owl:inverseOf basicplanexecution:isObjectIncludedIn ;
                                  rdfs:domain situation:Situation ;
                                  rdfs:range objectrole:Object ;
                                  rdfs:comment "A relation between situations and persons, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included me)."^^xsd:string ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                  rdfs:label "includes object"@en ;
                                  skos:prefLabel "include l'oggetto"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#includesRegion
basicplanexecution:includesRegion rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf situation:isSettingFor ;
                                  owl:inverseOf basicplanexecution:isRegionIncludedIn ;
                                  rdfs:domain situation:Situation ;
                                  rdfs:range region:Region ;
                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                  rdfs:label "includes region"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#isActionIncludedIn
basicplanexecution:isActionIncludedIn rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf situation:hasSetting ;
                                      rdfs:domain basicplanexecution:Action ;
                                      rdfs:range situation:Situation ;
                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                      rdfs:label "is action included in"@en ;
                                      skos:prefLabel "è un'azione inclusa in"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#isAgentIncludedIn
basicplanexecution:isAgentIncludedIn rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf situation:hasSetting ;
                                     rdfs:domain agentrole:Agent ;
                                     rdfs:range situation:Situation ;
                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                     rdfs:label "is agent included in"@en ;
                                     skos:prefLabel "è un agente nel contesto di"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#isObjectIncludedIn
basicplanexecution:isObjectIncludedIn rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf situation:hasSetting ;
                                      rdfs:domain objectrole:Object ;
                                      rdfs:range situation:Situation ;
                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                      rdfs:label "is an object included in"@en ;
                                      skos:prefLabel "è un oggetto nel contesto di"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#isParticipantInAction
basicplanexecution:isParticipantInAction rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf participation:isParticipantIn ;
                                         rdfs:domain objectrole:Object ;
                                         rdfs:range basicplanexecution:Action ;
                                         rdfs:comment "A relation between an object and a process, e.g. 'a mass of snow is partipant in the avalanche', or 'an agent, some sugar, flour, etc. are participant in the cooking of a cake'."^^xsd:string ;
                                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                         rdfs:label "is participant in action"@en ;
                                         skos:prefLabel "è un partecipante a"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#isRegionIncludedIn
basicplanexecution:isRegionIncludedIn rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf situation:hasSetting ;
                                      rdfs:domain region:Region ;
                                      rdfs:range situation:Situation ;
                                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                      rdfs:label "is region included in"@en ;
                                      skos:prefLabel "è una regione inclusa in"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant
participation:hasParticipant rdf:type owl:ObjectProperty ;
                             rdfs:label "hasParticipant"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn
participation:isParticipantIn rdf:type owl:ObjectProperty ;
                              rdfs:label "isParticipantIn"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting
situation:hasSetting rdf:type owl:ObjectProperty ;
                     rdfs:label "hasSetting"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
situation:isSettingFor rdf:type owl:ObjectProperty ;
                       rdfs:label "isSettingFor"^^xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent
agentrole:Agent rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty basicplanexecution:isAgentIncludedIn ;
                                  owl:allValuesFrom situation:Situation
                                ] ;
                rdfs:label "Agent"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#Action
basicplanexecution:Action rdf:type owl:Class ;
                          rdfs:subClassOf participation:Event ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty basicplanexecution:isActionIncludedIn ;
                                            owl:allValuesFrom basicplanexecution:PlanExecution
                                          ] ;
                          rdfs:comment "An Event with at least one Agent that isParticipantIn, and that executes a Task that typically isDefinedIn a Plan, Workflow, Project, etc."^^xsd:string ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                          rdfs:label "Action"@en ;
                          skos:prefLabel "Azione"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution
basicplanexecution:PlanExecution rdf:type owl:Class ;
                                 rdfs:subClassOf situation:Situation ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty basicplanexecution:includesAction ;
                                                   owl:someValuesFrom basicplanexecution:Action
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty basicplanexecution:includesAction ;
                                                   owl:allValuesFrom basicplanexecution:Action
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty basicplanexecution:includesRegion ;
                                                   owl:allValuesFrom region:Region
                                                 ] ;
                                 rdfs:comment "Plan executions are situations that proactively satisfy a plan. Subplan executions are proper parts of the whole plan execution." ;
                                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl> ;
                                 rdfs:label "Plan execution"@en ;
                                 skos:prefLabel "Esecuzione di piano"@it .


###  http://www.ontologydesignpatterns.org/cp/owl/objectrole.owl#Object
objectrole:Object rdf:type owl:Class ;
                  owl:equivalentClass participation:Object ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty basicplanexecution:isParticipantInAction ;
                                    owl:someValuesFrom basicplanexecution:Action
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty basicplanexecution:isParticipantInAction ;
                                    owl:allValuesFrom basicplanexecution:Action
                                  ] ;
                  rdfs:label "Object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event
participation:Event rdf:type owl:Class ;
                    rdfs:label "Event"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object
participation:Object rdf:type owl:Class ;
                     rdfs:label "Object"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/region.owl#Region
region:Region rdf:type owl:Class ;
              rdfs:label "Region"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
situation:Situation rdf:type owl:Class ;
                    rdfs:label "Situation"^^xsd:string .


