    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="en">Description (DC terms)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label xml:lang="en">Title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements">
        <rdfs:label xml:lang="en">covers requirements</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences">
        <rdfs:label xml:lang="en">has consequences</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs">
        <rdfs:label xml:lang="en">related c ps</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios">
        <rdfs:label xml:lang="en">scenarios</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
        <rdfs:label xml:lang="en">alternative label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#forSpecies -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#forSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasConditions"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#AquaticSpecies"/>
        <rdfs:label xml:lang="en">for species</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasBathymetricRange -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasBathymetricRange">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isBathymetricRangeFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#BathymetricRange"/>
        <rdfs:label xml:lang="en">has bathymetric range</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasConditions -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasConditions">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:label xml:lang="en">has conditions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasHabitat -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasHabitat">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isHabitatFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat"/>
        <rdfs:label xml:lang="en">has habitat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#inWaterArea -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#inWaterArea">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isWaterAreaFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:label xml:lang="en">in water area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isBathymetricRangeFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isBathymetricRangeFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#BathymetricRange"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:label xml:lang="en">is bathymetric range for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isHabitatFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isHabitatFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:label xml:lang="en">is habitat for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isWaterAreaFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#isWaterAreaFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <rdfs:label xml:lang="en">is water area for</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is water area of</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSetting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isSettingFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#AquaticSpecies -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#AquaticSpecies">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#BathymetricRange"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:comment>Aquatic species is characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).</rdfs:comment>
        <rdfs:label xml:lang="en">Aquatic species</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#BathymetricRange -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#BathymetricRange">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:comment>This class contains the set of bathymetric ranges. Bathymetry is numeric depth information about the ranges in which an aquatic species is found.
It can be mapped to fi:Bathymetry.</rdfs:comment>
        <rdfs:label xml:lang="en">Bathymetric range</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#Habitat">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:comment>Habitat is the biological and ecological context of a species in the area of an aquatic resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Habitat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#SpeciesConditions">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#forSpecies"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasBathymetricRange"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#hasHabitat"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#inWaterArea"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea"/>
        <rdfs:comment>A class that allows to represent the typical physic conditions (bathymetry, habitat) of an aquatic species for a certain water area.</rdfs:comment>
        <rdfs:label xml:lang="en">Species conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconditions.owl#WaterArea">
        <rdfs:label xml:lang="en">Water area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Situation</rdfs:label>
    </owl:Class>
</rdf:RDF>



