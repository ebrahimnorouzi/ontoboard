<http://www.ontologydesignpatterns.org/cp/owl/situation.owl> rdf:type owl:Ontology ;
                                                              rdfs:comment "Represents a relational context (situation) that includes entities playing roles. A situation is a unified view of a state of affairs." ;
                                                              rdfs:label "Situation Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting
:hasSetting rdf:type owl:ObjectProperty ;
            rdfs:domain :Entity ;
            rdfs:range :Situation ;
            rdfs:label "hasSetting" .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
:isSettingFor rdf:type owl:ObjectProperty ;
              rdfs:domain :Situation ;
              rdfs:range :Entity ;
              rdfs:label "isSettingFor" .


#################################################################
