# A medical emergency: the resuscitation in bay 3 is the situation that gives the
# patient, the staff who attend her and the defibrillator a single relational context.

@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/situation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ResuscitationInBay3 a owl:NamedIndividual , situation:Situation ;
    rdfs:label "the resuscitation of Maria Koch in bay 3, 07:12 on 4 March 2024" ;
    situation:isSettingFor ex:MariaKoch , ex:DrAhmedFarouk , ex:NurseLenaVogt , ex:Defibrillator17 .

ex:MariaKoch a owl:NamedIndividual , situation:Entity ;
    rdfs:label "Maria Koch, the patient" ;
    situation:hasSetting ex:ResuscitationInBay3 .

ex:DrAhmedFarouk a owl:NamedIndividual , situation:Entity ;
    rdfs:label "Dr Ahmed Farouk, the attending physician" ;
    situation:hasSetting ex:ResuscitationInBay3 .

ex:NurseLenaVogt a owl:NamedIndividual , situation:Entity ;
    rdfs:label "Lena Vogt, the nurse on duty" ;
    situation:hasSetting ex:ResuscitationInBay3 .

ex:Defibrillator17 a owl:NamedIndividual , situation:Entity ;
    rdfs:label "defibrillator no. 17, the device used" ;
    situation:hasSetting ex:ResuscitationInBay3 .
