# RADAR4Culture, the research data publication service that FIZ Karlsruhe provides for NFDI4Culture (launched March 2022).
# The service product is the output of a service process; a service product role inheres in it and is realized in that process; a specification denotes it.
# The service and its description follow the NFDI4Culture and FIZ Karlsruhe service pages (checked 2026-10-21).

@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ontology: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/nfdi-service-product-provision#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:radar4culture a owl:NamedIndividual , ontology:NFDI_0000232 ;
    rdfs:label "RADAR4Culture" ;
    obo:RO_0002353 ex:radar4culture_provision ;
    obo:IAO_0000235 ex:radar4culture_specification .

ex:radar4culture_provision a owl:NamedIndividual , ontology:NFDI_0000101 ;
    rdfs:label "provision of the RADAR4Culture service by FIZ Karlsruhe" .

ex:radar4culture_role a owl:NamedIndividual , ontology:NFDI_0000228 ;
    rdfs:label "service product role of RADAR4Culture" ;
    obo:BFO_0000197 ex:radar4culture ;
    obo:BFO_0000054 ex:radar4culture_provision .

ex:radar4culture_specification a owl:NamedIndividual , ontology:NFDI_0000244 ;
    rdfs:label "RADAR4Culture service description: a low-threshold research data publication service for material and immaterial cultural assets, with descriptive metadata and DOIs" .
