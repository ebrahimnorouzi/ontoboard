<?xml version="1.0"?>
<rdf:RDF xmlns="https://ontoboard.org/patterns/pmdco-categorical-value-specification.owl#"
     xml:base="https://ontoboard.org/patterns/pmdco-categorical-value-specification.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
