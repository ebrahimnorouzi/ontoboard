# Replacing the butter in a brownie recipe with coconut oil for a vegan guest. The
# substitution changes both the ingredient list and the method, it has to satisfy a
# dietary, a cultural and a technological condition, and the oil is recorded by how
# it tastes, how it fits a diet and how it behaves when baked.

@prefix foodingredientsubstitutes: <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#> .
@prefix ex: <https://w3id.org/ontoboard/example/food-recipe-ingredient-substitution-odp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:no_meat_with_dairy a owl:NamedIndividual , foodingredientsubstitutes:cultural_condition ;
    rdfs:label "the kosher rule that dairy is not served after a meat course" .

ex:substitution_record a owl:NamedIndividual , foodingredientsubstitutes:data_item ;
    rdfs:label "the row recording this substitution in the recipe database" .

ex:vegan_diet a owl:NamedIndividual , foodingredientsubstitutes:dietary_condition ;
    rdfs:label "the vegan diet the finished brownies must suit" .

ex:free_of_animal_products a owl:NamedIndividual , foodingredientsubstitutes:dietary_quality ;
    rdfs:label "containing nothing of animal origin" .

ex:refined_coconut_oil a owl:NamedIndividual , foodingredientsubstitutes:food_item ;
    rdfs:label "refined coconut oil, the fat standing in for butter" .

ex:brownie_recipe a owl:NamedIndividual , foodingredientsubstitutes:food_recipe ;
    rdfs:label "the chocolate brownie recipe on the back of the tin" .

ex:butter_to_coconut_oil a owl:NamedIndividual , <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#food_recipe_ingredient_substitution_(specification)> ;
    rdfs:label "substituting coconut oil for the butter in the brownie recipe" .

ex:brownie_ingredient_list a owl:NamedIndividual , <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_set_(specification)> ;
    rdfs:label "the brownie recipe's ingredient list" .

ex:swap_the_fat a owl:NamedIndividual , foodingredientsubstitutes:ingredient_set_transformation_specification ;
    rdfs:label "replace the 250 g of butter with 200 g of coconut oil" .

ex:two_hundred_fifty_g_butter a owl:NamedIndividual , foodingredientsubstitutes:ingredient_specification ;
    rdfs:label "250 g of unsalted butter, as the recipe lists it" .

ex:brownie_method a owl:NamedIndividual , <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#instruction_set_(specification)> ;
    rdfs:label "the brownie method, from creaming the fat to the skewer test" .

ex:melt_instead_of_cream a owl:NamedIndividual , foodingredientsubstitutes:instruction_set_transformation_specification ;
    rdfs:label "melt the oil and fold the sugar in, rather than creaming them" .

ex:keep_the_fudgy_crumb a owl:NamedIndividual , foodingredientsubstitutes:objective ;
    rdfs:label "feed a vegan guest without losing the fudgy crumb" .

ex:cream_fat_with_sugar a owl:NamedIndividual , foodingredientsubstitutes:step_specification ;
    rdfs:label "step 2: cream the fat with the sugar until pale" .

ex:mildly_nutty a owl:NamedIndividual , foodingredientsubstitutes:tastiness_quality ;
    rdfs:label "a mild, faintly nutty taste" .

ex:bakes_at_180c a owl:NamedIndividual , foodingredientsubstitutes:technological_condition ;
    rdfs:label "the batter must still set in 25 minutes at 180 degrees Celsius" .

ex:solid_when_cool a owl:NamedIndividual , foodingredientsubstitutes:technological_quality ;
    rdfs:label "melting near 24 degrees Celsius and setting firm again when cool" .
