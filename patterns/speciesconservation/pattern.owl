<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#"
     xml:base="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This pattern intend to represent a description of the conservation status of aquatic species.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Speciesconservation Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>What is the conservation status of this species? What are the species with a specific conservation status? What species&apos; conservation status contain a specific string?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasConsequences>The conservation status is simply represented as a string, there are no restrictions on how to express the status, thereby an additional convention on how to express this in natural language could be needed if a uniform naming of status levels is desired.</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This pattern intend to represent a description of the conservation status of aquatic species.</cpannotationschema:hasIntent>
        <cpannotationschema:hasUnitTest>SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus &quot;The status is vulnerable&quot;^^xsd:string}
SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus ?y FILTER regex(?y, &quot;Vulnerable&quot;, &quot;i&quot;)}
SELECT ?y WHERE {:Ostrica_gigas :hasConservationStatus ?y}</cpannotationschema:hasUnitTest>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x6; term declared x6;
- header: dcterms:title &quot;Speciesconservation Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <owl:versionInfo>Created by Eva Blomqvist</owl:versionInfo>
    </owl:Ontology>
    


