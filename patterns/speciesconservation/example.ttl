# Six aquatic species with their Red List standing, including the oyster the
# pattern's own unit test asks about. The status is a plain string with no agreed
# wording, which is the pattern's stated consequence: the oyster's entry below is
# phrased quite differently from the rest, and nothing in the pattern forbids it.

@prefix speciesconservation: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/speciesconservation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:AtlanticCod a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "Atlantic cod, Gadus morhua" ;
    speciesconservation:hasConservationStatus "Vulnerable on the IUCN Red List" .

ex:EuropeanEel a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "European eel, Anguilla anguilla" ;
    speciesconservation:hasConservationStatus "Critically Endangered on the IUCN Red List" .

ex:EuropeanSturgeon a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "European sturgeon, Acipenser sturio" ;
    speciesconservation:hasConservationStatus "Critically Endangered on the IUCN Red List" .

ex:WhaleShark a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "whale shark, Rhincodon typus" ;
    speciesconservation:hasConservationStatus "Endangered on the IUCN Red List" .

ex:NassauGrouper a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "Nassau grouper, Epinephelus striatus" ;
    speciesconservation:hasConservationStatus "Critically Endangered on the IUCN Red List" .

ex:PacificOyster a owl:NamedIndividual , speciesconservation:AquaticSpecies ;
    rdfs:label "Pacific oyster, Magallana gigas, long catalogued as Ostrea gigas" ;
    speciesconservation:hasConservationStatus "the status has never been assessed; the species is farmed worldwide" .
