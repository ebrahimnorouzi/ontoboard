@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl> rdf:type owl:Ontology ;
                                                                              owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What is the conservation status of this species? What are the species with a specific conservation status? What species' conservation status contain a specific string?" ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "The conservation status is simply represented as a string, there are no restrictions on how to express the status, thereby an additional convention on how to express this in natural language could be needed if a uniform naming of status levels is desired." ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "This pattern intend to represent a description of the conservation status of aquatic species." ;
                                                                              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus \"The status is vulnerable\"^^xsd:string}
SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus ?y FILTER regex(?y, \"Vulnerable\", \"i\")}
SELECT ?y WHERE {:Ostrica_gigas :hasConservationStatus ?y}""" ;
                                                                              owl:versionInfo "1.0"^^xsd:string ,
                                                                                              "Created by Eva Blomqvist" .

#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#hasConservationStatus
:hasConservationStatus rdf:type owl:DatatypeProperty ;
                       rdfs:domain :AquaticSpecies ;
                       rdfs:range xsd:string ;
                       rdfs:label "has conservation status"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasConservationStatus ;
                                  owl:someValuesFrom xsd:string
                                ] ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


