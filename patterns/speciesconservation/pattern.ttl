@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl> rdf:type owl:Ontology ;
                                                                              owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                              dcterms:description "This pattern intend to represent a description of the conservation status of aquatic species."^^xsd:string ;
                                                                              dcterms:title "Speciesconservation Pattern"^^xsd:string ;
                                                                              cpannotationschema:coversRequirements "What is the conservation status of this species? What are the species with a specific conservation status? What species' conservation status contain a specific string?" ;
                                                                              cpannotationschema:hasConsequences "The conservation status is simply represented as a string, there are no restrictions on how to express the status, thereby an additional convention on how to express this in natural language could be needed if a uniform naming of status levels is desired." ;
                                                                              cpannotationschema:hasIntent "This pattern intend to represent a description of the conservation status of aquatic species."^^xsd:string ;
                                                                              cpannotationschema:hasUnitTest """SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus \"The status is vulnerable\"^^xsd:string}
SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :hasConservationStatus ?y FILTER regex(?y, \"Vulnerable\", \"i\")}
SELECT ?y WHERE {:Ostrica_gigas :hasConservationStatus ?y}""" ;
                                                                              rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x6; term declared x6;
- header: dcterms:title \"Speciesconservation Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                              owl:versionInfo "1.0" ,
                                                                                              "Created by Eva Blomqvist" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest
cpannotationschema:hasUnitTest rdf:type owl:AnnotationProperty ;
                               rdfs:label "has unit test"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#hasConservationStatus
:hasConservationStatus rdf:type owl:DatatypeProperty ;
                       rdfs:domain :AquaticSpecies ;
                       rdfs:range xsd:string ;
                       rdfs:label "has conservation status"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesconservation.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasConservationStatus ;
                                  owl:someValuesFrom xsd:string
                                ] ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


