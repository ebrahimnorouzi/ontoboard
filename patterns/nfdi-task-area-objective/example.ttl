# Task Area TA-SD "Strategy Development" of NFDI-MatWerk, modelled as an objective specification rather than an opaque organisational node.
# Name, description and work packages are value nodes (denoted by); the main goals are reached by is subject of; it participates in the work that carries it out.
# The wording is taken from the TA-SD row of the MatWerk Knowledge Graph (work-package list shortened to the first three).

@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ontology: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/nfdi-task-area-objective#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ta_sd a owl:NamedIndividual , obo:IAO_0000005 ;
    rdfs:label "TA-SD" ;
    obo:IAO_0000235 ex:ta_sd_name , ex:ta_sd_description , ex:ta_sd_work_packages ;
    ontology:NFDI_0000226 ex:ta_sd_main_goals ;
    obo:RO_0000056 ex:ta_sd_work .

ex:ta_sd_name a owl:NamedIndividual , obo:IAO_0000300 ;
    rdfs:label "Strategy Development" .

ex:ta_sd_description a owl:NamedIndividual , obo:IAO_0000300 ;
    rdfs:label "This TA is responsible for managing the development of a digital strategy for our consortium and the MSE community." .

ex:ta_sd_work_packages a owl:NamedIndividual , ontology:NFDI_0001035 ;
    rdfs:label "WP SD-1.1 Develop Processes for Translating Community Needs into Infrastructure; WP SD-1.2 Develop and Implement Consortium Governance; WP SD-1.3 IUC-Management" .

ex:ta_sd_main_goals a owl:NamedIndividual , obo:IAO_0000005 ;
    rdfs:label "Support the digital transformation of materials science through a community-driven process; monitoring, analysis and feedback of the current state in the community" .

ex:ta_sd_work a owl:NamedIndividual , obo:BFO_0000015 ;
    rdfs:label "work of Task Area Strategy Development (TA-SD)" .
