# A sourdough loaf, showing four of Winston's part-whole relations side by side: the
# crust is a component of the loaf, a slice is a portion of it, rye flour is the stuff
# it is made of, and the loaf is a member of the morning batch. Each parthood is stated
# plainly with part-of and then contextualised by a relation instance, whose class says
# WHICH part-whole relation it is and whose hasWhole points at the whole. The pattern
# contextualises non-parthood relations the same way - here, the batch's location.

@prefix contextualizedwinstonpartwhole: <http://daselab.org/ContextualizedWinstonPartWhole#> .
@prefix ex: <https://w3id.org/ontoboard/example/contextualizedwinstonpartwhole#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:TheSourdoughLoaf a owl:NamedIndividual ;
    rdfs:label "the sourdough loaf" ;
    contextualizedwinstonpartwhole:part-of ex:TheMorningBatch ;
    contextualizedwinstonpartwhole:IsPartOf ex:LoafInTheBatch .

ex:TheCrust a owl:NamedIndividual ;
    rdfs:label "the crust of that loaf" ;
    contextualizedwinstonpartwhole:part-of ex:TheSourdoughLoaf ;
    contextualizedwinstonpartwhole:IsPartOf ex:CrustOfTheLoaf .

ex:CrustOfTheLoaf a owl:NamedIndividual , contextualizedwinstonpartwhole:PO-Component-Type ;
    rdfs:label "crust-of-loaf, as a component of an integral object" ;
    contextualizedwinstonpartwhole:hasWhole ex:TheSourdoughLoaf .

ex:TheSlice a owl:NamedIndividual ;
    rdfs:label "the slice cut from that loaf" ;
    contextualizedwinstonpartwhole:part-of ex:TheSourdoughLoaf ;
    contextualizedwinstonpartwhole:IsPartOf ex:SliceOfTheLoaf .

ex:SliceOfTheLoaf a owl:NamedIndividual , contextualizedwinstonpartwhole:PO-Portion-Type ;
    rdfs:label "slice-of-loaf, as a portion of a mass" ;
    contextualizedwinstonpartwhole:hasWhole ex:TheSourdoughLoaf .

ex:TheRyeFlour a owl:NamedIndividual ;
    rdfs:label "the rye flour the loaf is made of" ;
    contextualizedwinstonpartwhole:part-of ex:TheSourdoughLoaf ;
    contextualizedwinstonpartwhole:IsPartOf ex:FlourInTheLoaf .

ex:FlourInTheLoaf a owl:NamedIndividual , contextualizedwinstonpartwhole:PO-Stuff-Type ;
    rdfs:label "flour-in-loaf, as the stuff an object is made of" ;
    contextualizedwinstonpartwhole:hasWhole ex:TheSourdoughLoaf .

ex:LoafInTheBatch a owl:NamedIndividual , contextualizedwinstonpartwhole:PO-Member-Type ;
    rdfs:label "loaf-in-batch, as a member of a collection" ;
    contextualizedwinstonpartwhole:hasWhole ex:TheMorningBatch .

ex:TheMorningBatch a owl:NamedIndividual ;
    rdfs:label "the morning batch of twelve loaves" ;
    contextualizedwinstonpartwhole:spatially-located-in ex:TheCoolingRack .

ex:BatchOnTheRack a owl:NamedIndividual , contextualizedwinstonpartwhole:Spatially-Located-In-Type ;
    rdfs:label "batch-on-rack, as a location and not a parthood" ;
    contextualizedwinstonpartwhole:hasWhole ex:TheCoolingRack .

ex:TheCoolingRack a owl:NamedIndividual ;
    rdfs:label "the cooling rack by the oven" .

