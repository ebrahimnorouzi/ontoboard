# Temporal dimensions of a process: the diffusion annealing of ingot I-2026-0417 in furnace F3 occupies one temporal
# interval whose first and last instants are named, and has two participants, the furnace and the ingot.
# The identifiers and timestamps are invented; the classes and properties are the pattern's.

@prefix co: <https://w3id.org/pmd/co/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ex: <https://w3id.org/ontoboard/example/pmdco-process-temporal-dimensions#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Annealing_I2026_0417 a owl:NamedIndividual , obo:BFO_0000015 ;
    rdfs:label "diffusion annealing of ingot I-2026-0417 (1250 °C, 12 h soak)" ;
    obo:BFO_0000199 ex:AnnealingInterval_I2026_0417 .

ex:AnnealingInterval_I2026_0417 a owl:NamedIndividual , obo:BFO_0000202 ;
    rdfs:label "time interval of the annealing, 20 h from charging to opening the furnace" ;
    obo:BFO_0000222 ex:AnnealingStart_I2026_0417 ;
    obo:BFO_0000224 ex:AnnealingEnd_I2026_0417 .

ex:AnnealingStart_I2026_0417 a owl:NamedIndividual , obo:BFO_0000203 ;
    rdfs:label "2026-03-02T06:00 (ingot charged into the furnace)" .

ex:AnnealingEnd_I2026_0417 a owl:NamedIndividual , obo:BFO_0000203 ;
    rdfs:label "2026-03-03T02:00 (furnace opened)" .

ex:Furnace_F3 a owl:NamedIndividual , obo:BFO_0000030 ;
    rdfs:label "chamber furnace F3" ;
    obo:RO_0000056 ex:Annealing_I2026_0417 .

ex:Ingot_I2026_0417 a owl:NamedIndividual , co:PMD_0020170 ;
    rdfs:label "ingot I-2026-0417 (steel S355J2, heat H-45812)" ;
    obo:RO_0000056 ex:Annealing_I2026_0417 .
