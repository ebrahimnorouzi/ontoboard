    <!-- https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001008 -->

    <owl:DatatypeProperty rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001008">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">has url</rdfs:label>
        <skos:definition xml:lang="en">A relation between an information content entity and its specific url.</skos:definition>
    </owl:DatatypeProperty>
    


