    <!-- http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#NaryParticipation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#NaryParticipation">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
