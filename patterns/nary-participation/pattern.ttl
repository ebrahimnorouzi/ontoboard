@prefix : <http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix naryparticipation: <http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl> rdf:type owl:Ontology ;
                                                                      owl:imports <http://www.ontologydesignpatterns.org/cp/owl/participation.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/cp/owl/situation.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl> ,
                                                                                  <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                      dcterms:description """The nary participation pattern. 
This pattern re-uses participation and situation patterns. It is extracted from DOLCE-UltraLite by partial clone of elements."""^^xsd:string ;
                                                                      dcterms:title "Nary Participation Pattern"^^xsd:string ;
                                                                      rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x8; term declared x2;
- header: dcterms:title \"Nary Participation Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                   """The nary participation pattern. 
This pattern re-uses participation and situation patterns. It is extracted from DOLCE-UltraLite by partial clone of elements."""^^xsd:string ;
                                                                      owl:versionInfo "Created by Aldo Gangemi and Valentina Presutti"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#isIncludedInParticipation
naryparticipation:isIncludedInParticipation rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf situation:hasSetting ;
                                            rdfs:domain owl:Thing ;
                                            rdfs:range naryparticipation:NaryParticipation ;
                                            rdfs:label "is included in participation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#participationIncludes
naryparticipation:participationIncludes rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf situation:isSettingFor ;
                                        rdfs:domain naryparticipation:NaryParticipation ;
                                        rdfs:range owl:Thing ;
                                        rdfs:label "participation includes"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting
situation:hasSetting rdf:type owl:ObjectProperty ;
                     rdfs:label "hasSetting"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
situation:isSettingFor rdf:type owl:ObjectProperty ;
                       rdfs:label "isSettingFor"^^xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/naryparticipation.owl#NaryParticipation
naryparticipation:NaryParticipation rdf:type owl:Class ;
                                    rdfs:subClassOf situation:Situation ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty naryparticipation:participationIncludes ;
                                                      owl:someValuesFrom participation:Event
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty naryparticipation:participationIncludes ;
                                                      owl:someValuesFrom participation:Object
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty naryparticipation:participationIncludes ;
                                                      owl:someValuesFrom timeinterval:TimeInterval
                                                    ] ;
                                    rdfs:label "Nary participation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event
participation:Event rdf:type owl:Class ;
                    rdfs:label "Event"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object
participation:Object rdf:type owl:Class ;
                     rdfs:label "Object"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
situation:Situation rdf:type owl:Class ;
                    owl:disjointWith timeinterval:TimeInterval ;
                    rdfs:label "Situation"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval
timeinterval:TimeInterval rdf:type owl:Class ;
                          rdfs:label "Time interval"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


