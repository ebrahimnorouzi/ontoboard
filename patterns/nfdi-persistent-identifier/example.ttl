# Two published datasets and their DOIs: an identifier is an individual with its own URL (has url), part of the data collection it identifies,
# and the collection is denoted by it. Both datasets are Zenodo records of the NFDI-MatWerk community.
# The DOIs, titles and licences were checked against the Zenodo records on 2026-10-21 and 2026-10-22.

@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ontology: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/nfdi-persistent-identifier#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:matwerk_kg_rdf_dumps a owl:NamedIndividual , obo:IAO_0001000 ;
    rdfs:label "MatWerk Knowledge Graph - RDF Dumps (v2.2.1)" ;
    obo:IAO_0000235 ex:rdf_dumps_doi .

ex:rdf_dumps_doi a owl:NamedIndividual , ontology:NFDI_0001037 ;
    rdfs:label "DOI 10.5281/zenodo.23531121" ;
    ontology:NFDI_0001008 "https://doi.org/10.5281/zenodo.23531121"^^xsd:anyURI ;
    obo:BFO_0000050 ex:matwerk_kg_rdf_dumps .

ex:cold_rolling_data_objects a owl:NamedIndividual , obo:IAO_0001000 ;
    rdfs:label "Workflow-centric FAIR data objects capturing microstructure evolution and mechanical response of a polycrystalline material before and after cold-rolling simulation" ;
    obo:IAO_0000235 ex:cold_rolling_doi .

ex:cold_rolling_doi a owl:NamedIndividual , ontology:NFDI_0001037 ;
    rdfs:label "DOI 10.5281/zenodo.22737493" ;
    ontology:NFDI_0001008 "https://doi.org/10.5281/zenodo.22737493"^^xsd:anyURI ;
    obo:BFO_0000050 ex:cold_rolling_data_objects .
