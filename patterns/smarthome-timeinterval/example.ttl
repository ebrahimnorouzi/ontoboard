# A morning in an assisted-living apartment. Two instants are the timestamps the
# sensors reported, two intervals are the stretches of the day they fall in, and
# the temporal distance is the gap lying behind the kitchen entry, within which
# leaving the bed still counts as a precondition of it.
#
# The pattern declares only time:before as an object property, so that is the only
# edge an example can draw: the depths and lengths live in the labels.

@prefix ns1: <https://w3id.org/smartenvironment/patterns/time.owl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ex: <https://w3id.org/ontoboard/example/smarthome-timeinterval#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:LeftBedAt0840 a owl:NamedIndividual , ns1:Instant ;
    rdfs:label "08:40 on 14 February 2025, when the bed sensor reported the bed empty" ;
    time:before ex:EnteredKitchenAt0842 .

ex:EnteredKitchenAt0842 a owl:NamedIndividual , ns1:Instant ;
    rdfs:label "08:42 on 14 February 2025, when the kitchen motion sensor fired" .

ex:GapBehindKitchenEntry a owl:NamedIndividual , ns1:TemporalDistance ;
    rdfs:label "the two minutes lying behind the kitchen entry" ;
    time:before ex:EnteredKitchenAt0842 .

ex:TwoMinutes a owl:NamedIndividual , ns1:TimeDuration ;
    rdfs:label "two minutes, the length of that gap" .

ex:MorningRoutine a owl:NamedIndividual , ns1:Interval ;
    rdfs:label "the morning routine, 08:40 to 09:02 on 14 February 2025" ;
    time:before ex:MiddayRest .

ex:MiddayRest a owl:NamedIndividual , ns1:Interval ;
    rdfs:label "the midday rest, 12:30 to 13:15 the same day" .
