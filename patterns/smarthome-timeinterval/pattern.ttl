@prefix : <https://w3id.org/smartenvironment/patterns/time.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix se-time: <https://w3id.org/smartenvironment/patterns/time.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://ecareathome-ontology.mpi.aass.oru.se/patterns/time.owl> .

<http://ecareathome-ontology.mpi.aass.oru.se/patterns/time.owl> rdf:type owl:Ontology ;
                                                                 owl:imports <http://www.w3.org/2006/time#2016> ;
                                                                 terms:created "2017-10-22"^^xsd:date ;
                                                                 terms:description "This ontology pattern extends the OWL-Time ontology (https://www.w3.org/2006/time) and describes time in the form of time stamps, time intervals with specific starting and ending points, as well as temporal distance that indicates a relative time distance to a given time point, in the form of an interval. By relative time distance, we mean a distance regardless of the exact timepoints."@en ;
                                                                 terms:title "Smart Environment Time Ontology Pattern"@en ;
                                                                 vann:preferredNamespacePrefix <https://w3id.org/smartenvironment/patterns/time.owl> ,
                                                                                               "se-time"@en ;
                                                                 cpannotationschema:coversRequirements "What is the temporal distance between two specific time steps?"@en ,
                                                                                                       "What is the time interval between two specific timestamps in the form of dates?"@en ;
                                                                 cpannotationschema:hasConsequences """We can quantitavely represent temporal distances through  an observation process for different purposes . These purposes include 
definition of an event in terms of its preconditions whose occurance timestamp is within a specific temporal distance with that of the event."""@en ;
                                                                 cpannotationschema:hasIntent "The ontology pattern Time represents temporal entities in the form of Instant, Interval and Temporal Distance (for example the relative temporal relations between an event and its preconditions.) in the context of smart environments."@en ;
                                                                 cpannotationschema:isSpecializationOf <https://www.w3.org/2006/time> ;
                                                                 rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x17; term declared x4;
- file: pattern.owl declares <http://purl.org/dc/terms/description> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://purl.org/dc/terms/title> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://purl.org/vocab/vann/preferredNamespacePrefix> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> as an annotation property, as pattern.ttl did
- file: pattern.owl declares <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> as an annotation property, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
terms:created rdf:type owl:AnnotationProperty ;
              rdfs:label "Date Created"@en .


###  http://purl.org/dc/terms/description
terms:description rdf:type owl:AnnotationProperty ;
                  rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
terms:title rdf:type owl:AnnotationProperty ;
            rdfs:label "Title"@en .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty ;
                              rdfs:label "preferred namespace prefix"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf
cpannotationschema:isSpecializationOf rdf:type owl:AnnotationProperty ;
                                      rdfs:label "is specialization of"@en .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty ;
                rdfs:label "definition (SKOS)"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2006/time#before
<http://www.w3.org/2006/time#before> rdf:type owl:ObjectProperty ;
                                     rdfs:label "before"@en .


###  http://www.w3.org/2006/time#hasBeginning
<http://www.w3.org/2006/time#hasBeginning> rdf:type owl:ObjectProperty ;
                                           rdfs:label "has beginning"@en .


###  http://www.w3.org/2006/time#hasDuration
<http://www.w3.org/2006/time#hasDuration> rdf:type owl:ObjectProperty ;
                                          rdfs:label "has duration"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2006/time#inXSDDateTimeStamp
<http://www.w3.org/2006/time#inXSDDateTimeStamp> rdf:type owl:DatatypeProperty ;
                                                 rdfs:label "in XSD Date-Time-Stamp"@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2006/time#Duration
<http://www.w3.org/2006/time#Duration> rdf:type owl:Class ;
                                       rdfs:label "Time duration"@en .


###  http://www.w3.org/2006/time#Instant
<http://www.w3.org/2006/time#Instant> rdf:type owl:Class ;
                                      rdfs:label "Time instant"@en .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class ;
                                       rdfs:label "Time interval"@en .


###  http://www.w3.org/2006/time#TemporalEntity
<http://www.w3.org/2006/time#TemporalEntity> rdf:type owl:Class ;
                                             rdfs:label "Temporal entity"@en .


###  https://w3id.org/smartenvironment/patterns/time.owl#Instant
se-time:Instant rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/2006/time#Instant> ,
                                se-time:TemporalEntity ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/2006/time#inXSDDateTimeStamp> ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTimeStamp
                                ] ;
                rdfs:comment "Describes a temporal instant specifiying a specific datetimestamp"@en ;
                rdfs:label "instant"@en ;
                skos:definition "Describes a temporal instant specifiying a specific datetimestamp"@en .


###  https://w3id.org/smartenvironment/patterns/time.owl#Interval
se-time:Interval rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/2006/time#Interval> ,
                                 se-time:TemporalEntity ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2006/time#hasBeginning> ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass se-time:Instant
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2006/time#hasDuration> ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass se-time:TimeDuration
                                 ] ;
                 rdfs:comment "Describes a temporal entity with an extent or duration with a known starting time."@en ;
                 rdfs:label "interval"@en ;
                 skos:definition "Describes a temporal entity with an extent or duration with a known starting time."@en .


###  https://w3id.org/smartenvironment/patterns/time.owl#TemporalDistance
se-time:TemporalDistance rdf:type owl:Class ;
                         rdfs:subClassOf se-time:TemporalEntity ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty <http://www.w3.org/2006/time#before> ;
                                           owl:someValuesFrom se-time:Instant
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty <http://www.w3.org/2006/time#hasDuration> ;
                                           owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                           owl:onClass se-time:TimeDuration
                                         ] ;
                         rdfs:comment "Describes a temporal distance relatively set to a given time instant. The distance is specified using two separate temporal durations both ending with the given time instant. The object property 'before' indicates that the distance is temporaly behind the time instant as the target time."@en ;
                         rdfs:label "temporal distance"@en ;
                         skos:definition "Describes a temporal distance relatively set to a given time instant. The distance is specified using two separate temporal durations both ending with the given time instant. The object property 'before' indicates that the distance is temporaly behind the time instant as the target time."@en .


###  https://w3id.org/smartenvironment/patterns/time.owl#TemporalEntity
se-time:TemporalEntity rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:unionOf ( se-time:Instant
                                                           se-time:Interval
                                                           se-time:TemporalDistance
                                                         )
                                           ] ;
                       rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity> ;
                       rdfs:comment "Describes a temporal entity that can represent a single time instant, a time interval, or a temporal distance."@en ;
                       rdfs:label "temporal entity"@en ;
                       skos:definition "Describes a temporal entity that can represent a single time instant, a time interval, or a temporal distance."@en .


###  https://w3id.org/smartenvironment/patterns/time.owl#TimeDuration
se-time:TimeDuration rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.w3.org/2006/time#Duration> ;
                     rdfs:comment "Describes time duration in the form of a numeric value indicating its length, and a temporal unit type."@en ;
                     rdfs:label "time duration"@en ;
                     skos:definition "Describes time duration in the form of a numeric value indicating its length, and a temporal unit type."@en .


[ owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger
] .

