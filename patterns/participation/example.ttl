# Two events and the objects taking part in them: two researchers attending a project
# kickoff meeting, and the enzyme and sugar taking part in glycolysis. The pattern
# declares hasParticipant and isParticipantIn separately, so each is stated here.

@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/participation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ProjectKickoffMeeting a owl:NamedIndividual , participation:Event ;
    rdfs:label "kickoff meeting of the NFDI-MatWerk project" ;
    participation:hasParticipant ex:AminaOkonkwo , ex:ClaraBeaumont .

ex:AminaOkonkwo a owl:NamedIndividual , participation:Object ;
    rdfs:label "Amina Okonkwo, project coordinator" ;
    participation:isParticipantIn ex:ProjectKickoffMeeting .

ex:ClaraBeaumont a owl:NamedIndividual , participation:Object ;
    rdfs:label "Clara Beaumont, data steward" ;
    participation:isParticipantIn ex:ProjectKickoffMeeting .

ex:Glycolysis a owl:NamedIndividual , participation:Event ;
    rdfs:label "glycolysis in a liver cell" ;
    participation:hasParticipant ex:Hexokinase , ex:GlucoseMolecule .

ex:Hexokinase a owl:NamedIndividual , participation:Object ;
    rdfs:label "the hexokinase enzyme catalysing the first step" ;
    participation:isParticipantIn ex:Glycolysis .

ex:GlucoseMolecule a owl:NamedIndividual , participation:Object ;
    rdfs:label "the glucose molecule being phosphorylated" ;
    participation:isParticipantIn ex:Glycolysis .
