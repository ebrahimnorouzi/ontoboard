<http://www.ontologydesignpatterns.org/cp/owl/participation.owl> rdf:type owl:Ontology ;
                                                                  rdfs:comment "Represents the participation of an object in an event or process." ;
                                                                  rdfs:label "Participation Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant
:hasParticipant rdf:type owl:ObjectProperty ;
                rdfs:domain :Event ;
                rdfs:range :Object ;
                rdfs:label "hasParticipant" .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn
:isParticipantIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Object ;
                 rdfs:range :Event ;
                 rdfs:label "isParticipantIn" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event
:Event rdf:type owl:Class ;
       rdfs:label "Event" .


###  http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object
:Object rdf:type owl:Class ;
        rdfs:label "Object" .


