@prefix : <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix col: <http://ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix set: <http://www.ontologydesignpatterns.org/cp/owl/set.owl#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix situ: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl2xml: <http://www.w3.org/2006/12/owl2-xml#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl> .

<http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl> rdf:type owl:Ontology ;
                                                                 owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                 dc:creator <http://www.garcia-castro.com/#me> ;
                                                                 dc:description "An object can have different states for which different restrictions apply. The goal of the pattern is to allow modelling the different states of an object and the restrictions on such object for its different states"^^xsd:string ;
                                                                 dc:title "Object With States Pattern"^^xsd:string ;
                                                                 cpannotationschema:coversRequirements "An object can have three different states"@en ,
                                                                                                       "Object states must belong to a single collection of non-duplicate elements (i.e., to a set)"@en ,
                                                                                                       "Objects in StateA must have at least one value for property property1"@en ,
                                                                                                       "Objects in StateB must have at most one value for property property2"@en ,
                                                                                                       "Objects in StateC must have exactly one value for property property3"@en ,
                                                                                                       "Objects must have a unique state"@en ,
                                                                                                       "The possible states are: StateA, StateB and StateC"@en ;
                                                                 cpannotationschema:hasConsequences "The pattern requires modelling states as individuals instead of as literals."@en ;
                                                                 cpannotationschema:hasIntent "An object can have different states for which different restrictions apply. The goal of the pattern is to allow modelling the different states of an object and the restrictions on such object for its different states"@en ;
                                                                 cpannotationschema:scenarios "A sample scenario is the following. A software defect created in an issue tracker must have a creator and be associated to a certain software product. Once it is checked that the defect is reproducible, it must be assigned to some developer and have a certain priority. However, before checking the defect reproducilibty the defect must not have either asignee or priority."@en ;
                                                                 rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x13; term declared x6;
- header: dcterms:title \"Object With States Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: pattern.owl declares <http://purl.org/dc/terms/creator> as an annotation property, as pattern.ttl did
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                              "Ontology including the content ontology design pattern for modelling objects with states."@en ;
                                                                 rdfs:label "Object with states ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dc:creator rdf:type owl:AnnotationProperty ;
           rdfs:label "Creator"@en .


###  http://purl.org/dc/terms/description
dc:description rdf:type owl:AnnotationProperty ;
               rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dc:title rdf:type owl:AnnotationProperty ;
         rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Object Properties
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#hasState
:hasState rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf situ:hasSetting ;
          owl:inverseOf :isStateOf ;
          rdfs:domain :Object ;
          rdfs:range :State ;
          rdfs:comment "Defines the state of an object."@en ;
          rdfs:label "has state"@en .


###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#isStateOf
:isStateOf rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf situ:isSettingFor ;
           rdfs:domain :State ;
           rdfs:range :Object ;
           rdfs:comment "Defines the object that has an state"@en ;
           rdfs:label "is state of"@en .


###  http://ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf
col:isMemberOf rdf:type owl:ObjectProperty ;
               rdfs:label "is member of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting
situ:hasSetting rdf:type owl:ObjectProperty ;
                rdfs:label "hasSetting"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor
situ:isSettingFor rdf:type owl:ObjectProperty ;
                  rdfs:label "isSettingFor"^^xsd:string .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/set.owl#size
set:size rdf:type owl:DatatypeProperty ;
         rdfs:label "size"^^xsd:string .


#################################################################
#    Classes
#################################################################

###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#Object
:Object rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasState ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :State
                        ] ;
        rdfs:comment "Objects are entities that have different states and that in each state different restrictions on their properties apply."@en ;
        rdfs:label "Object"@en .


###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#State
:State rdf:type owl:Class ;
       rdfs:subClassOf situ:Situation ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty col:isMemberOf ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :StateSet
                       ] ;
       rdfs:comment "States are the different states that an object can have. States must belong to a single collection of non-duplicate elements (i.e., to a set)."@en ;
       rdfs:label "State"@en .


###  http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#StateSet
:StateSet rdf:type owl:Class ;
          rdfs:subClassOf set:Set ;
          rdfs:comment "State sets are sets of states (i.e., collections of non-duplicate states)."@en ;
          rdfs:label "State set"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/set.owl#Set
set:Set rdf:type owl:Class ;
        rdfs:label "set"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation
situ:Situation rdf:type owl:Class ;
               rdfs:label "Situation"^^xsd:string .


