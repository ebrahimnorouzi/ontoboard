# The pattern's own scenario, website half: the same bus drivers' protest of 16 July 2016 as
# livingintheworld.com reported it. The article gave the protest a second cause the television
# material never mentioned, and the editors ran it at the bottom of the page - so the claim and
# the prominence belong to this reporting of the event, not to the event.

@prefix actingfor: <http://www.ontologydesignpatterns.org/cp/owl/actingfor.owl#> .
@prefix intensionextension: <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#> .
@prefix newsreportingevent: <http://semantic.cs.put.poznan.pl/ontologies/newsreportingevent.owl#> .
@prefix reportingevent: <http://semantic.cs.put.poznan.pl/ontologies/reportingevent.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix typesofentities: <http://www.ontologydesignpatterns.org/cp/owl/typesofentities.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/newsreportingevent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:BusDriversProtest a owl:NamedIndividual , reportingevent:ActualEvent ;
    rdfs:label "the bus drivers' protest in the city centre, 16 July 2016" ;
    rdfs:comment "One event, reported by two media that disagreed about it. The event individual carries none of the disputed detail." .

ex:LivingInTheWorldArticle a owl:NamedIndividual , reportingevent:ActualEventView ;
    rdfs:label "the livingintheworld.com article: breakdowns and a planned benefit cut as causes, and public property destroyed" ;
    intensionextension:isAbout ex:BusDriversProtest ;
    intensionextension:expresses ex:BenefitCutCauseClaim .

ex:BenefitCutCauseClaim a owl:NamedIndividual , intensionextension:SocialObject ;
    rdfs:label "the claim that a planned reduction of social benefits was a cause of the protest" ;
    rdfs:comment "Only this article made the claim. Holding it as a separate individual is what keeps it attributable." .

ex:ArticlePublication a owl:NamedIndividual , newsreportingevent:NewsReportingEvent ;
    rdfs:label "the act of reporting the protest on livingintheworld.com" ;
    reportingevent:reports ex:LivingInTheWorldArticle ;
    reportingevent:hasAuthor ex:StaffWriter ;
    reportingevent:isBasedOnSourceObject ex:AgencyWireCopy ;
    newsreportingevent:presentedAt ex:LivingInTheWorldSite ;
    newsreportingevent:hasPresentationContext ex:BottomOfFrontPage ;
    timeindexedsituation:atTime ex:PublicationDay .

ex:StaffWriter a owl:NamedIndividual , newsreportingevent:NewsEventReporter ;
    rdfs:label "the staff writer who filed the article" ;
    actingfor:actsFor ex:LivingInTheWorldPublishing .

ex:LivingInTheWorldPublishing a owl:NamedIndividual , newsreportingevent:NewsProvider ;
    rdfs:label "the publisher behind the website" ;
    newsreportingevent:owns ex:LivingInTheWorldSite .

ex:LivingInTheWorldSite a owl:NamedIndividual , newsreportingevent:Media ;
    rdfs:label "livingintheworld.com, a news website" .

ex:BottomOfFrontPage a owl:NamedIndividual , newsreportingevent:NewsPresentationContext ;
    rdfs:label "the bottom of the front page" ;
    rdfs:comment "Where the editors put it, which is how little they thought of it. The same event led the television programme." .

ex:AgencyWireCopy a owl:NamedIndividual , reportingevent:SourceObject ;
    rdfs:label "the agency wire copy the article was worked up from" .

ex:PublicationDay a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "16 July 2016, the day the article went up" ;
    timeinterval:hasIntervalDate "2016-07-16" .

# Only one direction of each inverse pair is asserted: actsFor/actsThrough, atTime/isTimeIndexFor, expresses/isExpressedBy, forEntity/hasTimeIndexedSetting, isAbout/isReferenceOf. A reasoner adds the other.
