#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#anyType
xsd:anyType rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_component
:has_component rdf:type owl:ObjectProperty ;
               rdfs:label "has component"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_member
:has_member rdf:type owl:ObjectProperty ;
            rdfs:label "has member"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_part
:has_part rdf:type owl:ObjectProperty ;
          rdfs:label "has part"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_quality
:has_quality rdf:type owl:ObjectProperty ;
             rdfs:label "has quality"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#is_about
:is_about rdf:type owl:ObjectProperty ;
          rdfs:label "is about"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#is_quality_measure_of
:is_quality_measure_of rdf:type owl:ObjectProperty ;
                       rdfs:label "is quality measure of"@en .


#################################################################
#    Data properties
#################################################################

###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_quantity
:has_quantity rdf:type owl:DatatypeProperty ;
              rdfs:label "has quantity"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#has_unit
:has_unit rdf:type owl:DatatypeProperty ;
          rdfs:label "has unit"@en .


#################################################################
#    Classes
#################################################################

###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#action_specification
:action_specification rdf:type owl:Class ;
                      rdfs:label "action specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#condition
:condition rdf:type owl:Class ;
           rdfs:subClassOf :proposition ;
           rdfs:label "condition"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#cultural_condition
:cultural_condition rdf:type owl:Class ;
                    rdfs:subClassOf :condition ;
                    rdfs:label "cultural condition"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#data_item
:data_item rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :is_quality_measure_of ;
                             owl:someValuesFrom :quality
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :has_quantity ;
                             owl:someValuesFrom xsd:anyType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :has_unit ;
                             owl:someValuesFrom xsd:anyType
                           ] ;
           rdfs:label "data item"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#data_set
:data_set rdf:type owl:Class ;
          rdfs:label "data set"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#dietary_condition
:dietary_condition rdf:type owl:Class ;
                   rdfs:subClassOf :condition ;
                   rdfs:label "dietary condition"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#dietary_quality
:dietary_quality rdf:type owl:Class ;
                 rdfs:subClassOf :quality ;
                 rdfs:label "dietary quality"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#food_item
:food_item rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :has_quality ;
                             owl:someValuesFrom :quality
                           ] ;
           rdfs:label "food item"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#food_recipe
:food_recipe rdf:type owl:Class ;
             rdfs:subClassOf :plan_specification ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :has_component ;
                               owl:someValuesFrom <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_set_(specification)>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :has_component ;
                               owl:someValuesFrom <http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#instruction_set_(specification)>
                             ] ;
             rdfs:label "food recipe"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_set_transformation_specification
:ingredient_set_transformation_specification rdf:type owl:Class ;
                                             rdfs:label "ingredient set transformation specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_specification
:ingredient_specification rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :has_component ;
                                            owl:someValuesFrom :data_item
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :is_about ;
                                            owl:someValuesFrom :food_item
                                          ] ;
                          rdfs:label "ingredient specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#instruction_set_transformation_specification
:instruction_set_transformation_specification rdf:type owl:Class ;
                                              rdfs:label "instruction set transformation specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#objective
:objective rdf:type owl:Class ;
           rdfs:subClassOf :objective_specification ;
           rdfs:label "objective"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#objective_specification
:objective_specification rdf:type owl:Class ;
                         rdfs:label "objective specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#plan_specification
:plan_specification rdf:type owl:Class ;
                    rdfs:label "plan specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#proposition
:proposition rdf:type owl:Class ;
             rdfs:label "proposition"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#quality
:quality rdf:type owl:Class ;
         rdfs:label "quality"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#step_specification
:step_specification rdf:type owl:Class ;
                    rdfs:subClassOf :action_specification ;
                    rdfs:label "step specification"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#tastiness_quality
:tastiness_quality rdf:type owl:Class ;
                   rdfs:subClassOf :quality ;
                   rdfs:label "tastiness quality"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#technological_condition
:technological_condition rdf:type owl:Class ;
                         rdfs:subClassOf :condition ;
                         rdfs:label "technological condition"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#technological_quality
:technological_quality rdf:type owl:Class ;
                       rdfs:subClassOf :quality ;
                       rdfs:label "technological quality"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#food_recipe_ingredient_substitution_(specification)
<http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#food_recipe_ingredient_substitution_(specification)> rdf:type owl:Class ;
                                                                                                                              rdfs:subClassOf :plan_specification ,
                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                owl:onProperty :has_part ;
                                                                                                                                                owl:someValuesFrom :condition
                                                                                                                                              ] ,
                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                owl:onProperty :has_part ;
                                                                                                                                                owl:someValuesFrom :food_recipe
                                                                                                                                              ] ,
                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                owl:onProperty :has_part ;
                                                                                                                                                owl:someValuesFrom :ingredient_set_transformation_specification
                                                                                                                                              ] ,
                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                owl:onProperty :has_part ;
                                                                                                                                                owl:someValuesFrom :instruction_set_transformation_specification
                                                                                                                                              ] ,
                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                owl:onProperty :has_part ;
                                                                                                                                                owl:someValuesFrom :objective
                                                                                                                                              ] ;
                                                                                                                              rdfs:label "food recipe ingredient substitution (specification)"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_set_(specification)
<http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#ingredient_set_(specification)> rdf:type owl:Class ;
                                                                                                         rdfs:subClassOf :data_set ,
                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                           owl:onProperty :has_member ;
                                                                                                                           owl:someValuesFrom :ingredient_specification
                                                                                                                         ] ;
                                                                                                         rdfs:label "ingredient set (specification)"@en .


###  http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#instruction_set_(specification)
<http://semantic.cs.put.poznan.pl/ontologies/food_ingredient_substitutes#instruction_set_(specification)> rdf:type owl:Class ;
                                                                                                          rdfs:subClassOf :data_set ,
                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                            owl:onProperty :has_member ;
                                                                                                                            owl:someValuesFrom :step_specification
                                                                                                                          ] ;
                                                                                                          rdfs:label "instruction set (specification)"@en .


