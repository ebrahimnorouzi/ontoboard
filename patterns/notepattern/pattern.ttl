np:NotePitch rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty np:isRealisedAsFrequency ;
                               owl:someValuesFrom mobj:Frequency
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty np:isPitchOf ;
                               owl:allValuesFrom np:SymbolicNote
                             ] ;
             rdfs:comment "The pitch of a symbolic note."@en ;
             rdfs:label "Note Pitch"@en .


