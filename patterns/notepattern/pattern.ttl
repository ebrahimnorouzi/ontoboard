###  https://purl.org/andreapoltronieri/notepattern/SymbolicNote
np:SymbolicNote rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty np:hasRealisation ;
                                  owl:someValuesFrom mobj:MusicalObject
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:belongsToFragment ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass sp:HomogeneousFragment
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:belongsToFragment ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass sp:Section
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:belongsToFragment ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass sp:Voice
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:hasNoteDuration ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass np:NoteDuration
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:hasNoteDynamic ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass np:NoteDynamic
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:hasNotePitch ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass np:NotePitch
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:hasPosition ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass np:Position
                                ] ;
                rdfs:comment "A music note from the western temperament system."@en ;
                rdfs:label "Note Event"@en ;
