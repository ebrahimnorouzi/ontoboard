np:NoteDuration rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty np:isRealisedAsDuration ;
                                  owl:someValuesFrom mobj:MusicalObjectDuration
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty np:isDurationOfNote ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass np:SymbolicNote
                                ] ;
                rdfs:comment "The quantised duration of a symbolic music note."@en ;
                rdfs:label "Note Duration"@en .


###  https://purl.org/andreapoltronieri/notepattern/NoteDynamic
np:NoteDynamic rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty np:isRealisedAsIntensity ;
                                 owl:someValuesFrom mobj:SoundIntensity
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty np:isDynamicOf ;
                                 owl:allValuesFrom np:SymbolicNote
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty np:hasLiteralDynamic ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty np:hasMidiVelocity ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:int
                               ] ;
               rdfs:comment "The dynamic of a symbolic note."@en ;
               rdfs:label "Note Dynamic"@en .


