# A welding bay in a steel fabrication shop: the people and the equipment present,
# and the hazard each of them is exposed to. The welder is exposed to two at once,
# and the acetylene cylinder shows that an exposed object need not be a person.

@prefix hazardoussituation: <http://semantic.cs.put.poznan.pl/ontologies/oshdo/HazardousSituation#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/hazardoussituation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ArcRadiation a owl:NamedIndividual , hazardoussituation:Hazard ;
    rdfs:label "ultraviolet radiation from the welding arc" .

ex:WeldingFume a owl:NamedIndividual , hazardoussituation:Hazard ;
    rdfs:label "manganese-bearing welding fume" .

ex:UnguardedLeadingEdge a owl:NamedIndividual , hazardoussituation:Hazard ;
    rdfs:label "unguarded leading edge six metres above the shop floor" .

ex:RadiantHeat a owl:NamedIndividual , hazardoussituation:Hazard ;
    rdfs:label "radiant heat from the cutting torch in the next bay" .

ex:Welder a owl:NamedIndividual , hazardoussituation:Object ;
    rdfs:label "the welder working the frame-assembly bay" ;
    hazardoussituation:exposedTo ex:ArcRadiation , ex:WeldingFume .

ex:Scaffolder a owl:NamedIndividual , hazardoussituation:Object ;
    rdfs:label "the scaffolder dismantling the gantry platform" ;
    hazardoussituation:exposedTo ex:UnguardedLeadingEdge .

ex:AcetyleneCylinder a owl:NamedIndividual , hazardoussituation:Object ;
    rdfs:label "the acetylene cylinder stored beside the bay" ;
    hazardoussituation:exposedTo ex:RadiantHeat .

# Only one direction of each inverse pair is asserted: hasParticipant/participantIn. A reasoner adds the other.

