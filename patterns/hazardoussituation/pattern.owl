    <owl:ObjectProperty rdf:about="http://semantic.cs.put.poznan.pl/ontologies/oshdo/HazardousSituation#hasParticipant">
        <owl:inverseOf rdf:resource="http://semantic.cs.put.poznan.pl/ontologies/oshdo/HazardousSituation#participantIn"/>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


