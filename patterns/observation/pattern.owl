    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl">
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents an observation made by an observer about a feature of interest, producing a result.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation Pattern</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x2; term declared x2;
- header: dcterms:title &quot;Observation Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents an observation made by an observer about a feature of interest, producing a result.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation Pattern</rdfs:label>
    </owl:Ontology>
    


