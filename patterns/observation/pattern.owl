<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontologydesignpatterns.org/cp/owl/observation.owl">
  <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl">
    <rdfs:label>Observation Pattern</rdfs:label>
    <rdfs:comment>Represents an observation made by an observer about a feature of interest, producing a result.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation">
    <rdfs:label>Observation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#FeatureOfInterest">
    <rdfs:label>Feature of Interest</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Result">
    <rdfs:label>Result</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observer">
    <rdfs:label>Observer</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasFeatureOfInterest">
    <rdfs:label>hasFeatureOfInterest</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#FeatureOfInterest"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasResult">
    <rdfs:label>hasResult</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Result"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#madeBy">
    <rdfs:label>madeBy</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observer"/>
  </owl:ObjectProperty>
</rdf:RDF>