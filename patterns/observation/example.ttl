# Two observations: a thermohygrometer reading the temperature of a server room,
# and a marine biologist recording crab abundance in an eelgrass bed. Each pairs an
# observer and a feature of interest with the result the observation produced.

@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/observation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ServerRoomB214 a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "server room B2.14" .

ex:TemperatureReading a owl:NamedIndividual , observation:Observation ;
    rdfs:label "temperature reading taken in server room B2.14" ;
    observation:hasFeatureOfInterest ex:ServerRoomB214 ;
    observation:hasResult ex:Reading214Celsius ;
    observation:madeBy ex:ThermohygrometerTH12 .

ex:ThermohygrometerTH12 a owl:NamedIndividual , observation:Observer ;
    rdfs:label "wall-mounted thermohygrometer TH-12" .

ex:Reading214Celsius a owl:NamedIndividual , observation:Result ;
    rdfs:label "21.4 degrees Celsius" .

ex:EelgrassBedKielFjord a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the eelgrass bed in Kiel Fjord" .

ex:CrabAbundanceSurvey a owl:NamedIndividual , observation:Observation ;
    rdfs:label "shore crab abundance survey of the Kiel Fjord eelgrass bed" ;
    observation:hasFeatureOfInterest ex:EelgrassBedKielFjord ;
    observation:hasResult ex:Count47PerSquareMetre ;
    observation:madeBy ex:BiologistLindqvist .

ex:BiologistLindqvist a owl:NamedIndividual , observation:Observer ;
    rdfs:label "Maria Lindqvist, marine biologist" .

ex:Count47PerSquareMetre a owl:NamedIndividual , observation:Result ;
    rdfs:label "47 shore crabs per square metre" .
