<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#"
     xml:base="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:place="http://www.ontologydesignpatterns.org/cp/owl/place.owl#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:owl2xml="http://www.w3.org/2006/12/owl2-xml#"
     xmlns:catchrecord="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#"
     xmlns:observation="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#"
     xmlns:water_FAO_areas="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#"
     xmlns:species_taxonomic="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#"
     xmlns:speciesfactsheets="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/waterareasfactsheets.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent the catch records from time series FIGIS application, which contain temporally-indexed aggregated information about aquatic species cacthing.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catchrecord Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>What species, and what amount of organisms, have been caught from what areas, countries, at what date and fishing year?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasAuthor>Aldo Gangemi (CNR), based on specifications by Claudio Baldassarre (UN-FAO), Caterina Caracciolo (UN-FAO), and Michael Erdmann (Ontoprise), for the NeOn project.</cpannotationschema:hasAuthor>
        <cpannotationschema:hasComponent>SpeciesFactsheets,WaterAreaFactsheets</cpannotationschema:hasComponent>
        <cpannotationschema:hasConsequences>We are able to query time-series data for catches of species in a certain fishing area, by vessels of some country, with anounts and measurement units.</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent the catch records from time series FIGIS application, which contain temporally-indexed aggregated information about aquatic species cacthing.</cpannotationschema:hasIntent>
        <cpannotationschema:isSpecializationOf>Observation</cpannotationschema:isSpecializationOf>
        <rdfs:comment>A design pattern for populating an ontology of aquatic species catching records.</rdfs:comment>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x24; term declared x2;
- header: dcterms:title &quot;Catchrecord Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- file: only pattern.ttl said Declaration(Datatype(xsd:gYear)) - not kept: pattern.owl is what an import copies
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:label>Catch record pattern.</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.3
- added annotations for uploading on ODP. (Aldo Gangemi, 15 February 2010).
1.2
- updated year datatype properties. Added comments. (Aldo Gangemi, 28 January 2010).
1.1
- updated ontology import axioms and added place.owl pattern. Changed names for catch record properties. (Aldo Gangemi, 6 January 2010).</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="en">Description (DC terms)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label xml:lang="en">Title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements">
        <rdfs:label xml:lang="en">covers requirements</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor">
        <rdfs:label xml:lang="en">has author</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent">
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences">
        <rdfs:label xml:lang="en">has consequences</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent">
        <rdfs:label xml:lang="en">has intent</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf -->

    <owl:AnnotationProperty rdf:about="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf">
        <rdfs:label xml:lang="en">is specialization of</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#countryOfRecord -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#countryOfRecord">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#forCountry"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#Country"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The country parameter for a species catch record.</rdfs:comment>
        <rdfs:label>isCountryFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fishingAreaOfRecord -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fishingAreaOfRecord">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fromFishingArea"/>
        <rdfs:domain rdf:resource="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The area parameter for a species catch record.</rdfs:comment>
        <rdfs:label>isFishingAreaFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#forCountry -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#forCountry">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#Country"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The country parameter for a species catch record.</rdfs:comment>
        <rdfs:label>fromCountry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fromFishingArea -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fromFishingArea">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The area parameter for a species catch record.</rdfs:comment>
        <rdfs:label>fromFishingArea</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#hasCatchRecord -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#hasCatchRecord">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#isCatchRecordFor"/>
        <rdfs:domain rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The catch record of a species, i.e. its statistical observation over a reference year.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has catch record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#isCatchRecordFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#isCatchRecordFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The catch record of a species, i.e. its statistical observation over a reference year.</rdfs:comment>
        <rdfs:label>is catch record for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#unitUsedInRecord -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#unitUsedInRecord">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#withUnit"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#UnitOfMeasure"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit of measure parameter for a species catch record.</rdfs:comment>
        <rdfs:label>isUnitFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#withUnit -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#withUnit">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#UnitOfMeasure"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The unit of measure parameter for a species catch record.</rdfs:comment>
        <rdfs:label>unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#areaOfSpecies -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#areaOfSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/place.owl#isLocationOf"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#foundIn"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isFishingAreaOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#foundIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/speciesfactsheets.owl#foundIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/place.owl#hasLocation"/>
        <rdfs:label xml:lang="en">found in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation">
        <rdfs:label xml:lang="en">has observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter">
        <rdfs:label xml:lang="en">has parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf">
        <rdfs:label xml:lang="en">is observation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf">
        <rdfs:label xml:lang="en">is parameter of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/place.owl#hasLocation -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/place.owl#hasLocation">
        <rdfs:label xml:lang="en">has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/place.owl#isLocationOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/place.owl#isLocationOf">
        <rdfs:label xml:lang="en">is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#amount -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#amount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>amount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#referenceYear -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#referenceYear">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The year for which the status of the target object (e.g. Marine Resource, Fishery...) has been evaluated.</rdfs:comment>
        <rdfs:label>reference year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#reportingYear -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#reportingYear">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The year in which a catch record has been officially reported (different from its reference year, i.e. the year of the actual observation).</rdfs:comment>
        <rdfs:label>reporting year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#inDate">
        <rdfs:label xml:lang="en">in date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species -->

    <owl:Class rdf:about="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species">
        <rdfs:label xml:lang="en">species</rdfs:label>
    </owl:Class>
    


    <!-- http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Taxon -->

    <owl:Class rdf:about="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Taxon">
        <rdfs:label xml:lang="en">taxon</rdfs:label>
    </owl:Class>
    


    <!-- http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#Area -->

    <owl:Class rdf:about="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#Area">
        <rdfs:label xml:lang="en">area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area -->

    <owl:Class rdf:about="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#FAO_fishing_area">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/place.owl#Place"/>
        <rdfs:label xml:lang="en">FAO fishing area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#TypeOfWater -->

    <owl:Class rdf:about="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#TypeOfWater">
        <rdfs:label xml:lang="en">type of water</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#CatchRecord">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#forCountry"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#Country"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#fromFishingArea"/>
                <owl:someValuesFrom rdf:resource="http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#Area"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#isCatchRecordFor"/>
                <owl:someValuesFrom rdf:resource="http://www.fao.org/aims/aos/fi/species_taxonomic.owl#Species"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#withUnit"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#UnitOfMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#amount"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#referenceYear"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
