                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A design pattern representing the semantics of the data contained in a database view (record) about catches of species in certain fishing areas for a certain reference year.</rdfs:comment>
        <rdfs:label>Catch record</rdfs:label>
    </owl:Class>
    


