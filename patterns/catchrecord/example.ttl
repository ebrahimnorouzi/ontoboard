# One row of the FAO capture-production time series: Norway's reported catch of Atlantic
# cod in FAO Major Fishing Area 27 for the reference year 2021, in tonnes, reported two
# years later. Beside it is the stock survey that such a record is an observation of -
# a catch record is an Observation, with a feature of interest, an observer and a result.

@prefix catchrecord: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/catchrecord.owl#> .
@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix place: <http://www.ontologydesignpatterns.org/cp/owl/place.owl#> .
@prefix speciestaxonomic: <http://www.fao.org/aims/aos/fi/species_taxonomic.owl#> .
@prefix waterfaoareas: <http://www.fao.org/aims/aos/fi/water_FAO_areas.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/catchrecord#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:NorwegianCodCatch2021 a owl:NamedIndividual , catchrecord:CatchRecord ;
    rdfs:label "Norway's reported cod catch in Area 27, reference year 2021" ;
    catchrecord:amount "340512.0"^^xsd:float ;
    catchrecord:referenceYear "2021"^^xsd:gYear ;
    catchrecord:reportingYear "2023"^^xsd:gYear .

ex:Norway a owl:NamedIndividual , catchrecord:Country ;
    rdfs:label "Norway, the country whose vessels landed the catch" ;
    catchrecord:countryOfRecord ex:NorwegianCodCatch2021 .

ex:FaoMajorFishingArea27 a owl:NamedIndividual , waterfaoareas:FAO_fishing_area ;
    rdfs:label "FAO Major Fishing Area 27, the Northeast Atlantic" ;
    catchrecord:fishingAreaOfRecord ex:NorwegianCodCatch2021 .

ex:AtlanticCod a owl:NamedIndividual , speciestaxonomic:Species ;
    rdfs:label "Atlantic cod, Gadus morhua" ;
    catchrecord:hasCatchRecord ex:NorwegianCodCatch2021 .

ex:Tonnes a owl:NamedIndividual , catchrecord:UnitOfMeasure ;
    rdfs:label "tonnes, live weight equivalent" ;
    catchrecord:unitUsedInRecord ex:NorwegianCodCatch2021 .

ex:WinterSurvey2021 a owl:NamedIndividual , observation:Observation ;
    rdfs:label "the 2021 winter survey of the Northeast Arctic cod stock" ;
    observation:hasFeatureOfInterest ex:NortheastArcticCodStock ;
    observation:hasResult ex:SpawningStockBiomass2021 ;
    observation:madeBy ex:InstituteOfMarineResearch .

ex:NortheastArcticCodStock a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the Northeast Arctic cod stock" .

ex:InstituteOfMarineResearch a owl:NamedIndividual , observation:Observer ;
    rdfs:label "the Institute of Marine Research, Bergen" .

ex:SpawningStockBiomass2021 a owl:NamedIndividual , observation:Result ;
    rdfs:label "spawning stock biomass in 2021, 1.1 million tonnes" .

# Only one direction of each inverse pair is asserted: areaOfSpecies/foundIn, countryOfRecord/forCountry, fishingAreaOfRecord/fromFishingArea, hasCatchRecord/isCatchRecordFor, unitUsedInRecord/withUnit. A reasoner adds the other.

