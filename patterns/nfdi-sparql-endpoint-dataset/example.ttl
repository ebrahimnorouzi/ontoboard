# The MatWerk Knowledge Graph and the two addresses it can be queried at. The endpoint is a separate individual reached
# from the dataset by obo:IAO_0000235 (denoted by), which is how the MatWerk sheet records it; each endpoint states its URL
# with nfdi:NFDI_0001008 (has url). Both addresses answered on 2026-10-22: the first returns SPARQL results, the second is the web interface.

@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ontology: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/nfdi-sparql-endpoint-dataset#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:matwerk_knowledge_graph a owl:NamedIndividual , obo:IAO_0001000 ;
    rdfs:label "MatWerk Knowledge Graph (v2.2.1 named graphs)" ;
    obo:IAO_0000235 ex:matwerk_sparql_endpoint , ex:matwerk_shmarql_interface .

ex:matwerk_sparql_endpoint a owl:NamedIndividual , ontology:NFDI_0001095 ;
    rdfs:label "SPARQL endpoint of the MatWerk Knowledge Graph" ;
    ontology:NFDI_0001008 "https://nfdi.fiz-karlsruhe.de/matwerk/sparql"^^xsd:anyURI .

ex:matwerk_shmarql_interface a owl:NamedIndividual , ontology:NFDI_0001095 ;
    rdfs:label "SHMARQL query interface of the MatWerk Knowledge Graph" ;
    ontology:NFDI_0001008 "https://nfdi.fiz-karlsruhe.de/matwerk/shmarql/"^^xsd:anyURI .
