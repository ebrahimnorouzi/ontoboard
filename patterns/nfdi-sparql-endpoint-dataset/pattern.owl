    <!-- https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000009 -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000009">
        <rdfs:label xml:lang="en">obsolete dataset</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that refers to a structured collection of data, organized typically for a specific goal such as analysis, research, or reference. Dataset is structured information about a resource provided by an organization or a person.</skos:definition>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000222 -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000222">
        <rdfs:label xml:lang="en">web application software</rdfs:label>
        <skos:definition xml:lang="en">Software that is installed on a server and can be used by users via a web page and the internet, for example Software-as-a-service (SaaS).</skos:definition>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001095 -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001095">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000222"/>
        <rdfs:label xml:lang="de">sparql endpoint</rdfs:label>
        <skos:definition xml:lang="en">A SPARQL Endpoint is a web application software that provides a queryable interface for accessing and retrieving structured data from RDF-based knowledge graphs using the SPARQL query language.</skos:definition>
    </owl:Class>
</rdf:RDF>



