@prefix : <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linnaeantaxonomy: <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> rdf:type owl:Ontology ;
                                                                     owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                     dcterms:description "The linnaean taxonomy content ontology design pattern represents the layered classification invented by Linneus in the XVIII century. It is created by reengineering Wikipedia articles about taxa, taxonomic ranks, and linnaean taxonomy."^^xsd:string ;
                                                                     dcterms:title "Linnaeantaxonomy Pattern"^^xsd:string ;
                                                                     cpannotationschema:reengineeredFrom "http://en.wikipedia.org/wiki/Linnaean_taxonomy" ,
                                                                                                         "http://en.wikipedia.org/wiki/Taxon" ,
                                                                                                         "http://en.wikipedia.org/wiki/Taxonomic_rank" ;
                                                                     rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x3; term declared x2;
- header: dcterms:title \"Linnaeantaxonomy Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                                  "The linnaean taxonomy content ontology design pattern represents the layered classification invented by Linneus in the XVIII century. It is created by reengineering Wikipedia articles about taxa, taxonomic ranks, and linnaean taxonomy."^^xsd:string ;
                                                                     owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                                     "Created by Aldo Gangemi and Valentina Presutti"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#reengineeredFrom
cpannotationschema:reengineeredFrom rdf:type owl:AnnotationProperty ;
                                    rdfs:label "reengineered from"@en .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#hasDirectHigherRank
linnaeantaxonomy:hasDirectHigherRank rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf linnaeantaxonomy:hasHigherRank ;
                                     owl:inverseOf linnaeantaxonomy:hasDirectLowerRank ;
                                     rdfs:domain linnaeantaxonomy:Taxon ;
                                     rdfs:range linnaeantaxonomy:Taxon ;
                                     rdfs:comment "This property relates two taxa, where the first is more specific then the second and there is no other taxon that is both more general than the first and more specific than the second." ;
                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                                     rdfs:label "has direct higher rank"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#hasDirectLowerRank
linnaeantaxonomy:hasDirectLowerRank rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf linnaeantaxonomy:hasLowerRank ;
                                    rdfs:domain linnaeantaxonomy:Taxon ;
                                    rdfs:range linnaeantaxonomy:Taxon ;
                                    rdfs:comment "This property relates two taxa, where the first is less specific then the second and there is no other taxon that is both more specific than the first and more general than the second." ;
                                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                                    rdfs:label "has direct lower rank"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#hasHigherRank
linnaeantaxonomy:hasHigherRank rdf:type owl:ObjectProperty ;
                               owl:inverseOf linnaeantaxonomy:hasLowerRank ;
                               rdf:type owl:TransitiveProperty ;
                               rdfs:domain linnaeantaxonomy:Taxon ;
                               rdfs:range linnaeantaxonomy:Taxon ;
                               rdfs:comment "This property relates two taxa, where the first is more specific than the second." ;
                               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                               rdfs:label "has higher rank"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#hasLowerRank
linnaeantaxonomy:hasLowerRank rdf:type owl:ObjectProperty ,
                                       owl:TransitiveProperty ;
                              rdfs:domain linnaeantaxonomy:Taxon ;
                              rdfs:range linnaeantaxonomy:Taxon ;
                              rdfs:comment "This property relates two taxa, where the first is less specific than the second." ;
                              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                              rdfs:label "has lower rank"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Class
linnaeantaxonomy:Class rdf:type owl:Class ;
                       rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Phylum
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Order
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( linnaeantaxonomy:Kingdom
                                                                           linnaeantaxonomy:Phylum
                                                                         )
                                                           ]
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                             owl:complementOf [ rdf:type owl:Class ;
                                                                                owl:unionOf ( linnaeantaxonomy:Class
                                                                                              linnaeantaxonomy:Kingdom
                                                                                              linnaeantaxonomy:Phylum
                                                                                            )
                                                                              ]
                                                           ]
                                       ] ;
                       owl:disjointWith linnaeantaxonomy:Family ,
                                        linnaeantaxonomy:Genus ,
                                        linnaeantaxonomy:Kingdom ,
                                        linnaeantaxonomy:Order ,
                                        linnaeantaxonomy:Phylum ,
                                        linnaeantaxonomy:Species ;
                       rdfs:comment "Class is the third highest traditional taxon. E.g., in the case of humans the class is 'Mammalia'." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                       rdfs:label "Class"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Family
linnaeantaxonomy:Family rdf:type owl:Class ;
                        rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                          owl:allValuesFrom linnaeantaxonomy:Order
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                          owl:allValuesFrom linnaeantaxonomy:Genus
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                              owl:complementOf [ rdf:type owl:Class ;
                                                                                 owl:unionOf ( linnaeantaxonomy:Family
                                                                                               linnaeantaxonomy:Genus
                                                                                               linnaeantaxonomy:Species
                                                                                             )
                                                                               ]
                                                            ]
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                              owl:unionOf ( linnaeantaxonomy:Genus
                                                                            linnaeantaxonomy:Species
                                                                          )
                                                            ]
                                        ] ;
                        owl:disjointWith linnaeantaxonomy:Genus ,
                                         linnaeantaxonomy:Kingdom ,
                                         linnaeantaxonomy:Order ,
                                         linnaeantaxonomy:Phylum ,
                                         linnaeantaxonomy:Species ;
                        rdfs:comment "Family is the fifth highest traditional taxon. E.g., in the case of humans the family is 'Hominidae'." ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                        rdfs:label "Family"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Genus
linnaeantaxonomy:Genus rdf:type owl:Class ;
                       rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Family
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Species
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                             owl:complementOf [ rdf:type owl:Class ;
                                                                                owl:unionOf ( linnaeantaxonomy:Genus
                                                                                              linnaeantaxonomy:Species
                                                                                            )
                                                                              ]
                                                           ]
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Species
                                       ] ;
                       owl:disjointWith linnaeantaxonomy:Kingdom ,
                                        linnaeantaxonomy:Order ,
                                        linnaeantaxonomy:Phylum ,
                                        linnaeantaxonomy:Species ;
                       rdfs:comment "Genus is the sixth highest traditional taxon. E.g., in the case of humans the genus is 'Homo'." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                       rdfs:label "Genus"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Kingdom
linnaeantaxonomy:Kingdom rdf:type owl:Class ;
                         rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                           owl:allValuesFrom linnaeantaxonomy:Phylum
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                           owl:allValuesFrom [ rdf:type owl:Class ;
                                                               owl:complementOf linnaeantaxonomy:Kingdom
                                                             ]
                                         ] ;
                         owl:disjointWith linnaeantaxonomy:Order ,
                                          linnaeantaxonomy:Phylum ,
                                          linnaeantaxonomy:Species ;
                         rdfs:comment "Kingdom is the highest traditional taxon. E.g., in the case of humans the kingdom is 'Animalia'." ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                         rdfs:label "Kingdom"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Order
linnaeantaxonomy:Order rdf:type owl:Class ;
                       rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Class
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                         owl:allValuesFrom linnaeantaxonomy:Family
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( linnaeantaxonomy:Class
                                                                           linnaeantaxonomy:Kingdom
                                                                           linnaeantaxonomy:Phylum
                                                                         )
                                                           ]
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                             owl:unionOf ( linnaeantaxonomy:Family
                                                                           linnaeantaxonomy:Genus
                                                                           linnaeantaxonomy:Species
                                                                         )
                                                           ]
                                       ] ;
                       owl:disjointWith linnaeantaxonomy:Phylum ,
                                        linnaeantaxonomy:Species ;
                       rdfs:comment "Order is the fourth highest traditional taxon. E.g., in the case of humans the phylum is 'Primates'." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                       rdfs:label "Order"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Phylum
linnaeantaxonomy:Phylum rdf:type owl:Class ;
                        rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                          owl:allValuesFrom linnaeantaxonomy:Kingdom
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasDirectLowerRank ;
                                          owl:allValuesFrom linnaeantaxonomy:Class
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                          owl:allValuesFrom linnaeantaxonomy:Kingdom
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty linnaeantaxonomy:hasLowerRank ;
                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                              owl:complementOf [ rdf:type owl:Class ;
                                                                                 owl:unionOf ( linnaeantaxonomy:Kingdom
                                                                                               linnaeantaxonomy:Phylum
                                                                                             )
                                                                               ]
                                                            ]
                                        ] ;
                        owl:disjointWith linnaeantaxonomy:Species ;
                        rdfs:comment "Phylum is the second highest traditional taxon. E.g., in the case of humans the phylum is 'Chordata'." ;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                        rdfs:label "Phylum"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Species
linnaeantaxonomy:Species rdf:type owl:Class ;
                         rdfs:subClassOf linnaeantaxonomy:Taxon ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty linnaeantaxonomy:hasDirectHigherRank ;
                                           owl:allValuesFrom linnaeantaxonomy:Genus
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty linnaeantaxonomy:hasHigherRank ;
                                           owl:allValuesFrom [ rdf:type owl:Class ;
                                                               owl:complementOf linnaeantaxonomy:Species
                                                             ]
                                         ] ;
                         rdfs:comment "Species is the lowest traditional taxon. E.g., in the case of humans the species is 'Homo sapiens'." ;
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                         rdfs:label "Species"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#Taxon
linnaeantaxonomy:Taxon rdf:type owl:Class ;
                       rdfs:comment "A taxon is a concept denoting a type of organism or of a group of organisms." ;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl> ;
                       rdfs:label "Taxon"@en .


