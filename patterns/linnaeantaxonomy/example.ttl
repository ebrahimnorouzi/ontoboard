# The Linnaean classification of the lion: seven taxa, from the species
# Panthera leo up to the kingdom Animalia, each one a rank below the next.
# hasDirectHigherRank joins adjacent ranks; hasHigherRank skips the chain.

@prefix linnaeantaxonomy: <http://www.ontologydesignpatterns.org/cp/owl/linnaeantaxonomy.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/linnaeantaxonomy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PantheraLeo a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Panthera leo, the lion (species)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Panthera ;
    linnaeantaxonomy:hasHigherRank ex:Animalia .

ex:Panthera a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Panthera, the big cats (genus)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Felidae .

ex:Felidae a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Felidae, the cat family (family)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Carnivora .

ex:Carnivora a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Carnivora, the carnivorans (order)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Mammalia .

ex:Mammalia a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Mammalia, the mammals (class)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Chordata .

ex:Chordata a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Chordata, the chordates (phylum)" ;
    linnaeantaxonomy:hasDirectHigherRank ex:Animalia .

ex:Animalia a owl:NamedIndividual , linnaeantaxonomy:Taxon ;
    rdfs:label "Animalia, the animals (kingdom)" .

# Only one direction of each inverse pair is asserted: hasDirectHigherRank/hasDirectLowerRank, hasHigherRank/hasLowerRank. A reasoner adds the other.
