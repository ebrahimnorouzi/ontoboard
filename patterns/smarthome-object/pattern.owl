    </owl:ObjectProperty>
    


    <!-- http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf -->

    <owl:ObjectProperty rdf:about="http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf">
        <rdfs:label xml:lang="en">is property of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasConstituent -->

