# Anatomical parts of the human body. The pattern declares properties and no classes,
# so these individuals are untyped, which is what the pattern says about them. hasPart
# is transitive, so a reasoner concludes the body also has the substantia nigra as a part.

@prefix partof: <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/partof#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:HumanBody a owl:NamedIndividual ;
    rdfs:label "the human body" ;
    partof:hasPart ex:Brain , ex:Heart .

ex:Brain a owl:NamedIndividual ;
    rdfs:label "the brain" ;
    partof:hasPart ex:SubstantiaNigra , ex:Cerebellum .

ex:Heart a owl:NamedIndividual ;
    rdfs:label "the heart" ;
    partof:hasPart ex:LeftVentricle .

ex:SubstantiaNigra a owl:NamedIndividual ;
    rdfs:label "the substantia nigra" .

ex:Cerebellum a owl:NamedIndividual ;
    rdfs:label "the cerebellum" .

ex:LeftVentricle a owl:NamedIndividual ;
    rdfs:label "the left ventricle" .
