# below are untyped - which is what the pattern says about them.

@prefix partof: <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/partof#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Whole a owl:NamedIndividual ;
    rdfs:label "the whole" ;
    partof:hasPart ex:Part .

ex:Part a owl:NamedIndividual ;
    rdfs:label "the part" .

