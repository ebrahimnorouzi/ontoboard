                                             ) ,
                                             ( :spatially-located-in
                                               :po-component
                                             ) ,
                                             ( :spatially-located-in
                                               :po-feature
                                             ) ,
                                             ( :spatially-located-in
                                               :po-member
                                             ) ,
                                             ( :spatially-located-in
                                               :po-place
                                             ) ,
                                             ( :spatially-located-in
