# Winston's six senses of "part of", all asserted about one mountain: Everest is a component of
# a massif, a member of a list of peaks, a place in a range, a portion of a rock mass, a feature
# of a skyline, and the stuff a moraine is built from. Same subject, six different relations.

@prefix winstonpartwhole: <http://daselab.org/WinstonPartWhole#> .
@prefix ex:               <https://w3id.org/ontoboard/example/winstonpartwhole#> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .

ex:MountEverest a owl:NamedIndividual ;
    rdfs:label "Mount Everest" ;
    winstonpartwhole:part-of ex:SagarmathaNationalPark ;
    winstonpartwhole:po-component ex:MahalangurHimal ;
    winstonpartwhole:po-feature ex:NamcheSkyline ;
    winstonpartwhole:po-member ex:TheEightThousanders ;
    winstonpartwhole:po-place ex:Himalayas ;
    winstonpartwhole:po-portion ex:HighHimalayanRockMass ;
    winstonpartwhole:po-stuff ex:KhumbuMoraine ;
    winstonpartwhole:spatially-located-in ex:Khumbu .

ex:SagarmathaNationalPark a owl:NamedIndividual ;
    rdfs:label "Sagarmatha National Park, which the mountain is part of without the kind of part being said" .

ex:MahalangurHimal a owl:NamedIndividual ;
    rdfs:label "the Mahalangur Himal, the massif the mountain is a component of" .

ex:NamcheSkyline a owl:NamedIndividual ;
    rdfs:label "the skyline seen from Namche Bazaar, of which the peak is a feature" .

ex:TheEightThousanders a owl:NamedIndividual ;
    rdfs:label "the fourteen eight-thousanders, the collection the mountain is a member of" .

ex:Himalayas a owl:NamedIndividual ;
    rdfs:label "the Himalayas, the range the mountain is a place in" .

ex:HighHimalayanRockMass a owl:NamedIndividual ;
    rdfs:label "the High Himalayan rock mass, which the mountain is a portion of" .

ex:KhumbuMoraine a owl:NamedIndividual ;
    rdfs:label "the moraine below the Khumbu icefall, built from rock shed by the mountain" .

ex:Khumbu a owl:NamedIndividual ;
    rdfs:label "the Khumbu, the region of north-eastern Nepal the mountain rises from" .

# The pattern declares no classes, so the individuals are untyped - what it says about them is
# how they are joined. Each po- relation is a sub-property of part-of, so a reasoner adds the
# plain part-of edge, and because spatially-located-in composes with every po- relation it also
# adds that Everest is located in every whole a po- relation reaches. Only the one sense that
# fits each whole is asserted.
