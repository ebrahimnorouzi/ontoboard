# One digitisation workstation and the three things it runs on: the operating system
# it uses, a graphics card, and the display driver that card needs. These are the
# four kinds the pattern's own scenarios name - "the computer uses Ubuntu 16.04",
# "the graphics card requires driver A".

@prefix computersystemodp: <http://mklab.iti.gr/pericles/ComputerSystem_ODP#> .
@prefix ex: <https://w3id.org/ontoboard/example/computer-system#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:DigitisationWorkstation a owl:NamedIndividual , computersystemodp:Computer ;
    rdfs:label "the digitisation workstation in the imaging lab" .

ex:NvidiaDisplayDriver390 a owl:NamedIndividual , computersystemodp:Driver ;
    rdfs:label "the NVIDIA 390 display driver" .

ex:QuadroK2200 a owl:NamedIndividual , computersystemodp:Hardware ;
    rdfs:label "the Quadro K2200 graphics card in that workstation" .

ex:Ubuntu1604 a owl:NamedIndividual , computersystemodp:OperatingSystem ;
    rdfs:label "Ubuntu 16.04 LTS" .
