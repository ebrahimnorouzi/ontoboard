# Three science-fiction novels on a public library shelf, one of which is also on
# this year's book-club reading list - so the same book is a member of two collections.

@prefix collectionentity: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/collection-entity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ScienceFictionShelf a owl:NamedIndividual , collectionentity:Collection ;
    rdfs:label "the science-fiction shelf, Karlsruhe City Library" ;
    collectionentity:hasMember ex:LeftHandOfDarkness ,
        ex:Solaris ,
        ex:Kindred .

ex:BookClubReadingList a owl:NamedIndividual , collectionentity:Collection ;
    rdfs:label "the 2026 book-club reading list" .

ex:LeftHandOfDarkness a owl:NamedIndividual , collectionentity:Entity ;
    rdfs:label "Le Guin, The Left Hand of Darkness (1969)" .

ex:Solaris a owl:NamedIndividual , collectionentity:Entity ;
    rdfs:label "Lem, Solaris (1961)" .

ex:Kindred a owl:NamedIndividual , collectionentity:Entity ;
    rdfs:label "Butler, Kindred (1979)" ;
    collectionentity:isMemberOf ex:BookClubReadingList .

