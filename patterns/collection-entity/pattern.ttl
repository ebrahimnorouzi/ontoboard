<http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl> rdf:type owl:Ontology ;
                                                                     rdfs:comment "Represents a collection and its members. Collections group entities that share some criterion." ;
                                                                     rdfs:label "Collection Entity Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           rdfs:domain :Collection ;
           rdfs:range :Entity ;
           rdfs:label "hasMember" .


###  http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf
:isMemberOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Entity ;
            rdfs:range :Collection ;
            rdfs:label "isMemberOf" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection
:Collection rdf:type owl:Class ;
            rdfs:label "Collection" .


###  http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Entity
:Entity rdf:type owl:Class ;
        rdfs:label "Entity" .


