# The skipjack tuna stock of the Western Central Pacific, recorded as lying in the
# tropical zone for the 2019 reference year - the pattern's own unit test asks for
# exactly this: the resource observations whose zone is 'Tropical'. Alongside it, a
# sea-surface temperature survey shows the generic observation pattern it specialises.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix climaticzone: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#> .
@prefix observation: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/climaticzone#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:SkipjackStockWCPO a owl:NamedIndividual , aquaticresources:AquaticResource , climaticzone:AquaticResource ;
    rdfs:label "the skipjack tuna stock of the Western and Central Pacific" ;
    aquaticresources:hasSpecies ex:SkipjackTuna .

ex:SkipjackZoneRecord2019 a owl:NamedIndividual , climaticzone:AquaticResourceObservation ;
    rdfs:label "the 2019 stock record placing the skipjack stock in the tropical zone" ;
    climaticzone:hasClimaticZone ex:Tropical ;
    climaticzone:hasReferenceYear "2019"^^xsd:gYear ;
    climaticzone:hasResource ex:SkipjackStockWCPO .

ex:SkipjackTuna a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "skipjack tuna (Katsuwonus pelamis)" .

ex:Tropical a owl:NamedIndividual , climaticzone:ClimaticZone ;
    rdfs:label "Tropical" .

ex:CoralSeaSurfaceWaters a owl:NamedIndividual , observation:FeatureOfInterest ;
    rdfs:label "the surface waters of the Coral Sea" .

ex:CoralSeaTemperatureSurvey a owl:NamedIndividual , observation:Observation ;
    rdfs:label "the February 2019 sea-surface temperature survey of the Coral Sea" ;
    observation:hasFeatureOfInterest ex:CoralSeaSurfaceWaters ;
    observation:hasResult ex:MeanSurfaceTemperature ;
    observation:madeBy ex:TunaTaggingTeam .

ex:TunaTaggingTeam a owl:NamedIndividual , observation:Observer ;
    rdfs:label "the Pacific Community's tuna tagging team" .

ex:MeanSurfaceTemperature a owl:NamedIndividual , observation:Result ;
    rdfs:label "a mean sea-surface temperature of 28.4 degrees Celsius" .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, hasClimaticZone/isClimaticZoneOf, hasResource/isResourceOf, hasSpecies/isSpeciesPresentIn. A reasoner adds the other.
