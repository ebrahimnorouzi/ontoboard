@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.ontologydesignpatterns.org/cp/owl/observation.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What resource has what climatic zone?" ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """This pattern only allows to query what climatic zones are typical of an aquatic resource. Whereas such values can be subject to observation, another pattern based on the generic 'observation' pattern should be used.
The climatic zone is intended to have a fixed set of values (to be defined as nominals) but this is not explicit in the pattern.""" ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "The intent of the pattern is to be able to represent climatic zones for aquatic resources." ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> "SELECT ?x WHERE {?x a :AquaticResourceObservation.  ?x :hasClimaticZone :Tropical}" ;
                                                                       <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "Give me the resource observations where the zone is 'Tropical'" ;
                                                                       owl:versionInfo "1.0"^^xsd:string .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasClimaticZone
:hasClimaticZone rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter> ;
                 owl:inverseOf :isClimaticZoneOf ;
                 rdfs:domain :AquaticResourceObservation ;
                 rdfs:range :ClimaticZone ;
                 rdfs:label "has climatic zone"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasResource
:hasResource rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf> ;
             owl:inverseOf :isResourceOf ;
             rdfs:domain :AquaticResourceObservation ;
             rdfs:range :AquaticResource ;
             rdfs:label "has resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#isClimaticZoneOf
:isClimaticZoneOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf> ;
                  rdfs:domain :ClimaticZone ;
                  rdfs:range :AquaticResourceObservation ;
                  rdfs:label "is climatic zone of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#isResourceOf
:isResourceOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation> ;
              rdfs:domain :AquaticResource ;
              rdfs:range :AquaticResourceObservation ;
              rdfs:label "is resource of"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasReferenceYear
:hasReferenceYear rdf:type owl:DatatypeProperty ;
                  rdfs:domain :AquaticResourceObservation ;
                  rdfs:range xsd:gYear ;
                  rdfs:label "has reference year"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#AquaticResource
:AquaticResource rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing ;
                 owl:disjointWith <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation> ,
                                  <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
                 rdfs:comment """A fishery resource (a collection of actual aquatic organisms) that can include aquatic organisms from different AquaticSpecies, and is localized in some WaterArea.
It can be mapped to fi:AqResRef""" ;
                 rdfs:label "Aquatic resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#AquaticResourceObservation
:AquaticResourceObservation rdf:type owl:Class ;
                            rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation> ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasClimaticZone ;
                                              owl:someValuesFrom :ClimaticZone
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasResource ;
                                              owl:someValuesFrom :AquaticResource
                                            ] ;
                            rdfs:comment "An observation of a resource characterised by different parameters." ;
                            rdfs:label "Aquatic resource observation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#ClimaticZone
:ClimaticZone rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter> ;
              rdfs:label "Climatic zone"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation

###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter

