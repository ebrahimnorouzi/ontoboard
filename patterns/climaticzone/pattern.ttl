@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#> .
@prefix obs: <http://www.ontologydesignpatterns.org/cp/owl/observation.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl> rdf:type owl:Ontology ;
                                                                       owl:imports <http://www.ontologydesignpatterns.org/cp/owl/observation.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl> ,
                                                                                   <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                       dcterms:description "The intent of the pattern is to be able to represent climatic zones for aquatic resources."^^xsd:string ;
                                                                       dcterms:title "Climaticzone Pattern"^^xsd:string ;
                                                                       cpannotationschema:coversRequirements "What resource has what climatic zone?" ;
                                                                       cpannotationschema:hasConsequences """This pattern only allows to query what climatic zones are typical of an aquatic resource. Whereas such values can be subject to observation, another pattern based on the generic 'observation' pattern should be used.
The climatic zone is intended to have a fixed set of values (to be defined as nominals) but this is not explicit in the pattern.""" ;
                                                                       cpannotationschema:hasIntent "The intent of the pattern is to be able to represent climatic zones for aquatic resources."^^xsd:string ;
                                                                       cpannotationschema:hasUnitTest "SELECT ?x WHERE {?x a :AquaticResourceObservation.  ?x :hasClimaticZone :Tropical}" ;
                                                                       cpannotationschema:scenarios "Give me the resource observations where the zone is 'Tropical'" ;
                                                                       rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x13; term declared x13;
- header: dcterms:title \"Climaticzone Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
- file: only pattern.ttl said Declaration(Datatype(xsd:gYear)) - not kept: pattern.owl is what an import copies
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                       owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences
cpannotationschema:hasConsequences rdf:type owl:AnnotationProperty ;
                                   rdfs:label "has consequences"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest
cpannotationschema:hasUnitTest rdf:type owl:AnnotationProperty ;
                               rdfs:label "has unit test"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios
cpannotationschema:scenarios rdf:type owl:AnnotationProperty ;
                             rdfs:label "scenarios"@en .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasClimaticZone
:hasClimaticZone rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obs:hasParameter ;
                 owl:inverseOf :isClimaticZoneOf ;
                 rdfs:domain :AquaticResourceObservation ;
                 rdfs:range :ClimaticZone ;
                 rdfs:label "has climatic zone"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasResource
:hasResource rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf obs:isObservationOf ;
             owl:inverseOf :isResourceOf ;
             rdfs:domain :AquaticResourceObservation ;
             rdfs:range :AquaticResource ;
             rdfs:label "has resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#isClimaticZoneOf
:isClimaticZoneOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf obs:isParameterOf ;
                  rdfs:domain :ClimaticZone ;
                  rdfs:range :AquaticResourceObservation ;
                  rdfs:label "is climatic zone of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#isResourceOf
:isResourceOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf obs:hasObservation ;
              rdfs:domain :AquaticResource ;
              rdfs:range :AquaticResourceObservation ;
              rdfs:label "is resource of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasObservation
obs:hasObservation rdf:type owl:ObjectProperty ;
                   rdfs:label "has observation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#hasParameter
obs:hasParameter rdf:type owl:ObjectProperty ;
                 rdfs:label "has parameter"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isObservationOf
obs:isObservationOf rdf:type owl:ObjectProperty ;
                    rdfs:label "is observation of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#isParameterOf
obs:isParameterOf rdf:type owl:ObjectProperty ;
                  rdfs:label "is parameter of"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#hasReferenceYear
:hasReferenceYear rdf:type owl:DatatypeProperty ;
                  rdfs:domain :AquaticResourceObservation ;
                  rdfs:range xsd:gYear ;
                  rdfs:label "has reference year"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#AquaticResource
:AquaticResource rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing ;
                 owl:disjointWith obs:Observation ,
                                  obs:Parameter ;
                 rdfs:comment """A fishery resource (a collection of actual aquatic organisms) that can include aquatic organisms from different AquaticSpecies, and is localized in some WaterArea.
It can be mapped to fi:AqResRef""" ;
                 rdfs:label "Aquatic resource"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#AquaticResourceObservation
:AquaticResourceObservation rdf:type owl:Class ;
                            rdfs:subClassOf obs:Observation ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasClimaticZone ;
                                              owl:someValuesFrom :ClimaticZone
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasResource ;
                                              owl:someValuesFrom :AquaticResource
                                            ] ;
                            rdfs:comment "An observation of a resource characterised by different parameters." ;
                            rdfs:label "Aquatic resource observation"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/climaticzone.owl#ClimaticZone
:ClimaticZone rdf:type owl:Class ;
              rdfs:subClassOf obs:Parameter ;
              rdfs:label "Climatic zone"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Observation
obs:Observation rdf:type owl:Class ;
                rdfs:label "Observation"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/observation.owl#Parameter
obs:Parameter rdf:type owl:Class ;
              rdfs:label "Parameter"@en .


