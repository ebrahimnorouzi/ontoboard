# The two intervals from this pattern's scenarios - a project that runs from January to
# June, and a lecture slot - showing that the same two properties carry a date and a
# clock time, because the pattern declares no range for either.

@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/time-interval#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ProjectRun a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "the project's run, January to June 2024" ;
    timeinterval:hasIntervalStartDate "2024-01-08" ;
    timeinterval:hasIntervalEndDate "2024-06-28" .

ex:LectureSlot a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "the Tuesday lecture slot, 10:00 to 11:30" ;
    timeinterval:hasIntervalStartDate "10:00" ;
    timeinterval:hasIntervalEndDate "11:30" .
