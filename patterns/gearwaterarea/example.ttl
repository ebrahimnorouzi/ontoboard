# North Sea flatfish gear, on the pattern's own scenario: which water areas a gear type is used
# in. Bottom-set gillnets and beam trawls are both suitable for ICES Division 4b, where the sole
# stock they catch occurs; the beam trawl is also worked in the Eastern English Channel.

@prefix aquaticresources: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#> .
@prefix gearspecies: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/gearwaterarea#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:NorthSeaSoleStock a owl:NamedIndividual , aquaticresources:AquaticResource ;
    rdfs:label "the North Sea sole stock" ;
    aquaticresources:hasSpecies ex:CommonSole .

ex:CommonSole a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "common sole (Solea solea)" ;
    gearspecies:isCaughtByGearType ex:BottomSetGillnet .

ex:EuropeanPlaice a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "European plaice (Pleuronectes platessa)" .

ex:HarbourPorpoise a owl:NamedIndividual , aquaticresources:AquaticSpecies ;
    rdfs:label "harbour porpoise (Phocoena phocoena)" .

ex:BottomSetGillnet a owl:NamedIndividual , gearspecies:GearType ;
    rdfs:label "bottom-set gillnet (anchored)" ;
    gearspecies:incidentallyCatchesSpecies ex:HarbourPorpoise .

ex:BeamTrawl a owl:NamedIndividual , gearspecies:GearType ;
    rdfs:label "beam trawl" ;
    gearspecies:targetsSpecies ex:EuropeanPlaice ;
    gearspecies:catchesSpecies ex:CommonSole .

ex:IcesDivision4b a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "ICES Division 4b, the central North Sea" ;
    <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearwaterarea.owl#isSuitableForGearType> ex:BottomSetGillnet , ex:BeamTrawl .

ex:IcesDivision7d a owl:NamedIndividual , aquaticresources:WaterArea ;
    rdfs:label "ICES Division 7d, the eastern English Channel" ;
    <http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearwaterarea.owl#isSuitableForGearType> ex:BeamTrawl .

# Only one direction of each inverse pair is asserted: canOccurIn/isAreaOfOccurrenceOf, catchesSpecies/isCaughtBy, hasSpecies/isSpeciesPresentIn, isSuitableForGearType/isUsedInWaterArea. A reasoner adds the other.
