###  https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001037
<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001037> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000578> ;
