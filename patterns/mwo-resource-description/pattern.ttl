                                                      rdfs:label "standard"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "A specification that establishes a set of guidelines, criteria, or norms recognized and adopted by internationational community."@en .


###  https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001001
<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001001> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000300> ;
                                                      rdfs:label "citation"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "A textual entity intended to identify a particular publication." .


###  https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001017
<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001017> rdf:type owl:Class ;
                                                      rdfs:label "export format specification"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "A directive information entity that defines the structural, syntactic, and encoding rules for representing data when it is exported from a system."@en .


###  https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001018
<https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001018> rdf:type owl:Class ;
