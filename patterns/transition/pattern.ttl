@prefix : <http://www.ontologydesignpatterns.org/cp/owl/transition.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix region: <http://www.ontologydesignpatterns.org/cp/owl/region.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix transition: <http://www.ontologydesignpatterns.org/cp/owl/transition.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix participation: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeindexedparticipation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/transition.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/transition.owl> rdf:type owl:Ontology ;
                                                               owl:imports <http://www.ontologydesignpatterns.org/cp/owl/region.owl> ,
                                                                           <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> ,
                                                                           <http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl> ;
                                                               dcterms:description "To represent basic knowledge about transitions (events, states, processes, objects)."^^xsd:string ;
                                                               dcterms:title "Transition Pattern"^^xsd:string ;
                                                               cpannotationschema:coversRequirements "What states of some object are changed by what event during a transition?,What is the process that is invariant through the transition?,What transitions are occurring on what object at what time?" ;
                                                               cpannotationschema:hasAuthor "Aldo Gangemi" ;
                                                               cpannotationschema:hasComponent "Region,Sequence,Time indexed participation" ;
                                                               cpannotationschema:hasConsequences """We are able to represent part of the semantics involved in transitions (e.g. what is implied by Petri Nets): initial and final states, causal events, underlying processes, affected objects, and sequences of time intervals for situations and events.
However, it is not possible to define axioms for automatically infer initial and final states from time sequences, because coreference is not allowed in OWL (not even in OWL2).""" ;
                                                               cpannotationschema:hasIntent "To represent basic knowledge about transitions (events, states, processes, objects)."^^xsd:string ;
                                                               cpannotationschema:hasUnitTest """SELECT ?is ?e ?fs ?p ?o ?t1 ?t2 ?t3
WHERE {
?x :includesInitialSituation ?is .
?x :includeFinalSituation ?fs .
?x :includeEvent ?e .
?x :includesProcess ?p .
?x :includesObject ?o .
?x :atTimeInitial ?t1 .
?x :atTimeEvent ?t2 .
?x :atTimeFinal ?t3 .
?is :occursAt ?t1 .
?e :occursAt ?t2 .
?fs :occursAt ?t3 .
?t1 :precedes ?t2 .
?t2 :precedes ?t3 }""" ;
                                                               cpannotationschema:scenarios "The addition of Bud Powell on piano made the tune jump from a static, aerial comping into a hard driving swing improvisation" ;
                                                               rdfs:comment "A simple pattern to represent transitions between states." ,
                                                                            """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x1; label added x28; term declared x3;
- header: dcterms:title \"Transition Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                               rdfs:label "Transition pattern" ;
                                                               owl:versionInfo """1.1
- Enriched axioms on transition class, revised properties, added annotations for ODP submission
1.0
- Created by Aldo Gangemi""" ,
                                                                               "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

