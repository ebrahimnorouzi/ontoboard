     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/region.owl#hasRegion -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/region.owl#hasRegion">
        <rdfs:label xml:lang="en">has region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/region.owl#isRegionFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/region.owl#isRegionFor">
        <rdfs:label xml:lang="en">is region for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isSettingFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesEvent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesEvent">
        <rdfs:label xml:lang="en">includes event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesObject -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesObject">
        <rdfs:label xml:lang="en">includes object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime">
        <rdfs:label xml:lang="en">at time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity">
        <rdfs:label xml:lang="en">for entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting">
        <rdfs:label xml:lang="en">has time indexed setting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor">
        <rdfs:label xml:lang="en">is time index for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasEventAtTime -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasEventAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isEventTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:comment>The time of the event causing the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>atTimeEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasFinalStateAtTime -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasFinalStateAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalStateTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:comment>The time of the final state of the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>atTimeFinal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasInitialStateAtTime -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#hasInitialStateAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialStateTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:comment>The time of the initial state in the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>atTimeInitial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesFinalSituation -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesFinalSituation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalSituationIncludedIn"/>
        <rdfs:comment>A relation between a transition situation and the situation resulting from the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>includesFinalSituation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesInitialSituation -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesInitialSituation">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialSituationIncludedIn"/>
        <rdfs:comment>A relation between a transition situation and the situation existing before  the transition event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>includesInitialSituation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesProcess -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesProcess">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isProcessIncludedIn"/>
        <rdfs:comment>A relation between a transition situation and the underlying process that  is invariant for the object(s) included in the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>includesProcess</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isEventTimeIndexFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isEventTimeIndexFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label xml:lang="en">is event time index for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalSituationIncludedIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalSituationIncludedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting"/>
        <rdfs:comment>A relation between a transition situation and the situation resulting from the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>isFinalSituationIncludedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalStateTimeIndexFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isFinalStateTimeIndexFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label xml:lang="en">is final state time index for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialSituationIncludedIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialSituationIncludedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting"/>
        <rdfs:comment>A relation between a transition situation and the situation existing before  the transition event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>isInitialSituationIncludedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialStateTimeIndexFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isInitialStateTimeIndexFor">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is initial state time index for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isProcessIncludedIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isProcessIncludedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting"/>
        <rdfs:comment>A relation between a transition situation and the underlying process that  is invariant for the object(s) included in the transition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>isProcessIncludedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isTimeOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#isTimeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/region.owl#isRegionFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#occursAt"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>isTimeOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#occursAt -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#occursAt">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/region.owl#hasRegion"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label>occursAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event">
        <rdfs:comment>In this pattern, it is the cause for the transition.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object">
        <rdfs:comment>In this pattern, it is the entity that is invariant through the Process underlying  the transition, but is also changed by the Event that causes the transition.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/region.owl#Region -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/region.owl#Region">
        <rdfs:label xml:lang="en">Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Situation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#TimeIndexedParticipation -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#TimeIndexedParticipation">
        <rdfs:label xml:lang="en">Time indexed participation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/region.owl#Region"/>
        <rdfs:label xml:lang="en">Time interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Process -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Process">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
        <rdfs:comment>The invariance under some different transitions (including the one represented here), in which at least one Object is situated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label xml:lang="en">Process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Transition">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesObject"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">8</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#includesEvent"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesFinalSituation"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#TimeIndexedParticipation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesInitialSituation"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedparticipation.owl#TimeIndexedParticipation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#includesProcess"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A transition is a Situation that creates a context for three TimeInterval(s), two additional different Situation(s), one Event, one Process, and at least one Object: the Event is observed as the cause for the transition, one Situation is the state before the transition, the second Situation is the state after the transition, the Process is the invariance under some different transitions (including the one represented here), in which at least one Object is situated. Finally, the time intervals position the situations and the transitional event in time.
This class of situations partly encodes the ontology underlying typical engineering algebras for processes, e.g. Petri Nets. 
A full representation of the transition ontology is outside the expressivity of OWL, because we would need qualified cardinality restrictions,  coreference, property equivalence, and property composition.</rdfs:comment>
        <rdfs:comment>In this pattern, it is the entity that is invariant across the Process underlying the transition, but is also changed from an initial to a final state by an Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/transition.owl"/>
        <rdfs:label xml:lang="en">Transition</rdfs:label>
        <skos:prefLabel xml:lang="it">Transizione</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:RDF>



