<http://www.ontologydesignpatterns.org/cp/owl/constituency.owl> rdf:type owl:Ontology ;
                                                                 owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                 dcterms:description "The constituency pattern. It is extracted from DOLCE-UltraLite by partial clone of elements."^^xsd:string ;
                                                                 dcterms:title "Constituency Pattern"^^xsd:string ;
                                                                 rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x2; label added x3; term declared x3;
- header: dcterms:title \"Constituency Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                              "The constituency pattern. It is extracted from DOLCE-UltraLite by partial clone of elements."^^xsd:string ;
                                                                 rdfs:label "constituency" ;
                                                                 owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                                 "Created by Valentina Presutti"^^xsd:string .

