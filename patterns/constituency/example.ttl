# below are untyped - which is what the pattern says about them.

@prefix constituency: <http://www.ontologydesignpatterns.org/cp/owl/constituency.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/constituency#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Whole a owl:NamedIndividual ;
    rdfs:label "the whole" ;
    constituency:hasConstituent ex:Constituent .

ex:Constituent a owl:NamedIndividual ;
    rdfs:label "the constituent" .

