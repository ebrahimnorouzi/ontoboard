# The timeperiod pattern on three everyday durations. Each period keeps its number and its unit as
# two separate things - 14 days, not the string "14 days" - which is the whole point of the n-ary
# shape: the value is an integer a query can compare, and the unit is an individual periods share.

@prefix timeperiod: <http://www.ontologydesignpatterns.org/cp/owl/timeperiod.owl#> .
@prefix ex:         <https://w3id.org/ontoboard/example/timeperiod#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

ex:TwoYearWarranty a owl:NamedIndividual , timeperiod:TimePeriod ;
    rdfs:label "the two-year warranty on a new washing machine" ;
    timeperiod:hasTimePeriodMeasurementUnit ex:Year ;
    timeperiod:timePeriodValue 2 .

ex:FourteenDayReturnWindow a owl:NamedIndividual , timeperiod:TimePeriod ;
    rdfs:label "the fourteen days a customer has to return an online order" ;
    timeperiod:hasTimePeriodMeasurementUnit ex:Day ;
    timeperiod:timePeriodValue 14 .

ex:NinetyMinuteMatch a owl:NamedIndividual , timeperiod:TimePeriod ;
    rdfs:label "the ninety minutes of regular play in a football match" ;
    timeperiod:hasTimePeriodMeasurementUnit ex:Minute ;
    timeperiod:timePeriodValue 90 .

ex:Year a owl:NamedIndividual , timeperiod:TimePeriodMeasurementUnit ;
    rdfs:label "year" .

ex:Day a owl:NamedIndividual , timeperiod:TimePeriodMeasurementUnit ;
    rdfs:label "day" .

ex:Minute a owl:NamedIndividual , timeperiod:TimePeriodMeasurementUnit ;
    rdfs:label "minute" .

# Only one direction of each inverse pair is asserted: hasTimePeriodMeasurementUnit/isTimePeriodMeasurementUnitOf. A reasoner adds the other.

