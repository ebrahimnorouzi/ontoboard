     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeperiod.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl"/>
        <dc:creator>Aldo Gangemi</dc:creator>
        <dc:creator>Andrea Nuzzolese</dc:creator>
        <dc:creator>Valentina Carriero</dc:creator>
        <dc:creator>Valentina Presutti</dc:creator>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent time periods, as n-ary relation with a measurement unit and a numerical value.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Timeperiod Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>Which is the measurement unit of a time period?, Which is the value of a time period?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasConsequences>The measurement unit and the numerical value of a time period can be modeled.</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent time periods, as n-ary relation with a measurement unit and a numerical value.</cpannotationschema:hasIntent>
        <rdfs:comment xml:lang="en">A pattern for time periods.</rdfs:comment>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x6; term declared x5;
- header: dcterms:title &quot;Timeperiod Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:label>time period</rdfs:label>
    </owl:Ontology>
    


