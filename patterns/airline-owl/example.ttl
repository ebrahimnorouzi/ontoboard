# KLM's fleet: the airline and two of the aircraft in it. That is the whole of this
# pattern - an airline, an aircraft, and the relation between them, which is what answers
# "which aircraft are in a given airline's fleet?". The property keeps the pattern's own
# namespace.

@prefix ontology: <http://dbpedia.org/ontology/> .
@prefix ex: <https://w3id.org/ontoboard/example/airline-owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:KLM a owl:NamedIndividual , ontology:Airline ;
    rdfs:label "KLM Royal Dutch Airlines" ;
    <file:/C:/Users/eno/Documents/Git_repo/ebrahimnorouzi_github/ISE-FIZKarlsruhe/ontoboard/protege-plugin/../patterns/airline-owl/pattern.owl#hasAircraft> ex:Boeing737800 ,
        ex:Boeing777300ER .

ex:Boeing737800 a owl:NamedIndividual , ontology:Aircraft ;
    rdfs:label "Boeing 737-800" .

ex:Boeing777300ER a owl:NamedIndividual , ontology:Aircraft ;
    rdfs:label "Boeing 777-300ER" .

