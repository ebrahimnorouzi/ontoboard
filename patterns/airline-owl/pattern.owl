    <owl:Class rdf:about="http://dbpedia.org/ontology/Aircraft">
        <rdfs:label xml:lang="en">aircraft</rdfs:label>
        <skos:prefLabel xml:lang="fr">avion</skos:prefLabel>
        <skos:prefLabel xml:lang="el">αεροσκάφος</skos:prefLabel>
    </owl:Class>
    


    <!-- http://dbpedia.org/ontology/Airline -->

    <owl:Class rdf:about="http://dbpedia.org/ontology/Airline">
        <rdfs:label xml:lang="en">airline</rdfs:label>
        <skos:editorialNote xml:lang="en">Axioms were lost when this pattern was harvested: the OWL API could not read part of the source and substituted placeholder classes in http://org.semanticweb.owlapi/error#, which asserted this class to be a subclass of Error1, Error2 and so on. The placeholders are removed here because they carry no information. What they stood for is still in the source: https://ontologydesignpatterns.org/wiki/Submissions:Airline.owl.</skos:editorialNote>
        <skos:prefLabel xml:lang="fr">compagnie aérienne</skos:prefLabel>
    </owl:Class>
    


