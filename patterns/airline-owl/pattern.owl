    <!-- http://dbpedia.org/ontology/MeanOfTransportation -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/MeanOfTransportation"/>
    


    <!-- http://www.ontologydesignpatterns.org/ekp/owl/Airline.owl#hasAircraft -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ekp/owl/Airline.owl#hasAircraft">
        <rdfs:subPropertyOf rdf:resource="http://dbpedia.org/ontology/MeanOfTransportation"/>
