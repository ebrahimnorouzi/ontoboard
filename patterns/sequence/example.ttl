# Six steps of a real route in the order they have to happen: a 42CrMo4 blank is cut, hardened,
# machined to size and pulled to failure. Both the step-to-step ordering and two longer-range
# statements are shown, because in this pattern neither follows from the other.

@prefix sequence: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/sequence#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:CutBlank a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "cut the test blank from the 40 mm 42CrMo4 bar" ;
    sequence:directlyPrecedes ex:Austenitise ;
    sequence:precedes ex:TensileTest .

ex:Austenitise a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "hold at 850 C for 30 minutes" ;
    sequence:directlyPrecedes ex:OilQuench .

ex:OilQuench a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "quench into oil held at 60 C" ;
    sequence:directlyPrecedes ex:Temper .

ex:Temper a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "temper at 200 C for one hour" ;
    sequence:directlyPrecedes ex:MachineToGauge .

ex:MachineToGauge a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "machine the hardened blank down to the 10 mm gauge diameter" ;
    rdfs:comment "After the quench, not before: machining last takes off the distorted and decarburised surface." .

ex:TensileTest a owl:NamedIndividual , sequence:Entity ;
    rdfs:label "pull the specimen to failure at 2 mm/min" ;
    sequence:directlyFollows ex:MachineToGauge ;
    sequence:follows ex:Austenitise .

# This version of the pattern declares no inverses, no transitivity and no link between the
# direct and the indirect properties. So nothing here is inferred: that cutting the blank
# precedes the tensile test five steps later is asserted, because otherwise no one could ask it.
