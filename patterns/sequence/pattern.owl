<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl">
  <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl">
    <rdfs:label>Sequence Pattern</rdfs:label>
    <rdfs:comment>Represents an ordered sequence of entities where each element follows another.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity">
    <rdfs:label>Entity</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyFollows">
    <rdfs:label>directlyFollows</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyPrecedes">
    <rdfs:label>directlyPrecedes</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows">
    <rdfs:label>follows</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes">
    <rdfs:label>precedes</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity"/>
  </owl:ObjectProperty>
</rdf:RDF>