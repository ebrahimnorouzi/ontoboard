<http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> rdf:type owl:Ontology ;
                                                             rdfs:comment "Represents an ordered sequence of entities where each element follows another." ;
                                                             rdfs:label "Sequence Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyFollows
:directlyFollows rdf:type owl:ObjectProperty ;
                 rdfs:domain :Entity ;
                 rdfs:range :Entity ;
                 rdfs:label "directlyFollows" .


###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyPrecedes
:directlyPrecedes rdf:type owl:ObjectProperty ;
                  rdfs:domain :Entity ;
                  rdfs:range :Entity ;
                  rdfs:label "directlyPrecedes" .


###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows
:follows rdf:type owl:ObjectProperty ;
         rdfs:domain :Entity ;
         rdfs:range :Entity ;
         rdfs:label "follows" .


###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes
:precedes rdf:type owl:ObjectProperty ;
          rdfs:domain :Entity ;
          rdfs:range :Entity ;
          rdfs:label "precedes" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#Entity
:Entity rdf:type owl:Class ;
        rdfs:label "Entity" .


