     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:label xml:lang="en">Description (DC terms)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:label xml:lang="en">Title</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#isDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
        <rdfs:label xml:lang="en">preferred label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsFor">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsThrough"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson"/>
        <rdfs:comment>The relation holding between any Agent, and a SocialPerson. In principle, a SocialPerson requires at least one NaturalPerson in order to act, but this dependency can be &apos;delegated&apos;; e.g. a university can be acted for by a department, which on its turm is acted for by natural persons.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">acts for</rdfs:label>
        <skos:prefLabel xml:lang="it">agisce per</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsThrough -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsThrough">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
        <rdfs:comment>The relation holding between any Agent, and a SocialPerson. In principle, a SocialPerson requires at least one NaturalPerson in order to act, but this dependency can be &apos;delegated&apos;; e.g. a university can be acted for by a department, which on its turm is acted for by natural persons.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">acts through</rdfs:label>
        <skos:prefLabel xml:lang="it">agisce mediante</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#introduces -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#introduces">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#isIntroducedBy"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson"/>
        <rdfs:comment>A relation between a Description and a SocialPerson, e.g. a Constitutional Charter that introduces the SocialPerson &apos;PresidentOfRepublic&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">introduces</rdfs:label>
        <skos:prefLabel xml:lang="it">introduce</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#isIntroducedBy -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#isIntroducedBy">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description"/>
        <rdfs:comment>A relation between a Description and a SocialPerson, e.g. a Constitutional Charter that introduces the SocialPerson &apos;PresidentOfRepublic&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">is introduced by</rdfs:label>
        <skos:prefLabel xml:lang="it">è introdotto da</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent">
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Description</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#NaturalPerson -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#NaturalPerson">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#Person"/>
        <rdfs:comment>A Person in the physical commonsense intuition: &apos;have you seen that person walking down the street?&apos;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">Natural person</rdfs:label>
        <skos:prefLabel xml:lang="it">Persona fisica</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#Person -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#Person">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#NaturalPerson"/>
                    <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
        <rdfs:comment>Persons in commonsense intuition, which does not apparently distinguish between either natural or social persons.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <skos:prefLabel xml:lang="it">Persona</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#SocialPerson">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl#actsThrough"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Person that needs the existence of a specific NaturalPerson in order to act (but the lifetime of the NaturalPerson has only to overlap that of the SocialPerson). The NaturalPerson through which it acts can be also indirectly related, e.g. an organization that acts through another organization, which actsThrough one or more NaturalPerson(s).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/persons.owl"/>
        <rdfs:label xml:lang="en">Social person</rdfs:label>
        <skos:prefLabel xml:lang="it">Persona sociale</skos:prefLabel>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:RDF>



