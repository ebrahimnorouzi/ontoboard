<http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> rdf:type owl:Ontology ;
                                                                   owl:imports <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl> ,
                                                                               <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> ;
                                                                   dcterms:description "Diagram (this article has no graphical representation)"^^xsd:string ;
                                                                   dcterms:title "Planconditions Pattern"^^xsd:string ;
                                                                   rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x7; term declared x2;
- header: dcterms:title \"Planconditions Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                   owl:versionInfo "1.0" ,
                                                                                   "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string .

