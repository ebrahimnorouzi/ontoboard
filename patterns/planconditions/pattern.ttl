dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#followsPrecondition
planconditions:followsPrecondition rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf sequence:follows ;
                                   owl:inverseOf planconditions:isPreconditionFollowedBy ;
                                   rdfs:domain basicplanexecution:PlanExecution ;
                                   rdfs:range situation:Situation ;
                                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                   rdfs:label "follows precondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#hasPostcondition
planconditions:hasPostcondition rdf:type owl:ObjectProperty ;
                                owl:inverseOf planconditions:isPostconditionOf ;
                                rdfs:domain basicplandescription:Plan ;
                                rdfs:range situation:Situation ;
                                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                rdfs:label "has postcondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#hasPrecondition
planconditions:hasPrecondition rdf:type owl:ObjectProperty ;
                               owl:inverseOf planconditions:isPreconditionOf ;
                               rdfs:domain basicplandescription:Plan ;
                               rdfs:range situation:Situation ;
                               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                               rdfs:label "has precondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPostconditionOf
planconditions:isPostconditionOf rdf:type owl:ObjectProperty ;
                                 rdfs:domain situation:Situation ;
                                 rdfs:range basicplandescription:Plan ;
                                 rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                 rdfs:label "is postcondition of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPostconditionPrecededBy
planconditions:isPostconditionPrecededBy rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf sequence:follows ;
                                         owl:inverseOf planconditions:precedesPostcondition ;
                                         rdfs:domain situation:Situation ;
                                         rdfs:range basicplanexecution:PlanExecution ;
                                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                         rdfs:label "is postcondition preceded by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPreconditionFollowedBy
planconditions:isPreconditionFollowedBy rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf sequence:precedes ;
                                        rdfs:domain situation:Situation ;
                                        rdfs:range basicplanexecution:PlanExecution ;
                                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                        rdfs:label "is precondition followed by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPreconditionOf
planconditions:isPreconditionOf rdf:type owl:ObjectProperty ;
                                rdfs:domain situation:Situation ;
                                rdfs:range basicplandescription:Plan ;
                                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                rdfs:label "is precondition of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#precedesPostcondition
planconditions:precedesPostcondition rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf sequence:precedes ;
                                     rdfs:domain basicplanexecution:PlanExecution ;
                                     rdfs:range situation:Situation ;
                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                                     rdfs:label "precedes postcondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows
sequence:follows rdf:type owl:ObjectProperty ;
                 rdfs:label "follows"^^xsd:string .


###  http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes
sequence:precedes rdf:type owl:ObjectProperty ;
                  rdfs:label "precedes"^^xsd:string .


