                 rdfs:label "has precondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPostconditionOf
:isPostconditionOf rdf:type owl:ObjectProperty ;
                   rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                   rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan> ;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                   rdfs:label "is postcondition of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPostconditionPrecededBy
:isPostconditionPrecededBy rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows> ;
                           owl:inverseOf :precedesPostcondition ;
                           rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                           rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution> ;
                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                           rdfs:label "is postcondition preceded by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPreconditionFollowedBy
:isPreconditionFollowedBy rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> ;
                          rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                          rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution> ;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                          rdfs:label "is precondition followed by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#isPreconditionOf
:isPreconditionOf rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                  rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan> ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                  rdfs:label "is precondition of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#precedesPostcondition
:precedesPostcondition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> ;
                       rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution> ;
