###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#followsPrecondition
:followsPrecondition rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows> ;
                     owl:inverseOf :isPreconditionFollowedBy ;
                     rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution> ;
                     rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                     rdfs:label "follows precondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#hasPostcondition
:hasPostcondition rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isPostconditionOf ;
                  rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan> ;
                  rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl> ;
                  rdfs:label "has postcondition"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/planconditions.owl#hasPrecondition
:hasPrecondition rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isPreconditionOf ;
                 rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan> ;
                 rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> ;
