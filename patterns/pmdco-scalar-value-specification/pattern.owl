     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ontoboard.org/patterns/pmdco-scalar-value-specification.owl">
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents scalar physical quantities by combining a numerical value and a unit. A scalar value specification carries has specified numeric value plus a measurement unit label, and is attached to a specifically dependent continuant through specified by value. Units are drawn from UO or QUDT.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scalar value specification</dcterms:title>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x7; term declared x3;
- header: dcterms:title &quot;Scalar value specification&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
- header: dcterms:license &lt;https://creativecommons.org/licenses/by/4.0/&gt; - https://github.com/materialdigital/core-ontology
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
    </owl:Ontology>
    


