# The countingas pattern in use, on Searle's own kind of case: at the faculty board meeting of
# 14 March 2024, Maria Rossi raising her hand counts as a vote in favour. The raised hand is the
# entity, "vote in favour" the concept that classifies it, and the meeting the situation that is
# the setting in which it counts as one.

@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix countingas: <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/countingas#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:VoteInFavour a owl:NamedIndividual , classification:Concept ;
    rdfs:label "the concept \"vote in favour\"" ;
    classification:classifies ex:MariaRossiRaisesHerHand .

ex:MariaRossiRaisesHerHand a owl:NamedIndividual , classification:Entity , situation:Entity ;
    rdfs:label "Maria Rossi raising her hand" ;
    classification:isClassifiedBy ex:VoteInFavour ;
    situation:hasSetting ex:FacultyBoardMeeting20240314 .

ex:FacultyBoardMeeting20240314 a owl:NamedIndividual , situation:Situation ;
    rdfs:label "the faculty board meeting of 14 March 2024" ;
    situation:isSettingFor ex:MariaRossiRaisesHerHand .
