# A plan for moving an archive, and one of the concepts it defines: a packing
# deadline. The deadline is nothing on its own - it means something only inside
# the plan that uses it, which is the point of the pattern. Both directions are
# asserted here because the pattern declares the two properties separately
# rather than as an owl:inverseOf pair.

@prefix description: <http://www.ontologydesignpatterns.org/cp/owl/description.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/description#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PackingDeadline a owl:NamedIndividual , description:Concept ;
    rdfs:label "the two-week packing deadline set for each shelf" ;
    description:isConceptUsedIn ex:ArchiveMovePlan .

ex:ArchiveMovePlan a owl:NamedIndividual , description:Description ;
    rdfs:label "the plan for moving the archive into the new reading room" ;
    description:usesConcept ex:PackingDeadline .
