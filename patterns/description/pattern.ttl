@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.ontologydesignpatterns.org/cp/owl/description.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/description.owl> rdf:type owl:Ontology ;
                                                                dcterms:description "Represents non-physical objects (descriptions, plans, norms) that define or describe situations."^^xsd:string ;
                                                                dcterms:title "Description Pattern"^^xsd:string ;
                                                                rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x2; term declared x2;
- header: dcterms:title \"Description Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ,
                                                                             "Represents non-physical objects (descriptions, plans, norms) that define or describe situations."^^xsd:string ;
                                                                rdfs:label "Description Pattern"^^xsd:string .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#isConceptUsedIn
:isConceptUsedIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Concept ;
                 rdfs:range :Description ;
                 rdfs:label "isConceptUsedIn" .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#usesConcept
:usesConcept rdf:type owl:ObjectProperty ;
             rdfs:domain :Description ;
             rdfs:range :Concept ;
             rdfs:label "usesConcept" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Concept
:Concept rdf:type owl:Class ;
         rdfs:label "Concept" .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description
:Description rdf:type owl:Class ;
             rdfs:label "Description" .


