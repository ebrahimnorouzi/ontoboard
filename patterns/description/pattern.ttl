@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/description.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/description.owl> rdf:type owl:Ontology ;
                                                                rdfs:comment "Represents non-physical objects (descriptions, plans, norms) that define or describe situations." ;
                                                                rdfs:label "Description Pattern" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#isConceptUsedIn
:isConceptUsedIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Concept ;
                 rdfs:range :Description ;
                 rdfs:label "isConceptUsedIn" .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#usesConcept
:usesConcept rdf:type owl:ObjectProperty ;
             rdfs:domain :Description ;
             rdfs:range :Concept ;
             rdfs:label "usesConcept" .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Concept
:Concept rdf:type owl:Class ;
         rdfs:label "Concept" .


###  http://www.ontologydesignpatterns.org/cp/owl/description.owl#Description
:Description rdf:type owl:Class ;
             rdfs:label "Description" .


