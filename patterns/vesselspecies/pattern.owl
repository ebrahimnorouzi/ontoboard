    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#catchesSpecies -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#catchesSpecies">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies"/>
        <rdfs:comment>Actually a composed property: this needs either a property chain, a SPARQL query, or a SWRL rule to gather a value. E.g. in SPARQL:

CONSTRUCT {?x :catchesSpecies ?y . ?y isCaughtBy ?x}
WHERE {
?x gearvessel:usesGearType ?z .
?z gearspecies:catchesSpecies ?y
}</rdfs:comment>
        <rdfs:label xml:lang="en">catches species</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtBy -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtBy">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Actually a composed property: this needs either a property chain, a SPARQL query, or a SWRL rule to gather a value. E.g. in SPARQL:

CONSTRUCT {?x :catchesSpecies ?y . ?y isCaughtBy ?x}
WHERE {
?x gearvessel:usesGearType ?z .
?z gearspecies:catchesSpecies ?y
}</rdfs:comment>
        <rdfs:label xml:lang="en">is caught by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtByVesselType -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtByVesselType">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/vesselspecies.owl#isCaughtBy"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/aquaticresources.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType"/>
        <rdfs:label xml:lang="en">is caught by vessel type</rdfs:label>
    </owl:ObjectProperty>
    


