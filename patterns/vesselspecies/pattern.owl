        <rdfs:label xml:lang="en">Aquatic species</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#GearType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearspecies.owl#GearType">
        <owl:equivalentClass rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType"/>
        <rdfs:label xml:lang="en">gear type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#GearType">
        <rdfs:label xml:lang="en">Gear type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/gearvessel.owl#VesselType">
        <rdfs:label xml:lang="en">Vessel type</rdfs:label>
    </owl:Class>
</rdf:RDF>



