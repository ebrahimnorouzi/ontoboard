# A fragment of a newspaper subject directory: the topic "sport" broken down into
# more specific topics, each with the concept that classifies the things written about.

@prefix topic: <http://www.ontologydesignpatterns.org/cp/owl/topic.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/simpletopic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Sport a owl:NamedIndividual , topic:Topic ;
    rdfs:label "the topic 'sport'" ;
    topic:hasCoreConcept ex:SportingEvent ;
    topic:hasSubTopic ex:Football , ex:Cycling .

ex:Football a owl:NamedIndividual , topic:Topic ;
    rdfs:label "the topic 'football'" ;
    topic:hasCoreConcept ex:FootballMatch ;
    topic:hasSubTopic ex:WomensFootball .

ex:Cycling a owl:NamedIndividual , topic:Topic ;
    rdfs:label "the topic 'cycling'" ;
    topic:hasCoreConcept ex:BicycleRace .

ex:WomensFootball a owl:NamedIndividual , topic:Topic ;
    rdfs:label "the topic \"women's football\"" .

ex:SportingEvent a owl:NamedIndividual , topic:Concept ;
    rdfs:label "the concept 'sporting event'" .

ex:FootballMatch a owl:NamedIndividual , topic:Concept ;
    rdfs:label "the concept 'football match'" .

ex:BicycleRace a owl:NamedIndividual , topic:Concept ;
    rdfs:label "the concept 'bicycle race'" .

# Only one direction of each inverse pair is asserted: hasCoreConcept/isCoreConceptFor, hasPart/isPartOf, hasSubTopic/isSubTopicOf, hasTopic/isTopicOf. A reasoner adds the other.
