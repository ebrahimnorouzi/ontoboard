@prefix topic: <http://www.ontologydesignpatterns.org/cp/owl/topic.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/simpletopic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Concept1 a owl:NamedIndividual , topic:Concept ;
    rdfs:label "a Concept" .

ex:Topic1 a owl:NamedIndividual , topic:Topic ;
    rdfs:label "an Argomento" ;
    topic:hasCoreConcept ex:Concept1 ;
    topic:hasSubTopic ex:Topic2 .

ex:Topic2 a owl:NamedIndividual , topic:Topic ;
    rdfs:label "an Argomento (another)" .

