<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#"
     xml:base="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:tagging="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#"
     xmlns:tagging2="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#"
     xmlns:agentrole="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#"
     xmlns:situation="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#"
     xmlns:timeinterval="http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#"
     xmlns:classification="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#"
     xmlns:collectionentity="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#"
     xmlns:intensionextension="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl#"
     xmlns:timeindexedsituation="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#">
    <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl">
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl"/>
        <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl"/>
        <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent a tagging situation, in which someone uses a term, from a list of a folksonomy, to tag something (or the content of something). We might also want to represent the time and the polarity of the tagging.</dcterms:description>
        <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tagging Pattern</dcterms:title>
        <cpannotationschema:coversRequirements>Who is tagging (the content of) what, by using what term from what folksonomy?, Which polarity has the tagging?</cpannotationschema:coversRequirements>
        <cpannotationschema:hasAuthor>Aldo Gangemi</cpannotationschema:hasAuthor>
        <cpannotationschema:hasComponent>AgentRole</cpannotationschema:hasComponent>
        <cpannotationschema:hasComponent>CollectionEntity</cpannotationschema:hasComponent>
        <cpannotationschema:hasComponent>IntensionExtension</cpannotationschema:hasComponent>
        <cpannotationschema:hasConsequences>We are able to represent data about tagging activities from web 2.0 applications, from document annotation projects, or from RDFa documents.
</cpannotationschema:hasConsequences>
        <cpannotationschema:hasIntent rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To represent a tagging situation, in which someone uses a term, from a list of a folksonomy, to tag something (or the content of something). We might also want to represent the time and the polarity of the tagging.</cpannotationschema:hasIntent>
        <cpannotationschema:hasUnitTest>SELECT ?a ?tag ?time ?thing ?folk ?pol
WHERE { 
?x :byAgent ?a .
?x :usingTag ?tag .
?x atTime ?time .
?x :forEntity ?thing .
?x :fromCloud ?folk .
?x :hasPolarity ?pol }</cpannotationschema:hasUnitTest>
        <cpannotationschema:isSpecializationOf>TimeIndexedSituation</cpannotationschema:isSpecializationOf>
        <cpannotationschema:relatedCPs>Topic</cpannotationschema:relatedCPs>
        <cpannotationschema:scenarios>A Flickr picture showing a leopard, tagged with the Tag &apos;leopard&apos;,A Flickr picture showing a boy surfing with a sombrero hat, tagged with the Tag &apos;cool&apos;, A Flickr picture tagged as &apos;taken in Sicily&apos;
</cpannotationschema:scenarios>
        <rdfs:comment xml:lang="en">Curated by OntoBoard 1.155.0, so that the pattern passes ODK&apos;s quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label moved to skos:prefLabel x1; label moved to skos:altLabel x1; label added x29; term declared x4;
- header: dcterms:title &quot;Tagging Pattern&quot; - the library&apos;s name for the pattern
- header: dcterms:description - the library&apos;s description of the pattern
Each change is listed under &quot;curated&quot; in the pattern&apos;s metadata.json in OntoBoard&apos;s pattern library.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The tagging ontology drafted by Tom Gruber in FOL, and formalized here in OWL by Aldo Gangemi with pattern-based design.
A Tag is here classified as a linguistic object that is used in the context of a Tagging Situation, which also involves a (tagged) Entity, an Agent, and a Folksonomy.</rdfs:comment>
        <rdfs:label>Tagging ontology</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.1 added rdfs:isDefinedBy for all named entities</owl:versionInfo>
        <owl:versionInfo>1.2
- Added annotations for ODP publication
1.1
- Revised some axioms involving restrictions on the Tagging situation class
1.0
- Created by Aldo Gangemi, March 2007</owl:versionInfo>
    </owl:Ontology>
    


