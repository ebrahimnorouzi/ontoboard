    <!-- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#hasMember -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#hasMember">
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf">
        <rdfs:label xml:lang="en">is member of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSetting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isSettingFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#byAgent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#byAgent">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#isTaggingAgentIn"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label xml:lang="en">by agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#isTagUsedIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#isTagUsedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#usingTag"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tag"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label>isTagUsedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#isTaggingAgentIn -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#isTaggingAgentIn">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl#Agent"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label xml:lang="en">is tagging agent in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#usingTag -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#usingTag">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tag"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label>usingTag</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime">
        <rdfs:label xml:lang="en">at time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity">
        <rdfs:label xml:lang="en">for entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting">
        <rdfs:label xml:lang="en">has time indexed setting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#fromCloud -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#fromCloud">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#isTagCloudOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Folksonomy"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label>from cloud</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#isTagCloudOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#isTagCloudOf">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Folksonomy"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/tagging.owl#Tagging"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/tagging.owl"/>
        <rdfs:label>is tag cloud of</rdfs:label>
    </owl:ObjectProperty>
    


