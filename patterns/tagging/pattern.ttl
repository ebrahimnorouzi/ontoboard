@prefix : <http://www.ontologydesignpatterns.org/cp/owl/tagging.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/tagging.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/tagging.owl> rdf:type owl:Ontology ;
                                                            owl:imports <http://www.ontologydesignpatterns.org/cp/owl/agentrole.owl> ,
                                                                        <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl> ,
                                                                        <http://www.ontologydesignpatterns.org/cp/owl/intensionextension.owl> ,
                                                                        <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "Who is tagging (the content of) what, by using what term from what folksonomy?, Which polarity has the tagging?" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Aldo Gangemi" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> "AgentRole" ,
                                                                                                                                                "CollectionEntity" ,
                                                                                                                                                "IntensionExtension" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """We are able to represent data about tagging activities from web 2.0 applications, from document annotation projects, or from RDFa documents.
""" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent a tagging situation, in which someone uses a term, from a list of a folksonomy, to tag something (or the content of something). We might also want to represent the time and the polarity of the tagging." ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?a ?tag ?time ?thing ?folk ?pol
WHERE { 
?x :byAgent ?a .
?x :usingTag ?tag .
?x atTime ?time .
?x :forEntity ?thing .
?x :fromCloud ?folk .
?x :hasPolarity ?pol }""" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> "TimeIndexedSituation" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "Topic" ;
                                                            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> """A Flickr picture showing a leopard, tagged with the Tag 'leopard',A Flickr picture showing a boy surfing with a sombrero hat, tagged with the Tag 'cool', A Flickr picture tagged as 'taken in Sicily'
""" ;
                                                            rdfs:comment """The tagging ontology drafted by Tom Gruber in FOL, and formalized here in OWL by Aldo Gangemi with pattern-based design.
A Tag is here classified as a linguistic object that is used in the context of a Tagging Situation, which also involves a (tagged) Entity, an Agent, and a Folksonomy."""^^xsd:string ;
                                                            rdfs:label "Tagging ontology" ;
                                                            owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities"^^xsd:string ,
                                                                            """1.2
- Added annotations for ODP publication
1.1
- Revised some axioms involving restrictions on the Tagging situation class
1.0
- Created by Aldo Gangemi, March 2007""" .

