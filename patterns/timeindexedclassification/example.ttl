# Pluto counted as a planet from its discovery in 1930 until the IAU vote of August 2006,
# and as a dwarf planet ever since: one body, two categories, each dated by its own interval.

@prefix classification: <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#> .
@prefix countingas: <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl#> .
@prefix situation: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#> .
@prefix timeindexedclassification: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedclassification.owl#> .
@prefix timeindexedsituation: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#> .
@prefix timeinterval: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#> .
@prefix ex: <https://w3id.org/ontoboard/example/timeindexedclassification#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:PlanetCategory a owl:NamedIndividual , classification:Concept ;
    rdfs:label "the category 'planet'" ;
    classification:classifies ex:Pluto .

ex:DwarfPlanetCategory a owl:NamedIndividual , classification:Concept ;
    rdfs:label "the category 'dwarf planet'" ;
    classification:classifies ex:Pluto .

ex:Pluto a owl:NamedIndividual , classification:Entity , situation:Entity ;
    rdfs:label "Pluto" ;
    classification:isClassifiedBy ex:PlanetCategory , ex:DwarfPlanetCategory ;
    situation:hasSetting ex:PlutoAsPlanet , ex:PlutoAsDwarfPlanet .

ex:PlutoAsPlanet a owl:NamedIndividual , situation:Situation ;
    rdfs:label "Pluto counting as a planet" ;
    situation:isSettingFor ex:Pluto .

ex:PlutoAsDwarfPlanet a owl:NamedIndividual , situation:Situation ;
    rdfs:label "Pluto counting as a dwarf planet" ;
    situation:isSettingFor ex:Pluto .

ex:PlutoAsPlanet_1930_2006 a owl:NamedIndividual , timeindexedsituation:TimeIndexedSituation ;
    rdfs:label "Pluto counting as a planet, dated 1930 to 2006" ;
    timeindexedsituation:atTime ex:Interval_1930_2006 .

ex:PlutoAsDwarfPlanet_from_2006 a owl:NamedIndividual , timeindexedsituation:TimeIndexedSituation ;
    rdfs:label "Pluto counting as a dwarf planet, dated from 2006" ;
    timeindexedsituation:atTime ex:Interval_from_2006 .

ex:Interval_1930_2006 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "18 February 1930 to 24 August 2006" ;
    timeinterval:hasIntervalDate "1930-02-18/2006-08-24" ;
    timeinterval:hasIntervalStartDate "1930-02-18" ;
    timeinterval:hasIntervalEndDate "2006-08-24" .

ex:Interval_from_2006 a owl:NamedIndividual , timeinterval:TimeInterval ;
    rdfs:label "24 August 2006 to the present" ;
    timeinterval:hasIntervalStartDate "2006-08-24" .

# Only one direction of each inverse pair is asserted: atTime/isTimeIndexFor, forEntity/hasTimeIndexedSetting. A reasoner adds the other.
