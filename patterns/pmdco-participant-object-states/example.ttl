# Participant object states: ingot I-2026-0417 keeps its identity while its microstructure is in two states, before and
# after the diffusion annealing. Each state is a temporally qualified continuant with its own segregation factor and
# its own time interval. The identifiers and numbers are invented; the classes and properties are the pattern's.

@prefix co: <https://w3id.org/pmd/co/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ex: <https://w3id.org/ontoboard/example/pmdco-participant-object-states#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The anchor: the one thing that stays the same.
ex:Ingot_I2026_0417 a owl:NamedIndividual , co:PMD_0020170 ;
    rdfs:label "ingot I-2026-0417 (steel S355J2, heat H-45812)" .

ex:Microstructure_Before a owl:NamedIndividual , co:PMD_0000857 , co:PMD_0000068 ;
    rdfs:label "microstructure of ingot I-2026-0417 before the annealing (as-cast, dendritic)" ;
    co:PMD_0000070 ex:Ingot_I2026_0417 ;
    obo:RO_0000086 ex:SegregationFactor_Before ;
    obo:BFO_0000108 ex:Interval_Before .

ex:Microstructure_After a owl:NamedIndividual , co:PMD_0000857 , co:PMD_0000068 ;
    rdfs:label "microstructure of ingot I-2026-0417 after the annealing (homogenised)" ;
    co:PMD_0000070 ex:Ingot_I2026_0417 ;
    obo:RO_0000086 ex:SegregationFactor_After ;
    obo:BFO_0000108 ex:Interval_After .

ex:SegregationFactor_Before a owl:NamedIndividual , obo:BFO_0000019 ;
    rdfs:label "manganese segregation factor before the annealing: 1.42 (maximum local / mean concentration)" .

ex:SegregationFactor_After a owl:NamedIndividual , obo:BFO_0000019 ;
    rdfs:label "manganese segregation factor after the annealing: 1.21" .

ex:Interval_Before a owl:NamedIndividual , obo:BFO_0000008 ;
    rdfs:label "from casting on 2026-02-27 until the annealing starts, 2026-03-02T06:00" ;
    obo:BFO_0000063 ex:Interval_After .

ex:Interval_After a owl:NamedIndividual , obo:BFO_0000008 ;
    rdfs:label "from the end of the annealing, 2026-03-03T02:00, onwards" .
