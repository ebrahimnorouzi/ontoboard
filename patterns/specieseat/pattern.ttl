@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl> rdf:type owl:Ontology ;
                                                                     owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What species feed upon a certain species? What species are eaten by a certain species? What species is preyed upon by a certain species? What species preyes upon a certain species?" ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "The pattern intends to model the situation that a certain species feed upon other species and that some species are preyed upon by a certain species." ;
                                                                     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :feedsUpon :Shrimp. }
SELECT ?x WHERE {?x a :AquaticSpecies.  :Shrimp :isEatenBy ?x. }
SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :isPreyedUponBy :Seals.}
SELECT ?x WHERE {?x a :AquaticSpecies.  :Seals :preyesUpon ?x.}""" ;
                                                                     owl:versionInfo "1.0"^^xsd:string ,
                                                                                     "Created by Eva Blomqvist" .

#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#feedsUpon
:feedsUpon rdf:type owl:ObjectProperty ;
           owl:inverseOf :isFoodOf ;
           rdfs:domain :AquaticSpecies ;
           rdfs:range :AquaticSpecies ;
           rdfs:label "feeds upon"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isFoodOf
:isFoodOf rdf:type owl:ObjectProperty ;
          rdfs:domain :AquaticSpecies ;
          rdfs:range :AquaticSpecies ;
          rdfs:label "is food of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isPreyedUponBy
:isPreyedUponBy rdf:type owl:ObjectProperty ;
                owl:inverseOf :preyesUpon ;
                rdfs:domain :AquaticSpecies ;
                rdfs:range :AquaticSpecies ;
                rdfs:label "is preyed upon by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#preyesUpon
:preyesUpon rdf:type owl:ObjectProperty ;
            rdfs:domain :AquaticSpecies ;
            rdfs:range :AquaticSpecies ;
            rdfs:label "preyes upon"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :feedsUpon ;
                                  owl:someValuesFrom :AquaticSpecies
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isPreyedUponBy ;
                                  owl:someValuesFrom :AquaticSpecies
                                ] ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


