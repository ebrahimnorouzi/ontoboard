@prefix : <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cpannotationschema: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@base <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl> .

<http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl> rdf:type owl:Ontology ;
                                                                     owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl> ;
                                                                     dcterms:description "The pattern intends to model the situation that a certain species feed upon other species and that some species are preyed upon by a certain species."^^xsd:string ;
                                                                     dcterms:title "Specieseat Pattern"^^xsd:string ;
                                                                     cpannotationschema:coversRequirements "What species feed upon a certain species? What species are eaten by a certain species? What species is preyed upon by a certain species? What species preyes upon a certain species?" ;
                                                                     cpannotationschema:hasIntent "The pattern intends to model the situation that a certain species feed upon other species and that some species are preyed upon by a certain species."^^xsd:string ;
                                                                     cpannotationschema:hasUnitTest """SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :feedsUpon :Shrimp. }
SELECT ?x WHERE {?x a :AquaticSpecies.  :Shrimp :isEatenBy ?x. }
SELECT ?x WHERE {?x a :AquaticSpecies.  ?x :isPreyedUponBy :Seals.}
SELECT ?x WHERE {?x a :AquaticSpecies.  :Seals :preyesUpon ?x.}""" ;
                                                                     rdfs:comment """Curated by OntoBoard 1.155.0, so that the pattern passes ODK's quality report with its default profile, names every term with a label, and is consistent and coherent. Changes: label added x5; term declared x5;
- header: dcterms:title \"Specieseat Pattern\" - the library's name for the pattern
- header: dcterms:description - the library's description of the pattern
Each change is listed under \"curated\" in the pattern's metadata.json in OntoBoard's pattern library."""@en ;
                                                                     owl:versionInfo "1.0" ,
                                                                                     "Created by Eva Blomqvist" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "Description (DC terms)"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements
cpannotationschema:coversRequirements rdf:type owl:AnnotationProperty ;
                                      rdfs:label "covers requirements"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent
cpannotationschema:hasIntent rdf:type owl:AnnotationProperty ;
                             rdfs:label "has intent"@en .


###  http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest
cpannotationschema:hasUnitTest rdf:type owl:AnnotationProperty ;
                               rdfs:label "has unit test"@en .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#feedsUpon
:feedsUpon rdf:type owl:ObjectProperty ;
           owl:inverseOf :isFoodOf ;
           rdfs:domain :AquaticSpecies ;
           rdfs:range :AquaticSpecies ;
           rdfs:label "feeds upon"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isFoodOf
:isFoodOf rdf:type owl:ObjectProperty ;
          rdfs:domain :AquaticSpecies ;
          rdfs:range :AquaticSpecies ;
          rdfs:label "is food of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isPreyedUponBy
:isPreyedUponBy rdf:type owl:ObjectProperty ;
                owl:inverseOf :preyesUpon ;
                rdfs:domain :AquaticSpecies ;
                rdfs:range :AquaticSpecies ;
                rdfs:label "is preyed upon by"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#preyesUpon
:preyesUpon rdf:type owl:ObjectProperty ;
            rdfs:domain :AquaticSpecies ;
            rdfs:range :AquaticSpecies ;
            rdfs:label "preyes upon"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies
:AquaticSpecies rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :feedsUpon ;
                                  owl:someValuesFrom :AquaticSpecies
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :isPreyedUponBy ;
                                  owl:someValuesFrom :AquaticSpecies
                                ] ;
                rdfs:comment """Aquatic species are conceptual entities that are characterized together with resources and water areas. 
Mappable to fi:Species, fi:SpeciesRef, fi:SpeciesFeature, etc.
It has related axioms from FIGIS Schema that are included in the classes linked to the fi:Species class, such as fi:SpeciesRef (holding association with fi:AqResRef, which holds association with fi:WaterAreaRef).""" ;
                rdfs:label "Aquatic species"@en .


