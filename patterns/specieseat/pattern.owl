    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#feedsUpon -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#feedsUpon">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isFoodOf"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:label xml:lang="en">feeds upon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isFoodOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isFoodOf">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:label xml:lang="en">is food of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isPreyedUponBy -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#isPreyedUponBy">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#preyesUpon"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:label xml:lang="en">is preyed upon by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#preyesUpon -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#preyesUpon">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#AquaticSpecies"/>
        <rdfs:label xml:lang="en">preyes upon</rdfs:label>
    </owl:ObjectProperty>
    


