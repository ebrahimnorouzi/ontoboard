# The specieseat pattern on the scenario the pattern itself asks about: what eats shrimp, and
# what seals eat. A short North Atlantic food web - northern shrimp and herring feed Atlantic
# cod, cod is preyed upon by the harbour seal, and the seal by the killer whale.

@prefix specieseat: <http://www.ontologydesignpatterns.org/cp/owl/fsdas/specieseat.owl#> .
@prefix ex:         <https://w3id.org/ontoboard/example/specieseat#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .

ex:AtlanticCod a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "Atlantic cod (Gadus morhua)" ;
    specieseat:feedsUpon ex:NorthernShrimp , ex:AtlanticHerring ;
    specieseat:isPreyedUponBy ex:HarbourSeal .

ex:NorthernShrimp a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "northern shrimp (Pandalus borealis)" ;
    specieseat:feedsUpon ex:CalanoidCopepod .

ex:AtlanticHerring a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "Atlantic herring (Clupea harengus)" ;
    specieseat:feedsUpon ex:CalanoidCopepod ;
    specieseat:isPreyedUponBy ex:HarbourSeal .

ex:HarbourSeal a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "harbour seal (Phoca vitulina)" ;
    specieseat:isPreyedUponBy ex:KillerWhale .

ex:KillerWhale a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "killer whale (Orcinus orca)" .

ex:CalanoidCopepod a owl:NamedIndividual , specieseat:AquaticSpecies ;
    rdfs:label "calanoid copepod (Calanus finmarchicus)" .

# Only one direction of each inverse pair is asserted: feedsUpon/isFoodOf, isPreyedUponBy/preyesUpon. A reasoner adds the other.

