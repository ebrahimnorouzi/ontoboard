<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontologydesignpatterns.org/cp/owl/partof.owl">
  <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl">
    <rdfs:label>Part-Of Pattern</rdfs:label>
    <rdfs:comment>Models mereological part-whole relationships. A whole entity has parts, and parts are components of a whole.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Whole">
    <rdfs:label>Whole</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Part">
    <rdfs:label>Part</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart">
    <rdfs:label>hasPart</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Whole"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Part"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf">
    <rdfs:label>isPartOf</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Part"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#Whole"/>
  </owl:ObjectProperty>
</rdf:RDF>