<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ontologydesignpatterns.org/cp/owl/participation.owl">
  <owl:Ontology rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl">
    <rdfs:label>Participation Pattern</rdfs:label>
    <rdfs:comment>Represents the participation of an object in an event or process.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object">
    <rdfs:label>Object</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event">
    <rdfs:label>Event</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant">
    <rdfs:label>hasParticipant</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn">
    <rdfs:label>isParticipantIn</rdfs:label>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
  </owl:ObjectProperty>
</rdf:RDF>