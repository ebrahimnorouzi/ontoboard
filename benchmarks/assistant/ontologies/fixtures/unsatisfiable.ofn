Prefix(:=<http://example.org/ontoboard-fixtures/materials#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)

Ontology(<http://example.org/ontoboard-fixtures/unsatisfiable>
Annotation(dcterms:title "Materials, two unsatisfiable classes (OntoBoard benchmark fixture)")
Annotation(rdfs:comment "Consistent, with two classes that can have no instances: one made a subclass of two disjoint classes, and one that runs into a property's domain - the slip that is easy to make and hard to see. Written for OntoBoard; CC0.")

Declaration(Class(:Material))
Declaration(Class(:Metal))
Declaration(Class(:Polymer))
Declaration(Class(:Composite))
Declaration(Class(:MetalPolymerHybrid))
Declaration(Class(:FibreReinforcedAluminium))
Declaration(ObjectProperty(:reinforcedWith))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(dcterms:title))

AnnotationAssertion(rdfs:label :Material "material"@en)
AnnotationAssertion(rdfs:label :Metal "metal"@en)
AnnotationAssertion(rdfs:label :Polymer "polymer"@en)
AnnotationAssertion(rdfs:label :Composite "composite"@en)
AnnotationAssertion(rdfs:label :MetalPolymerHybrid "metal-polymer hybrid"@en)
AnnotationAssertion(rdfs:label :FibreReinforcedAluminium "fibre-reinforced aluminium"@en)
AnnotationAssertion(rdfs:label :reinforcedWith "reinforced with"@en)

AnnotationAssertion(obo:IAO_0000115 :Metal "A material whose atoms are held together by metallic bonding.")
AnnotationAssertion(obo:IAO_0000115 :Polymer "A material made of long chains of repeating molecular units.")
AnnotationAssertion(obo:IAO_0000115 :Composite "A material made of two or more constituent materials that stay distinct within it.")
AnnotationAssertion(obo:IAO_0000115 :MetalPolymerHybrid "A material that joins a metal part and a polymer part.")
AnnotationAssertion(obo:IAO_0000115 :FibreReinforcedAluminium "An aluminium reinforced with ceramic or carbon fibres.")

SubClassOf(:Metal :Material)
SubClassOf(:Polymer :Material)
SubClassOf(:Composite :Material)
DisjointClasses(:Metal :Polymer)
DisjointClasses(:Metal :Composite)

SubClassOf(:MetalPolymerHybrid :Metal)
SubClassOf(:MetalPolymerHybrid :Polymer)

ObjectPropertyDomain(:reinforcedWith :Composite)
SubClassOf(:FibreReinforcedAluminium :Metal)
SubClassOf(:FibreReinforcedAluminium ObjectSomeValuesFrom(:reinforcedWith :Material))
)
