Prefix(:=<http://example.org/ontoboard-fixtures/materials#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)

Ontology(<http://example.org/ontoboard-fixtures/restrictions>
Annotation(dcterms:title "Materials, restrictions beyond some and only (OntoBoard benchmark fixture)")
Annotation(rdfs:comment "Consistent, with every class satisfiable. Each superclass restriction is of a shape the text-to-axiom task says in words: min, max and exactly with a class, a value that is an individual, some of a datatype, and a typed value; and one definition with exactly. None of them follows from the rest, none makes a class empty when it is put back, and no near miss is equivalent given the rest: no lower bound sits above an exactly, and the properties have no range, so an answer must name its class or datatype. Written for OntoBoard; CC0.")

Declaration(Class(:Material))
Declaration(Class(:Metal))
Declaration(Class(:Alloy))
Declaration(Class(:BinaryAlloy))
Declaration(Class(:HighEntropyAlloy))
Declaration(Class(:Brass))
Declaration(Class(:Steel))
Declaration(Class(:ReferenceSteel))
Declaration(Class(:PureMetal))
Declaration(Class(:Element))
Declaration(Class(:TestSpecimen))
Declaration(ObjectProperty(:hasConstituentElement))
Declaration(ObjectProperty(:hasMainElement))
Declaration(DataProperty(:hasDensity))
Declaration(NamedIndividual(:iron))
Declaration(NamedIndividual(:copper))
Declaration(NamedIndividual(:zinc))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(dcterms:title))

AnnotationAssertion(rdfs:label :Material "material"@en)
AnnotationAssertion(rdfs:label :Metal "metal"@en)
AnnotationAssertion(rdfs:label :Alloy "alloy"@en)
AnnotationAssertion(rdfs:label :BinaryAlloy "binary alloy"@en)
AnnotationAssertion(rdfs:label :HighEntropyAlloy "high-entropy alloy"@en)
AnnotationAssertion(rdfs:label :Brass "brass"@en)
AnnotationAssertion(rdfs:label :Steel "steel"@en)
AnnotationAssertion(rdfs:label :ReferenceSteel "reference steel"@en)
AnnotationAssertion(rdfs:label :PureMetal "pure metal"@en)
AnnotationAssertion(rdfs:label :Element "element"@en)
AnnotationAssertion(rdfs:label :TestSpecimen "test specimen"@en)
AnnotationAssertion(rdfs:label :hasConstituentElement "has constituent element"@en)
AnnotationAssertion(rdfs:label :hasMainElement "has main element"@en)
AnnotationAssertion(rdfs:label :hasDensity "has density"@en)
AnnotationAssertion(rdfs:label :iron "iron"@en)
AnnotationAssertion(rdfs:label :copper "copper"@en)
AnnotationAssertion(rdfs:label :zinc "zinc"@en)

AnnotationAssertion(obo:IAO_0000115 :Metal "A material whose atoms are held together by metallic bonding.")
AnnotationAssertion(obo:IAO_0000115 :Alloy "A metal made by combining a metal with one or more other elements.")
AnnotationAssertion(obo:IAO_0000115 :Brass "An alloy of copper and zinc.")
AnnotationAssertion(obo:IAO_0000115 :Steel "An alloy of iron and carbon that contains at most about 2 percent carbon by weight.")
AnnotationAssertion(obo:IAO_0000115 :PureMetal "A metal that is made of one element only.")
AnnotationAssertion(obo:IAO_0000115 :TestSpecimen "A material prepared in a standard shape so that its properties can be measured.")

SubClassOf(:Metal :Material)
SubClassOf(:Alloy :Metal)
SubClassOf(:Brass :Alloy)
SubClassOf(:HighEntropyAlloy :Alloy)
SubClassOf(:Steel :Alloy)
SubClassOf(:ReferenceSteel :Steel)
SubClassOf(:PureMetal :Metal)
SubClassOf(:TestSpecimen :Material)
DisjointClasses(:Material :Element)
DisjointClasses(:Alloy :PureMetal)

ObjectPropertyDomain(:hasConstituentElement :Material)
ObjectPropertyRange(:hasMainElement :Element)

ClassAssertion(:Element :iron)
ClassAssertion(:Element :copper)
ClassAssertion(:Element :zinc)

SubClassOf(:HighEntropyAlloy ObjectMinCardinality(5 :hasConstituentElement :Element))
SubClassOf(:PureMetal ObjectMaxCardinality(1 :hasConstituentElement :Element))
SubClassOf(:Brass ObjectExactCardinality(2 :hasConstituentElement :Element))
SubClassOf(:Steel ObjectHasValue(:hasMainElement :iron))
SubClassOf(:TestSpecimen DataSomeValuesFrom(:hasDensity xsd:decimal))
SubClassOf(:ReferenceSteel DataHasValue(:hasDensity "7.85"^^xsd:decimal))
EquivalentClasses(:BinaryAlloy ObjectIntersectionOf(:Alloy ObjectExactCardinality(2 :hasConstituentElement :Element)))
)
