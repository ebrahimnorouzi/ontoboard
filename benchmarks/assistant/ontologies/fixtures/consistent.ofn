Prefix(:=<http://example.org/ontoboard-fixtures/materials#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)

Ontology(<http://example.org/ontoboard-fixtures/consistent>
Annotation(dcterms:title "Materials, consistent (OntoBoard benchmark fixture)")
Annotation(rdfs:comment "A small consistent ontology for the assistant benchmark: classes with definitions and named parents for the definition task, and disjoint classes the generator injects faults into for the explain and repair tasks. Written for OntoBoard; CC0.")

Declaration(Class(:Material))
Declaration(Class(:Metal))
Declaration(Class(:Alloy))
Declaration(Class(:Steel))
Declaration(Class(:StainlessSteel))
Declaration(Class(:Polymer))
Declaration(Class(:Thermoplastic))
Declaration(Class(:Ceramic))
Declaration(Class(:Composite))
Declaration(Class(:ManufacturingProcess))
Declaration(Class(:HeatTreatment))
Declaration(Class(:Annealing))
Declaration(ObjectProperty(:hasConstituent))
Declaration(ObjectProperty(:processedBy))
Declaration(DataProperty(:hasMeltingPointCelsius))
Declaration(NamedIndividual(:aisi304))
Declaration(NamedIndividual(:annealingRun1))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(dcterms:title))

AnnotationAssertion(rdfs:label :Material "material"@en)
AnnotationAssertion(rdfs:label :Metal "metal"@en)
AnnotationAssertion(rdfs:label :Alloy "alloy"@en)
AnnotationAssertion(rdfs:label :Steel "steel"@en)
AnnotationAssertion(rdfs:label :StainlessSteel "stainless steel"@en)
AnnotationAssertion(rdfs:label :Polymer "polymer"@en)
AnnotationAssertion(rdfs:label :Thermoplastic "thermoplastic"@en)
AnnotationAssertion(rdfs:label :Ceramic "ceramic"@en)
AnnotationAssertion(rdfs:label :Composite "composite"@en)
AnnotationAssertion(rdfs:label :ManufacturingProcess "manufacturing process"@en)
AnnotationAssertion(rdfs:label :HeatTreatment "heat treatment"@en)
AnnotationAssertion(rdfs:label :Annealing "annealing"@en)
AnnotationAssertion(rdfs:label :hasConstituent "has constituent"@en)
AnnotationAssertion(rdfs:label :processedBy "processed by"@en)
AnnotationAssertion(rdfs:label :hasMeltingPointCelsius "has melting point in degrees Celsius"@en)
AnnotationAssertion(rdfs:label :aisi304 "AISI 304 sample"@en)
AnnotationAssertion(rdfs:label :annealingRun1 "annealing run 1"@en)

AnnotationAssertion(obo:IAO_0000115 :Metal "A material whose atoms are held together by metallic bonding.")
AnnotationAssertion(obo:IAO_0000115 :Alloy "A metal made by combining a metal with one or more other elements.")
AnnotationAssertion(obo:IAO_0000115 :Steel "An alloy of iron and carbon that contains at most about 2 percent carbon by weight.")
AnnotationAssertion(obo:IAO_0000115 :StainlessSteel "A steel that contains at least 10.5 percent chromium, which makes it resist corrosion.")
AnnotationAssertion(obo:IAO_0000115 :Polymer "A material made of long chains of repeating molecular units.")
AnnotationAssertion(obo:IAO_0000115 :Thermoplastic "A polymer that softens when heated and hardens again when cooled.")
AnnotationAssertion(obo:IAO_0000115 :Ceramic "A material that is an inorganic, non-metallic solid, usually made by firing.")
AnnotationAssertion(obo:IAO_0000115 :Composite "A material made of two or more constituent materials that stay distinct within it.")
AnnotationAssertion(obo:IAO_0000115 :HeatTreatment "A manufacturing process that heats and cools a material to change its properties.")
AnnotationAssertion(obo:IAO_0000115 :Annealing "A heat treatment that heats a material and cools it slowly to reduce hardness and internal stress.")

SubClassOf(:Metal :Material)
SubClassOf(:Alloy :Metal)
SubClassOf(:Steel :Alloy)
SubClassOf(:StainlessSteel :Steel)
SubClassOf(:Polymer :Material)
SubClassOf(:Thermoplastic :Polymer)
SubClassOf(:Ceramic :Material)
SubClassOf(:Composite :Material)
SubClassOf(:Composite ObjectSomeValuesFrom(:hasConstituent :Material))
SubClassOf(:HeatTreatment :ManufacturingProcess)
SubClassOf(:Annealing :HeatTreatment)
DisjointClasses(:Metal :Polymer :Ceramic)
DisjointClasses(:Material :ManufacturingProcess)

ObjectPropertyDomain(:processedBy :Material)
ObjectPropertyRange(:processedBy :ManufacturingProcess)
ObjectPropertyRange(:hasConstituent :Material)
DataPropertyRange(:hasMeltingPointCelsius xsd:decimal)
FunctionalDataProperty(:hasMeltingPointCelsius)

ClassAssertion(:StainlessSteel :aisi304)
ClassAssertion(:Annealing :annealingRun1)
ObjectPropertyAssertion(:processedBy :aisi304 :annealingRun1)
DataPropertyAssertion(:hasMeltingPointCelsius :aisi304 "1400"^^xsd:decimal)
)
