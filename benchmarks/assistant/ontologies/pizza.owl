<?xml version="1.0"?>
<rdf:RDF xmlns="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#"
     xml:base="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:pizza="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#"
     xmlns:price="http://www.ontologydesignpatterns.org/cp/owl/price.owl#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:classification="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#">
    <owl:Ontology rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl">
        <owl:versionIRI rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza/1.0.0"/>
        <terms:description xml:lang="en">A pizza ontology built with OntoBoard from ontology design patterns, following the eXtreme Design methodology.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Pizza Ontology</terms:title>
        <rdfs:label xml:lang="en">Pizza Ontology</rdfs:label>
        <owl:priorVersion rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza/0.4.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000115 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity"/>
        <rdfs:label>classifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept"/>
        <rdfs:label>isClassifiedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart"/>
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf"/>
        <rdfs:comment>The hasPart relation without transitivity, holding between an entity (the system) and another (the component), and assuming a design that structures the system. For an explicit pattern encoding design, see the &apos;designobject&apos; pattern.
The componency pattern uses the transitive reduction logical pattern to preserve transitive on the superproperty from the partof pattern. In practice, the partof pattern acts here as the transitive reduction of the componency pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl"/>
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf"/>
        <rdfs:comment>The hasPart relation without transitivity, holding between an entity (the system) and another (the component), and assuming a design that structures the system. For an explicit pattern encoding design, see the &apos;designobject&apos; pattern.
The componency pattern uses the transitive reduction logical pattern to preserve transitive on the superproperty from the partof pattern. In practice, the partof pattern acts here as the transitive reduction of the componency pattern.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl"/>
        <rdfs:label xml:lang="en">is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>A transitive relation expressing parthood between any entities, e.g. &apos;the human body has a brain as part&apos;. When specializing this pattern, take care of restricting the domain and range appropriately, since it could be counterintuitive to use this relation arbitrarily, e.g. between animals and planets. For an intransitive partof pattern, see &apos;componency&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>A transitive relation expressing parthood between any entities, e.g. &apos;brain is a part of the human body&apos;. When specializing this pattern, take care of restricting the domain and range appropriately, since it could be counterintuitive to use this relation arbitrarily, e.g. between animals and planets. For an intransitive partof pattern, see &apos;componency&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/partof.owl"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">has currency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasPrice -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasPrice">
        <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">has price</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf -->

    <owl:ObjectProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">is price of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasBase -->

    <owl:ObjectProperty rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent"/>
        <rdfs:domain rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaBase"/>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to the base it is built on.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has base</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping -->

    <owl:ObjectProperty rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent"/>
        <rdfs:domain rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaTopping"/>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to a topping on it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has topping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue -->

    <owl:DatatypeProperty rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept">
        <rdfs:label>Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity">
        <rdfs:label>Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent"/>
                <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf"/>
                <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Any physical, social, or mental object, or a substance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/componency.owl"/>
        <rdfs:label xml:lang="en">Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price"/>
        <rdfs:comment>A system of money in general use in a particular country.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">Currency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The amount of money expected, required, or given in payment for something.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/price.owl"/>
        <rdfs:label xml:lang="en">Price</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made of cheese.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cheese topping</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheesyPizza -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
        <obo:IAO_0000115 xml:lang="en">Any pizza that has at least one cheese topping.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cheesy pizza</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#ChiliPepperTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#ChiliPepperTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicyTopping"/>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#VegetableTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping of chili pepper.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">chili pepper topping</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DeepPanBase -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DeepPanBase">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaBase"/>
        <obo:IAO_0000115 xml:lang="en">A thick pizza base baked in a pan.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">deep pan base</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Diavola -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Diavola">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheesyPizza"/>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicyPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicySalamiTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A named pizza topped with mozzarella, tomato, spicysalami.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">diavola</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DietCategory -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DietCategory">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept"/>
        <obo:IAO_0000115 xml:lang="en">A concept a menu uses to say which diets a pizza suits.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">diet category</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FontinaTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FontinaTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping of fontina.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fontina topping</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FruitTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FruitTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping made of fruit.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">fruit topping</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Funghi -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Funghi">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheesyPizza"/>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MushroomTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A named pizza topped with mozzarella, tomato, mushroom.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">funghi</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#GorgonzolaTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#GorgonzolaTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping of gorgonzola.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">gorgonzola topping</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#HamTopping -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#HamTopping">
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MeatTopping"/>
        <obo:IAO_0000115 xml:lang="en">A pizza topping of ham.</obo:IAO_0000115>
