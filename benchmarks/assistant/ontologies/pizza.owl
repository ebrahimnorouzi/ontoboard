    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicyTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza"/>
        <obo:IAO_0000115 xml:lang="en">Any pizza that has at least one spicy topping.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">spicy pizza</rdfs:label>
    </owl:Class>
    


