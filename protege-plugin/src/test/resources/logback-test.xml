<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the tests log, said once.

  Until 1.153.0 the tests logged nothing at all, by accident: the test class path held a logback
  (1.5.6, drawn in by robot-core) that slf4j 1.7 cannot use, so slf4j fell back to logging nothing.
  Since ROBOT's command line runs inside Protege, logback is the host's (1.1.3 on the test class
  path, as in Protege 5.5), logging works, and whichever logback.xml happened to come first on the
  class path - robot-command's jar carries one - decided what was printed.

  This file is looked for before any logback.xml. Errors are printed; one logger is off:

  - org.semanticweb.owlapi.utilities.Injector logs "No instantiation found for
    java.util.function.Supplier<OWLOntologyLoaderConfiguration>" at ERROR for every ontology
    manager made on a plain class path - some 1,500 lines a run, the same in every OWL API 4.5.x,
    and of no consequence: the manager is made and works. Inside Protege the OWL API is the host's
    bundle and the line does not occur. Left on, it buries any real error in the run's log.
-->
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="org.semanticweb.owlapi.utilities.Injector" level="OFF"/>
  <root level="ERROR">
    <appender-ref ref="console"/>
  </root>
</configuration>
