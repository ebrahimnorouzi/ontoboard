Prefix(:=<http://example.org/mini-pizza#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)

Ontology(<http://example.org/mini-pizza>
Annotation(dcterms:title "Mini pizza")

Declaration(Class(:Pizza))
Declaration(Class(:NamedPizza))
Declaration(Class(:Margherita))
Declaration(Class(:VegetarianPizza))
Declaration(Class(:PizzaTopping))
Declaration(Class(:VegetarianTopping))
Declaration(Class(:MeatTopping))
Declaration(Class(:CheeseTopping))
Declaration(Class(:Country))
Declaration(Class(:City))
Declaration(ObjectProperty(:hasTopping))
Declaration(ObjectProperty(:locatedIn))
Declaration(NamedIndividual(:Italy))
Declaration(NamedIndividual(:Naples))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(oboInOwl:hasExactSynonym))
Declaration(AnnotationProperty(dcterms:title))

AnnotationAssertion(rdfs:label :VegetarianPizza "vegetarian pizza"@en)
AnnotationAssertion(rdfs:label :VegetarianPizza "vegetarische Pizza"@de)
AnnotationAssertion(obo:IAO_0000115 :VegetarianPizza "A pizza with no meat.")
AnnotationAssertion(rdfs:comment :VegetarianPizza "Used in the tutorial.")
AnnotationAssertion(oboInOwl:hasExactSynonym :VegetarianPizza "veggie pizza")
AnnotationAssertion(rdfs:label :CheeseTopping "cheese topping"@en)
AnnotationAssertion(obo:IAO_0000115 :VegetarianTopping "A topping that contains no meat or fish.")

SubClassOf(:NamedPizza :Pizza)
SubClassOf(:Margherita :NamedPizza)
SubClassOf(:Margherita ObjectSomeValuesFrom(:hasTopping :CheeseTopping))
SubClassOf(:VegetarianPizza :Pizza)
SubClassOf(:VegetarianPizza ObjectAllValuesFrom(:hasTopping :VegetarianTopping))
SubClassOf(:VegetarianTopping :PizzaTopping)
SubClassOf(:MeatTopping :PizzaTopping)
SubClassOf(:CheeseTopping :VegetarianTopping)
DisjointClasses(:VegetarianTopping :MeatTopping)
DisjointClasses(:Pizza :PizzaTopping)

ObjectPropertyDomain(:hasTopping :Pizza)
ObjectPropertyRange(:hasTopping :PizzaTopping)
TransitiveObjectProperty(:locatedIn)

ClassAssertion(:Country :Italy)
ClassAssertion(:City :Naples)
ObjectPropertyAssertion(:locatedIn :Naples :Italy)
)
