     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/ro.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2026-01-01/ro.owl"/>
        <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
        <dcterms:title>A small stand-in for a relation ontology, made for OntoBoard&apos;s tests</dcterms:title>
    </owl:Ontology>
    


