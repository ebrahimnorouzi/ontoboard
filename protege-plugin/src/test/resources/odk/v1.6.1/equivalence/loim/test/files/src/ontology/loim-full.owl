        <dcterms:description>An ontology that uses terms of three others, for the tests of the import chain</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>Local imports test ontology</dcterms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


