    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115>An entity that persists, endures, or continues to exist through time while maintaining its identity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000115>An entity that unfolds itself in time.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115>An occurrent that has some temporal proper part and for some time has a material entity as participant.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000300">
        <obo:IAO_0000115>A document part that describes some entity.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">textual entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
        <obo:IAO_0000115>A collection of information content entities intended to be understood together as a whole.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <obo:IAO_0000115>A document that is the output of a publishing process.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">publication</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/LOIM_0000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/LOIM_0000000">
        <obo:IAO_0000115 xml:lang="en">The class everything of this ontology is under.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">root node</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/LOIM_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/LOIM_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/LOIM_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A process in which water is brought to the boil.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">boiling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/LOIM_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/LOIM_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A document that says how a dish is made.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">recipe</rdfs:label>
    </owl:Class>
