Prefix(:=<http://purl.obolibrary.org/obo/loim.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<http://purl.obolibrary.org/obo/loim.owl>
<http://purl.obolibrary.org/obo/loim/releases/1.0.0/loim.owl>
Annotation(dcterms:description "An ontology that uses terms of three others, for the tests of the import chain")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:title "Local imports test ontology")
Annotation(owl:versionInfo "1.0.0")

Declaration(Class(obo:BFO_0000001))
Declaration(Class(obo:BFO_0000002))
Declaration(Class(obo:BFO_0000003))
Declaration(Class(obo:BFO_0000015))
Declaration(Class(obo:IAO_0000300))
Declaration(Class(obo:IAO_0000310))
Declaration(Class(obo:IAO_0000311))
Declaration(Class(obo:LOIM_0000000))
Declaration(Class(obo:LOIM_0000001))
Declaration(Class(obo:LOIM_0000002))
Declaration(ObjectProperty(obo:RO_0000056))
Declaration(ObjectProperty(obo:RO_0000057))
Declaration(ObjectProperty(obo:RO_0002233))
Declaration(ObjectProperty(obo:RO_0002234))
Declaration(AnnotationProperty(obo:IAO_0000115))
Declaration(AnnotationProperty(dce:source))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
############################
#   Annotation Properties
############################

# Annotation Property: obo:IAO_0000115 (definition)

AnnotationAssertion(rdfs:label obo:IAO_0000115 "definition")

# Annotation Property: dcterms:description (description)

AnnotationAssertion(rdfs:label dcterms:description "description")

# Annotation Property: dcterms:license (license)

AnnotationAssertion(rdfs:label dcterms:license "license")

# Annotation Property: dcterms:title (title)

AnnotationAssertion(rdfs:label dcterms:title "title")


############################
#   Object Properties
############################

# Object Property: obo:RO_0000056 (participates in)

AnnotationAssertion(obo:IAO_0000115 obo:RO_0000056 "A relation between a continuant and a process, in which the continuant is somehow involved in the process.")
AnnotationAssertion(rdfs:label obo:RO_0000056 "participates in"@en)
InverseObjectProperties(obo:RO_0000056 obo:RO_0000057)

# Object Property: obo:RO_0000057 (has participant)

AnnotationAssertion(obo:IAO_0000115 obo:RO_0000057 "A relation between a process and a continuant, in which the continuant is somehow involved in the process.")
AnnotationAssertion(rdfs:label obo:RO_0000057 "has participant"@en)

# Object Property: obo:RO_0002233 (has input)

AnnotationAssertion(obo:IAO_0000115 obo:RO_0002233 "p has input c iff p is a process, c is a material entity, c is a participant in p, and c is present at the start of p.")
AnnotationAssertion(rdfs:label obo:RO_0002233 "has input"@en)
SubObjectPropertyOf(obo:RO_0002233 obo:RO_0000057)

# Object Property: obo:RO_0002234 (has output)

AnnotationAssertion(rdfs:label obo:RO_0002234 "has output"@en)
SubObjectPropertyOf(obo:RO_0002234 obo:RO_0000057)



############################
#   Classes
############################

# Class: obo:BFO_0000001 (entity)

AnnotationAssertion(rdfs:label obo:BFO_0000001 "entity"@en)

# Class: obo:BFO_0000002 (continuant)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000002 "An entity that persists, endures, or continues to exist through time while maintaining its identity.")
AnnotationAssertion(rdfs:label obo:BFO_0000002 "continuant"@en)
SubClassOf(obo:BFO_0000002 obo:BFO_0000001)
DisjointClasses(obo:BFO_0000002 obo:BFO_0000003)

# Class: obo:BFO_0000003 (occurrent)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000003 "An entity that unfolds itself in time.")
AnnotationAssertion(rdfs:label obo:BFO_0000003 "occurrent"@en)
SubClassOf(obo:BFO_0000003 obo:BFO_0000001)

# Class: obo:BFO_0000015 (process)

AnnotationAssertion(obo:IAO_0000115 obo:BFO_0000015 "An occurrent that has some temporal proper part and for some time has a material entity as participant.")
AnnotationAssertion(rdfs:label obo:BFO_0000015 "process"@en)
SubClassOf(obo:BFO_0000015 obo:BFO_0000003)

# Class: obo:IAO_0000300 (textual entity)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000300 "A document part that describes some entity.")
AnnotationAssertion(rdfs:label obo:IAO_0000300 "textual entity"@en)

# Class: obo:IAO_0000310 (document)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000310 "A collection of information content entities intended to be understood together as a whole.")
AnnotationAssertion(rdfs:label obo:IAO_0000310 "document"@en)

# Class: obo:IAO_0000311 (publication)

AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000311 "A document that is the output of a publishing process.")
AnnotationAssertion(rdfs:label obo:IAO_0000311 "publication"@en)
SubClassOf(obo:IAO_0000311 obo:IAO_0000310)

# Class: obo:LOIM_0000000 (root node)

AnnotationAssertion(obo:IAO_0000115 obo:LOIM_0000000 "The class everything of this ontology is under."@en)
AnnotationAssertion(rdfs:label obo:LOIM_0000000 "root node"@en)

# Class: obo:LOIM_0000001 (boiling)

AnnotationAssertion(obo:IAO_0000115 obo:LOIM_0000001 "A process in which water is brought to the boil."@en)
AnnotationAssertion(rdfs:label obo:LOIM_0000001 "boiling"@en)
SubClassOf(obo:LOIM_0000001 obo:BFO_0000015)
SubClassOf(obo:LOIM_0000001 ObjectSomeValuesFrom(obo:RO_0002233 obo:LOIM_0000000))

# Class: obo:LOIM_0000002 (recipe)

AnnotationAssertion(obo:IAO_0000115 obo:LOIM_0000002 "A document that says how a dish is made."@en)
AnnotationAssertion(rdfs:label obo:LOIM_0000002 "recipe"@en)
SubClassOf(obo:LOIM_0000002 obo:IAO_0000310)


)