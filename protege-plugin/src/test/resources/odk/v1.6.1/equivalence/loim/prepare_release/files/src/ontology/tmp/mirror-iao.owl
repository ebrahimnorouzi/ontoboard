    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/iao.owl">
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title>A small stand-in for an information ontology, made for OntoBoard&apos;s tests</dcterms:title>
    </owl:Ontology>
    


