Prefix(:=<urn:unnamed:ontology#ont1>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<urn:unnamed:ontology#ont1>

Declaration(Class(<http://purl.obolibrary.org/obo/ptt/example.yaml>))
Declaration(Class(<http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000050>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/RO_0001025>))
Declaration(AnnotationProperty(<http://purl.obolibrary.org/obo/IAO_0000115>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/title>))



############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/ptt/example.yaml> (Part of 'example')

AnnotationAssertion(<http://purl.org/dc/terms/title> <http://purl.obolibrary.org/obo/ptt/example.yaml> "example"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ptt/example.yaml> "Part of 'example'"^^xsd:string)
EquivalentClasses(<http://purl.obolibrary.org/obo/ptt/example.yaml> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> owl:Thing))

# Class: <http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml> ('thing' resident)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml> "Anything that is located in a 'thing'."^^xsd:string)
AnnotationAssertion(<http://purl.org/dc/terms/title> <http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml> "locatedIn"^^xsd:string)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml> "'thing' resident"^^xsd:string)
SubClassOf(<http://purl.obolibrary.org/obo/ptt/patterns/locatedIn.yaml> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0001025> owl:Thing))


)