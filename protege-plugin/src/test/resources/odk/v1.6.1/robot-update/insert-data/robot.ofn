Prefix(:=<http://purl.obolibrary.org/obo/eggboil.owl#>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://purl.obolibrary.org/obo/eggboil.owl>

Declaration(Class(obo:EGGBOIL_0000001))
Declaration(Class(obo:EGGBOIL_0000002))
Declaration(Class(obo:EGGBOIL_0000003))


############################
#   Classes
############################

# Class: obo:EGGBOIL_0000001 (egg)

AnnotationAssertion(rdfs:label obo:EGGBOIL_0000001 "egg"@en)

# Class: obo:EGGBOIL_0000002 (boiled egg)

AnnotationAssertion(rdfs:label obo:EGGBOIL_0000002 "boiled egg"@en)
SubClassOf(obo:EGGBOIL_0000002 obo:EGGBOIL_0000001)

# Class: obo:EGGBOIL_0000003 (soft-boiled egg)

AnnotationAssertion(rdfs:label obo:EGGBOIL_0000003 "soft-boiled egg"@en)
AnnotationAssertion(rdfs:label obo:EGGBOIL_0000003 "œuf mollet"@fr)
SubClassOf(obo:EGGBOIL_0000003 obo:EGGBOIL_0000002)


)