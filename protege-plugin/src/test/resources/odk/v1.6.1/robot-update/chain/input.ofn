Prefix(:=<https://nfdi.fiz-karlsruhe.de/ontology/test/mirror.owl#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)
Prefix(nfdicore:=<https://nfdi.fiz-karlsruhe.de/ontology/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<https://nfdi.fiz-karlsruhe.de/ontology/test/mirror.owl>
<https://nfdi.fiz-karlsruhe.de/ontology/test/releases/2026-04-09/mirror.owl>
Annotation(dcterms:title "A mirror, for OntoBoard's tests"@en)
Annotation(owl:versionInfo "2026-04-09")

Declaration(Class(obo:BFO_0000001))
Declaration(Class(obo:UBERON_0000061))
Declaration(Class(nfdicore:NFDI_0000001))
Declaration(Class(nfdicore:NFDI_0000002))
Declaration(AnnotationProperty(dcterms:title))
Declaration(AnnotationProperty(oboInOwl:SubsetProperty))
Declaration(AnnotationProperty(oboInOwl:SynonymTypeProperty))
Declaration(AnnotationProperty(oboInOwl:hasExactSynonym))
Declaration(AnnotationProperty(oboInOwl:hasSynonymType))
Declaration(AnnotationProperty(oboInOwl:inSubset))
AnnotationAssertion(rdfs:label obo:BFO_0000001 "entity"@en)
AnnotationAssertion(rdfs:label obo:UBERON_0000061 "anatomical structure"@en)
AnnotationAssertion(oboInOwl:inSubset obo:UBERON_0000061 <http://purl.obolibrary.org/obo/uberon/core#uberon_slim>)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasExactSynonym obo:UBERON_0000061 "AS")
SubClassOf(obo:UBERON_0000061 obo:BFO_0000001)
AnnotationAssertion(rdfs:label nfdicore:NFDI_0000001 "process"@en)
AnnotationAssertion(oboInOwl:inSubset nfdicore:NFDI_0000001 nfdicore:core_subset)
SubClassOf(nfdicore:NFDI_0000001 obo:BFO_0000001)
AnnotationAssertion(rdfs:label nfdicore:NFDI_0000002 "planned process"@en)
AnnotationAssertion(oboInOwl:inSubset nfdicore:NFDI_0000002 nfdicore:extended_subset)
SubClassOf(nfdicore:NFDI_0000002 nfdicore:NFDI_0000001)
)
