# Every dataset has part
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?term ?label WHERE {
  ?term rdfs:subClassOf* <https://example.org/mini/MINI_0000005> .
  ?term a owl:Class .
  FILTER(isIRI(?term))
  FILTER NOT EXISTS {
    ?term rdfs:subClassOf* ?above .
    ?above rdfs:subClassOf|owl:equivalentClass ?r .
    ?r owl:onProperty <https://example.org/mini/MINI_0000101> .
  }
  OPTIONAL { ?term rdfs:label ?label }
}
