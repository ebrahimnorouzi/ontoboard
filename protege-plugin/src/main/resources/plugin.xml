<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?eclipse version="3.0"?>
<plugin>

  <!-- OntoBoardTab subclasses Protege's OWLWorkspaceViewsTab only so that a changed
       viewconfig-ontoboardtab.xml reaches users who have already opened the tab; Protege
       otherwise restores the arrangement it saved and ignores the new default. -->
  <extension id="OntoBoardTab" point="org.protege.editor.core.application.WorkspaceTab">
    <label value="OntoBoard"/>
    <class value="de.fizkarlsruhe.ise.ontoboard.views.OntoBoardTab"/>
    <index value="O"/>
    <editorKitId value="OWLEditorKit"/>
    <defaultViewConfigFileName value="viewconfig-ontoboardtab.xml"/>
  </extension>

  <extension id="SchemaCanvasView" point="org.protege.editor.core.application.ViewComponent">
    <label value="Schema Canvas"/>
    <class value="de.fizkarlsruhe.ise.ontoboard.views.SchemaCanvasView"/>
    <headerColor value="@org.protege.ontologycolor"/>
    <category value="@org.protege.ontologycategory"/>
  </extension>

  <!-- Tools menu: start a new ODK project -->
  <extension id="NewOdkProjectAction" point="org.protege.editor.core.application.EditorKitMenuAction">
    <name value="New ODK Project..."/>
    <path value="org.protege.editor.owl.menu.tools/SlotA-A"/>
    <toolTip value="Create an ODK-style ontology repository and start editing it"/>
    <class value="de.fizkarlsruhe.ise.ontoboard.odk.NewProjectAction"/>
    <editorKitId value="OWLEditorKit"/>
  </extension>

</plugin>
