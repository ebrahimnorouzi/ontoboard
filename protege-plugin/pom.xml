<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.fizkarlsruhe.ise</groupId>
  <artifactId>ontoboard</artifactId>
  <version>1.135.2</version>
  <packaging>bundle</packaging>

  <name>OntoBoard</name>
  <description>Visual ontology engineering and ODK/ROBOT pipeline tooling for Protege Desktop</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The target host bundles a Java 8 JRE. Java 8 bytecode also runs on Protege 5.6.x.
         release (not source/target) also rejects any Java 9+ API surface at compile time,
         since it compiles against the Java 8 bootclasspath/ct.sym instead of just emitting
         Java 8 class file format from whatever JDK APIs happen to be present. -->
    <maven.compiler.release>8</maven.compiler.release>
    <protege.version>5.5.0</protege.version>
    <owlapi.version>4.5.9</owlapi.version>
    <jgraphx.version>4.2.2</jgraphx.version>
    <!--
      The one place ROBOT's version is written. The bundle embeds this, the generated CI installs
      it, and the generated Makefile's report runs against it - and if those three ever disagree,
      a user's quality report in Protege and the one their CI produces come from different rules.
      It reaches OdkScaffold through the filtered ontoboard-build.properties rather than a second
      literal in Java.
    -->
    <robot.version>1.9.8</robot.version>
    <!-- ODK's ROBOT plugin, at the version the pinned ODK image carries (odk/seed/OdkPin). -->
    <odk.robot.plugin.version>0.3.1</odk.robot.plugin.version>
    <junit.version>5.10.2</junit.version>
    <github.repo>ebrahimnorouzi/ontoboard</github.repo>
  </properties>

  <dependencyManagement>
    <!-- Protege 5.5.0 ships owlapi 4.5.9. robot-core declares 4.5.29; force it down so
         there is exactly one OWL API. Verified working - see spec section 9a.
         scope=provided: the host's bundles/owlapi-osgidistribution.jar exports every
         org.semanticweb.owlapi.*, uk.ac.manchester.cs.owl.owlapi.* and org.obolibrary.oboformat.*
         package robot-core needs, so OWL API is imported from the host, not embedded
         (fix round 1 ruling). -->
    <dependencies>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-osgidistribution</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-api</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-apibinding</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-impl</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-parsers</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-rio</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-distribution</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- Guava: the host's owlapi bundle imports com.google.guava (host ships Guava 18.0)
           and returns host-Guava types (e.g. OWLOntologyID.getOntologyIRI() returns
           com.google.common.base.Optional) from its own API. Embedding a different Guava
           would link our code against a different Optional class than the host's OWL API
           returns, producing a ClassCastException/LinkageError. So Guava must also be
           provided, pinned to what the host actually ships (fix round 1 ruling). -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>18.0</version>
        <scope>provided</scope>
      </dependency>
      <!-- Logback: the host's, for the same reason. Protege logs through logback (5.5.0 ships
           1.1.3, 5.6.9 ships 1.2.13, both exporting ch.qos.logback.classic), and ROBOT's command
           line casts the root logger slf4j hands it to ch.qos.logback.classic.Logger on every
           command (CommandLineHelper.maybeGetCommandLine). With a logback of its own in the
           bundle that cast met a second copy of the class and every command failed. The copy
           was no use besides: robot-core dragged in logback-classic 1.5.6, which needs slf4j 2
           and Java 11, beside the host's logback-core 1.1.3 and slf4j 1.7. Pinned to what the
           older host ships, as OWL API and Guava are. -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.1.3</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>1.1.3</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    One artifact is not on Maven Central: ODK's ROBOT plugin. It is kept in this repository, in
    Maven's own layout, and resolved from there like any other.
  -->
  <repositories>
    <repository>
      <id>ontoboard-local</id>
      <name>Artifacts kept with OntoBoard's sources</name>
      <url>file:///${project.basedir}/local-repo</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- provided: supplied by the Protege runtime, never embedded.
         Also brings the OWL API, Jackson, JGit and SLF4J transitively. -->
    <dependency>
      <groupId>edu.stanford.protege</groupId>
      <artifactId>protege-editor-owl</artifactId>
      <version>${protege.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.github.vlsi.mxgraph</groupId>
      <artifactId>jgraphx</artifactId>
      <version>${jgraphx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.obolibrary.robot</groupId>
      <artifactId>robot-core</artifactId>
      <version>${robot.version}</version>
    </dependency>

    <!--
      ROBOT's command line, beside its operations. Without Docker, OntoBoard runs ODK's recipes
      itself, and a recipe is a ROBOT command line; run through ROBOT's own command layer
      (odk/OdkRobot) each option means what it means in ODK's container. 120 KB.

      It comes alone. Of what its pom names, commons-cli is in the bundle already, at the same
      version. commons-io is too, older (2.4), and has every method robot-command calls
      (FileUtils.readFileToString, writeLines; FilenameUtils.getExtension, getBaseName):
      taking 2.14.0 with it would change that library under a hundred other embedded jars for
      nothing. javax.inject and caffeine it never references; the host has its own of both,
      and a second javax.inject in the bundle would be a second set of the classes OWL API's
      signatures are written in.
    -->
    <dependency>
      <groupId>org.obolibrary.robot</groupId>
      <artifactId>robot-command</artifactId>
      <version>${robot.version}</version>
      <exclusions>
        <exclusion>
          <groupId>commons-io</groupId>
          <artifactId>commons-io</artifactId>
        </exclusion>
        <exclusion>
          <groupId>javax.inject</groupId>
          <artifactId>javax.inject</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.ben-manes.caffeine</groupId>
          <artifactId>caffeine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      ODK's ROBOT plugin: odk:import, odk:normalize and odk:subset, which ODK's Makefile calls.
      It is the jar the ODK image carries as /tools/robot-plugins/odk.jar, kept in local-repo/
      because Maven Central does not have it (OdkRobotTest checks its checksum). 42 KB, Java 8
      class files, BSD-3-Clause; it needs nothing but robot-command.
    -->
    <dependency>
      <groupId>org.incenp</groupId>
      <artifactId>odk-robot-plugin</artifactId>
      <version>${odk.robot.plugin.version}</version>
    </dependency>

    <!--
      Java-WebSocket: the collaboration client's transport. 140 KB, Java 7 bytecode, and its
      only compile-scope dependency is slf4j-api, which the host already exports and we
      already import. Chosen over a Yjs binding because Java has no mature Yjs client and an
      immature JNI binding inside an OSGi bundle is a poor trade; the bridge in collab/
      translates JSON to the shared Y.Doc instead.
    -->
    <dependency>
      <groupId>org.java-websocket</groupId>
      <artifactId>Java-WebSocket</artifactId>
      <version>1.5.7</version>
      <exclusions>
        <!--
          Its only compile dependency is slf4j-api, which the host already exports and we
          already import. Pulling in another copy shifted the resolved logging stack enough
          to break logback-classic against logback-core
          (NoSuchMethodError: Loader.systemClassloaderIfNull), which failed 61 tests that
          had nothing to do with WebSockets.
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- The launcher's listener interface, for GitHubAnnotations, which names a failing test in
         the summary of a GitHub Actions run. Surefire runs this launcher anyway; declaring it only
         makes the interface visible to the test sources. Its version goes with junit.version. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <!-- filtering resolves ${project.artifactId} inside plugin.xml and view configs -->
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <!--
          The bundled design patterns, from the repository root rather than copied into
          src/main/resources: one copy of the data, and the index generator reads the same
          directory the build packages.

          Filtering is off and must stay off. These are data files full of IRIs, and Maven's
          filter rewrites ${...} - an OWL file is not a template, and a silent substitution
          inside an IRI would be exactly the quiet corruption this project keeps guarding
          against. 2.5 MB over 123 patterns.
        -->
        <directory>${project.basedir}/../patterns</directory>
        <targetPath>patterns</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>index.tsv</include>
          <!--
            What a reasoner found in each pattern, so the chooser can warn somebody BEFORE they
            import one whose class cannot have an instance. Generated and checked by
            PatternSoundnessTest. 16 KB.
          -->
          <include>soundness.tsv</include>
          <!--
            What each pattern's terms are called, so the library can be searched by them.
            Generated and checked by PatternLabelsTest.
          -->
          <include>labels.tsv</include>
          <include>*/pattern.owl</include>
          <!--
            The Turtle beside each one. The plugin loads the RDF/XML; this is for a person -
            an OWL file in RDF/XML is not something anybody reads, and a design pattern is
            meant to be read before it is imported. It compresses to very little.
          -->
          <include>*/pattern.ttl</include>
        </includes>
      </resource>
      <resource>
        <!--
          ODK's own templates, exactly as the pinned ODK image holds them (PROVENANCE.txt in
          there says which image). A project created without Docker is rendered from these and
          must equal what `odk.py seed` writes, byte for byte.

          A directory of its own, not src/main/resources, because that one is filtered: ODK's
          Makefile template is full of ${...} and $(...), and Maven's filter would rewrite the
          first kind silently. Filtering is off here and must stay off.
        -->
        <directory>${project.basedir}/src/main/odk</directory>
        <targetPath>odk</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <!--
          propertiesEncoding, because ontoboard-build.properties is filtered. Without it Maven
          warns that a filtered .properties file will be copied with whatever encoding the other
          resources use, which is a guess - and this one carries the ROBOT version that ends up in
          a generated CI file.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <propertiesEncoding>UTF-8</propertiesEncoding>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>5.1.9</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <!--
              Suppress the generated `Require-Capability: osgi.ee=JavaSE version=11`.
              bnd computes that from the HIGHEST class-file version across the whole
              bundle, and embedded jars (obographs-core and obographs-owlapi 0.3.1; until
              1.153.0 also a logback-classic 1.5.6, which is the host's now and no longer
              embedded) carry Java 11 classes. Protege 5.5.0 runs on its
              bundled Java 8 JRE, so the requirement is unsatisfiable and Felix refuses
              to resolve the bundle - which is why 1.0.1 installed but never started.

              OntoBoard's own classes are Java 8 (enforced by maven.compiler.release and
              guarded by a test). The Java 11 classes are obographs', which writes ROBOT's
              JSON form of an ontology; loaded on Java 8, one throws
              UnsupportedClassVersionError. ROBOT loaded one of them on every save - found
              when its command line first ran inside Protege 5.5 (1.153.0) - so OntoBoard
              carries that one class compiled for Java 8 (the Export-Package comment below),
              and odk/OdkRobot refuses JSON output on Java 8 by name.
            -->
            <_noee>true</_noee>
            <!--
              So that `java -jar ontoboard.jar corpus book.xlsx` works. Harmless to OSGi, which
              reads the Bundle- headers and ignores this one, and the difference between a
              reproduction package a reviewer can run and one they cannot: the measurements live
              in a class that needs robot-core, and robot-core is one of the 104 jars
              Embed-Dependency nests inside this bundle, where the java launcher cannot see it.
              Launcher reads Bundle-ClassPath and unpacks exactly those.
            -->
            <Main-Class>de.fizkarlsruhe.ise.ontoboard.bench.Launcher</Main-Class>
            <Bundle-Activator>org.protege.editor.owl.ProtegeOWL</Bundle-Activator>
            <Bundle-SymbolicName>${project.artifactId};singleton:=true</Bundle-SymbolicName>
            <Bundle-Vendor>ISE / FIZ Karlsruhe</Bundle-Vendor>
            <Bundle-Name>OntoBoard</Bundle-Name>
            <Bundle-Description>Visual ontology engineering and ODK/ROBOT pipeline tooling for Protege Desktop</Bundle-Description>
            <Bundle-DocURL>https://github.com/${github.repo}</Bundle-DocURL>
            <!-- Do NOT set Bundle-ClassPath; Embed-Dependency manages it. -->
            <Embed-Dependency>*;scope=compile|runtime;artifactId=!log4j-api</Embed-Dependency>
            <Embed-Transitive>true</Embed-Transitive>
            <!--
              OntoBoard's own packages are exported, every one, as they were by default - written
              out as a pattern because of the one package of its sources that is somebody else's
              name: org.geneontology.obographs.owlapi, where OntoBoard keeps one class compiled
              for Java 8 (see that class). That one is not exported: another plugin asking for
              obographs must not be handed OntoBoard's one class. And it is taken from
              OntoBoard's sources alone ("first"): left to the default, every jar's classes of
              the package are merged into the bundle's own, which copied obographs' six Java 11
              classes in beside it. (An exclusion in front of {local-packages} does not do it:
              the package was exported all the same. BundleConfigurationTest holds both.)
            -->
            <Export-Package>de.fizkarlsruhe.ise.ontoboard.*</Export-Package>
            <Private-Package>org.geneontology.obographs.owlapi;-split-package:=first</Private-Package>
            <!-- version="5.5.0" means [5.5.0, infinity), so this also loads on 5.6.x -->
            <!--
              `!java.*` is load-bearing. OSGi forbids Import-Package entries for java.*
              (they always come from the boot classloader), and Felix rejects the bundle
              at INSTALL time - before resolution - with
              "Importing java.* packages not allowed". With 100+ embedded jars, bnd's
              wildcard emitted ~44 java.* clauses, which is why 1.0.0 never loaded.

              The explicit clauses below are what OntoBoard's own code needs, so a missing
              one should fail loudly. Everything else - Saxon, logback, POI, javaparser,
              bouncycastle, scala, appengine, dragged in by robot-core's dependency tree -
              is optional: those code paths are not called, and a mandatory import for
              each would make the bundle unresolvable.
            -->
            <Import-Package>
              !java.*,
              <!-- forced: named only as a string in plugin.xml, so bnd cannot see it -->
              org.protege.editor.owl.ui,
              org.protege.editor.owl.*;version="5.5.0",
              org.protege.editor.core.*;version="5.5.0",
              org.semanticweb.owlapi.*,
              com.google.common.*,
              org.slf4j,
              javax.swing.*,
              javax.imageio.*,
              javax.xml.parsers,
              org.w3c.dom,
              org.xml.sax,
              org.xml.sax.helpers,
              *;resolution:=optional
            </Import-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
