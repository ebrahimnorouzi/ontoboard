<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.fizkarlsruhe.ise</groupId>
  <artifactId>ontoboard</artifactId>
  <version>1.16.0</version>
  <packaging>bundle</packaging>

  <name>OntoBoard</name>
  <description>Visual ontology engineering and ODK/ROBOT pipeline tooling for Protege Desktop</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The target host bundles a Java 8 JRE. Java 8 bytecode also runs on Protege 5.6.x.
         release (not source/target) also rejects any Java 9+ API surface at compile time,
         since it compiles against the Java 8 bootclasspath/ct.sym instead of just emitting
         Java 8 class file format from whatever JDK APIs happen to be present. -->
    <maven.compiler.release>8</maven.compiler.release>
    <protege.version>5.5.0</protege.version>
    <owlapi.version>4.5.9</owlapi.version>
    <jgraphx.version>4.2.2</jgraphx.version>
    <junit.version>5.10.2</junit.version>
    <github.repo>ebrahimnorouzi/ontoboard</github.repo>
  </properties>

  <dependencyManagement>
    <!-- Protege 5.5.0 ships owlapi 4.5.9. robot-core declares 4.5.29; force it down so
         there is exactly one OWL API. Verified working - see spec section 9a.
         scope=provided: the host's bundles/owlapi-osgidistribution.jar exports every
         org.semanticweb.owlapi.*, uk.ac.manchester.cs.owl.owlapi.* and org.obolibrary.oboformat.*
         package robot-core needs, so OWL API is imported from the host, not embedded
         (fix round 1 ruling). -->
    <dependencies>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-osgidistribution</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-api</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-apibinding</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-impl</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-parsers</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-rio</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.owlapi</groupId>
        <artifactId>owlapi-distribution</artifactId>
        <version>${owlapi.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- Guava: the host's owlapi bundle imports com.google.guava (host ships Guava 18.0)
           and returns host-Guava types (e.g. OWLOntologyID.getOntologyIRI() returns
           com.google.common.base.Optional) from its own API. Embedding a different Guava
           would link our code against a different Optional class than the host's OWL API
           returns, producing a ClassCastException/LinkageError. So Guava must also be
           provided, pinned to what the host actually ships (fix round 1 ruling). -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>18.0</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- provided: supplied by the Protege runtime, never embedded.
         Also brings the OWL API, Jackson, JGit and SLF4J transitively. -->
    <dependency>
      <groupId>edu.stanford.protege</groupId>
      <artifactId>protege-editor-owl</artifactId>
      <version>${protege.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.github.vlsi.mxgraph</groupId>
      <artifactId>jgraphx</artifactId>
      <version>${jgraphx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.obolibrary.robot</groupId>
      <artifactId>robot-core</artifactId>
      <version>1.9.8</version>
    </dependency>

    <!--
      Java-WebSocket: the collaboration client's transport. 140 KB, Java 7 bytecode, and its
      only compile-scope dependency is slf4j-api, which the host already exports and we
      already import. Chosen over a Yjs binding because Java has no mature Yjs client and an
      immature JNI binding inside an OSGi bundle is a poor trade; the bridge in collab/
      translates JSON to the shared Y.Doc instead.
    -->
    <dependency>
      <groupId>org.java-websocket</groupId>
      <artifactId>Java-WebSocket</artifactId>
      <version>1.5.7</version>
      <exclusions>
        <!--
          Its only compile dependency is slf4j-api, which the host already exports and we
          already import. Pulling in another copy shifted the resolved logging stack enough
          to break logback-classic against logback-core
          (NoSuchMethodError: Loader.systemClassloaderIfNull), which failed 61 tests that
          had nothing to do with WebSockets.
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <!-- filtering resolves ${project.artifactId} inside plugin.xml and view configs -->
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>5.1.9</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <!--
              Suppress the generated `Require-Capability: osgi.ee=JavaSE version=11`.
              bnd computes that from the HIGHEST class-file version across the whole
              bundle, and three embedded jars (logback-classic 1.5.6, obographs-core and
              obographs-owlapi 0.3.1) carry Java 11 classes. Protege 5.5.0 runs on its
              bundled Java 8 JRE, so the requirement is unsatisfiable and Felix refuses
              to resolve the bundle - which is why 1.0.1 installed but never started.

              OntoBoard's own classes are Java 8 (enforced by maven.compiler.release and
              guarded by a test). The Java 11 classes belong to a logging backend Protege
              already provides and to a ROBOT JSON format this release does not call; if
              such a class were ever loaded it would throw UnsupportedClassVersionError,
              the same trade-off already accepted for the optional import tail.
            -->
            <_noee>true</_noee>
            <Bundle-Activator>org.protege.editor.owl.ProtegeOWL</Bundle-Activator>
            <Bundle-SymbolicName>${project.artifactId};singleton:=true</Bundle-SymbolicName>
            <Bundle-Vendor>ISE / FIZ Karlsruhe</Bundle-Vendor>
            <Bundle-Name>OntoBoard</Bundle-Name>
            <Bundle-Description>Visual ontology engineering and ODK/ROBOT pipeline tooling for Protege Desktop</Bundle-Description>
            <Bundle-DocURL>https://github.com/${github.repo}</Bundle-DocURL>
            <!-- Do NOT set Bundle-ClassPath; Embed-Dependency manages it. -->
            <Embed-Dependency>*;scope=compile|runtime;artifactId=!log4j-api</Embed-Dependency>
            <Embed-Transitive>true</Embed-Transitive>
            <!-- version="5.5.0" means [5.5.0, infinity), so this also loads on 5.6.x -->
            <!--
              `!java.*` is load-bearing. OSGi forbids Import-Package entries for java.*
              (they always come from the boot classloader), and Felix rejects the bundle
              at INSTALL time - before resolution - with
              "Importing java.* packages not allowed". With 100+ embedded jars, bnd's
              wildcard emitted ~44 java.* clauses, which is why 1.0.0 never loaded.

              The explicit clauses below are what OntoBoard's own code needs, so a missing
              one should fail loudly. Everything else - Saxon, logback, POI, javaparser,
              bouncycastle, scala, appengine, dragged in by robot-core's dependency tree -
              is optional: those code paths are not called, and a mandatory import for
              each would make the bundle unresolvable.
            -->
            <Import-Package>
              !java.*,
              <!-- forced: named only as a string in plugin.xml, so bnd cannot see it -->
              org.protege.editor.owl.ui,
              org.protege.editor.owl.*;version="5.5.0",
              org.protege.editor.core.*;version="5.5.0",
              org.semanticweb.owlapi.*,
              com.google.common.*,
              org.slf4j,
              javax.swing.*,
              javax.imageio.*,
              javax.xml.parsers,
              org.w3c.dom,
              org.xml.sax,
              org.xml.sax.helpers,
              *;resolution:=optional
            </Import-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
