# OntoBoard environment variables
# Copy to .env and customize as needed

# Data directory (default: /app/data in Docker)
DATA_DIR=/app/data

# Authentication
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@ontoboard.local

# Redis (for job queue)
REDIS_URL=redis://redis:6379/0
