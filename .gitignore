# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
.vite/

# Runtime data (board files, databases, uploads)
data/

# Environment & secrets
.env
*.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/*

# Temp files
playground.pptx
# Built by tools/build-deck.py, which is what is tracked.
playground-ontoboard.pptx
mwo301.ttl
test_upload.ttl
*.tmp
paper/*
# mkdocs build output
site/

# Generated by tools/generate-pattern-pages.py from patterns/index.tsv, every time the site is
# built. 159 Markdown files plus 159 Turtle copies in git would rot the moment somebody edited
# one by hand - and the index they derive from is itself generated and checked by a test.
docs/patterns/

# Deck build output: the rendered slides and the regenerated figures. tools/build-deck.py makes
# all of it from the repository in one command, so only the captured screenshots are kept - those
# came from a running Protege and cannot be regenerated by a script.
build/render/
build/deck/
build/*.pptx

# The BFO artifact tools/extract-bfo-patterns.py downloads and verifies by sha256. Fetched on
# demand; the patterns extracted from it are committed, the 72 KB source is not.
build/bfo-notime.owl

# The canvas layout OntoBoard saves beside an ontology. One appears for every file anybody
# opens in the plugin - mwo301.ttl grew a 3,164-line one the first time all 524 of its terms
# went on a board - and it is per-person board furniture, not shared state.
*.ontoboard.json

# Test projects built with OntoBoard (test/pizza, test/pizza-bfo). Each is a git repository of
# its own, with a tag for every release, so it is not part of this one.
/test/

# Internal evaluation and study material: the evaluation plan, the user-study protocol, consent
# text, questionnaires, task generators and answer keys, expert-testing notes, participant guides
# and decks, and research plans. Kept on the maintainer's machine and no longer published (earlier
# versions remain in the repository's history) - the site is built from docs/, and none of this is
# under docs/. Anchored to the root so it cannot hide a folder called private somewhere else. See
# private/README.md (local only).
/private/

# Design specs and plans written while working (the superpowers skills write them here). Internal,
# like private/: kept on the maintainer's machine, out of git and out of the site (mkdocs.yml
# exclude_docs). Until 1.134.0 they were tracked; earlier versions remain in the history.
/docs/superpowers/
